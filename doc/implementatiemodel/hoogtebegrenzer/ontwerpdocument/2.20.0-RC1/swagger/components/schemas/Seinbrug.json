{
  "title": "Seinbrug",
  "type": "object",
  "description": "Metalen constructie bestaande uit twee of meer verticale steunen met voetplaat en uit een enkele of een dubbel uitgevoerde horizontale dwarsverbinding,allen kokervormig met rechthoekige doorsnede.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Seinbrug)",
      "pattern": "^Seinbrug$"
    },
    "overspanning": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "vrijeHoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "type": {
      "$ref": "#/components/schemas/SeinbrugType"
    },
    "hoogteVerticaleSteun": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "aantalLadders": {
      "type": "object",
      "description": "Het aantal ladders waarmee de seinbrug toegankelijk is.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftLooproosters": {
      "type": "object",
      "description": "Geeft aan of de seinbrug is uitgerust met een loopinrichting en beloopbaar is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aantalSteunen": {
      "type": "object",
      "description": "Het aantal steunen waarmee de seinbrug gedragen wordt.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "rijrichting": {
      "$ref": "#/components/schemas/SeinbrugRijrichting"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "berekeningsnota": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "controlemetingEBS": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "beschermlaag": {
      "$ref": "#/components/schemas/DraagconstructieBeschermlaag"
    },
    "bijzonderTransport": {
      "$ref": "#/components/schemas/DraagconstructieBijzonderTransport"
    },
    "kleur": {
      "$ref": "#/components/schemas/RAL-Kleur"
    },
    "beschermendeLaag": {
      "$ref": "#/components/schemas/BeschermendeLaag"
    },
    "fabrikant": {
      "type": "object",
      "description": "De fabrikant van de steun.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "hoogteBovenkant": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "elektrischeBeveiliging": {
      "$ref": "#/components/schemas/EM-DraagconstructieElektrischeBeveiliging"
    },
    "naampad": {
      "type": "object",
      "description": "Een set van objecten (bv. collecties) die aanduiden waar het object zich bevindt in de objectenboom (EM-Infra). Dient consistent te zijn met de naam.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    }
  },
  "required": [
    "@type",
    "overspanning",
    "vrijeHoogte",
    "type",
    "hoogteVerticaleSteun",
    "aantalLadders",
    "heeftLooproosters",
    "aantalSteunen",
    "rijrichting",
    "technischeFiche",
    "berekeningsnota",
    "controlemetingEBS",
    "beschermlaag",
    "bijzonderTransport",
    "kleur",
    "beschermendeLaag",
    "fabrikant",
    "hoogteBovenkant",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "elektrischeBeveiliging",
    "naampad"
  ]
}