      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "waarde": {
      "type": "object",
      "description": "Bevat een getal die bij het datatype hoort.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "standaardEenheid",
    "waarde"
  ]
