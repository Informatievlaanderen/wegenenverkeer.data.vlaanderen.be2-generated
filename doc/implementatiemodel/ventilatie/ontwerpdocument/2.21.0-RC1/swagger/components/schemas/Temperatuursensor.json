{
  "title": "Temperatuursensor",
  "type": "object",
  "description": "Een meettoestel dat de temperatuur van een omgeving of medium meet. Het resultaat wordt omgezet in een uitleesbaar signaal.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Temperatuursensor)",
      "pattern": "^Temperatuursensor$"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/TemperatuursensorModelnaam"
    },
    "merk": {
      "$ref": "#/components/schemas/TemperatuursensorMerk"
    },
    "componentnummer": {
      "$ref": "#/components/schemas/Temperatuursensor.componentnummer"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Temperatuursensor.serienummer"
    },
    "naampad": {
      "$ref": "#/components/schemas/Temperatuursensor.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Temperatuursensor.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Temperatuursensor.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Temperatuursensor.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Temperatuursensor.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Temperatuursensor.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Temperatuursensor.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Temperatuursensor.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "modelnaam",
    "merk",
    "componentnummer",
    "serienummer",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}