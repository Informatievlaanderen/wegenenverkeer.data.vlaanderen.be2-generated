    rdfs:label "standen"@nl;
    rdfs:comment "Met de standen van de ventilator kan de draaisnelheid en soms ook de draairichting van de de bladen van de ventilator bepaald worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ventilatie/ontwerpdocument/2.20.0-RC1#Ventilator.Standen>;
