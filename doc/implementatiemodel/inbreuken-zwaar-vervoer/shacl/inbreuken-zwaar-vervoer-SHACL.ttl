    shacl:description "Een AID-camera is een CCTV-camera met geintegreerde AID-module. Deze camera genereert naast een camerabeeld ook metadata ivm wat zich afspeelt op het beeld. Een voorbeeld hiervan is gestopte voertuigen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft AID"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Camera.heeftAid>
  ], [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van de camera."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/inbreuken-zwaar-vervoer/ontwerpdocument/DEV#Camera.Merk>;
    shacl:description "Het merk van de camera."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Camera.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "configuratie bestand AID"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.3.0-RC1"@nl;
    rdfs:comment "Het bestand met de configuratie van de AID component die deel is van de camera."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/inbreuken-zwaar-vervoer/ontwerpdocument/DEV#Camera.ConfiguratieBestandAID>;
