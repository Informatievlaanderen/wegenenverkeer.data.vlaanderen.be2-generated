    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft spitsstrook"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Camera.heeftSpitsstrook>
  ], [
