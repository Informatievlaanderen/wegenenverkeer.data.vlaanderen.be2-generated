{
  "title": "Niet-SelectieveDetectielus",
  "type": "object",
  "description": "Een niet-selectieve detectielus werkt onder invloed van een wijziging in de zelfinductie van een lus in het wegdek wanneer het metaal van een voertuig binnen het gevoeligheidsgebied van de lus komt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Niet-SelectieveDetectielus)",
      "pattern": "^Niet-SelectieveDetectielus$"
    },
    "soortVoertuig": {
      "type": "array",
      "description": "Type voertuig dat de detectielus volgens zijn instellingen kan detecteren. Lijst van VRI-LusSoortVoertuig items.",
      "items": {
        "$ref": "#/components/schemas/VRI-LusSoortVoertuig"
      },
      "minItems": 1
    },
    "isRichtingsgevoelig": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.isRichtingsgevoelig"
    },
    "isMotorgevoelig": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.isMotorgevoelig"
    },
    "functie": {
      "$ref": "#/components/schemas/VRI-LusFunctie"
    },
    "heeftMofInTrekput": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.heeftMofInTrekput"
    },
    "isPrioritair": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.isPrioritair"
    },
    "bewakingstijd": {
      "$ref": "#/components/schemas/Tijdsduur"
    },
    "afmetingenBL": {
      "$ref": "#/components/schemas/AfmetingBxlInMeter"
    },
    "soortBewaking": {
      "$ref": "#/components/schemas/VRIBewaking"
    },
    "naam": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Niet-SelectieveDetectielus.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Niet-SelectieveDetectielus.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "$ref": "#/components/schemas/Niet-SelectieveDetectielus.naampad"
    }
  },
  "required": [
    "@type",
    "soortVoertuig",
    "isRichtingsgevoelig",
    "isMotorgevoelig",
    "functie",
    "heeftMofInTrekput",
    "isPrioritair",
    "bewakingstijd",
    "afmetingenBL",
    "soortBewaking",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad"
  ]
}