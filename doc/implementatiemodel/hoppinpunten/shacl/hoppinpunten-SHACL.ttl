<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/hoppinpunten/ontwerpdocument/2.20.0-RC1#FunderingShape> a shacl:NodeShape;
  rdfs:label "Fundering"@nl;
  rdfs:comment "Abstracte voor verschillende manieren om er voor te zorgen dat het eigen gewicht van het object dat de fundering krijgt en de krachten uitgeoefend op dat object, zoals nuttige belasting, sneeuw, winddruk, enzovoorts, worden overgedragen op de draagkrachtige ondergrond. Een fundering zit hoofdzakelijk onder het maaiveld en heeft tot doel het stabiliseren van een ander object."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aanzetpeil"@nl;
    rdfs:comment "De hoogte van het laagste punt van de onderkant van een element, ten opzichte van gemiddeld laagwaterpeil te Oostende (TAWpeil)."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/hoppinpunten/ontwerpdocument/2.20.0-RC1#Fundering.Aanzetpeil>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW>;
    shacl:description "De hoogte van het laagste punt van de onderkant van een element, ten opzichte van gemiddeld laagwaterpeil te Oostende (TAWpeil)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aanzetpeil"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Fundering.aanzetpeil>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hoogte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.0.0-RC4"@nl;
    rdfs:comment "De afstand tussen het laagste punt van de onderkant en hoogste punt van de bovenkant van de fundering."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/hoppinpunten/ontwerpdocument/2.20.0-RC1#Fundering.Hoogte>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter>;
    shacl:description "De afstand tussen het laagste punt van de onderkant en hoogste punt van de bovenkant van de fundering."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hoogte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Fundering.hoogte>
