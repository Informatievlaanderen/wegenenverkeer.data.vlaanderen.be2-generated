<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/hoppinpunten/ontwerpdocument/2.20.0-RC1#AIMToestandShape> a shacl:NodeShape;
  rdfs:label "AIM Toestand"@nl,
    "AIM toestand"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat de huidige stand in de levenscyclus van het object aangeeft."@nl,
    "Keuzelijst met fasen uit de levenscyclus van een object om de toestand op een moment mee vast te leggen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "AIM-toestand"@nl;
    rdfs:comment "Geeft de actuele stand in de levenscyclus van het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/hoppinpunten/ontwerpdocument/2.20.0-RC1#AIMToestand.AIM-Toestand>;
    shacl:class skos:Concept;
    shacl:description "Geeft de actuele stand in de levenscyclus van het object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "AIM-toestand"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMToestand.toestand>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Zonnepaneel>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Laag>,
