      "KwantitatieveWaardeInMeter": {
        "title": "KwantitatieveWaardeInMeter",
        "type": "object",
        "description": "Een kwantitatieve waarde die een getal in meter uitdrukt.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse KwantitatieveWaardeInMeter)",
            "pattern": "^KwantitatieveWaardeInMeter$"
          },
          "standaardEenheid": {
            "type": "object",
            "description": "De standaard eenheid bij dit datatype is uitgedrukt in meter. \"m\"^^cdt:ucumunit",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "waarde": {
            "type": "object",
            "description": "Bevat een getal die bij het datatype hoort.",
            "properties": {
              "@value": {
                "type": "string",
                "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
              },
              "@type": {
                "type": "string",
                "pattern": "^Decimal$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          }
        },
        "required": [
          "@type",
          "standaardEenheid",
          "waarde"
        ]
      },
