  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
    rdfs:comment "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/akela-failover/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.TypeUri>;
