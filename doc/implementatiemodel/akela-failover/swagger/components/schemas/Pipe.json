{
  "title": "Pipe",
  "type": "object",
  "description": "Een buis die dienst kan doen als object voor het omhullen van meerdere kabels of andere (kleinere) leidingen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Pipe)",
      "pattern": "^Pipe$"
    },
    "kleur": {
      "$ref": "#/components/schemas/Beschermbuiskleur"
    },
    "containertype": {
      "$ref": "#/components/schemas/PipeContainerType"
    },
    "netwerktype": {
      "$ref": "#/components/schemas/NetwerkType"
    },
    "buitendiameter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "isRisicovol": {
      "$ref": "#/components/schemas/Pipe.isRisicovol"
    },
    "naam": {
      "$ref": "#/components/schemas/Pipe.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Pipe.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pipe.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Pipe.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pipe.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Pipe.datumOprichtingObject"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/Pipe.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "kleur",
    "containertype",
    "netwerktype",
    "buitendiameter",
    "isRisicovol",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}