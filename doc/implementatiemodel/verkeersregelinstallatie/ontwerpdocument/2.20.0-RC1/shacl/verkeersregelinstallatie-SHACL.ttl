<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/2.20.0-RC1#VR-CommunicatiekaartShape> a shacl:NodeShape;
  rdfs:label "VR-communicatiekaart"@nl;
  <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.12.0-RC2"@nl;
  rdfs:comment "Modem die alle toestandswijzigingen van de stuurkaart doorgeeft aan het afstandsbewakingssysteem. De module maakt continue een backup van alle log en data gegevens en slaat deze op op de aanwezige SD kaart. Tevens wordt de module ook gebruikt om vanop afstand te kunnen communiceren met de regelaar"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type geheugen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.12.0-RC2"@nl;
    rdfs:comment "Type opslaggeheugen op de aanwezige SD-kaart."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/2.20.0-RC1#VR-Communicatiekaart.TypeGeheugen>;
    shacl:class skos:Concept;
    shacl:description "Type opslaggeheugen op de aanwezige SD-kaart."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type geheugen"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VRCommunicatiekaart.typeGeheugen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft smartguard"@nl;
