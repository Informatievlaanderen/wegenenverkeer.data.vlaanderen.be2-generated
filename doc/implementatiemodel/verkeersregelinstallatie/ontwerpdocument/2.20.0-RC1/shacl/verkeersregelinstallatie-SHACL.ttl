    rdfs:label "uitgangsfrequentie"@nl;
    rdfs:comment "De waarde van de frequentie van de elektriciteit aan de uitgangszijde van de omvormer. Indien het om DC stroom gaat, is deze waarde gelijk aan nul."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/2.20.0-RC1#UPS.Uitgangsfrequentie>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInHerz>;
    shacl:description "De waarde van de frequentie van de elektriciteit aan de uitgangszijde van de omvormer. Indien het om DC stroom gaat, is deze waarde gelijk aan nul."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "uitgangsfrequentie"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS.uitgangsfrequentie>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS> .

