    shacl:minCount 1;
    shacl:name "maximaal continu vermogen"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS.maxContinuVermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgangsstroom"@nl;
    rdfs:comment "De waarde van de elektrische stroom aan de uitgangszijde van de omvormer."@nl;
