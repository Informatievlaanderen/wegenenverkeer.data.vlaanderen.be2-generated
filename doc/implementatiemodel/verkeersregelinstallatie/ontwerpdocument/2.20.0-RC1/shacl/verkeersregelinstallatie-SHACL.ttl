    shacl:minCount 1;
    shacl:name "standaardbestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject.standaardBestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
