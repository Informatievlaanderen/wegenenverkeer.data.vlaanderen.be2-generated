{
  "title": "DetectieCamera",
  "type": "object",
  "description": "Deze camera's worden onder andere opgesteld op kruispunten om de aanwezigheid van voertuigen te detecteren. De detectie kan optisch en/of thermografisch gebeuren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse DetectieCamera)",
      "pattern": "^DetectieCamera$"
    },
    "detectieprincipe": {
      "type": "array",
      "description": "Geeft aan of de camera optisch en/of thermografisch werkt. Lijst van DetectiecameraDetectieprincipe items.",
      "items": {
        "$ref": "#/components/schemas/DetectiecameraDetectieprincipe"
      },
      "minItems": 1
    },
    "merk": {
      "$ref": "#/components/schemas/DetectiecameraMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/DetectiecameraModelnaam"
    },
    "communicatiewijze": {
      "$ref": "#/components/schemas/VRICommunicatieprotocolVerkeersdetectie"
    },
    "typeWeggebruiker": {
      "$ref": "#/components/schemas/VRIDetectorTypeweggebruiker"
    },
    "voedingsspanning": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVolt"
    },
    "firmwareversie": {
      "$ref": "#/components/schemas/DetectieCamera.firmwareversie"
    },
    "soortBewaking": {
      "$ref": "#/components/schemas/VRIBewaking"
    },
    "naam": {
      "$ref": "#/components/schemas/DetectieCamera.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/DetectieCamera.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/DetectieCamera.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/DetectieCamera.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/DetectieCamera.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/DetectieCamera.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/DetectieCamera.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "detectieprincipe",
    "merk",
    "modelnaam",
    "communicatiewijze",
    "typeWeggebruiker",
    "voedingsspanning",
    "firmwareversie",
    "soortBewaking",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}