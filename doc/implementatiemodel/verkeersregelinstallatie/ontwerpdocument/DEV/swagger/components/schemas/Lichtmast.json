{
  "title": "Lichtmast",
  "type": "object",
  "description": "Paal waarop een verlichtingstoestel of andere toestellen zoals een camera bevestigd kunnen worden met uitzondering van wegverlichting. Omvat het deurtje, klemmenblok, montagekastje, bevestigingsmaterialen (bv. voetplaten) en fundering (bv. buisfundering) of verankeringsmassief. Indien de paal gebruikt wordt voor wegverlichting moet het objecttype WVLichtmast gebruikt worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Lichtmast)",
      "pattern": "^Lichtmast$"
    },
    "leverancier": {
      "$ref": "#/components/schemas/LichtmastLeverancier"
    },
    "masttype": {
      "$ref": "#/components/schemas/LichtmastType"
    },
    "beschermendeLaag": {
      "$ref": "#/components/schemas/BeschermendeLaag"
    },
    "dwarsdoorsnede": {
      "$ref": "#/components/schemas/DraagconstructieDwarsdoorsnede"
    },
    "normeringBotsvriendelijk": {
      "$ref": "#/components/schemas/LichtmastBotsnormering"
    },
    "beschermlaag": {
      "$ref": "#/components/schemas/DraagconstructieBeschermlaag"
    },
    "heeftAnti-VandalismeBeugel": {
      "$ref": "#/components/schemas/Lichtmast.heeftAnti-VandalismeBeugel"
    },
    "heeftStopcontactAanwezig": {
      "$ref": "#/components/schemas/Lichtmast.heeftStopcontactAanwezig"
    },
    "kleur": {
      "$ref": "#/components/schemas/RAL-Kleur"
    },
    "masthoogte": {
      "$ref": "#/components/schemas/Masthoogte"
    },
    "kleurStandaard": {
      "$ref": "#/components/schemas/KleurStandaard"
    },
    "specialeUitvoeringswijze": {
      "$ref": "#/components/schemas/Lichtmast.specialeUitvoeringswijze"
