{
  "title": "TLC-FIPoort",
  "type": "object",
  "description": "Functionele software component die een TLC-FI interface aanbiedt waardoor data kan uitgewisseld worden voor intelligente verkeersregelaars.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse TLC-FIPoort)",
      "pattern": "^TLC-FIPoort$"
    },
    "merk": {
      "$ref": "#/components/schemas/IVRIMerkTLCfi"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/IVRIModelTLCfi"
    },
    "baseline": {
      "$ref": "#/components/schemas/IVRIBaseline"
    },
    "certificaat": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "dependencies": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "poortenconfiguratie": {
      "type": "array",
      "description": "Lijst van SoftwarePoortconfiguratie items.",
      "items": {
        "$ref": "#/components/schemas/SoftwarePoortconfiguratie"
      },
      "minItems": 1
    },
    "aangebodenServices": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "versie": {
      "type": "object",
      "description": "Het versienummer van de software.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "licentie": {
      "$ref": "#/components/schemas/SoftwareLicentie"
    },
    "onlineDocumentatie": {
      "type": "object",
      "description": "De url waarop documentatie over de software te vinden is.",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "documentatie": {
      "type": "object",
      "description": "Link naar documentatie over de software. Attribuut uit gebruik sinds versie 2.1.0-RC2",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "buildnummer": {
      "type": "object",
      "description": "De software build.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "type": "object",
      "description": "Een set van objecten (bv. collecties) die aanduiden waar het object zich bevindt in de objectenboom (EM-Infra). Dient consistent te zijn met de naam.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "baseline",
    "certificaat",
    "dependencies",
    "poortenconfiguratie",
    "aangebodenServices",
    "versie",
    "licentie",
    "onlineDocumentatie",
    "documentatie",
    "buildnummer",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad"
  ]
}