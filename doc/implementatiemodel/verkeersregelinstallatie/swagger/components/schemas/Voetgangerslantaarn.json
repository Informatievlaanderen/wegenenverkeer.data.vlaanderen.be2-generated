{
  "title": "Voetgangerslantaarn",
  "type": "object",
  "description": "Geheel van meerdere verkeerslichten die boven elkaar worden opgesteld en worden bevestigd op een steun, teneinde de beweging van voetgangers te verhinderen of toe te laten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voetgangerslantaarn)",
      "pattern": "^Voetgangerslantaarn$"
    },
    "diameter": {
      "$ref": "#/components/schemas/SeinlantaarnDiameter"
    },
    "vormgeving": {
      "$ref": "#/components/schemas/LantaarnVormgeving"
    },
    "heeftContrastschermAanwezig": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.heeftContrastschermAanwezig"
    },
    "merk": {
      "$ref": "#/components/schemas/SeinlantaarnMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/SeinlantaarnModelnaam"
    },
    "aantalModules": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.aantalModules"
    },
    "naam": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Voetgangerslantaarn.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Voetgangerslantaarn.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Voetgangerslantaarn.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
