    shacl:description "Documenten van interne of externe organisaties, die de installatie goedkeuren of opmerkingen geven."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "certificaat"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#ASTRIDInstallatie.certificaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "technische fiche"@nl;
    rdfs:comment "De technische fiche van de ASTRID installatie."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/2.20.0-RC1#ASTRIDInstallatie.TechnischeFiche>;
