    shacl:description "Het IP-adres van de omvormer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "ip adres"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omvormer.ipAdres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "De soort omvorming die gebeurt er in de omvormer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/2.20.0-RC1#Omvormer.Type>;
    shacl:class skos:Concept;
    shacl:description "De soort omvorming die gebeurt er in de omvormer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omvormer.type>
