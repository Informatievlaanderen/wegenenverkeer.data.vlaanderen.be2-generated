<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#AIMNaamObjectShape> a shacl:NodeShape;
  rdfs:label "AIM naam object"@nl;
