    shacl:description "Documenten van interne of externe organisaties, die de installatie goedkeuren of opmerkingen geven."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "certificaat"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#ASTRIDInstallatie.certificaat>
  ], [
    a shacl:PropertyShape;
