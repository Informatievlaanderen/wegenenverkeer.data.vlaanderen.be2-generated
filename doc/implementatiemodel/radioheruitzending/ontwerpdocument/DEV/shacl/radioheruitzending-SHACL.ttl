    shacl:minCount 1;
    shacl:name "standaardbestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.standaardBestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
    rdfs:comment "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#AIMObject.TypeURI>;
