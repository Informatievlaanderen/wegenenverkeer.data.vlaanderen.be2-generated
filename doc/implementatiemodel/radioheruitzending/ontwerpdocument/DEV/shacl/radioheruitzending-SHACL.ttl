<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#UPSShape> a shacl:NodeShape;
  rdfs:label "UPS"@nl;
  rdfs:comment "Toestel (Uninterruptible Power Supply = niet onderbreekbare voeding) voor het leveren van elektrische energie van een vastgelegde kwaliteit, onafhankelijk van de beschikbaarheid van een betrouwbare netspanning. Indien het openbare net niet langer bruikbaar is om als energiebron te fungeren, wordt de energievoorziening overgenomen door de accubatterij. Deze zal gedurende een bepaalde tijd, afhankelijk van de capaciteit, de stroomvoorziening verzorgen. De UPS dient om de (minimale) voeding ononderbroken te verzekeren"@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#UPS>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "max piekvermogen"@nl;
    rdfs:comment "Het maximale piekvermogen van de UPS."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#UPS.MaxPiekvermogen>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInWatt>;
    shacl:description "Het maximale piekvermogen van de UPS."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "max piekvermogen"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.maxPiekVermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "autonomie"@nl;
    rdfs:comment "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/radioheruitzending/ontwerpdocument/DEV#UPS.Autonomie>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInkWh>;
    shacl:description "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "autonomie"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.autonomie>
  ], [
    a shacl:PropertyShape;
