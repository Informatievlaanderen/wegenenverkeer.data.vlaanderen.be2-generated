{
  "title": "Alarmmodule",
  "type": "object",
  "description": "Module binnen een installatie, waar de verschillende alarmen van andere modules toekomen, en die via het netwerk doorgestuurd kunnen worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Alarmmodule)",
      "pattern": "^Alarmmodule$"
    },
    "merk": {
      "$ref": "#/components/schemas/AlarmModuleMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/AlarmModuleModelnaam"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aantalAlarmen": {
      "$ref": "#/components/schemas/Alarmmodule.aantalAlarmen"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Alarmmodule.serienummer"
    },
    "naam": {
      "$ref": "#/components/schemas/Alarmmodule.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Alarmmodule.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Alarmmodule.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Alarmmodule.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Alarmmodule.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Alarmmodule.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Alarmmodule.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "ipAdres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "dNSNaam": {
      "$ref": "#/components/schemas/Alarmmodule.dNSNaam"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "technischeFiche",
    "aantalAlarmen",
    "serienummer",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "ipAdres",
    "dNSNaam"
  ]
}