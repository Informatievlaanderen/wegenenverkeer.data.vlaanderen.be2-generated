{
  "title": "FMRepeaterBox",
  "type": "object",
  "description": "Een radio-ontvanger en -zender, die het FM-signaal ontvangt en weer doorgeeft om zo grotere afstanden te overbruggen en plaatsen te bereiken, waar de radiosignalen niet geraken, zoals in tunnels. De uitvoering is van het type 'box' waar aparte repeatermodules per frequentie of voor meerdere frequenties kunnen ingestoken worden, zoals in een vaste computer.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse FMRepeaterBox)",
      "pattern": "^FMRepeaterBox$"
    },
    "aantalFMKaarten": {
      "$ref": "#/components/schemas/FMRepeaterBox.aantalFMKaarten"
    },
    "merk": {
      "$ref": "#/components/schemas/FMRepeaterboxModelnaam"
    },
    "aantalModulators": {
