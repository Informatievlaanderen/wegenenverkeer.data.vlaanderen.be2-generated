    },
    "modelnaam": {
      "$ref": "#/components/schemas/FMRepeaterboxModelnaam"
    },
    "aantalSwitches": {
      "$ref": "#/components/schemas/FMRepeaterBox.aantalSwitches"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aantalInstelbareFMFrequenties": {
      "$ref": "#/components/schemas/FMRepeaterBox.aantalInstelbareFMFrequenties"
    },
    "serienummer": {
