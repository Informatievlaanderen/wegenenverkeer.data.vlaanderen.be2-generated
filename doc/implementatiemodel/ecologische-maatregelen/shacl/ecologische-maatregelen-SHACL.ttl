    shacl:name "eindbeeld"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.eindbeeld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kroon diameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.0.0"@nl;
    rdfs:comment "Diameter van de kroonprojectie in meter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#OpgaandeBoom.KroonDiameter>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Diameter van de kroonprojectie in meter."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "kroon diameter"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpgaandeBoom.kroonDiameter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "groeifase"@nl;
