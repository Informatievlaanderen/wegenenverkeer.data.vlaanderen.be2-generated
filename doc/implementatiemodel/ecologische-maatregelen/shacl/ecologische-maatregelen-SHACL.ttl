<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#BoomShape> a shacl:NodeShape;
  rdfs:label "Boom"@nl;
  rdfs:comment "Een opgaande boom is een boom waarvan de vorm van de kruin overeenkomt met zijn natuurlijke, soortgebonden habitus. Opgaande bomen kunnen een hoge, lage, brede, smalle of een afwijkende groeivorm hebben, zoals zuil- en treurvormen. De boom kan zich op volstrekt natuurlijke wijze uitgezaaid hebben en zijn groeivorm kan bepaald zijn door de natuurlijke groeiomstandigheden (bv. natuurlijke snoei). Ontstond de boom in kunstmatige omstandigheden, dan is de groeivorm bepaald door de jeugdsnoei in de kwekerij en is het eindbeeld van de boom bepaald door de begeleidingssnoei of vormsnoei die wordt uitgevoerd vanaf het planten."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is verplant"@nl;
    rdfs:comment "Aanduiding of de opgaande boom al dan niet van locatie veranderd is na een eerste aanplant binnen het openbaar domein."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.IsVerplant>;
    shacl:class xsd:boolean;
    shacl:description "Aanduiding of de opgaande boom al dan niet van locatie veranderd is na een eerste aanplant binnen het openbaar domein."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is verplant"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.isVerplant>
  ], [
    a shacl:PropertyShape;
    rdfs:label "eindbeeld"@nl;
    rdfs:comment "Het nagestreefde beeld van de volgroeide boom of struik op deze specifieke standplaats."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.Eindbeeld>;
    shacl:class skos:Concept;
    shacl:description "Het nagestreefde beeld van de volgroeide boom of struik op deze specifieke standplaats."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "eindbeeld"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.eindbeeld>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kroon diameter"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.8.0"@nl;
    rdfs:comment "Diameter van de kroonprojectie in meter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.KroonDiameter>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Diameter van de kroonprojectie in meter."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "kroon diameter"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.kroonDiameter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "groeifase"@nl;
    rdfs:comment "Fase van beheer volgens de verschillende levensfases van de boom."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.Groeifase>;
    shacl:class skos:Concept;
    shacl:description "Fase van beheer volgens de verschillende levensfases van de boom."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "groeifase"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.groeifase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vrije doorrijhoogte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.16.0"@nl;
    rdfs:comment "Vrij te houden hoogte in meter, voor het doorrijden van verkeer toe te laten."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.VrijeDoorrijhoogte>;
