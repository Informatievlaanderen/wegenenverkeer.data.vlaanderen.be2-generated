<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#AanlegBoomvormShape> a shacl:NodeShape;
  rdfs:label "aanleg boomvorm"@nl;
  rdfs:comment "Complex datatype om alle eigenschappen van de aanleg van een opgaande boom onder 1 noemer te houden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft boomplaat"@nl;
    rdfs:comment "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#AanlegBoomvorm.HeeftBoomplaat>;
    shacl:class xsd:boolean;
    shacl:description "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeft boomplaat"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftBoomplaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wortel aanplant"@nl;
    rdfs:comment "De manier van levering en aanplanting van het wortelgestel van de boom of plant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#AanlegBoomvorm.WortelAanplant>;
    shacl:class skos:Concept;
    shacl:description "De manier van levering en aanplanting van het wortelgestel van de boom of plant."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "wortel aanplant"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.wortelAanplant>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft wortelgeleiding wortelwering"@nl;
    rdfs:comment "Aanduiding of de boom wortelwering heeft. Wortelgeleiding en –wering moet voorkomen dat boomwortels het trottoir, de middenberm, het fietspad, de rijweg, andere wegverhardingen en leidingstelsels beschadigen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#AanlegBoomvorm.HeeftWortelgeleidingWortelwering>;
    shacl:class xsd:boolean;
    shacl:description "Aanduiding of de boom wortelwering heeft. Wortelgeleiding en –wering moet voorkomen dat boomwortels het trottoir, de middenberm, het fietspad, de rijweg, andere wegverhardingen en leidingstelsels beschadigen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "heeft wortelgeleiding wortelwering"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftWortelgeleidingwortelwering>
  ], [
    a shacl:PropertyShape;
    rdfs:label "plantmaat hoogte"@nl;
    rdfs:comment "De hoogte in meter gemeten van de stamvoet tot de top met een minimum en maximum waarde."@nl;
