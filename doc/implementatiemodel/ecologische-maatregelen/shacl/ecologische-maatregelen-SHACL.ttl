    shacl:name "boomverankeringszone"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.boomverankeringszone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanleg"@nl;
    rdfs:comment "De manier van aanplanten van individuele bomen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.Aanleg>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm>;
    shacl:description "De manier van aanplanten van individuele bomen."@nl;
    shacl:maxCount "1";
