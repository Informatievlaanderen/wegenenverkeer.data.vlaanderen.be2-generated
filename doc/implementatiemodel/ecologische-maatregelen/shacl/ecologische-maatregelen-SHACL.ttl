    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "totale boombeschermingszone"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Boom.totaleBoombeschermingszone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "boomverankeringszone"@nl;
    rdfs:comment "De straal van de cirkelvormige ruimte waarbinnen de wortels zich bevinden die instaan voor de stabiliteit van de boom uitgedrukt in meter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/2.18.1#Boom.Boomverankeringszone>;
