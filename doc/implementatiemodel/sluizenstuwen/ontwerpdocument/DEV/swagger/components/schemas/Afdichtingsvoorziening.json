{
  "title": "Afdichtingsvoorziening",
  "type": "object",
  "description": "Een afdichtingsvoorziening is een afdichtend component dat wordt toegepast ter hoogte van een voeg, naad of overgang tussen constructiedelen om waterdichtheid te realiseren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Afdichtingsvoorziening)",
      "pattern": "^Afdichtingsvoorziening$"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "materiaalAfdichtingsvoorziening": {
      "$ref": "#/components/schemas/MateriaalAfdichtingsvoorziening"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "typeAfdichtingsvoorziening": {
      "$ref": "#/components/schemas/Afdichtingsvoorzieningtype"
    },
    "naam": {
      "$ref": "#/components/schemas/Afdichtingsvoorziening.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Afdichtingsvoorziening.bestekpostnummer"
      },
      "minItems": 1
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Afdichtingsvoorziening.datumOprichtingObject"
    },
    "notitie": {
      "$ref": "#/components/schemas/Afdichtingsvoorziening.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Afdichtingsvoorziening.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "typeURI": {
      "$ref": "#/components/schemas/Afdichtingsvoorziening.typeURI"
    },
    "isActief": {
      "$ref": "#/components/schemas/Afdichtingsvoorziening.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "lengte",
    "materiaalAfdichtingsvoorziening",
    "technischeFiche",
    "typeAfdichtingsvoorziening",
    "naam",
    "asset-Id",
    "bestekpostnummer",
    "datumOprichtingObject",
    "notitie",
    "standaardbestekpostnummer",
    "theoretischeLevensduur",
    "typeURI",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}