{
  "title": "Sluisvoertegel",
  "type": "object",
  "description": "Een betontegel met grote afmetingen specifiek van toepassing voor de bodem van een sluis.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Sluisvoertegel)",
      "pattern": "^Sluisvoertegel$"
    },
    "heeftVoegbanden": {
      "$ref": "#/components/schemas/Sluisvoertegel.heeftVoegbanden"
    },
    "afmetingen": {
      "$ref": "#/components/schemas/AfmetingBxlxhInMeter"
    },
    "betonspecificaties": {
      "$ref": "#/components/schemas/Betonspecificaties"
    },
    "wapeningsplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "uitvoeringsmethode": {
      "$ref": "#/components/schemas/Uitvoeringsmethode"
    },
    "bekistingsplan": {
      "type": "array",
      "description": "Een plan die bekistingsmaten bevat en ook alle maten van alle mogelijke uitsparingen die er kunnen zijn. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "technischeFicheBetonbescherming": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "naam": {
      "$ref": "#/components/schemas/Sluisvoertegel.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Sluisvoertegel.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Sluisvoertegel.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Sluisvoertegel.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Sluisvoertegel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Sluisvoertegel.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Sluisvoertegel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "heeftVoegbanden",
    "afmetingen",
    "betonspecificaties",
    "wapeningsplan",
    "uitvoeringsmethode",
    "bekistingsplan",
    "technischeFicheBetonbescherming",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}