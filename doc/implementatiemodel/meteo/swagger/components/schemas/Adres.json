      "pattern": "^Adres$"
    },
    "straatnaam": {
      "$ref": "#/components/schemas/Adres.straatnaam"
    },
    "huisnummer": {
      "$ref": "#/components/schemas/Adres.huisnummer"
    },
    "bus": {
      "$ref": "#/components/schemas/Adres.bus"
    },
    "postcode": {
      "$ref": "#/components/schemas/Adres.postcode"
    },
    "provincie": {
      "$ref": "#/components/schemas/Provincie"
    },
    "gemeente": {
      "$ref": "#/components/schemas/Gemeente"
    }
  },
  "required": [
    "@type",
    "straatnaam",
    "huisnummer",
    "bus",
    "postcode",
    "provincie",
    "gemeente"
