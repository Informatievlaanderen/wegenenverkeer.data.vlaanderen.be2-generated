        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "ingangsstroom": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInAmpèRe"
    },
    "uitgangsspanning": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVolt"
    },
