{
  "title": "OptischeWegdeksensor",
  "type": "object",
  "description": "Een meettoestel dat gebruik maakt van optische eigenschappen om de wegdekcondities zoals nat,ijs,sneeuw en vorst te meten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse OptischeWegdeksensor)",
      "pattern": "^OptischeWegdeksensor$"
    },
    "merk": {
      "$ref": "#/components/schemas/OptischeWegdeksensorMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/OptischeWegdeksensorModelnaam"
    },
    "naam": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/OptischeWegdeksensor.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/OptischeWegdeksensor.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "opstelhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "opstelwijze": {
      "$ref": "#/components/schemas/SensorOpstelwijze"
    },
    "serienummer": {
      "$ref": "#/components/schemas/OptischeWegdeksensor.serienummer"
    },
    "kalibratiecertificaat": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technsiche fiche als bijlage van de sensor. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "opstelhoogte",
    "opstelwijze",
    "serienummer",
    "kalibratiecertificaat",
    "technischeFiche"
  ]
}