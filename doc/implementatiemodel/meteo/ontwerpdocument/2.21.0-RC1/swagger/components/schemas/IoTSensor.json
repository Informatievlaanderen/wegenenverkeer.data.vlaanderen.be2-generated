{
  "title": "IoTSensor",
  "type": "object",
  "description": "Een sensor die veranderingen in de omgeving registreert en erop reageert.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse IoTSensor)",
      "pattern": "^IoTSensor$"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/IoT-SensorModelnaam"
    },
    "serienummer": {
      "$ref": "#/components/schemas/IoTSensor.serienummer"
    },
    "merk": {
      "$ref": "#/components/schemas/IoT-SensorMerk"
    },
    "gemetenParameters": {
      "type": "array",
      "description": "De mogelijke parameters die kunnen gemeten worden door de IoT-sensor. Lijst van IoT-SensorParameter items.",
      "items": {
        "$ref": "#/components/schemas/IoT-SensorParameter"
      },
      "minItems": 1
    },
    "batterij": {
      "$ref": "#/components/schemas/CompacteBatterij"
    },
    "typeVerbinding": {
      "$ref": "#/components/schemas/IoT-SensorVerbindingtype"
    },
    "typeIoT-Sensor": {
      "$ref": "#/components/schemas/TypeSensor"
    },
    "naam": {
      "$ref": "#/components/schemas/IoTSensor.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/IoTSensor.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/IoTSensor.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/IoTSensor.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/IoTSensor.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/IoTSensor.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/IoTSensor.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "modelnaam",
    "serienummer",
    "merk",
    "gemetenParameters",
    "batterij",
    "typeVerbinding",
    "typeIoT-Sensor",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}