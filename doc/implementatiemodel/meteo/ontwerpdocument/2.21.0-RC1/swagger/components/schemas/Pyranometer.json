{
  "title": "Pyranometer",
  "type": "object",
  "description": "Een meettoestel dat wordt gebruikt om de intensiteit van zonnestraling te meten. Het meetresultaat wordt omgezet in een uitleesbaar signaal.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Pyranometer)",
      "pattern": "^Pyranometer$"
    },
    "merk": {
      "$ref": "#/components/schemas/PyranometerMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/PyranometerModelnaam"
    },
    "naam": {
      "$ref": "#/components/schemas/Pyranometer.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Pyranometer.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pyranometer.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Pyranometer.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pyranometer.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Pyranometer.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Pyranometer.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "opstelhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "opstelwijze": {
      "$ref": "#/components/schemas/SensorOpstelwijze"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Pyranometer.serienummer"
    },
    "kalibratiecertificaat": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technsiche fiche als bijlage van de sensor. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "opstelhoogte",
    "opstelwijze",
    "serienummer",
    "kalibratiecertificaat",
    "technischeFiche"
  ]
}