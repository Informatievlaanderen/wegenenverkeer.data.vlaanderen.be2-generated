{
  "title": "Meetcel",
  "type": "object",
  "description": "Een cel voorzien met uitrusting voor het meten van het energieverbruik aan de hoogspanningszijde van de transformator.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Meetcel)",
      "pattern": "^Meetcel$"
    },
    "transformatieverhouding": {
      "$ref": "#/components/schemas/Meetcel.transformatieverhouding"
    },
    "nauwkeurigheidsvermogen": {
      "$ref": "#/components/schemas/MeetcelNauwkeurigheidsvermogen"
    },
    "nauwkeurigheidsklasse": {
      "$ref": "#/components/schemas/MeetcelNauwkeurigheidsklasse"
    },
    "veiligheidsfactor": {
      "$ref": "#/components/schemas/MeetcelVeiligheidsfactor"
    },
    "naampad": {
      "$ref": "#/components/schemas/Meetcel.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Meetcel.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Meetcel.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Meetcel.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Meetcel.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Meetcel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Meetcel.datumOprichtingObject"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/Meetcel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "transformatieverhouding",
    "nauwkeurigheidsvermogen",
    "nauwkeurigheidsklasse",
    "veiligheidsfactor",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}