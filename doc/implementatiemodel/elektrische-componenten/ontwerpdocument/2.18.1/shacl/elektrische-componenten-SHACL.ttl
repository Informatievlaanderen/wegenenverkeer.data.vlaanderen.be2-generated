    rdfs:comment "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/2.18.1#Ups.Autonomie>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInkWh>;
    shacl:description "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "autonomie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.autonomie>
  ], [
    a shacl:PropertyShape;
