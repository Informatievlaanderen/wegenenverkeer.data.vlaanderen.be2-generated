    shacl:description "Unieke identificatie van de aanvullende geometrie zoals toegekend door de beheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bijlage"@nl;
    rdfs:comment "Het document of artefact dat een geometrie heeft of een bijlage is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/DEV#AbstracteAanvullendeGeometrie.Bijlage>;
