    shacl:name "serienummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.serienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximaal continu vermogen"@nl;
