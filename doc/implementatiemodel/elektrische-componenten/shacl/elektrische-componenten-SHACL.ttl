<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/DEV#AbstracteAanvullendeGeometrieShape> a shacl:NodeShape;
  rdfs:label "Abstracte aanvullende geometrie"@nl;
  rdfs:comment "Abstracte om de eigenschappen en relaties van AanvullendeGeometrie te bundelen."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/DEV#AbstracteAanvullendeGeometrie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de aanvullende geometrie zoals toegekend door de beheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/DEV#AbstracteAanvullendeGeometrie.Asset-Id>;
