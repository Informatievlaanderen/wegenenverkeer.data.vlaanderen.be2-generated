  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De mensleesbare naam van een aanvullende geometrie of bijlage. De beheerder kent deze naam toe of geeft de opdracht om deze toe te kennen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektrische-componenten/ontwerpdocument/DEV#AbstracteAanvullendeGeometrie.Naam>;
