    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkGraslandGraslandfase4.huidigNatuurbeeld>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkGraslandGraslandfase4>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkVochtigTotNatGrasland>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Stroomdalgrasland>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkGlanshavergrasland>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkStruisgrasgrasland>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#KalkrijkKamgrasland> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#BloemrijkStruisgrasgraslandShape> a shacl:NodeShape;
  rdfs:label "Bloemrijk struisgrasgrasland"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."@nl;
  rdfs:comment "G4d - akkerhoornbloem, gewone veldbies, gewoon biggenkruid, gewoon duizendblad, gewoon struisgras, hazenpootje, klein vogelpootje, kleine klaver, kleine leeuwentand, knolboterbloem, muizenoor, schapenzuring, smalle weegbree, vroege haver, zilverhaver."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkStruisgrasgrasland> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#BloemrijkVochtigTotNatGraslandShape> a shacl:NodeShape;
  rdfs:label "Bloemrijk vochtig tot nat grasland"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."@nl;
  rdfs:comment "G4e - echte koekoeksbloem, grote ratelaar, kruipend zenegroen, moeras/zompvergeet-me-nietje, dotterbloem, kale jonker, lidrus, moerasrolklaver, moeraswalstro, egelboterbloem, pinksterbloem, slanke sleutelbloem, tweerijige zegge, gewone waterbies, heelblaadjes, penningkruid, pijptorkruid, zomprus."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BloemrijkVochtigTotNatGrasland> .

