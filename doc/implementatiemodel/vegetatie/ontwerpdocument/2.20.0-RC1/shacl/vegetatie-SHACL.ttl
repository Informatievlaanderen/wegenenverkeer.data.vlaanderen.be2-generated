<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#OnderwatervegetatieShape> a shacl:NodeShape;
  rdfs:label "Onderwatervegetatie"@nl;
  rdfs:comment "Vegetatie die zich onder het wateroppervlak bevindt."@nl;
