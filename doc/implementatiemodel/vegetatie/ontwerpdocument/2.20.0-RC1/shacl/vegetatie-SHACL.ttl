    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#Boom.KroonDiameter>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Diameter van de kroonprojectie in meter."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "kroon diameter"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Boom.kroonDiameter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "groeifase"@nl;
    rdfs:comment "Fase van beheer volgens de verschillende levensfases van de boom."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#Boom.Groeifase>;
    shacl:class skos:Concept;
    shacl:description "Fase van beheer volgens de verschillende levensfases van de boom."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "groeifase"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Boom.groeifase>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vrije doorrijhoogte"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.16.0-RC1"@nl;
    rdfs:comment "Vrij te houden hoogte in meter, voor het doorrijden van verkeer toe te laten."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/2.20.0-RC1#Boom.VrijeDoorrijhoogte>;
