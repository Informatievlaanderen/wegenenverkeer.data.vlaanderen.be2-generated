{
  "title": "Haag",
  "type": "object",
  "description": "Hagen zijn smalle lijnvormige elementen bestaande uit houtige soorten die geschoren kunnen worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Haag)",
      "pattern": "^Haag$"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "knipoppervlak": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "isVrijUitgroeiend": {
      "$ref": "#/components/schemas/Haag.isVrijUitgroeiend"
    },
    "aanleg": {
      "type": "array",
      "description": "De manier van aanplanten van de houtige vegetatie. Lijst van HoutigeAanleg items.",
      "items": {
        "$ref": "#/components/schemas/HoutigeAanleg"
      },
      "minItems": 1
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "heeftObstakels": {
      "$ref": "#/components/schemas/Haag.heeftObstakels"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "taludwaarde": {
      "$ref": "#/components/schemas/TaludWaarde"
    },
    "drassigheid": {
      "$ref": "#/components/schemas/VegetatieDrassigheid"
    },
    "soort": {
      "type": "array",
      "description": "Met deze eigenschap worden de Nederlandse soortnaam, wetenschappelijke soortnaam en de soortcode van de meest voorkomende soorten binnen het begroeid oppervlak weergegeven. Lijst van VegetatieSoortnaam items.",
      "items": {
        "$ref": "#/components/schemas/VegetatieSoortnaam"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Haag.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Haag.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Haag.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Haag.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Haag.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Haag.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "hoogte",
    "knipoppervlak",
    "isVrijUitgroeiend",
    "aanleg",
    "breedte",
    "lengte",
    "heeftObstakels",
    "oppervlakte",
    "taludwaarde",
    "drassigheid",
    "soort",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}