{
  "title": "Maaien",
  "type": "object",
  "description": "Complex datatype voor de eigenschappen van maaien.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Maaien)",
      "pattern": "^Maaien$"
    },
    "periode": {
      "type": "array",
      "description": "Lijst van Maaiperiode items.",
      "items": {
        "$ref": "#/components/schemas/Maaiperiode"
      },
      "minItems": 1
    },
    "frequentie": {
      "type": "array",
      "description": "Lijst van Maaifrequentie items.",
      "items": {
        "$ref": "#/components/schemas/Maaifrequentie"
      },
      "minItems": 1
    },
    "isVeiligheidsmaaien": {
      "type": "object",
      "description": "Aanduiding of er een maaistrook aanwezig is voor het vrijwaren van de zichtbaarheid en voor het vrijhouden van de bebakening en signalisatie.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "klepelmaaierToegelaten": {
      "type": "object",
      "description": "Aanduiding of er gemaaid mag worden met een klepelmaaier.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isRuigtebeheer": {
      "type": "object",
      "description": "Aanduiding of de grazige vegetatie minder dan 1x per jaar gemaaid wordt.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isGazonbeheer": {
      "type": "object",
      "description": "Aanduiding of de grazige vegetatie meer dan 3x per jaar gemaaid wordt.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isMachinaal": {
      "type": "object",
      "description": "Aanduiding of het maaien machinaal of handmatig wordt uitgevoerd.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    }
  },
  "required": [
    "@type",
    "periode",
    "frequentie",
    "isVeiligheidsmaaien",
    "klepelmaaierToegelaten",
    "isRuigtebeheer",
    "isGazonbeheer",
    "isMachinaal"
  ]
}