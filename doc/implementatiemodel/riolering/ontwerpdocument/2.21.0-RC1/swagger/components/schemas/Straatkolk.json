    },
    "type": {
      "$ref": "#/components/schemas/StraatkolkType"
    },
    "typeUitlaat": {
      "$ref": "#/components/schemas/StraatkolkTypeUitlaat"
    },
    "rooster": {
      "$ref": "#/components/schemas/Putrooster"
    },
    "baktype": {
      "$ref": "#/components/schemas/StraatkolkBakType"
    },
    "bakAfmetingen": {
