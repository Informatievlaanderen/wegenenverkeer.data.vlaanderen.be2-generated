    "fungeertAlsSpuier",
    "bakdiameter",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "maaiveldpeil",
    "toestandPut",
    "adres",
    "diepte",
    "technischeFiche"
  ]
}