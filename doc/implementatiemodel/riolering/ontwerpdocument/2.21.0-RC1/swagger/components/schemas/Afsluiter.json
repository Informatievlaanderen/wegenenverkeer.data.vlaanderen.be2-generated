{
  "title": "Afsluiter",
  "type": "object",
  "description": "Een afsluiter dient om leidingen, verbindingen of strengen van aan- en afvoer stelsels (bv. rioolstrengen) af te sluiten bij bv. gebreken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Afsluiter)",
      "pattern": "^Afsluiter$"
    },
    "type": {
      "$ref": "#/components/schemas/AfsluiterType"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "peil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "isContinuRegelbaar": {
      "$ref": "#/components/schemas/Afsluiter.isContinuRegelbaar"
    },
    "materiaal": {
      "$ref": "#/components/schemas/TerugslagklepAfsluiterMateriaal"
    },
    "actueleHoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van een linkend element. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Afsluiter.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Afsluiter.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Afsluiter.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Afsluiter.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Afsluiter.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Afsluiter.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "type",
    "hoogte",
    "breedte",
    "peil",
    "isContinuRegelbaar",
    "materiaal",
    "actueleHoogte",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}