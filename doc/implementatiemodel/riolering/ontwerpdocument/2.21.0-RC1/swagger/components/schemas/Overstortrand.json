{
  "title": "Overstortrand",
  "type": "object",
  "description": "Een overstortrand heeft als doel het afvoeren van (pieken in) overtollig rioolwater vanuit de gemengde riolering naar het oppervlaktewater.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Overstortrand)",
      "pattern": "^Overstortrand$"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "wanddikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "materiaal": {
      "$ref": "#/components/schemas/OverstortrandMateriaal"
    },
    "variabelDeelType": {
      "$ref": "#/components/schemas/VariabelDeelType"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Overstortrand.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Overstortrand.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Overstortrand.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Overstortrand.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Overstortrand.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Overstortrand.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "breedte",
    "hoogte",
    "wanddikte",
    "materiaal",
    "variabelDeelType",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}