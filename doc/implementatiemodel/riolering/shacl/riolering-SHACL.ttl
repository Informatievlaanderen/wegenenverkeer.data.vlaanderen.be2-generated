    shacl:name "materiaal drempel"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort.materiaalDrempel>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort> .

