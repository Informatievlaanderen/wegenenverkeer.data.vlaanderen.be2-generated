    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "breedte"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort.drempellengte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "peil"@nl;
    rdfs:comment "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.18.1#Overstort.Peil>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW>;
    shacl:description "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "peil"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Overstort.peil>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vrije hoogte"@nl;
    rdfs:comment "De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.18.1#Overstort.VrijeHoogte>;
