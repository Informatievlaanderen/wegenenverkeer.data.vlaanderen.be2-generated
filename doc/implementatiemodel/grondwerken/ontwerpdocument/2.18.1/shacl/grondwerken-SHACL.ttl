<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimDatabankStatus.IsActief>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is actief"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus.isActief>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.Asset-id>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.Notitie>;
    shacl:class xsd:string;
    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.notitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardbestekpostnummer"@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.Standaardbestekpostnummer>;
    shacl:class xsd:string;
    shacl:description "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    shacl:minCount "1";
    shacl:name "standaardbestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.standaardBestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
    rdfs:comment "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.TypeUri>;
    shacl:class xsd:anyURI;
    shacl:description "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type URI"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.typeURI>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestekpostnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek."@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.Bestekpostnummer>;
    shacl:class xsd:string;
    shacl:description "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt."@nl;
    shacl:minCount "1";
    shacl:name "bestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.bestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "theoretische levensduur"@nl;
    rdfs:comment "De levensduur in aantal maanden die theoretisch mag verwacht worden voor een object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.TheoretischeLevensduur>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMaand>;
    shacl:description "De levensduur in aantal maanden die theoretisch mag verwacht worden voor een object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "theoretische levensduur"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.theoretischeLevensduur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "datum oprichting object"@nl;
    rdfs:comment "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimObject.DatumOprichtingObject>;
    shacl:class xsd:date;
    shacl:description "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "datum oprichting object"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.datumOprichtingObject>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/grondwerken/ontwerpdocument/2.18.1#AimToestandShape> a shacl:NodeShape;
