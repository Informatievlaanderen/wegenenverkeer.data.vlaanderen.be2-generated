{
  "title": "Grond",
  "type": "object",
  "description": "Lithologisch hoofd- en nevenbestanddeel (als code) van de laag zoals gebruikt bij Databank Ondergrond Vlaanderen (gecodeerde lithologie en geotechnische codering).",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Grond)",
      "pattern": "^Grond$"
    },
    "milieuhygiëNischeCode": {
      "$ref": "#/components/schemas/Grond.milieuhygiëNischeCode"
    },
    "soortGrond": {
      "$ref": "#/components/schemas/Grondsoort"
    },
    "technischVerslagBodemonderzoek": {
      "type": "array",
      "description": "Het technisch verslag van een bodemonderzoek. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "tot": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "van": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "soortVervuiling": {
      "$ref": "#/components/schemas/SoortVervuiling"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "laagrol": {
      "$ref": "#/components/schemas/LaagRol"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Grond.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Grond.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Grond.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Grond.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Grond.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Grond.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "dikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    }
  },
  "required": [
    "@type",
    "milieuhygiëNischeCode",
    "soortGrond",
    "technischVerslagBodemonderzoek",
    "tot",
    "van",
    "soortVervuiling",
    "lengte",
    "breedte",
    "oppervlakte",
    "laagrol",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "dikte"
  ]
}