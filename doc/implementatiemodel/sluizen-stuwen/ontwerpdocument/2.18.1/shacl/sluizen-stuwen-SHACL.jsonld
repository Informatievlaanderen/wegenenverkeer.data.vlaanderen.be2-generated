      {
        "@id": "_:df_7_161"
      },
      {
        "@id": "_:df_7_162"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Heftoren"
      }
    ]
  },
