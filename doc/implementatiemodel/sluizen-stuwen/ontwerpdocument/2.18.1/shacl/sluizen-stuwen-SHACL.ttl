    shacl:description "Aanduiding of de heftoren al dan niet gevuld is met een tegengewicht."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is gevuld met tegengewicht"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Heftoren.isGevuldMetTegengewicht>
  ], [
