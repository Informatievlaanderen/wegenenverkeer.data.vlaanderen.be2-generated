{
  "title": "Stroomverdelingssysteem",
  "type": "object",
  "description": "Een stroomverdelingssysteem, ook wel Power Distribution Unit of PDU genoemd, is een inrichting met verschillende outputs voor het distribueren van elektriciteit.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Stroomverdelingssysteem)",
      "pattern": "^Stroomverdelingssysteem$"
    },
    "merk": {
      "$ref": "#/components/schemas/MerknamenPDU"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnamenPDU"
    },
    "aantalAansluitpunten": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.aantalAansluitpunten"
    },
    "heeftAlgemeneAan-Uit": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.heeftAlgemeneAan-Uit"
    },
    "iP-Adres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "componentnummer": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.componentnummer"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.serienummer"
    },
    "naam": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Stroomverdelingssysteem.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Stroomverdelingssysteem.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Stroomverdelingssysteem.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "aantalAansluitpunten",
    "heeftAlgemeneAan-Uit",
    "iP-Adres",
    "componentnummer",
    "serienummer",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}