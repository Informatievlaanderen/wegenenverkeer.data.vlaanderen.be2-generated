{
  "title": "BypassSchakelaar",
  "type": "object",
  "description": "Een schakelaar die toelaat om de stroomtoevoer naar afnemende technieken via het geschakeld toestel zoals een UPS, te omzeilen en te isoleren om veilig te kunnen werken aan dat toestel terwijl de stroomtoevoer voor afnemende technieken verzekerd blijft.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse BypassSchakelaar)",
      "pattern": "^BypassSchakelaar$"
    },
    "merk": {
      "$ref": "#/components/schemas/MerknamenBypassSchakelaar"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnamenBypassSchakelaars"
    },
    "locatie": {
      "$ref": "#/components/schemas/BypassSchakelaarLocatie"
    },
    "uitvoering": {
      "$ref": "#/components/schemas/UitvoeringSchakelaar"
    },
    "componentnummer": {
      "$ref": "#/components/schemas/BypassSchakelaar.componentnummer"
    },
    "serienummer": {
      "$ref": "#/components/schemas/BypassSchakelaar.serienummer"
    },
    "naam": {
      "$ref": "#/components/schemas/BypassSchakelaar.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/BypassSchakelaar.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/BypassSchakelaar.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/BypassSchakelaar.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/BypassSchakelaar.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/BypassSchakelaar.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/BypassSchakelaar.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "locatie",
    "uitvoering",
    "componentnummer",
    "serienummer",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}