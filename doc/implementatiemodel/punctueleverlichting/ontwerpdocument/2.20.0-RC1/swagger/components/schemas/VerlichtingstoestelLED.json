    "isLijnvormig",
    "lumenOutput",
    "technischeFiche",
    "systeemvermogen",
    "heeftAansluitkastGeïNtegreerd",
    "stroomkringnummer",
    "merk",
    "modelnaam",
    "inclinatiehoek",
    "verlichtGebied",
    "serienummer",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
