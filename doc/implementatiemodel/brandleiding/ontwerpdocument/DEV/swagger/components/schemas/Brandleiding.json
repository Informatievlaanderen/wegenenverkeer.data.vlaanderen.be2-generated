{
  "title": "Brandleiding",
  "type": "object",
  "description": "Segment uit de leiding die water aanvoert voor het blussen van een brand.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Brandleiding)",
      "pattern": "^Brandleiding$"
    },
    "leidingdruk": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInBar"
    },
    "isGeïSoleerd": {
      "$ref": "#/components/schemas/Brandleiding.isGeïSoleerd"
    },
    "materiaal": {
      "$ref": "#/components/schemas/PersleidingMateriaal"
    },
    "sDRKlasse": {
      "$ref": "#/components/schemas/SDRKlasse"
    },
    "toestandBuis": {
      "$ref": "#/components/schemas/Tekstblok"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "hoogteBinnenzijde": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "isManToegankelijk": {
      "$ref": "#/components/schemas/Brandleiding.isManToegankelijk"
    },
    "vorm": {
      "$ref": "#/components/schemas/RioleringVorm"
    },
    "diepteOpwaarts": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de buis. Bestanden van het type xlsx of pdf. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "bokOpwaarts": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "diepteAfwaarts": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "bokAfwaarts": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "helling": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInPromille"
    },
    "hoogteBuitenzijde": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "breedteBinnenzijde": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "isOpgevuld": {
      "$ref": "#/components/schemas/Brandleiding.isOpgevuld"
    },
    "breedteBuitenzijde": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Brandleiding.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brandleiding.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Brandleiding.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brandleiding.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Brandleiding.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Brandleiding.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "$ref": "#/components/schemas/Brandleiding.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Brandleiding.naam"
    }
  },
  "required": [
    "@type",
    "leidingdruk",
    "isGeïSoleerd",
    "materiaal",
    "sDRKlasse",
    "toestandBuis",
    "breedte",
    "hoogteBinnenzijde",
    "isManToegankelijk",
    "vorm",
    "diepteOpwaarts",
    "technischeFiche",
    "bokOpwaarts",
    "diepteAfwaarts",
    "bokAfwaarts",
    "lengte",
    "helling",
    "hoogteBuitenzijde",
    "breedteBinnenzijde",
    "isOpgevuld",
    "breedteBuitenzijde",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad",
    "naam"
  ]
}