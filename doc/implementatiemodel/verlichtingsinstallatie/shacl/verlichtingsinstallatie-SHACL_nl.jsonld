      {
        "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelHgLP"
      }
    ]
  },
  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verlichtingsinstallatie/ontwerpdocument/2.18.1#VerlichtingstoestelInclinatiehoekShape",
