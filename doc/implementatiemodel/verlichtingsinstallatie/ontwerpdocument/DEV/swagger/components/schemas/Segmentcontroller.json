{
  "title": "Segmentcontroller",
  "type": "object",
  "description": "Controller die zorgt voor de bewaking en bediening van verlichtingssegmenten per paal en aldus zorgt voor de communicatie tussen de cabine en de armatuurcontrollers.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Segmentcontroller)",
      "pattern": "^Segmentcontroller$"
    },
    "merk": {
      "$ref": "#/components/schemas/Segmentcontroller.merk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/Segmentcontroller.modelnaam"
    },
    "beveiligingssleutel": {
      "$ref": "#/components/schemas/ControllerBeveiligingssleutel."
    },
    "netwerkconfiguratieWegverlichting": {
      "$ref": "#/components/schemas/NetwerkconfiguratieWegverlichting"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Segmentcontroller.serienummer"
    },
    "iP-Adres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "firmwareversie": {
      "$ref": "#/components/schemas/Segmentcontroller.firmwareversie"
    },
    "batchnummer": {
      "$ref": "#/components/schemas/Segmentcontroller.batchnummer"
    },
    "dNS-Naam": {
      "$ref": "#/components/schemas/Segmentcontroller.dNS-Naam"
    },
    "naam": {
      "$ref": "#/components/schemas/Segmentcontroller.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Segmentcontroller.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Segmentcontroller.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Segmentcontroller.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Segmentcontroller.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Segmentcontroller.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Segmentcontroller.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "$ref": "#/components/schemas/Segmentcontroller.naampad"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "beveiligingssleutel",
    "netwerkconfiguratieWegverlichting",
    "serienummer",
    "iP-Adres",
    "firmwareversie",
    "batchnummer",
    "dNS-Naam",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad"
  ]
}