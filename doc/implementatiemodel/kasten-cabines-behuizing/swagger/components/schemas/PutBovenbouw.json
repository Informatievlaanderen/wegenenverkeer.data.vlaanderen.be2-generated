        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "dekselvorm": {
      "$ref": "#/components/schemas/RioleringVorm"
    },
    "kader": {
      "$ref": "#/components/schemas/DekselkaderType"
    },
    "vergrendeling": {
      "$ref": "#/components/schemas/Dekselvergrendeling"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "isScharnierend": {
      "$ref": "#/components/schemas/PutBovenbouw.isScharnierend"
    },
    "isAfgesloten": {
      "$ref": "#/components/schemas/PutBovenbouw.isAfgesloten"
    },
    "materiaal": {
