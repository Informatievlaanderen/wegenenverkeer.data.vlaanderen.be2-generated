{
  "title": "PutBovenbouw",
  "type": "object",
  "description": "Een combinatie van het (riool)deksel met de kader en de regeling.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse PutBovenbouw)",
      "pattern": "^PutBovenbouw$"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "dekselklasse": {
      "$ref": "#/components/schemas/Dekselklasse"
    },
    "regeling": {
      "$ref": "#/components/schemas/Dekselregeling"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de bovenbouw. Bestanden van het type xlsx of pdf. Lijst van Bestandsbijlage items.",
