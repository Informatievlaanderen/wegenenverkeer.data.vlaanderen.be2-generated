{
  "title": "Kokervoeg",
  "type": "object",
  "description": "De kokervoeg is de naad of overgang tussen twee verschillende of gelijke materialen zodat elementen van de koker vrij kunnen bewegen ten opzichte van elkaar zonder schade te veroorzaken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Kokervoeg)",
      "pattern": "^Kokervoeg$"
    },
    "typeKokervoeg": {
      "$ref": "#/components/schemas/TypeMetselvoeg"
    },
    "dilatatieCapaciteit": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "materiaal": {
      "$ref": "#/components/schemas/TypeMateriaal"
    },
    "heeftVerkeerOverVoeg": {
      "$ref": "#/components/schemas/Kokervoeg.heeftVerkeerOverVoeg"
    },
    "drukWeerstand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInBar"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "etagDocument": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "kokervoegtype": {
      "$ref": "#/components/schemas/TypeKokervoeg"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Kokervoeg.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kokervoeg.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Kokervoeg.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kokervoeg.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Kokervoeg.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Kokervoeg.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "typeKokervoeg",
    "dilatatieCapaciteit",
    "materiaal",
    "heeftVerkeerOverVoeg",
    "drukWeerstand",
    "technischeFiche",
    "etagDocument",
    "kokervoegtype",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}