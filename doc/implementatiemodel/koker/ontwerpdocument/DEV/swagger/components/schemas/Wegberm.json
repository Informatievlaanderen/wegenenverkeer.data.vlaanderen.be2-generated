{
  "title": "Wegberm",
  "type": "object",
  "description": "Gedeelte van het wegplatform dat buiten de rijbanen ligt. Een wegberm kan sloten en bijzonder ingerichte onderdelen bevatten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wegberm)",
      "pattern": "^Wegberm$"
    },
    "type": {
      "$ref": "#/components/schemas/WegbermType"
    },
    "bijzonderIngerichteOnderdelenVanDeWegberm": {
      "$ref": "#/components/schemas/WegbermBIO"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "niveau": {
      "$ref": "#/components/schemas/Wegberm.niveau"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "naampad": {
      "$ref": "#/components/schemas/Wegberm.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Wegberm.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Wegberm.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Wegberm.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Wegberm.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Wegberm.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Wegberm.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Wegberm.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "type",
    "bijzonderIngerichteOnderdelenVanDeWegberm",
    "breedte",
    "lengte",
    "niveau",
    "oppervlakte",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}