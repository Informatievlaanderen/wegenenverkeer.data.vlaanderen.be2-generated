{
  "title": "Randafwerking",
  "type": "object",
  "description": "Profiel ter afwerking van de rand. Deze kan uitgevoerd worden in verschillende materialen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Randafwerking)",
      "pattern": "^Randafwerking$"
    },
    "uitvoeringRandafwerking": {
      "$ref": "#/components/schemas/UitvoeringRandafwerking"
    },
    "typeRandafwerking": {
      "$ref": "#/components/schemas/TypeRandafwerking"
    },
    "materiaalRandafwerking": {
      "$ref": "#/components/schemas/MateriaalRandafwerking"
    },
    "lopendeMeter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "detailplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "naam": {
      "$ref": "#/components/schemas/Randafwerking.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Randafwerking.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Randafwerking.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Randafwerking.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Randafwerking.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Randafwerking.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Randafwerking.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "uitvoeringRandafwerking",
    "typeRandafwerking",
    "materiaalRandafwerking",
    "lopendeMeter",
    "detailplan",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}