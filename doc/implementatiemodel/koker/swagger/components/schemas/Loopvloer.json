{
  "title": "Loopvloer",
  "type": "object",
  "description": "Een vloer die ligt op,in of nabij een constructie die wordt gebruikt om deze op een veilige manier te betreden of bereiken.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Loopvloer)",
      "pattern": "^Loopvloer$"
    },
    "isDemonteerbaar": {
      "$ref": "#/components/schemas/Loopvloer.isDemonteerbaar"
    },
    "karakteristiekeGebruiksbelasting": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKNPerVierkanteMeter"
    },
    "karakteristiekePuntbelasting": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "materiaal": {
      "$ref": "#/components/schemas/KeuzelijstMateriaalLoopvloer"
    },
    "nuttigeBreedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Loopvloer.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Loopvloer.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Loopvloer.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Loopvloer.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Loopvloer.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Loopvloer.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Loopvloer.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "isDemonteerbaar",
    "karakteristiekeGebruiksbelasting",
    "karakteristiekePuntbelasting",
    "materiaal",
    "nuttigeBreedte",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}