{
  "title": "Weegcomputer",
  "type": "object",
  "description": "Een verwerkingseenheid met als input de weeggegevens van de weegcellen en output het gewicht.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Weegcomputer)",
      "pattern": "^Weegcomputer$"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Weegcomputer.serienummer"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnaamWeegcomputer"
    },
    "merk": {
      "$ref": "#/components/schemas/WeegcomputerMerk"
    },
    "checksum": {
      "$ref": "#/components/schemas/Weegcomputer.checksum"
    },
    "bevestiging": {
      "$ref": "#/components/schemas/IndoorKast"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Weegcomputer.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Weegcomputer.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Weegcomputer.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Weegcomputer.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Weegcomputer.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Weegcomputer.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "serienummer",
    "modelnaam",
    "merk",
    "checksum",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}