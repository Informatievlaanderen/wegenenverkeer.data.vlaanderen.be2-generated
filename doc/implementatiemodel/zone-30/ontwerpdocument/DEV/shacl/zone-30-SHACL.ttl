<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zone-30/ontwerpdocument/DEV#BehuizingShape> a shacl:NodeShape;
  rdfs:label "Behuizing"@nl;
  rdfs:comment "Abstracte voor alle types van behuizing voor het beschermen van technieken."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zone-30/ontwerpdocument/DEV#Behuizing>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres (aanduiding van de locatie) van de behuizing. Indien deze geen adres heeft, wordt net zoals door Fluvius voor cabines, het adres van een nabijgelegen straat genomen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zone-30/ontwerpdocument/DEV#Behuizing.Adres>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres>;
    shacl:description "Adres (aanduiding van de locatie) van de behuizing. Indien deze geen adres heeft, wordt net zoals door Fluvius voor cabines, het adres van een nabijgelegen straat genomen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "adres"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Behuizing.adres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "risicoanalyse"@nl;
    <http://purl.org/vocab/vann/usageNote> "De risicoanalyse heeft in eerste instantie betrekking op werken in en rond een behuizing met elektrische installaties. Voor behuizingen met installaties van de distributienetbeheerder wordt de risicoanalyse bestemd voor die beheerder, bewaard in het gelijknamig attribuut van het onderdeel van die beheerder, bv. EnergiemeterDNB."@nl;
    rdfs:comment "Een bestandsbijlage met de risicoanalyse voor werken in en rond een behuizing."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zone-30/ontwerpdocument/DEV#Behuizing.Risicoanalyse>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Een bestandsbijlage met de risicoanalyse voor werken in en rond een behuizing."@nl;
    shacl:minCount 1;
    shacl:name "risicoanalyse"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Behuizing.risicoanalyse>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tabel uitwendige invloeden"@nl;
    <http://purl.org/vocab/vann/usageNote> "De tabel is in eerste instantie enkel vereist voor behuizingen die elektrische installaties bevatten die onder het AREI vallen."@nl;
    rdfs:comment "Een bestandsbijlage met de ingevulde en actuele tabel uitwendige invloeden zoals vereist door het AREI voor bepaalde elektrische installaties."@nl;
