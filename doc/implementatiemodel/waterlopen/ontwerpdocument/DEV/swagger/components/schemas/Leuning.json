      "$ref": "#/components/schemas/MateriaalEnAfwerking"
    },
    "detailplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "naam": {
      "$ref": "#/components/schemas/Leuning.naam"
    },
    "asset-Id": {
