        "$ref": "#/components/schemas/AfwerkingstypeLeuning"
      },
      "minItems": 1
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "professioneelGebruik": {
      "$ref": "#/components/schemas/Leuning.professioneelGebruik"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "materiaal": {
      "$ref": "#/components/schemas/MateriaalSoorten"
    },
    "vorm": {
      "$ref": "#/components/schemas/VormLeuning"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
