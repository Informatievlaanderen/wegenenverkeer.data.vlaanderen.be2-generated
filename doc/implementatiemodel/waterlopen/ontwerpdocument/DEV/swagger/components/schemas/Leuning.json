{
  "title": "Leuning",
  "type": "object",
  "description": "Een leuning is een constructie waaraan men met een hand steun of stabiliteit kan vinden om niet in de diepte te vallen. Ze kan bestaan uit een stevige balk, strip of touw maar ook uit een boven- en onderregel en stijlen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Leuning)",
      "pattern": "^Leuning$"
    },
    "afwerkingstype": {
      "type": "array",
      "description": "Het type afwerking van de leuning. Attribuut uit gebruik sinds versie 2.18.0-RC1 Lijst van AfwerkingstypeLeuning items.",
