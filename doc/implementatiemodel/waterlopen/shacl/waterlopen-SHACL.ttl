    shacl:minCount "1";
    shacl:name "materiaal"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kopmuur.materiaal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hellingshoek"@nl;
    rdfs:comment "De hoek tussen de as van de gracht en het vlak van de kopmuur in graden."@nl;
