    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.notitie>
  ];
