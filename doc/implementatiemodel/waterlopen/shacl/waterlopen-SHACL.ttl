<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  rdfs:comment "Complex datatype voor de aanduiding van een bepaalde locatie, doorgaans van een huis, woning, gebouw of faciliteit, op de aarde."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "De naam van de straat."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#Adres.Straatnaam>;
    shacl:class xsd:string;
    shacl:description "De naam van de straat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.straatnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#Adres.Huisnummer>;
    shacl:class xsd:string;
    shacl:description "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.huisnummer>
  ], [
    a shacl:PropertyShape;
