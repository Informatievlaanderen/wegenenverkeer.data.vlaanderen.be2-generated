<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#StuwconstructieShape> a shacl:NodeShape;
  rdfs:label "Stuwconstructie"@nl;
  rdfs:comment "Een debietbegrenzende constructie waarbij het af te voeren water in zijn geheel door een (knijp)opening stroomt bij normale afvoer. Bij hevige regenval, wanneer de watertoevoer niet meer kan worden verwerkt, wordt een buffer opgebouwd tot aan de overstort."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "overstortpeil"@nl;
    rdfs:comment "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
