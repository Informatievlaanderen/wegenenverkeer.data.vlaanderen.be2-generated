<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AanhorighedenBrugShape> a shacl:NodeShape;
  rdfs:label "Aanhorigheden brug"@nl;
  rdfs:comment "Een bundeling van aanhorigheden die bij een brug kunnen horen."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AanhorighedenKokerShape> a shacl:NodeShape;
  rdfs:label "Aanhorigheden koker"@nl;
  rdfs:comment "Een abstracte klasse die de aanhorigheden bundelt die in een koker kunnen voorkomen zodat de overerving van de bevestigingsrelatie kan plaatsvinden."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidKoker> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AanhorigheidSluisEnStuwShape> a shacl:NodeShape;
  rdfs:label "Aanhorigheid sluis en stuw"@nl;
  rdfs:comment "Een bundeling van aanhorigheden die bij een Sluis en/of Stuw kunnen horen."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidSluisStuw> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AanvullendeMiddellijnShape> a shacl:NodeShape;
  rdfs:label "Aanvullende middellijn"@nl;
  rdfs:comment "Een lijn die het midden of de centrale as van een object markeert, zoals bv. de centrale as van een gracht."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#AanvullendeMiddellijn> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrieShape> a shacl:NodeShape;
  rdfs:label "Abstracte aanvullende geometrie"@nl;
  rdfs:comment "Abstracte om de eigenschappen en relaties van AanvullendeGeometrie te bundelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de aanvullende geometrie zoals toegekend door de beheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.Asset-id>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de aanvullende geometrie zoals toegekend door de beheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bijlage"@nl;
    rdfs:comment "Het document of artefact dat een geometrie heeft of een bijlage is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.Bijlage>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Het document of artefact dat een geometrie heeft of een bijlage is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bijlage"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.bijlage>
  ], [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    rdfs:comment "De mensleesbare naam van een aanvullende geometrie of bijlage. De beheerder kent deze naam toe of geeft de opdracht om deze toe te kennen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.Naam>;
    shacl:class xsd:string;
    shacl:description "De mensleesbare naam van een aanvullende geometrie of bijlage. De beheerder kent deze naam toe of geeft de opdracht om deze toe te kennen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.naam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
    rdfs:comment "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.TypeUri>;
    shacl:class xsd:anyURI;
    shacl:description "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type URI"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie.typeURI>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrie.Notitie>;
