    shacl:description "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "overstortpeil"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Stuwconstructie.overstortpeil>
  ], [
    a shacl:PropertyShape;
    rdfs:label "diameter knijpopening"@nl;
    rdfs:comment "De diameter van de opening onderaan de cascade die zorgt voor een vertraagde waterafvoer bij hevige regenval of overvloedige toevoer van water in millimeter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/2.18.1#Stuwconstructie.DiameterKnijpopening>;
