    shacl:description "De waarde van de elektrische stroom aan de uitgangszijde van de omvormer."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgangsstroom"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.uitgangsstroom>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgangsfrequentie"@nl;
    rdfs:comment "De waarde van de frequentie van de elektriciteit aan de uitgangszijde van de omvormer. Indien het om DC stroom gaat, is deze waarde gelijk aan nul."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Uitgangsfrequentie>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInHerz>;
    shacl:description "De waarde van de frequentie van de elektriciteit aan de uitgangszijde van de omvormer. Indien het om DC stroom gaat, is deze waarde gelijk aan nul."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "uitgangsfrequentie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.uitgangsfrequentie>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS> .

