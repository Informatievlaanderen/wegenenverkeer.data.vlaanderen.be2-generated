<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#UpsShape> a shacl:NodeShape;
  rdfs:label "UPS"@nl;
  rdfs:comment "Toestel (Uninterruptible Power Supply = niet onderbreekbare voeding) voor het leveren van elektrische energie van een vastgelegde kwaliteit, onafhankelijk van de beschikbaarheid van een betrouwbare netspanning. Indien het openbare net niet langer bruikbaar is om als energiebron te fungeren, wordt de energievoorziening overgenomen door de accubatterij. Deze zal gedurende een bepaalde tijd, afhankelijk van de capaciteit, de stroomvoorziening verzorgen. De UPS dient om de (minimale) voeding ononderbroken te verzekeren"@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "max piekvermogen"@nl;
    rdfs:comment "Het maximale piekvermogen van de UPS."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.MaxPiekvermogen>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInWatt>;
    shacl:description "Het maximale piekvermogen van de UPS."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "max piekvermogen"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.maxPiekVermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "autonomie"@nl;
    rdfs:comment "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Autonomie>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInkWh>;
    shacl:description "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "autonomie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.autonomie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Merk waarmee de fabrikant de UPS identificeert."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Merk>;
    shacl:class skos:Concept;
    shacl:description "Merk waarmee de fabrikant de UPS identificeert."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "merk"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "Modelnaam van de UPS volgens de fabrikant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Modelnaam>;
    shacl:class skos:Concept;
    shacl:description "Modelnaam van de UPS volgens de fabrikant."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "modelnaam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.modelnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "serienummer"@nl;
    rdfs:comment "Unieke identificatiecode van het toestel, toegekend door de fabrikant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Serienummer>;
    shacl:class xsd:string;
    shacl:description "Unieke identificatiecode van het toestel, toegekend door de fabrikant."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "serienummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.serienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximaal continu vermogen"@nl;
    rdfs:comment "Maximale continu vermogen van de UPS."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.MaximaalContinuVermogen>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInWatt>;
    shacl:description "Maximale continu vermogen van de UPS."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "maximaal continu vermogen"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS.maxContinuVermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "uitgangsstroom"@nl;
    rdfs:comment "De waarde van de elektrische stroom aan de uitgangszijde van de omvormer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#Ups.Uitgangsstroom>;
