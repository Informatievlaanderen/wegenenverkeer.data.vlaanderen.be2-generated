<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AfmetingNetwerkelementShape> a shacl:NodeShape;
  rdfs:label "Afmeting netwerkelement"@nl;
  rdfs:comment "Complex datatype voor de afmetingen van een netwerktelement."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hoogte in RU"@nl;
    rdfs:comment "De hoogte die door het netwerkelement wordt ingenomen, uitgedrukt in RU (rack units)."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AfmetingNetwerkelement.HoogteInRu>;
    shacl:class xsd:integer;
    shacl:description "De hoogte die door het netwerkelement wordt ingenomen, uitgedrukt in RU (rack units)."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "hoogte in RU"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement.hoogteInRU>
  ], [
    a shacl:PropertyShape;
    rdfs:label "diepte"@nl;
    rdfs:comment "De diepte van het netwerkelement in centimeter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AfmetingNetwerkelement.Diepte>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter>;
    shacl:description "De diepte van het netwerkelement in centimeter."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "diepte"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement.diepte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "breedte"@nl;
    rdfs:comment "De breedte van het netwerkelement in centimeter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AfmetingNetwerkelement.Breedte>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInCentimeter>;
    shacl:description "De breedte van het netwerkelement in centimeter."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "breedte"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement.breedte>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DtcAfmetingNetwerkelement> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimDatabankStatus.IsActief>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is actief"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus.isActief>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimNaamObjectShape> a shacl:NodeShape;
  rdfs:label "AIM naam object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor elk OTL object dat benoemd wordt met een mensleesbare identificator."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is."@nl;
    rdfs:comment "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimNaamObject.Naam>;
    shacl:class xsd:string;
    shacl:description "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject.naam>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimObject.Asset-id>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimObject.Notitie>;
    shacl:class xsd:string;
    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMObject.notitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardbestekpostnummer"@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/software-hardware/ontwerpdocument/2.18.1#AimObject.Standaardbestekpostnummer>;
    shacl:class xsd:string;
