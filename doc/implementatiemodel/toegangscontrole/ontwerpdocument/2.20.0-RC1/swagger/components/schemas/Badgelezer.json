{
  "title": "Badgelezer",
  "type": "object",
  "description": "Een inrichting voor automatische authenticatie op basis van een badge.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Badgelezer)",
      "pattern": "^Badgelezer$"
    },
    "heeftCodeklavier": {
      "type": "object",
      "description": "Geeft aan of de badgelezer een geïntegreerd codeklavier heeft.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftExtraVandalismebescherming": {
      "type": "object",
      "description": "Geeft aan of de badgelezer voorzien is van additionele vandalismebescherming.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "merk": {
      "$ref": "#/components/schemas/MerknamenBadgelezers"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnamenBadgelezers"
    },
    "aansluitingskabel": {
      "$ref": "#/components/schemas/Aansluitingskabel"
    },
    "heeftQRCodelezer": {
      "type": "object",
      "description": "Geeft aan of de badgelezer een inrichting heeft om QR codes te lezen die integraal deel uitmaakt van de badgelzer zelf.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "encryptieType": {
      "$ref": "#/components/schemas/EncryptieType"
    },
    "configuratiebestand": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "isBuiten": {
      "type": "object",
      "description": "Geeft aan of de badgelezer zich binnen of buiten bevindt.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "protocol": {
      "$ref": "#/components/schemas/BadgelezerProtocollen"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aantalDraden": {
      "type": "object",
      "description": "Het aantal aders die door de kabel lopen.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "int64"
        },
        "@type": {
          "type": "string",
          "pattern": "^NonNegativeInteger$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "componentnummer": {
      "type": "object",
      "description": "Het componentnummer van het elektrische toestel, zoals weergegeven op het schema van het lokale laagspanningsbord. Wordt ook wel onderdeelcode (ODC) genoemd.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "serienummer": {
      "type": "object",
      "description": "Het unieke nummer waarmee het toestel door de fabrikant geïdentificeerd is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "firmwareversie": {
      "type": "object",
      "description": "Versie van de firmware.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naampad": {
      "type": "object",
      "description": "Een set van objecten (bv. collecties) die aanduiden waar het object zich bevindt in de objectenboom (EM-Infra). Dient consistent te zijn met de naam.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "heeftCodeklavier",
    "heeftExtraVandalismebescherming",
    "merk",
    "modelnaam",
    "aansluitingskabel",
    "heeftQRCodelezer",
    "encryptieType",
    "configuratiebestand",
    "isBuiten",
    "protocol",
    "technischeFiche",
    "aantalDraden",
    "componentnummer",
    "serienummer",
    "firmwareversie",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}