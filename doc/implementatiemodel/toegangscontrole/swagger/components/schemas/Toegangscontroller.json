{
  "title": "Toegangscontroller",
  "type": "object",
  "description": "Toestel dat een aantal vaste deurmodules voor een toegangscontrolepunt verbindt met een centrale server. Het kan uitgebreid worden met bijkomende deurmodules.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Toegangscontroller)",
      "pattern": "^Toegangscontroller$"
    },
    "merk": {
      "$ref": "#/components/schemas/ToegangscontrollerMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ToegangscontrollerModelnaam"
    },
    "serienummer": {
      "$ref": "#/components/schemas/Toegangscontroller.serienummer"
    },
    "iP-Adres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "firmwareversie": {
      "$ref": "#/components/schemas/Toegangscontroller.firmwareversie"
    },
    "batchnummer": {
      "$ref": "#/components/schemas/Toegangscontroller.batchnummer"
    },
    "dNS-Naam": {
      "$ref": "#/components/schemas/Toegangscontroller.dNS-Naam"
    },
    "naam": {
      "$ref": "#/components/schemas/Toegangscontroller.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Toegangscontroller.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Toegangscontroller.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Toegangscontroller.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Toegangscontroller.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Toegangscontroller.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Toegangscontroller.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "$ref": "#/components/schemas/Toegangscontroller.naampad"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "serienummer",
    "iP-Adres",
    "firmwareversie",
    "batchnummer",
    "dNS-Naam",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad"
  ]
}