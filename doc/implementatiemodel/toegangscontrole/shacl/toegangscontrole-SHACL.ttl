    rdfs:comment "De energie die de UPS kan voorzien aan een installatie voor een zekere tijd."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/toegangscontrole/ontwerpdocument/2.20.0-RC1#UPS.Autonomie>;
