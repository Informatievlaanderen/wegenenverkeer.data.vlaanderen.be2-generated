{
  "title": "ConserveringStaal",
  "type": "object",
  "description": "Geheel van beschermingsmaatregelen, inclusief conserveringssysteem en oppervlaktevoorbereiding, dat de corrosiebescherming van een stalen object specificeert.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ConserveringStaal)",
      "pattern": "^ConserveringStaal$"
    },
    "corrosiecategorie": {
      "$ref": "#/components/schemas/CorrosiecategorieëN"
    },
    "conserveringssysteem": {
      "$ref": "#/components/schemas/Conserveringssystemen"
    },
    "reinheidsgraad": {
      "$ref": "#/components/schemas/Reinheidsgraad"
    },
    "oppervlaktevoorbereiding": {
      "$ref": "#/components/schemas/Oppervlaktevoorbereiding"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/ConserveringStaal.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ConserveringStaal.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/ConserveringStaal.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ConserveringStaal.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/ConserveringStaal.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/ConserveringStaal.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "corrosiecategorie",
    "conserveringssysteem",
    "reinheidsgraad",
    "oppervlaktevoorbereiding",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}