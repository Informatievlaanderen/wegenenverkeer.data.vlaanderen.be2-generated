    a shacl:PropertyShape;
    rdfs:label "detail dwarsdoorsnede"@nl;
    rdfs:comment "Details van de afmetingen en van de dwarsdoorsnedes."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/constructie-element/ontwerpdocument/DEV#HoutenConstructieprofiel.DetailDwarsdoorsnede>;
