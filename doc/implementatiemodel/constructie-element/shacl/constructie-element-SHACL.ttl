    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInKubiekeMeter>;
    shacl:description "Het volume van de werkvloer uitgedrukt in kubieke meter."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "volume"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Werkvloer.volume>
  ], [
    a shacl:PropertyShape;
