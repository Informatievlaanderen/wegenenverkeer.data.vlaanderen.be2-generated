    shacl:minCount 1;
    shacl:name "detail dwarsdoorsnede"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HoutenConstructieprofiel.detailDwarsdoorsnede>
  ], [
    a shacl:PropertyShape;
