    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Windverband.type>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Windverband> .
