{
  "title": "Kunststofplaat",
  "type": "object",
  "description": "Een kunststof enkelvoudig constructie-object, dat zowel horizontaal (bij een plaat) als verticaal (bij een wand) geplaatst kan worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Kunststofplaat)",
      "pattern": "^Kunststofplaat$"
    },
    "dikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "volume": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKubiekeMeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Kunststofplaat.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Kunststofplaat.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kunststofplaat.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Kunststofplaat.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kunststofplaat.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Kunststofplaat.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Kunststofplaat.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "productieproces": {
      "$ref": "#/components/schemas/KlProductieproces"
    },
    "typeVezel": {
      "$ref": "#/components/schemas/TypeVezel"
    },
    "typeHars": {
      "$ref": "#/components/schemas/TypeHars"
    }
  },
  "required": [
    "@type",
    "dikte",
    "volume",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "technischeFiche",
    "productieproces",
    "typeVezel",
    "typeHars"
  ]
}