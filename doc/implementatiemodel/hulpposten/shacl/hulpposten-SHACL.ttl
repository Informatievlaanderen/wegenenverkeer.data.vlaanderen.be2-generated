    shacl:description "Een bestandsbijlage met de risicoanalyse voor werken in en rond een behuizing."@nl;
    shacl:minCount 1;
    shacl:name "risicoanalyse"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Behuizing.risicoanalyse>
  ], [
