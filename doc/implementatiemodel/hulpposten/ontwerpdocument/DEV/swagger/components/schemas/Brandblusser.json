{
  "title": "Brandblusser",
  "type": "object",
  "description": "Een apparaat om het vuur van een kleine brand mee te doven. Het bestaat uit een cilinder waarin een beperkte hoeveelheid blusmiddel onder druk staat.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Brandblusser)",
      "pattern": "^Brandblusser$"
    },
    "type": {
      "$ref": "#/components/schemas/BrandblusserType"
    },
    "blusmiddel": {
      "$ref": "#/components/schemas/BrandblusserBlusmiddel"
    },
    "keuringsdatum": {
      "$ref": "#/components/schemas/Brandblusser.keuringsdatum"
    },
    "gewicht": {
      "$ref": "#/components/schemas/BrandblusserGewicht"
    },
    "aankoopdatum": {
      "$ref": "#/components/schemas/Brandblusser.aankoopdatum"
    },
    "naampad": {
      "$ref": "#/components/schemas/Brandblusser.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Brandblusser.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Brandblusser.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brandblusser.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Brandblusser.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brandblusser.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Brandblusser.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Brandblusser.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "type",
    "blusmiddel",
    "keuringsdatum",
    "gewicht",
    "aankoopdatum",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}