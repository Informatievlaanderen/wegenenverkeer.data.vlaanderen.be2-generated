{
  "title": "BestratingVanNatuursteentegel",
  "type": "object",
  "description": "Een buitentegel (of buitenplavei) is elk element van natuursteen gebruikt als bestratingsmateriaal, waarvan de breedte groter is dan 150 mm en doorgaans groter is dan twee maal de dikte volgens PTV841.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse BestratingVanNatuursteentegel)",
      "pattern": "^BestratingVanNatuursteentegel$"
    },
    "afwerking": {
      "$ref": "#/components/schemas/BestratingAfwerking"
    },
    "gebruiksklasse": {
      "$ref": "#/components/schemas/NatuursteentegelGebruiksklasse"
    },
    "afmetingVanBestratingselementLxB": {
      "$ref": "#/components/schemas/AfmetingBestratingselementLengteXBreedte"
    },
    "steenverband": {
      "$ref": "#/components/schemas/BestratingSteenverband"
    },
    "voegvulling": {
      "$ref": "#/components/schemas/BestratingVoegvulling"
    },
    "kleur": {
      "$ref": "#/components/schemas/KleurSupplementen"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de bestrating. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "productidentificatiecode": {
      "$ref": "#/components/schemas/Productidentificatiecode"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "laagrol": {
      "$ref": "#/components/schemas/LaagRol"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/BestratingVanNatuursteentegel.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/BestratingVanNatuursteentegel.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/BestratingVanNatuursteentegel.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/BestratingVanNatuursteentegel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/BestratingVanNatuursteentegel.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/BestratingVanNatuursteentegel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "dikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    }
  },
  "required": [
    "@type",
    "afwerking",
    "gebruiksklasse",
    "afmetingVanBestratingselementLxB",
    "steenverband",
    "voegvulling",
    "kleur",
    "technischeFiche",
    "productidentificatiecode",
    "lengte",
    "breedte",
    "oppervlakte",
    "laagrol",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "dikte"
  ]
}