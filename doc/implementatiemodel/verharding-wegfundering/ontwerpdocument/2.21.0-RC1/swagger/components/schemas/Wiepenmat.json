{
  "title": "Wiepenmat",
  "type": "object",
  "description": "Een wiepenmat is een specifieke vorm van een bodembescherming die bestaat uit een houten gevlochten mat in combinatie met een geotextiel waarboven nadien stortsteen (breuksteen) wordt aangebracht.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Wiepenmat)",
      "pattern": "^Wiepenmat$"
    },
    "voegmateriaal": {
      "$ref": "#/components/schemas/SoortVoegmateriaal"
    },
    "productidentificatiecode": {
      "$ref": "#/components/schemas/Productidentificatiecode"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "laagrol": {
      "$ref": "#/components/schemas/LaagRol"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Wiepenmat.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Wiepenmat.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Wiepenmat.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Wiepenmat.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Wiepenmat.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Wiepenmat.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "elementBreedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "elementLengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "elementGewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKilogram"
    }
  },
  "required": [
    "@type",
    "voegmateriaal",
    "productidentificatiecode",
    "lengte",
    "breedte",
    "oppervlakte",
    "laagrol",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "elementBreedte",
    "elementLengte",
    "elementGewicht"
  ]
}