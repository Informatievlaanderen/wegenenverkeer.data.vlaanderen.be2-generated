{
  "title": "Schanskorf",
  "type": "object",
  "description": "Een schanskorf bestaat uit een metalen gaasnet dat wordt gevuld met steenachtige materialen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Schanskorf)",
      "pattern": "^Schanskorf$"
    },
    "heeftVerankeringspalen": {
      "$ref": "#/components/schemas/Schanskorf.heeftVerankeringspalen"
    },
    "vorm": {
      "$ref": "#/components/schemas/SchanskorfVorm"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de schanskorven als bijlage. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "isGegalvaniseerd": {
      "$ref": "#/components/schemas/Schanskorf.isGegalvaniseerd"
    },
    "type": {
      "$ref": "#/components/schemas/TypeSchanskorf"
    },
    "isGelast": {
      "$ref": "#/components/schemas/Schanskorf.isGelast"
    },
    "materiaalvulling": {
      "$ref": "#/components/schemas/StortsteenType"
    },
    "kaliber": {
      "$ref": "#/components/schemas/StortsteenKaliber"
    },
    "productidentificatiecode": {
      "$ref": "#/components/schemas/Productidentificatiecode"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "laagrol": {
      "$ref": "#/components/schemas/LaagRol"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Schanskorf.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Schanskorf.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Schanskorf.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Schanskorf.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Schanskorf.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Schanskorf.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "dikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    }
  },
  "required": [
    "@type",
    "heeftVerankeringspalen",
    "vorm",
    "technischeFiche",
    "isGegalvaniseerd",
    "type",
    "isGelast",
    "materiaalvulling",
    "kaliber",
    "productidentificatiecode",
    "lengte",
    "breedte",
    "oppervlakte",
    "laagrol",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "dikte"
  ]
}