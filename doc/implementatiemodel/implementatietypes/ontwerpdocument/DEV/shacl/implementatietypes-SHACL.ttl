<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/implementatietypes/ontwerpdocument/DEV#AanzichtVerkeersbordopstellingVKSShape> a shacl:NodeShape;
  rdfs:label "Aanzicht verkeersbordopstelling VKS"@nl;
  <http://purl.org/vocab/vann/usageNote> "Implementatietype enkel voor Signalisatie Vlaanderen (VKS)."@nl;
  rdfs:comment "Implementatie klasse voor VKS als extensie op de AanzichtVerkeersbordopstelling van de OTL."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/implementatietypes/ontwerpdocument/DEV#AanzichtVerkeersbordopstellingVKS>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "technische voorstelling"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik deze eigenschap enkel voor aanlevering ikv Signalisatie Vlaanderen (VKS)."@nl;
    rdfs:comment "Grafische weergave van de opstelling zoals fysiek te zien op het openbaar domein met aanduiding van opstelhoogtes en horizontale verschuivingen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/implementatietypes/ontwerpdocument/DEV#AanzichtVerkeersbordopstellingVKS.TechnischeVoorstelling>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Grafische weergave van de opstelling zoals fysiek te zien op het openbaar domein met aanduiding van opstelhoogtes en horizontale verschuivingen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "technische voorstelling"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AanzichtVerkeersbordopstellingVKS.technischeVoorstelling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "kaartvoorstelling"@nl;
    <http://purl.org/vocab/vann/usageNote> "Gebruik deze eigenschap enkel voor aanlevering ikv Signalisatie Vlaanderen (VKS)."@nl;
    rdfs:comment "Grafische weergave van de opstelling in ontwerp met visueel onderscheid op basis van de status van het bord nl: bestaand, gepland of te verwijderen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/implementatietypes/ontwerpdocument/DEV#AanzichtVerkeersbordopstellingVKS.Kaartvoorstelling>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Grafische weergave van de opstelling in ontwerp met visueel onderscheid op basis van de status van het bord nl: bestaand, gepland of te verwijderen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "kaartvoorstelling"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AanzichtVerkeersbordopstellingVKS.kaartvoorstelling>
  ], [
    a shacl:PropertyShape;
