    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
