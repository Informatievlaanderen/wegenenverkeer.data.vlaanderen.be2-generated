  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AardingskabelShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://purl.org/vocab/vann/usageNote": [
      {
        "@language": "nl",
        "@value": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een aardingskabel is een geleidende verbinding,typisch uit koper,die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Aardingskabel"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": "false"
      }
    ],
