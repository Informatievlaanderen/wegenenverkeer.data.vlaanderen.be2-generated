        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
