    shacl:description "Geeft het type aan van het aardingsstelsel volgens een keuzelijst."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "attest distributienetbeheerder"@nl;
    <http://purl.org/vocab/vann/usageNote> "Voor een globaal aardingsstelsel moet een attest voorzien worden zoniet moet er van uitgegaan worden dat het om een gescheiden stelsel gaat"@nl;
    rdfs:comment "Een bestandsbijlage met het attest volgens het aardingsstelsel voorzien door de distributienetbeheerder ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AardingsstelselDetails..AttestDistributienetbeheerder>;
