<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AIMDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AIMDatabankStatus.IsActief>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is actief"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus.isActief>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#AbstracteAanvullendeGeometrie>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Onderdoorboring>,
    <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Onderwaterkruising>,
