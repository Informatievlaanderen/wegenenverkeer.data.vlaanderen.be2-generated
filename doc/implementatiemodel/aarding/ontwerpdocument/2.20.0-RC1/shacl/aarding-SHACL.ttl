<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#BehuizingShape> a shacl:NodeShape;
  rdfs:label "Behuizing"@nl;
  rdfs:comment "Abstracte voor alle types van behuizing voor het beschermen van technieken."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "adres"@nl;
    rdfs:comment "Adres (aanduiding van de locatie) van de behuizing. Indien deze geen adres heeft, wordt net zoals door Fluvius voor cabines, het adres van een nabijgelegen straat genomen."@nl;
