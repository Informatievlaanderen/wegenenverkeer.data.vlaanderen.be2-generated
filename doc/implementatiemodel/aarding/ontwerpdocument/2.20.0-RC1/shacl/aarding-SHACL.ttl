    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "tabel uitwendige invloeden"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Behuizing.tabelUitwendigeInvloeden>
  ];
