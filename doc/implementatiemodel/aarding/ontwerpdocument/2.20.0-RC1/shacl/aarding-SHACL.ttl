<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AardingsinstallatieShape> a shacl:NodeShape;
  rdfs:label "Aardingsinstallatie"@nl;
  rdfs:comment "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aardingsnet"@nl;
    rdfs:comment "De manier waarop respectievelijk de bron en de verbruiker met de aarde verbonden worden om op die manier foutstromen af te voeren."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#Aardingsinstallatie.Aardingsnet>;
    shacl:class skos:Concept;
    shacl:description "De manier waarop respectievelijk de bron en de verbruiker met de aarde verbonden worden om op die manier foutstromen af te voeren."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aardingsnet"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie.aardingsnet>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aardingsstelsel"@nl;
    rdfs:comment "De wijze waarop verschillende aardingen (bv. laagspanningsaarding, nulpuntsaarding, hoogspanningsaarding) zich t.o.v. elkaar bevinden: ofwel bevinden alle aardingen zich uit elkaars invloedssfeer en hebben ze geen impact op elkaars potentiaal ofwel zijn alle aardverbindingen galvanisch met elkaar in contact. In het eerste geval spreekt men van gescheiden aardingsstelsel, in het tweede geval van een globale aarding."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#Aardingsinstallatie.Aardingsstelsel>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel>;
    shacl:description "De wijze waarop verschillende aardingen (bv. laagspanningsaarding, nulpuntsaarding, hoogspanningsaarding) zich t.o.v. elkaar bevinden: ofwel bevinden alle aardingen zich uit elkaars invloedssfeer en hebben ze geen impact op elkaars potentiaal ofwel zijn alle aardverbindingen galvanisch met elkaar in contact. In het eerste geval spreekt men van gescheiden aardingsstelsel, in het tweede geval van een globale aarding."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aardingsstelsel"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie.aardingsstelsel>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aardingsweerstand"@nl;
    rdfs:comment "De grootte van de weerstand tussen de aardelektrode en de omringende grond."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#Aardingsinstallatie.Aardingsweerstand>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInOhm>;
    shacl:description "De grootte van de weerstand tussen de aardelektrode en de omringende grond."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aardingsweerstand"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie.aardingsweerstand>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type aardingsinstallatietype"@nl;
    rdfs:comment "Mogelijke types van aardingsinstallaties."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#Aardingsinstallatie.TypeAardingsinstallatietype>;
    shacl:class skos:Concept;
    shacl:description "Mogelijke types van aardingsinstallaties."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type aardingsinstallatietype"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie.aardingsinstallatietype>
  ], [
    a shacl:PropertyShape;
    rdfs:label "Bevestiging"@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#Aardingsinstallatie.Bevestiging>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie>;
    shacl:name "Bevestiging"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/doc/implementatiemodel/aarding/#Bevestiging>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Aardingsinstallatie> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AardingskabelSectieShape> a shacl:NodeShape;
  rdfs:label "Aardingskabel sectie"@nl;
