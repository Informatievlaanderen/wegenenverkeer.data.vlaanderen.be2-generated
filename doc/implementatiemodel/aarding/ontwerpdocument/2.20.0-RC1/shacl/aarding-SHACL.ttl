    shacl:description "Een bestandsbijlage met het attest volgens het aardingsstelsel voorzien door de distributienetbeheerder ."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "attest distributienetbeheerder"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel.attestDNB>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#DtcAardingsstelsel> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aarding/ontwerpdocument/2.20.0-RC1#AbstracteAanvullendeGeometrieShape> a shacl:NodeShape;
