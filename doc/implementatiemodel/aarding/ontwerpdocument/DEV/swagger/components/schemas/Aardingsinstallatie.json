{
  "title": "Aardingsinstallatie",
  "type": "object",
  "description": "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Aardingsinstallatie)",
      "pattern": "^Aardingsinstallatie$"
    },
    "aardingsnet": {
      "$ref": "#/components/schemas/AardingsinstallatieAardingsnet"
    },
    "aardingsstelsel": {
      "$ref": "#/components/schemas/AardingsstelselDetails."
    },
    "aardingsweerstand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInOhm"
    },
    "typeAardingsinstallatietype": {
      "$ref": "#/components/schemas/TypeVanAardingsinstallatie"
    },
    "naam": {
      "$ref": "#/components/schemas/Aardingsinstallatie.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Aardingsinstallatie.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Aardingsinstallatie.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Aardingsinstallatie.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Aardingsinstallatie.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Aardingsinstallatie.datumOprichtingObject"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/Aardingsinstallatie.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "aardingsnet",
    "aardingsstelsel",
    "aardingsweerstand",
    "typeAardingsinstallatietype",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}