      {
        "@id": "_:df_2_84"
      },
      {
        "@id": "_:df_2_85"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Hefportiek"
      }
    ]
  },
  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.20.0-RC1#HeftorenShape",
