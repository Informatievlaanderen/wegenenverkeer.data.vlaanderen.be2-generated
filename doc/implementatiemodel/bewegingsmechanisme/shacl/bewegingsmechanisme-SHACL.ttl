    shacl:minCount "1";
    shacl:name "is oog"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#CilinderStangkop.isOog>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#CilinderStangkop> .

