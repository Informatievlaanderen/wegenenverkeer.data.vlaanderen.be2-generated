<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#BalgShape> a shacl:NodeShape;
  rdfs:label "Balg"@nl;
  rdfs:comment "Een flexibel, expansie- en contractie-element dat wordt gebruikt om de waterkerende constructie te laten bewegen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type vulling"@nl;
    rdfs:comment "Het type vulling van de balg."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Balg.TypeVulling>;
    shacl:class skos:Concept;
    shacl:description "Het type vulling van de balg."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "type vulling"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Balg.typeVulling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximale druk"@nl;
    rdfs:comment "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Balg.MaximaleDruk>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInBar>;
    shacl:description "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "maximale druk"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Balg.maximaleDruk>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Balg> .

