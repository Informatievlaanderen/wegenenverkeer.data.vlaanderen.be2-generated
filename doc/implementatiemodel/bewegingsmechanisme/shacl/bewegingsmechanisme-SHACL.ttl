    shacl:description "Het gebruikte materiaal van een regelbaar tegengewicht."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "materiaal"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#RegelbaarTegengewicht.materiaal>
  ];
