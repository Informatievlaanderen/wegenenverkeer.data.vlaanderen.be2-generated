  {
    "@id": "_:df_7_101",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "maximale druk"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Balg.MaximaleDruk"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInBar"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
