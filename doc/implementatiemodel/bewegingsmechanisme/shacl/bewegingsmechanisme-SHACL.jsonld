  {
    "@id": "_:df_7_86",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "De hoogste druk die het drukvat kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van het drukvat. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij het drukvat geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat het drukvat faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "maximale druk"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/bewegingsmechanisme/ontwerpdocument/2.18.1#Drukvat.MaximaleDruk"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#KwantWrdInBar"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "De hoogste druk die het drukvat kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van het drukvat. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij het drukvat geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat het drukvat faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@value": "1"
      }
    ],
