{
  "title": "HydraulischeCilinder",
  "type": "object",
  "description": "Hydraulisch aangedreven actuator waarbij de beweging wordt bewerkstelligd door een inwendige hydraulische druk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse HydraulischeCilinder)",
      "pattern": "^HydraulischeCilinder$"
    },
    "heeftHijsogen": {
      "type": "object",
      "description": "Geeft aan of de cilinder hijsogen heeft.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftStandmeting": {
      "type": "object",
      "description": "Geeft aan of de cilinder een inwendige standmeting heeft.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "proefdruk": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInBar"
    },
    "nominaleDruk": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInBar"
    },
    "maximaleWerkdruk": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInBar"
    },
    "heeftTegenstang": {
      "type": "object",
      "description": "Geeft aan of de cilinder voorzien is van een tegenstang. In zo'n geval bevindt er zich een stang aan beide kanten van de zuiger.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "nominaleKracht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "slag": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "gewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKilogram"
    },
    "maximaleKracht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "aantalSmeerpunten": {
      "type": "object",
      "description": "Het aantal aanwezige smeerpunten.",
      "properties": {
        "@value": {
          "type": "number",
          "format": "int64"
        },
        "@type": {
          "type": "string",
          "pattern": "^Integer$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "typeSmering": {
      "$ref": "#/components/schemas/SmeringType"
    },
    "technischDocument": {
      "type": "array",
      "description": "Lijst van ComplexDatatypeTechnischDocument items.",
      "items": {
        "$ref": "#/components/schemas/ComplexDatatypeTechnischDocument"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "heeftHijsogen",
    "heeftStandmeting",
    "proefdruk",
    "nominaleDruk",
    "maximaleWerkdruk",
    "heeftTegenstang",
    "nominaleKracht",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "slag",
    "gewicht",
    "maximaleKracht",
    "aantalSmeerpunten",
    "typeSmering",
    "technischDocument"
  ]
}