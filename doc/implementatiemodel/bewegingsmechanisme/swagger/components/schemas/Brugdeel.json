{
  "title": "Brugdeel",
  "type": "object",
  "description": "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben. In het geval van beweegbare bruggen worden de onderdelen die de beweging mogelijk maken zoals balansarmen, tegengewicht, hameipoort,..etc ook gevat in het object brugdeel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Brugdeel)",
      "pattern": "^Brugdeel$"
    },
    "graadVanBeweegbaarheid": {
      "$ref": "#/components/schemas/GraadVanBeweegbaarheid"
    },
    "typeBrugdeel": {
      "$ref": "#/components/schemas/TypeBrugdeel"
    },
    "typeBeweegbaarBrugdeel": {
      "$ref": "#/components/schemas/TypeBeweegbaarBrugdeel"
    },
    "graadVanStatischeBepaaldheid": {
      "$ref": "#/components/schemas/GraadVanStatischeBepaaldheid"
    },
    "totaleLengteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "aantalOverspanningen": {
      "$ref": "#/components/schemas/Brugdeel.aantalOverspanningen"
    },
    "individueleAfstandOverspanningen": {
      "type": "array",
      "description": "De individuele afstand tussen opeenvolgende opleggingen, in meter. Dit wordt uitgedrukt gaande van LO naar RO, of in oplopende kilometerpunten. Er kunnen meerdere waarden mogelijk zijn (vb.: voor hyperstatische brugdelen). Lijst van KwantitatieveWaardeInMeter items.",
      "items": {
        "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
      },
      "minItems": 1
    },
    "totaleBreedteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "totaleOppervlakteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "materiaalDragendeStructuur": {
      "$ref": "#/components/schemas/MateriaalDragendeStructuurBrugdeel"
    },
    "totaleSpankracht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "heeftVoorzieningNegatieveReactie": {
      "$ref": "#/components/schemas/Brugdeel.heeftVoorzieningNegatieveReactie"
    },
    "naam": {
      "$ref": "#/components/schemas/Brugdeel.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Brugdeel.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brugdeel.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Brugdeel.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brugdeel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Brugdeel.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Brugdeel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "graadVanBeweegbaarheid",
    "typeBrugdeel",
    "typeBeweegbaarBrugdeel",
    "graadVanStatischeBepaaldheid",
    "totaleLengteBrugdeel",
    "aantalOverspanningen",
    "individueleAfstandOverspanningen",
    "totaleBreedteBrugdeel",
    "totaleOppervlakteBrugdeel",
    "materiaalDragendeStructuur",
    "totaleSpankracht",
    "heeftVoorzieningNegatieveReactie",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}