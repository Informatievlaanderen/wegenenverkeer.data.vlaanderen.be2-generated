<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/luidspreker-intercom/ontwerpdocument/2.20.0-RC1#MeetmicrofoonShape> a shacl:NodeShape;
  rdfs:label "Meetmicrofoon"@nl;
  rdfs:comment "Een microfoon is een elektromechanisch instrument dat geluid omzet in een elektrisch signaal. Een meetmicrofoon registreert de geluidsdruk, is gevoelig voor geluid uit alle richtingen en heeft een vlakke frequentiekarakteristiek. Nauwkeurigheid is hier belangrijker dan geluidskwaliteit. In een tunnel meet de microfoon het geluidsniveau in de tunnel om het volume van een luidspreker aan te kunnen passen om zo verstaanbaar mogelijk te communiceren."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "transport type"@nl;
    rdfs:comment "Geeft aan op welke manier het audiosignaal wordt getransporteerd door het toestel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/luidspreker-intercom/ontwerpdocument/2.20.0-RC1#Meetmicrofoon.TransportType>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan op welke manier het audiosignaal wordt getransporteerd door het toestel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "transport type"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon.transportType>
  ], [
    a shacl:PropertyShape;
    rdfs:label "technische fiche"@nl;
    rdfs:comment "De technische fiche van de meetmicrofoon."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/luidspreker-intercom/ontwerpdocument/2.20.0-RC1#Meetmicrofoon.TechnischeFiche>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "De technische fiche van de meetmicrofoon."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "technische fiche"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon.technischeFiche>
  ], [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van de meetmicrofoon."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/luidspreker-intercom/ontwerpdocument/2.20.0-RC1#Meetmicrofoon.Merk>;
    shacl:class skos:Concept;
    shacl:description "Het merk van de meetmicrofoon."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "De modelnaam van de meetmicrofoon."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/luidspreker-intercom/ontwerpdocument/2.20.0-RC1#Meetmicrofoon.Modelnaam>;
    shacl:class skos:Concept;
    shacl:description "De modelnaam van de meetmicrofoon."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon.modelnaam>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon> .

