{
  "title": "Audioversterker",
  "type": "object",
  "description": "Elk toestel dat een inkomend audiosignaal omzet naar een signaal dat meerdere luidsprekers kan aansturen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Audioversterker)",
      "pattern": "^Audioversterker$"
    },
    "iP-Adres": {
      "type": "array",
      "description": "Het IP-adres van de audioversterker. Lijst van IPv4-Adres items.",
      "items": {
        "$ref": "#/components/schemas/IPv4-Adres"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "merk": {
      "$ref": "#/components/schemas/AudioversterkerMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/AudioversterkerModelnaam"
    },
    "dNSNaam": {
      "$ref": "#/components/schemas/Audioversterker.dNSNaam"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "naam": {
      "$ref": "#/components/schemas/Audioversterker.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Audioversterker.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Audioversterker.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Audioversterker.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Audioversterker.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Audioversterker.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Audioversterker.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "iP-Adres",
    "merk",
    "modelnaam",
    "dNSNaam",
    "technischeFiche",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}