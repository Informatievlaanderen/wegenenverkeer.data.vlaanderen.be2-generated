    "kortsluitvermogen",
    "kortsluitstroom",
    "heeftAardingsschakelaar",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
