    rdfs:comment "Aantal en sectie van de ader(s) van de kabel volgens een lijst van voorkomende types."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Voedingskabel.AantalAdersEnSectie>;
