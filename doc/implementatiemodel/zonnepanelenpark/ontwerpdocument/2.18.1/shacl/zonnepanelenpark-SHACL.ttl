<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  rdfs:comment "Complex datatype voor de aanduiding van een bepaalde locatie, doorgaans van een huis, woning, gebouw of faciliteit, op de aarde."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "De naam van de straat."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Straatnaam>;
    shacl:class xsd:string;
    shacl:description "De naam van de straat."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "straatnaam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.straatnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Huisnummer>;
    shacl:class xsd:string;
    shacl:description "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "huisnummer"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bus"@nl;
    rdfs:comment "Een nummer dat de postbus aanduidt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Bus>;
    shacl:class xsd:string;
    shacl:description "Een nummer dat de postbus aanduidt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "bus"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.bus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Een korte reeks tekens die in het postadres wordt opgenomen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Postcode>;
    shacl:class xsd:string;
    shacl:description "Een korte reeks tekens die in het postadres wordt opgenomen."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "postcode"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.postcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "provincie"@nl;
    rdfs:comment "Het deelgebied waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Provincie>;
    shacl:class skos:Concept;
    shacl:description "Het deelgebied waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "provincie"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.provincie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeente"@nl;
    rdfs:comment "De bestuurlijke eenheid waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zonnepanelenpark/ontwerpdocument/2.18.1#Adres.Gemeente>;
    shacl:class skos:Concept;
    shacl:description "De bestuurlijke eenheid waarin het adres gelegen is."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "gemeente"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres.gemeente>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcAdres> .

