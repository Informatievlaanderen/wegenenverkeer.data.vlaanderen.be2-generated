<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#AandrijfasShape> a shacl:NodeShape;
  rdfs:label "Aandrijfas"@nl;
  rdfs:comment "Een as die deel uitmaakt van een aandrijflijn en die dus een kracht overbrengt van een aandrijvend element naar een aangedreven element. Een aandrijfas kan aangedreven worden door o.a. een elektromotor, een verbrandingsmotor, een hydromotor, etc. Het aangedreven element kan een schoepenwiel van een pomp, een tandlat/tandrondsel, etc. zijn."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "technische fiche"@nl;
    rdfs:comment "De technische fiche van de aandrijfas."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Aandrijfas.TechnischeFiche>;
