<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#WentellagerShape> a shacl:NodeShape;
  rdfs:label "Wentellager"@nl;
  rdfs:comment "Een wentellager of rollend lager is een lager waarin de wrijving wordt verminderd door het gebruiken van rollende elementen tussen de as en de boring. Afhankelijk van de aard en de vorm van het rollend element, spreken we van cilinderlagers, diabololagers, kegellagers, kogellagers, naaldlagers, bollagers of tonlagers."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van het lager."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wentellager.Merk>;
    shacl:class skos:Concept;
    shacl:description "Het merk van het lager."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wentellager.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "De modelnaam volgens de fabrikant van het lager."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wentellager.Modelnaam>;
    shacl:class skos:Concept;
    shacl:description "De modelnaam volgens de fabrikant van het lager."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wentellager.modelnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Geeft aan welk type wentellager hier gebruikt wordt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wentellager.Type>;
    shacl:class skos:Concept;
    shacl:description "Geeft aan welk type wentellager hier gebruikt wordt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wentellager.type>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wentellager> .

