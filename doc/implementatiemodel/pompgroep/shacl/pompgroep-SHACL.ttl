    shacl:minCount 1;
    shacl:name "technische fiche"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aandrijfas.technischeFiche>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aandrijfas> .

