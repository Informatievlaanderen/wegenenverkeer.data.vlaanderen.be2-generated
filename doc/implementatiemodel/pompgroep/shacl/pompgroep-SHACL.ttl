<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#WerkschakelaarShape> a shacl:NodeShape;
  rdfs:label "Werkschakelaar"@nl;
  rdfs:comment "Een handbediende schakelaar die in de nabijheid van een elektromechanische installatie is aangebracht om deze gedurende onderhouds- en reparatiewerkzaamheden te kunnen uitschakelen."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Werkschakelaar> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#WormschroefShape> a shacl:NodeShape;
  rdfs:label "Wormschroef"@nl;
  rdfs:comment "Een spiraalvormige schroef die toelaat vloeistoffen, sluries, of poeders te transporteren. De schroef, geplaatst in een gesloten of deels open buis, wordt aangedreven en draait rond zijn eigen as. Deze draaiende beweging leidt tot de verplaatsing van het te verplaatsen medium. Wanneer het medium in opwaartse richting getransporteerd wordt spreekt men van een pomp. Wanneer het medium in afwaartse richting beweegt en al doende de schroef doet draaien, spreekt men van een turbine. Wordt ook wel waterschroef, opvoerschroef, vijzelpomp, of een schroef van Archimedes genoemd."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is afgesloten"@nl;
    rdfs:comment "Geeft aan of de schroef zich in een buis bevindt en dus afgesloten is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wormschroef.IsAfgesloten>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of de schroef zich in een buis bevindt en dus afgesloten is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is afgesloten"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef.isAfgesloten>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is visvriendelijk"@nl;
    rdfs:comment "Geeft aan of de wormschroef visvriendelijk is. Een schroef is visvriendelijk, als hij zodanig is ontworpen dat een vissen die worden meegeschept in leven blijven."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wormschroef.IsVisvriendelijk>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of de wormschroef visvriendelijk is. Een schroef is visvriendelijk, als hij zodanig is ontworpen dat een vissen die worden meegeschept in leven blijven."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is visvriendelijk"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef.isVisvriendelijk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "opvoerhoogte"@nl;
    rdfs:comment "De hoogte tot waarop het medium wordt opgepompt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wormschroef.Opvoerhoogte>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "De hoogte tot waarop het medium wordt opgepompt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "opvoerhoogte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef.opvoerhoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gewicht"@nl;
    rdfs:comment "Het gewicht van de wormschroef in kilogram."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wormschroef.Gewicht>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInKilogram>;
    shacl:description "Het gewicht van de wormschroef in kilogram."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gewicht"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef.gewicht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "lengte"@nl;
    rdfs:comment "De lengte van de wormschroef volgens zijn as."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.20.0-RC1#Wormschroef.Lengte>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter>;
    shacl:description "De lengte van de wormschroef volgens zijn as."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "lengte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef.lengte>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef> .
