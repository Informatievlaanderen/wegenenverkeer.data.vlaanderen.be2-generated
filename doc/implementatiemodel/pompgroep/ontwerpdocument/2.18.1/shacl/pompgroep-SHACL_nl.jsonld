  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/pompgroep/ontwerpdocument/2.18.1#WentellagerShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een wentellager of rollend lager is een lager waarin de wrijving wordt verminderd door het gebruiken van rollende elementen tussen de as en de boring. Afhankelijk van de aard en de vorm van het rollend element, spreken we van cilinderlagers, diabololagers, kegellagers, kogellagers, naaldlagers, bollagers of tonlagers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Wentellager"
      }
