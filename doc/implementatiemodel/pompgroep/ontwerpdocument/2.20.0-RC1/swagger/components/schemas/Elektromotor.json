{
  "title": "Elektromotor",
  "type": "object",
  "description": "Een machine die elektrische energie omzet in mechanische energie.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Elektromotor)",
      "pattern": "^Elektromotor$"
    },
    "merk": {
      "$ref": "#/components/schemas/ElektromotorMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ElektromotorModelnaam"
    },
    "gebruik": {
      "$ref": "#/components/schemas/ElektromotorRol"
    },
    "nominaleSpanning": {
      "$ref": "#/components/schemas/NominaleSpanning"
    },
    "bouwvorm": {
      "$ref": "#/components/schemas/ElektromotorBouwvorm"
    },
    "ashoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "asdiameter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "heeftGeforceerdeKoeling": {
      "type": "object",
      "description": "Geeft aan of de elektromotor voorzien is van geforceerde koeling.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "nominaalVermogen": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKilowatt"
    },
    "arbeidsfactor": {
      "type": "object",
      "description": "De arbeidsfactor of cosinus phi is de verhouding van het effectief elektrisch vermogen en het schijnbaar vermogen. Om het elektrisch net minimaal te belasten moet deze waarde zo dicht mogelijk bij 1 liggen.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "nominaleStroom": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInAmpèRe"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "beschermingsgraad": {
      "$ref": "#/components/schemas/ElektromotorBeschermingsgraad"
    },
    "nominaalToerental": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInRotatiesPerMinuut"
    },
    "componentnummer": {
      "type": "object",
      "description": "Het componentnummer van het elektrische toestel, zoals weergegeven op het schema van het lokale laagspanningsbord. Wordt ook wel onderdeelcode (ODC) genoemd.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "serienummer": {
      "type": "object",
      "description": "Het unieke nummer waarmee het toestel door de fabrikant geïdentificeerd is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naampad": {
      "type": "object",
      "description": "Een set van objecten (bv. collecties) die aanduiden waar het object zich bevindt in de objectenboom (EM-Infra). Dient consistent te zijn met de naam.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "gebruik",
    "nominaleSpanning",
    "bouwvorm",
    "ashoogte",
    "asdiameter",
    "heeftGeforceerdeKoeling",
    "nominaalVermogen",
    "arbeidsfactor",
    "nominaleStroom",
    "technischeFiche",
    "beschermingsgraad",
    "nominaalToerental",
    "componentnummer",
    "serienummer",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}