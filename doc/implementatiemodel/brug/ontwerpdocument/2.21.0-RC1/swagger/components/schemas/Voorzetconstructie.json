{
  "title": "Voorzetconstructie",
  "type": "object",
  "description": "Een voorzetconstructie is een wandconstructie die vóór een bestaande muur wordt geplaatst. Doorgaans uitgevoerd met kleine spouw met isolatiemateriaal en aan de binnenzijde van het bouw- of kunstwerk.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Voorzetconstructie)",
      "pattern": "^Voorzetconstructie$"
    },
    "bevestigingsmateriaal": {
      "$ref": "#/components/schemas/VoorzetconstructieBevestigingsmateriaal"
    },
    "brandweerstand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMinuten"
    },
    "dikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "isBrandwerend": {
      "$ref": "#/components/schemas/Voorzetconstructie.isBrandwerend"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "maximaleTemperatuurInterface": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCelsius"
    },
    "getestOpSpalling": {
      "$ref": "#/components/schemas/Voorzetconstructie.getestOpSpalling"
    },
    "technischDocument": {
      "type": "array",
      "description": "Een technisch document zoals een detailplan, een technische fiche en/of een rekennota. Lijst van ComplexDatatypeTechnischDocument items.",
      "items": {
        "$ref": "#/components/schemas/ComplexDatatypeTechnischDocument"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Voorzetconstructie.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Voorzetconstructie.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Voorzetconstructie.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Voorzetconstructie.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Voorzetconstructie.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Voorzetconstructie.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "naampad": {
      "$ref": "#/components/schemas/Voorzetconstructie.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Voorzetconstructie.naam"
    }
  },
  "required": [
    "@type",
    "bevestigingsmateriaal",
    "brandweerstand",
    "dikte",
    "isBrandwerend",
    "technischeFiche",
    "maximaleTemperatuurInterface",
    "getestOpSpalling",
    "technischDocument",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "naampad",
    "naam"
  ]
}