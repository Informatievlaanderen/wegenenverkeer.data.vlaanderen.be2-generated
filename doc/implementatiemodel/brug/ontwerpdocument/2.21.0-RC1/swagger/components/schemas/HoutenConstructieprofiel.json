        "$ref": "#/components/schemas/HoutenConstructieprofiel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/HoutenConstructieprofiel.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/HoutenConstructieprofiel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
