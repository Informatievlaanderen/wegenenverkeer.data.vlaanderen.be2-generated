{
  "title": "Brugdeel",
  "type": "object",
  "description": "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben. In het geval van beweegbare bruggen worden de onderdelen die de beweging mogelijk maken zoals balansarmen, tegengewicht, hameipoort,..etc ook gevat in het object brugdeel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Brugdeel)",
      "pattern": "^Brugdeel$"
    },
    "graadVanBeweegbaarheid": {
      "$ref": "#/components/schemas/GraadVanBeweegbaarheid"
    },
    "typeBrugdeel": {
      "$ref": "#/components/schemas/TypeBrugdeel"
    },
    "typeBeweegbaarBrugdeel": {
      "$ref": "#/components/schemas/TypeBeweegbaarBrugdeel"
    },
    "graadVanStatischeBepaaldheid": {
      "$ref": "#/components/schemas/GraadVanStatischeBepaaldheid"
    },
    "totaleLengteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "aantalOverspanningen": {
      "type": "object",
      "description": "Aantal overspanningen, van oplegging naar volgende oplegging (bij een isostatisch brugdeel zal dit één overspanning zijn, bij een hyperstatisch brugdeel zijn dit er meerdere).",
      "properties": {
        "@value": {
          "type": "number",
          "format": "int64"
        },
        "@type": {
          "type": "string",
          "pattern": "^NonNegativeInteger$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "individueleAfstandOverspanningen": {
      "type": "array",
      "description": "Lijst van KwantitatieveWaardeInMeter items.",
      "items": {
        "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
      },
      "minItems": 1
    },
    "totaleBreedteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "totaleOppervlakteBrugdeel": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "materiaalDragendeStructuur": {
      "$ref": "#/components/schemas/MateriaalDragendeStructuurBrugdeel"
    },
    "totaleSpankracht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "heeftVoorzieningNegatieveReactie": {
      "type": "object",
      "description": "Geeft aan of het brugdeel een voorziening negatieve reactie bevat, al dan niet.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "graadVanBeweegbaarheid",
    "typeBrugdeel",
    "typeBeweegbaarBrugdeel",
    "graadVanStatischeBepaaldheid",
    "totaleLengteBrugdeel",
    "aantalOverspanningen",
    "individueleAfstandOverspanningen",
    "totaleBreedteBrugdeel",
    "totaleOppervlakteBrugdeel",
    "materiaalDragendeStructuur",
    "totaleSpankracht",
    "heeftVoorzieningNegatieveReactie",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}