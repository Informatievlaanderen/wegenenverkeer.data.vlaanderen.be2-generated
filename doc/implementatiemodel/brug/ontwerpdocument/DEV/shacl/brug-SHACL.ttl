    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balk.typeBalk>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balk> .

