    rdfs:comment "De soort van balk."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brug/ontwerpdocument/DEV#Balk.TypeBalk>;
    shacl:description "De soort van balk."@nl;
