    shacl:description "Het gebruikte materiaal van een regelbaar tegengewicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "materiaal"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RegelbaarTegengewicht.materiaal>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RegelbaarTegengewicht> .

