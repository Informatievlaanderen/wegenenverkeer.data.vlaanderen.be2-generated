  rdfs:label "Horizontale constructieplaat"@nl;
  rdfs:comment "Een plaat die dient ter constructie en die horizontaal wordt gebruikt. Deze omvat geen platen die met fundering te maken hebben (vb.: funderingsplaat,funderingszool,...)."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brug/ontwerpdocument/DEV#HorizontaleConstructieplaat>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
