{
  "title": "Brugdekvoeg",
  "type": "object",
  "description": "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Brugdekvoeg)",
      "pattern": "^Brugdekvoeg$"
    },
    "lopendeMeterVoeg": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "typeBrugdekvoeg": {
      "$ref": "#/components/schemas/TypeBrugdekvoeg"
    },
    "detailplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "heeftGeluidsreducerendElementen": {
      "$ref": "#/components/schemas/Brugdekvoeg.heeftGeluidsreducerendElementen"
    },
    "typeVerankering": {
      "$ref": "#/components/schemas/TypeVerankeringBrugdekvoeg"
    },
    "beschikbareVoegopening": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "producent": {
      "$ref": "#/components/schemas/Brugdekvoeg.producent"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "naam": {
      "$ref": "#/components/schemas/Brugdekvoeg.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Brugdekvoeg.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brugdekvoeg.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Brugdekvoeg.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Brugdekvoeg.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Brugdekvoeg.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Brugdekvoeg.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "lopendeMeterVoeg",
    "typeBrugdekvoeg",
    "detailplan",
    "heeftGeluidsreducerendElementen",
    "typeVerankering",
    "beschikbareVoegopening",
    "producent",
    "technischeFiche",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}