      }
    ]
  },
  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugeloogShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een oogvormig onderdeel,geïntegreerd in een halsbeugelmechanisme,dat dient als bevestigingspunt van de halsbeugelpen met het gedeelte dat op beton is gemonteerd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Halsbeugeloog"
      }
    ],
