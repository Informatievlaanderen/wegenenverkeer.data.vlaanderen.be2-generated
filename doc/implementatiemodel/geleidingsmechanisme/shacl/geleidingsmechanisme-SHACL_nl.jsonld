      }
    ]
  },
  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugelpenShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Een onderdeel van het halsbeugelmechanisme dat is geïntegreerd in de sluisdeur. Deze pen fungeert als draaipunt voor de bewegingen van de deur. Rondom de pen zijn het lagerelement en het halsbeugeloog geplaatst, die de beweging ondersteunen en eventueel reguleren."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "Halsbeugelpen"
      }
    ],
    "http://www.w3.org/ns/shacl#closed": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
