      {
        "@language": "nl",
        "@value": "Het onderdeel dat gemonteerd is op de deur om een pen vast te houden indien de pen niet rechtstreeks in de deur is geïntegreerd."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
