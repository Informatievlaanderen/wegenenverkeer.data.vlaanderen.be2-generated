<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugeloogShape> a shacl:NodeShape;
  rdfs:label "Halsbeugeloog"@nl;
  rdfs:comment "Een oogvormig onderdeel,geïntegreerd in een halsbeugelmechanisme,dat dient als bevestigingspunt van de halsbeugelpen met het gedeelte dat op beton is gemonteerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Halsbeugeloog> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugelpenShape> a shacl:NodeShape;
  rdfs:label "Halsbeugelpen"@nl;
  rdfs:comment "Een onderdeel van het halsbeugelmechanisme dat is geïntegreerd in de sluisdeur. Deze pen fungeert als draaipunt voor de bewegingen van de deur. Rondom de pen zijn het lagerelement en het halsbeugeloog geplaatst, die de beweging ondersteunen en eventueel reguleren."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Halsbeugelpen> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugelschoenShape> a shacl:NodeShape;
  rdfs:label "Halsbeugelschoen"@nl;
  rdfs:comment "Het onderdeel dat gemonteerd is op de deur om een pen vast te houden indien de pen niet rechtstreeks in de deur is geïntegreerd."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Halsbeugelschoen> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HefportiekShape> a shacl:NodeShape;
  rdfs:label "Hefportiek"@nl;
  rdfs:comment "Een hefportiek is een vrijstaand, stijf hoofdconstructieonderdeel. Het bestaat uit minstens twee steunbenen die onderling verbonden zijn en rusten op de onderbouw. Deze steunbenen staan (mede) in voor het verticale steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dit niet rust op zijn vaste steunpunten. Het tilt meestal een brugdeel of beweegbare waterkerende constructie op. Meestal herbergt een hefportiek een mechaniek met ook een tegengewicht en steekt het samen met een tweede, gelijkaardig exemplaar aan de overzijde, hoog boven de rest van het kunstwerk uit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is gevuld met tegengewicht"@nl;
    rdfs:comment "Aanduiding of het hefportiek al dan niet gevuld is met een tegengewicht."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Hefportiek.IsGevuldMetTegengewicht>;
    shacl:class xsd:boolean;
    shacl:description "Aanduiding of het hefportiek al dan niet gevuld is met een tegengewicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is gevuld met tegengewicht"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Hefportiek.isGevuldMetTegengewicht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    rdfs:comment "Duidt de toegankelijkheid van het hefportiek aan."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Hefportiek.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "Duidt de toegankelijkheid van het hefportiek aan."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "toegankelijkheid"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Hefportiek.toegankelijkheid>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Hefportiek> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HeftorenShape> a shacl:NodeShape;
  rdfs:label "Heftoren"@nl;
  rdfs:comment "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is gevuld met tegengewicht"@nl;
    rdfs:comment "Aanduiding of de heftoren al dan niet gevuld is met een tegengewicht."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Heftoren.IsGevuldMetTegengewicht>;
    shacl:class xsd:boolean;
    shacl:description "Aanduiding of de heftoren al dan niet gevuld is met een tegengewicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is gevuld met tegengewicht"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Heftoren.isGevuldMetTegengewicht>
  ], [
    a shacl:PropertyShape;
    rdfs:label "toegankelijkheid"@nl;
    rdfs:comment "Duidt de toegankelijkheid aan van de heftoren."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Heftoren.Toegankelijkheid>;
    shacl:class skos:Concept;
    shacl:description "Duidt de toegankelijkheid aan van de heftoren."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "toegankelijkheid"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Heftoren.toegankelijkheid>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Heftoren> .

