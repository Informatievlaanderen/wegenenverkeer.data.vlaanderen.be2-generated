    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is regelbaar"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Halsbeugelmechanisme.isRegelbaar>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type mechanisme"@nl;
    rdfs:comment "Geeft de verschillende types halsbeugelmechanismen aan."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Halsbeugelmechanisme.TypeMechanisme>;
    shacl:class skos:Concept;
    shacl:description "Geeft de verschillende types halsbeugelmechanismen aan."@nl;
    shacl:maxCount 1;
