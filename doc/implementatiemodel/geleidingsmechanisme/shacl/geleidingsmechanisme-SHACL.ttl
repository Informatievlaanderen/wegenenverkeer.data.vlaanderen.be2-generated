  ], [
    a shacl:PropertyShape;
    rdfs:label "kracht"@nl;
    rdfs:comment "Dit is de voorspankracht in het geval van voorgespannen ankers met tegenplaat en maximale trekkracht in het geval van ingestorte ankers of niet-ingestorte ankers."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Ankerplaat.Kracht>;
