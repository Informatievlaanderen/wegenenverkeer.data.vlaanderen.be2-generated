<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AangrijpingShape> a shacl:NodeShape;
  rdfs:label "Aangrijping"@nl;
  rdfs:comment "Abstracte om attributen en relaties te bundelen voor aangrijping. Een aangrijping maakt de koppeling tussen tussen de actuator en de beweegbare constructive."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Aangrijping> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimDatabankStatus.IsActief>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "is actief"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus.isActief>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMDBStatus> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimNaamObjectShape> a shacl:NodeShape;
  rdfs:label "AIM naam object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor elk OTL object dat benoemd wordt met een mensleesbare identificator."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is."@nl;
    rdfs:comment "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimNaamObject.Naam>;
    shacl:class xsd:string;
    shacl:description "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    shacl:maxCount "1";
    shacl:minCount "1";
    shacl:name "naam"@nl;
    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject.naam>
  ];
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#AIMNaamObject> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.18.1#AimObject.Asset-id>;
    shacl:class <https://wegenenverkeer.data.vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
