<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#GrendelmechanismeShape> a shacl:NodeShape;
  rdfs:label "Grendelmechanisme"@nl;
  rdfs:comment "Een mechanisme dat de beweging van een beweegbare constructie blokkeert. Het bestaat uit een grendel die in een vaste of beweegbare constructie schuift of draait om beweging te verhinderen."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Grendelmechanisme> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#HalsbeugelmechanismeShape> a shacl:NodeShape;
  rdfs:label "Halsbeugelmechanisme"@nl;
  rdfs:comment "Dient om de beweging van de waterkerende constructie, meer bepaald puntdeur of draaideur, te geleiden. De geleiding bestaat hoofdzakelijk uit een rotatie om een verticale as en soms mogelijk ook een translatie."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is regelbaar"@nl;
    rdfs:comment "Geeft aan of het halsbeugelmechanisme regelbaar is of niet."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/geleidingsmechanisme/ontwerpdocument/2.20.0-RC1#Halsbeugelmechanisme.IsRegelbaar>;
