{
  "title": "Glijlager",
  "type": "object",
  "description": "Een machineonderdeel met als functie het toelaten van rotatie of translatie van een as. Bij een glijlager glijdt de as in een vast lager,het verlagen van de wrijving tussen as en lager gebeurt door smering of door het materiaal van het lager.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Glijlager)",
      "pattern": "^Glijlager$"
    },
    "vormgeving": {
      "$ref": "#/components/schemas/Vormgeving"
    },
    "merk": {
      "$ref": "#/components/schemas/MerknamenVanGlijlagers"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnamenVanGlijlagers"
    },
    "inwendigeDiameter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "uitwendigeDiameter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "typeBeweging": {
      "$ref": "#/components/schemas/TypeBeweging"
    },
    "typeSmering": {
      "$ref": "#/components/schemas/SmeringType"
    },
    "hoeveelheidVetPerSmeerronde": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKubiekeCentimeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Glijlager.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Glijlager.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Glijlager.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Glijlager.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Glijlager.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Glijlager.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Glijlager.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "technischDocument": {
      "type": "array",
      "description": "Een technisch document zoals een detailplan, een technische fiche en/of een rekennota. Lijst van ComplexDatatypeTechnischDocument items.",
      "items": {
        "$ref": "#/components/schemas/ComplexDatatypeTechnischDocument"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "vormgeving",
    "merk",
    "modelnaam",
    "inwendigeDiameter",
    "uitwendigeDiameter",
    "breedte",
    "typeBeweging",
    "typeSmering",
    "hoeveelheidVetPerSmeerronde",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "technischDocument"
  ]
}