{
  "title": "BeweegbareWaterkerendeConstructie",
  "type": "object",
  "description": "Een beweegbare constructie ontworpen om een waterpeilverschil te keren, inclusief alle gelaste onderdelen die bijdragen aan de structurele integriteit en functionaliteit van de constructie.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse BeweegbareWaterkerendeConstructie)",
      "pattern": "^BeweegbareWaterkerendeConstructie$"
    },
    "isMangatAanwezig": {
      "type": "object",
      "description": "Geeft aan of er een mangat aanwezig is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "afmetingenMangat": {
      "$ref": "#/components/schemas/AfmetingBxlInCentimeter"
    },
    "isNivelleerOfSpuivoorzieningAanwezig": {
      "type": "object",
      "description": "Geeft aan of er nivelleer -of spuivoorzieningen aanwezig zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "basisAfmeting": {
      "$ref": "#/components/schemas/AfmetingBxlxhInMeter"
    },
    "typeBeweegbareconstructie": {
      "$ref": "#/components/schemas/TypeBeweegbareWaterkerendeConstructie"
    },
    "isHoogtebeperkingAanwezig": {
      "type": "object",
      "description": "Geeft aan of er een hoogte beperking aanwezig is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "kruinpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "heeftHijsogen": {
      "type": "object",
      "description": "Geeft aan of er hijsogen aanwezig zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "niveauHoogtebeperking": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "gewicht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInTon"
    },
    "heeftOpboutbareHijsogen": {
      "type": "object",
      "description": "Geeft aan of er opboutbare hijsogen aanwezig zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftDraaischelpen": {
      "type": "object",
      "description": "Geeft aan of er draaischelpen aanwezig zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftOpboutbareDraaischelpen": {
      "type": "object",
      "description": "Geeft aan of er opboutbare draaischelpen aanwezig zijn.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "heeftPompput": {
      "type": "object",
      "description": "Geeft aan of in de beweegbare waterkerende constructie een pompput aanwezig is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "materiaal": {
      "$ref": "#/components/schemas/MateriaalBWCTWC"
    },
    "naam": {
      "type": "object",
      "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "isMangatAanwezig",
    "afmetingenMangat",
    "isNivelleerOfSpuivoorzieningAanwezig",
    "basisAfmeting",
    "typeBeweegbareconstructie",
    "isHoogtebeperkingAanwezig",
    "kruinpeil",
    "heeftHijsogen",
    "niveauHoogtebeperking",
    "gewicht",
    "heeftOpboutbareHijsogen",
    "heeftDraaischelpen",
    "heeftOpboutbareDraaischelpen",
    "heeftPompput",
    "materiaal",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}