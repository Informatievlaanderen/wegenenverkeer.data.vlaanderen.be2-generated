{
  "title": "Railconstructie",
  "type": "object",
  "description": "Geheel bestaande uit een doorlopend profiel waarop of waartegen iets rijdt of glijdt, samen met de klemmen, tussenplaten en ondersteuningsprofielen die het profiel bevestigen en ondersteunen.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Railconstructie)",
      "pattern": "^Railconstructie$"
    },
    "typeBevestigingRail": {
      "$ref": "#/components/schemas/TypeBevestigingRail"
    },
    "heeftVoegen": {
      "$ref": "#/components/schemas/Railconstructie.heeftVoegen"
    },
    "aantalVoegen": {
      "$ref": "#/components/schemas/Railconstructie.aantalVoegen"
    },
    "heeftLangsblokkeringrail": {
      "$ref": "#/components/schemas/Railconstructie.heeftLangsblokkeringrail"
    },
    "heeftOnderlegmat": {
      "$ref": "#/components/schemas/Railconstructie.heeftOnderlegmat"
    },
    "heeftTussenplaat": {
      "$ref": "#/components/schemas/Railconstructie.heeftTussenplaat"
    },
    "klemtype": {
      "$ref": "#/components/schemas/TypeKlem"
    },
    "typeKlem": {
      "$ref": "#/components/schemas/Railconstructie.typeKlem"
    },
    "naam": {
      "$ref": "#/components/schemas/Railconstructie.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Railconstructie.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Railconstructie.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Railconstructie.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Railconstructie.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Railconstructie.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Railconstructie.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "technischDocument": {
      "type": "array",
      "description": "Een technisch document zoals een detailplan, een technische fiche en/of een rekennota. Lijst van ComplexDatatypeTechnischDocument items.",
      "items": {
        "$ref": "#/components/schemas/ComplexDatatypeTechnischDocument"
      },
      "minItems": 1
    }
  },
  "required": [
    "@type",
    "typeBevestigingRail",
    "heeftVoegen",
    "aantalVoegen",
    "heeftLangsblokkeringrail",
    "heeftOnderlegmat",
    "heeftTussenplaat",
    "klemtype",
    "typeKlem",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "technischDocument"
  ]
}