{
  "title": "ZuilToegangscontrole",
  "type": "object",
  "description": "Een zuil om badgelezers en videofoonposten op te plaatsen. Deze bevinden zich typisch aan slagbomen of automatische poorten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ZuilToegangscontrole)",
      "pattern": "^ZuilToegangscontrole$"
    },
    "merk": {
      "$ref": "#/components/schemas/MerknamenZuilenToegangscontrole"
    },
    "materiaal": {
      "$ref": "#/components/schemas/MateriaalSoorten"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ModelnamenZuilenToegangscontrole"
    },
    "isGeschiktVoorVrachtwagens": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.isGeschiktVoorVrachtwagens"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "isGeschiktVoorPersonenvoertuigen": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.isGeschiktVoorPersonenvoertuigen"
    },
    "serienummer": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.serienummer"
    },
    "naampad": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ZuilToegangscontrole.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ZuilToegangscontrole.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/ZuilToegangscontrole.isActief"
    },
    "aIM-Toestand": {
