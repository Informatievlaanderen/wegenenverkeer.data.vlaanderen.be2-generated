{
  "title": "ANPRCamera",
  "type": "object",
  "description": "Nummerplaatherkenningscamera: een camera die als output de nummerplaat van een voertuig in tekst geeft en een foto van het deel van het voertuig waar de nummerplaat zich bevindt. Afhankelijk van het merk en type gecombineerd met een al dan niet bewegend overzichtsbeeld.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse ANPRCamera)",
      "pattern": "^ANPRCamera$"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/ANPRModelnaam"
    },
    "rijrichting": {
      "$ref": "#/components/schemas/Rijrichting"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "ipAdres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "heeftFlits": {
      "$ref": "#/components/schemas/ANPRCamera.heeftFlits"
    },
    "merk": {
      "$ref": "#/components/schemas/ANPR-CameraMerk"
    },
    "dNSNaam": {
      "$ref": "#/components/schemas/ANPRCamera.dNSNaam"
    },
    "opstelhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "naam": {
      "$ref": "#/components/schemas/ANPRCamera.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/ANPRCamera.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ANPRCamera.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/ANPRCamera.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/ANPRCamera.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/ANPRCamera.datumOprichtingObject"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/ANPRCamera.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "modelnaam",
    "rijrichting",
    "technischeFiche",
    "ipAdres",
    "heeftFlits",
    "merk",
    "dNSNaam",
    "opstelhoogte",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}