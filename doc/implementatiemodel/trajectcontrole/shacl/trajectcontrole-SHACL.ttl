<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#VoedtShape> a shacl:NodeShape;
  rdfs:label "Voedt"@nl;
  rdfs:comment "Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#Voedt>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aansluitspanning"@nl;
    rdfs:comment "Spanning van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#Voedt.Aansluitspanning>;
