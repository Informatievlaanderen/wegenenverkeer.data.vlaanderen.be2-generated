    shacl:description "Unieke identificatiecode van het toestel, toegekend door de fabrikant."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "serienummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.serienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximaal continu vermogen"@nl;
    rdfs:comment "Maximale continu vermogen van de UPS."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#UPS.MaximaalContinuVermogen>;
