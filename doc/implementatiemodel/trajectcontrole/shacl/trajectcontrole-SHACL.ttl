    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "Modelnaam van de UPS volgens de fabrikant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#UPS.Modelnaam>;
    shacl:description "Modelnaam van de UPS volgens de fabrikant."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UPS.modelnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "serienummer"@nl;
    rdfs:comment "Unieke identificatiecode van het toestel, toegekend door de fabrikant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/DEV#UPS.Serienummer>;
