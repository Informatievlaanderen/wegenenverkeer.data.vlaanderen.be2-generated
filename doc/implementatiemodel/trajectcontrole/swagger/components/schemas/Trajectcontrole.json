{
  "title": "Trajectcontrole",
  "type": "object",
  "description": "Trajectcontrole is een systeem waarbij de gemiddelde snelheid over een langere afstand wordt gemeten.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Trajectcontrole)",
      "pattern": "^Trajectcontrole$"
    },
    "attest": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "nTP": {
      "$ref": "#/components/schemas/Trajectcontrole.nTP"
    },
    "snelheidsregime": {
      "$ref": "#/components/schemas/Snelheidsregime"
    },
    "rijrichting": {
      "$ref": "#/components/schemas/Rijrichting"
    },
    "naampad": {
      "$ref": "#/components/schemas/Trajectcontrole.naampad"
    },
    "naam": {
      "$ref": "#/components/schemas/Trajectcontrole.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Trajectcontrole.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Trajectcontrole.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Trajectcontrole.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Trajectcontrole.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Trajectcontrole.datumOprichtingObject"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/Trajectcontrole.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "attest",
    "nTP",
    "snelheidsregime",
    "rijrichting",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}