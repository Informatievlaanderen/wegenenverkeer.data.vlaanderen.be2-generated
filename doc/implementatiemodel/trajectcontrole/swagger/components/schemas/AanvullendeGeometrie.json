    },
    "notitie": {
      "$ref": "#/components/schemas/AanvullendeGeometrie.notitie"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "$ref": "#/components/schemas/AanvullendeGeometrie.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
