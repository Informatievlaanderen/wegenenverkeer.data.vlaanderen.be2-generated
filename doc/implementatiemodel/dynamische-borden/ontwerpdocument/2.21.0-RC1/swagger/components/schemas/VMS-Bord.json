{
  "title": "VMS-Bord",
  "type": "object",
  "description": "Dynamisch verkeersbord dat gelijktijdig verkeerstekens en teksten kan weergeven op 2 geïntegreerde displays (verkeerstekens uiterst links). Het bord is bevestigd aan een seinbrug en heeft tot doel het verkeer te sturen (over een langer traject) en waarschuwingen en reistijden te tonen. VMS staat voor Variable Message Sign.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VMS-Bord)",
      "pattern": "^VMS-Bord$"
    },
    "merk": {
      "$ref": "#/components/schemas/DynBordVMSMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/DynBordVMSModelnaam"
    },
    "fabricagenummer": {
      "$ref": "#/components/schemas/VMS-Bord.fabricagenummer"
    },
    "revisienummer": {
      "$ref": "#/components/schemas/VMS-Bord.revisienummer"
    },
    "artikelnummer": {
      "$ref": "#/components/schemas/VMS-Bord.artikelnummer"
    },
    "heeftDeurcontact": {
      "$ref": "#/components/schemas/VMS-Bord.heeftDeurcontact"
    },
    "ipAdres": {
      "$ref": "#/components/schemas/IPv4-Adres"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "logischeGroepVerkeerscentrum": {
      "$ref": "#/components/schemas/VMS-Bord.logischeGroepVerkeerscentrum"
    },
    "communicatieprotocol": {
      "$ref": "#/components/schemas/LEDBordCommunicatieprotocol"
    },
    "protocol": {
      "$ref": "#/components/schemas/VMS-Bord.protocol"
    },
    "versie": {
      "$ref": "#/components/schemas/VMS-Bord.versie"
    },
    "dNSNaam": {
      "$ref": "#/components/schemas/VMS-Bord.dNSNaam"
    },
    "aantalLichtsensoren": {
      "$ref": "#/components/schemas/VMS-Bord.aantalLichtsensoren"
    },
    "naam": {
      "$ref": "#/components/schemas/VMS-Bord.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/VMS-Bord.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VMS-Bord.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/VMS-Bord.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VMS-Bord.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/VMS-Bord.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/VMS-Bord.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "afmeting": {
      "$ref": "#/components/schemas/AfmetingVerkeersbord"
    },
    "afbeelding": {
      "type": "array",
      "description": "De afbeelding van het verkeersbord. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "fabricagevoorschrift": {
      "$ref": "#/components/schemas/VMS-Bord.fabricagevoorschrift"
    },
    "operationeleStatus": {
      "$ref": "#/components/schemas/KeuzelijstOperationeleStatus"
    },
    "aanzicht": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInDecimaleGraden"
    },
    "opstelhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "naampad": {
      "$ref": "#/components/schemas/VMS-Bord.naampad"
    }
  },
  "required": [
    "@type",
    "merk",
    "modelnaam",
    "fabricagenummer",
    "revisienummer",
    "artikelnummer",
    "heeftDeurcontact",
    "ipAdres",
    "technischeFiche",
    "logischeGroepVerkeerscentrum",
    "communicatieprotocol",
    "protocol",
    "versie",
    "dNSNaam",
    "aantalLichtsensoren",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "afmeting",
    "afbeelding",
    "fabricagevoorschrift",
    "operationeleStatus",
    "aanzicht",
    "opstelhoogte",
    "naampad"
  ]
}