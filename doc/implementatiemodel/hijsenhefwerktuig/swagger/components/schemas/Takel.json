{
  "title": "Takel",
  "type": "object",
  "description": "Een hijsmiddel dat instaat voor het verticaal verplaatsen van een last via onder andere een staalkabel, ketting of hijsband.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Takel)",
      "pattern": "^Takel$"
    },
    "typeTakel": {
      "$ref": "#/components/schemas/TypeTakel"
    },
    "typeAandrijvingTakel": {
      "$ref": "#/components/schemas/TypeAandrijvingTakel"
    },
    "maximaleWerklast": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "massa": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInTon"
    },
    "hijshoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Takel.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Takel.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Takel.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Takel.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Takel.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Takel.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Takel.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "typeTakel",
    "typeAandrijvingTakel",
    "maximaleWerklast",
    "massa",
    "hijshoogte",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}