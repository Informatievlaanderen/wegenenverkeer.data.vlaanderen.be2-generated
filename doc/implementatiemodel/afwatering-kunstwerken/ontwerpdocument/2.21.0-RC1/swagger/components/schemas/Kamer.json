{
  "title": "Kamer",
  "type": "object",
  "description": "Een kamer is een aanééngesloten al dan niet ondergrondse constructie waarbinnen vrije stroming van water over de bodem mogelijk is. Een constructie of inspectieput kan één of meerdere kamers hebben.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Kamer)",
      "pattern": "^Kamer$"
    },
    "diepte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "materiaal": {
      "$ref": "#/components/schemas/PutMateriaal"
    },
    "vorm": {
      "$ref": "#/components/schemas/RioleringVorm"
    },
    "klasse": {
      "$ref": "#/components/schemas/KamerKlasse"
    },
    "heeftOlieafscheidendeKamer": {
      "$ref": "#/components/schemas/Kamer.heeftOlieafscheidendeKamer"
    },
    "heeftZandvang": {
      "$ref": "#/components/schemas/Kamer.heeftZandvang"
    },
    "isWoelkamer": {
      "$ref": "#/components/schemas/Kamer.isWoelkamer"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de kamer. Bestanden van het type xlsx, dwg of pdf. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Kamer.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kamer.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Kamer.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Kamer.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Kamer.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Kamer.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "diepte",
    "breedte",
    "hoogte",
    "materiaal",
    "vorm",
    "klasse",
    "heeftOlieafscheidendeKamer",
    "heeftZandvang",
    "isWoelkamer",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}