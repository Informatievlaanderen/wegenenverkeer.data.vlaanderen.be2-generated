  {
    "@id": "_:df_2_168",
    "@type": [
      "http://www.w3.org/ns/shacl#PropertyShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "nl",
        "@value": "Horizontaal geprojecteerde oppervlakte van de bovenbouw. Bij constante breedte berekend als de totale lengte van de brug (gemeten volgens de bovenliggende weg) vermenigvuldigd met de totale breedte, uitgedrukt in vierkante meter. Indien de lengte of breedte variabel is, of bij niet-rechthoekige vormen, wordt de oppervlakte van de ingetekende omschreven polygoon van de constructie gebruikt. Bij beschikbaarheid van een polygoon heeft deze methode de voorkeur."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "nl",
        "@value": "totale lengte brug"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/2.21.0-RC1#Brug.TotaleLengteBrug"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Horizontaal geprojecteerde oppervlakte van de bovenbouw. Bij constante breedte berekend als de totale lengte van de brug (gemeten volgens de bovenliggende weg) vermenigvuldigd met de totale breedte, uitgedrukt in vierkante meter. Indien de lengte of breedte variabel is, of bij niet-rechthoekige vormen, wordt de oppervlakte van de ingetekende omschreven polygoon van de constructie gebruikt. Bij beschikbaarheid van een polygoon heeft deze methode de voorkeur."
      }
    ],
    "http://www.w3.org/ns/shacl#maxCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1"
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": "1"
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
