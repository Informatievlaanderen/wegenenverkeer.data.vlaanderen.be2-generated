<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#BrugShape> a shacl:NodeShape;
  rdfs:label "Brug"@nl;
  rdfs:comment "Een beweegbare,vaste of drijvende verbinding voor het verkeer tussen twee punten,die door water of iets anders gescheiden zijn."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#Brug>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "burgerlijke klasse"@nl;
    rdfs:comment "Maximaal toegelaten belasting door gestandariseerde assen, meestal uitgedrukt als totaalgewicht / aslast in kN. Dit dient als ontwerpbelasting en om te oordelen of reële konvooien de brug kunnen overschrijden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#Brug.BurgerlijkeKlasse>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#DtcBurgerlijkeKlasseBrug>;
    shacl:description "Maximaal toegelaten belasting door gestandariseerde assen, meestal uitgedrukt als totaalgewicht / aslast in kN. Dit dient als ontwerpbelasting en om te oordelen of reële konvooien de brug kunnen overschrijden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "burgerlijke klasse"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug.burgerlijkeKlasse>
  ], [
    a shacl:PropertyShape;
    rdfs:label "dwarse indeling op de brug"@nl;
    rdfs:comment "Een dwarse indeling op de brug (wie maakt gebruik van welk deel van de brug,...). Dit wordt weergegeven in een schets of een plan."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#Brug.DwarseIndelingOpDeBrug>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Een dwarse indeling op de brug (wie maakt gebruik van welk deel van de brug,...). Dit wordt weergegeven in een schets of een plan."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "dwarse indeling op de brug"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug.dwarseIndelingOpBrug>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totale lengte brug"@nl;
    rdfs:comment "Horizontaal geprojecteerde oppervlakte van de bovenbouw. Bij constante breedte berekend als de totale lengte van de brug (gemeten volgens de bovenliggende weg) vermenigvuldigd met de totale breedte, uitgedrukt in vierkante meter. Indien de lengte of breedte variabel is, of bij niet-rechthoekige vormen, wordt de oppervlakte van de ingetekende omschreven polygoon van de constructie gebruikt. Bij beschikbaarheid van een polygoon heeft deze methode de voorkeur."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#Brug.TotaleLengteBrug>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Horizontaal geprojecteerde oppervlakte van de bovenbouw. Bij constante breedte berekend als de totale lengte van de brug (gemeten volgens de bovenliggende weg) vermenigvuldigd met de totale breedte, uitgedrukt in vierkante meter. Indien de lengte of breedte variabel is, of bij niet-rechthoekige vormen, wordt de oppervlakte van de ingetekende omschreven polygoon van de constructie gebruikt. Bij beschikbaarheid van een polygoon heeft deze methode de voorkeur."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "totale lengte brug"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug.totaleLengteBrug>
  ], [
    a shacl:PropertyShape;
    rdfs:label "totale breedte brug"@nl;
    rdfs:comment "Totale breedte van de bovenbouw, gemeten loodrecht op de lengteas van de bovenliggende weg, tussen de uiterste grens van de constructie, uitgedrukt in meter. Indien de breedte van de constructie variabel is (bv. trapeziumvormige brug, boog die uitwaaiert), wordt de gemiddelde breedte van de constructie genomen — d.w.z. de gemiddelde breedte van de dwarsprofielen gemeten loodrecht op de bovenliggende weg."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#Brug.TotaleBreedteBrug>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Totale breedte van de bovenbouw, gemeten loodrecht op de lengteas van de bovenliggende weg, tussen de uiterste grens van de constructie, uitgedrukt in meter. Indien de breedte van de constructie variabel is (bv. trapeziumvormige brug, boog die uitwaaiert), wordt de gemiddelde breedte van de constructie genomen — d.w.z. de gemiddelde breedte van de dwarsprofielen gemeten loodrecht op de bovenliggende weg."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "totale breedte brug"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug.totaleBreedteBrug>
  ], [
