<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheiderShape> a shacl:NodeShape;
  rdfs:label "KWS Afscheider"@nl;
  <http://purl.org/vocab/vann/usageNote> "Gebruik deze klasse voor een afzonderlijk geproduceerd, geplaatst en vervangbaar toestel. Een afscheidende functie die integraal deel uitmaakt van de Kamer wordt geregistreerd via het attribuut heeftOlieAfscheidendeKamer van de Kamer."@nl;
  rdfs:comment "Een toestel in een afwaterings- of rioleringsstelsel dat niet met water mengbare lichte vloeistoffen van minerale oorsprong, zoals olie en brandstoffen, door zwaartekracht en eventueel met behulp van coalescentie uit afval- of afstromend water afscheidt en tijdelijk vasthoudt vóór verdere afvoer."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheider>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "materiaal kuip KWS afscheider"@nl;
    rdfs:comment "Het hoofdmateriaal waaruit de vloeistofdichte kuip van de KWS-afscheider is vervaardigd."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheider.MateriaalKuipKWSAfscheider>;
    shacl:description "Het hoofdmateriaal waaruit de vloeistofdichte kuip van de KWS-afscheider is vervaardigd."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "materiaal kuip KWS afscheider"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#KWSAfscheider.materiaalKuip>
  ], [
    a shacl:PropertyShape;
    rdfs:label "nominaal debiet"@nl;
    rdfs:comment "Het door de fabrikant opgegeven debiet dat de KWS-afscheider onder nominale ontwerpcondities kan behandelen met behoud van de vooropgestelde afscheidingsprestatie."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheider.NominaalDebiet>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInKubiekeMeterPerSeconde>;
    shacl:description "Het door de fabrikant opgegeven debiet dat de KWS-afscheider onder nominale ontwerpcondities kan behandelen met behoud van de vooropgestelde afscheidingsprestatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "nominaal debiet"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#KWSAfscheider.nominaalDebiet>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft coalescentiefilter"@nl;
    rdfs:comment "Geeft aan of de KWS-afscheider een voorziening bevat die fijne druppels koolwaterstoffen laat samenvloeien tot grotere druppels om hun afscheiding uit het water te bevorderen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheider.HeeftCoalescentiefilter>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of de KWS-afscheider een voorziening bevat die fijne druppels koolwaterstoffen laat samenvloeien tot grotere druppels om hun afscheiding uit het water te bevorderen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft coalescentiefilter"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#KWSAfscheider.heeftCoalescentiefilter>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft geintegreerde slibvanger"@nl;
    rdfs:comment "Geeft aan of de KWS-afscheider een geïntegreerd compartiment bevat voor het afscheiden en tijdelijk opslaan van bezinkbare stoffen, zoals zand en slib."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/afwatering-kunstwerken/ontwerpdocument/DEV#KWSAfscheider.HeeftGeintegreerdeSlibvanger>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of de KWS-afscheider een geïntegreerd compartiment bevat voor het afscheiden en tijdelijk opslaan van bezinkbare stoffen, zoals zand en slib."@nl;
