      "description": "Object type (klasse StralendeKabel)",
      "pattern": "^StralendeKabel$"
    },
    "frequentierange": {
      "$ref": "#/components/schemas/Frequentierange"
    },
    "kabeldikte": {
      "$ref": "#/components/schemas/Kabeldikte"
    },
    "frequentiebereik": {
