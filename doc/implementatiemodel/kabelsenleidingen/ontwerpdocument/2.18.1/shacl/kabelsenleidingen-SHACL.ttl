    shacl:path <https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voedingskabel.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aantal aders en sectie"@nl;
    rdfs:comment "Aantal en sectie van de ader(s) van de kabel volgens een lijst van voorkomende types."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#Voedingskabel.AantalAdersEnSectie>;
