<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#AanhorighedenBrugShape> a shacl:NodeShape;
  rdfs:label "Aanhorigheden brug"@nl;
  rdfs:comment "Een bundeling van aanhorigheden die bij een brug kunnen horen."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorighedenBrug> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#AanhorighedenKokerShape> a shacl:NodeShape;
  rdfs:label "Aanhorigheden koker"@nl;
  rdfs:comment "Een abstracte klasse die de aanhorigheden bundelt die in een koker kunnen voorkomen zodat de overerving van de bevestigingsrelatie kan plaatsvinden."@nl;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#AanhorigheidKoker> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#AansluitstukMateriaalShape> a shacl:NodeShape;
  rdfs:label "Aansluitstuk materiaal"@nl;
  rdfs:comment "Het materiaal van het aansluitstuk."@nl;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#AbstracteAanvullendeGeometrieShape> a shacl:NodeShape;
  rdfs:label "Abstracte aanvullende geometrie"@nl;
  rdfs:comment "Abstracte om de eigenschappen en relaties van AanvullendeGeometrie te bundelen."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
