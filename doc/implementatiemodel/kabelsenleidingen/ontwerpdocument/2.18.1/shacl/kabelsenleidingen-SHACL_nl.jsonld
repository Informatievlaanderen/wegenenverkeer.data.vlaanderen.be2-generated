        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kabelkoker"
      }
    ]
  },
  {
    "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/2.18.1#KabelladderShape",
