<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#SignaalkabelShape> a shacl:NodeShape;
  rdfs:label "Signaalkabel"@nl;
  <http://purl.org/vocab/vann/usageNote> "De kabel zorgt primair voor de uitwisseling van digitale en analoge stuursignalen tussen twee onderdelen, bv. tussen een sensor en een verwerkingseenheid. De sturing verloopt in principe via lagere spanning. In voorkomende gevallen kan die ook met gewone netspanning gebeuren om de gekoppelde techniek van stroom te voorzien. De sturing primeert evenwel op het loutere transport van spanning en vermogen."@nl;
  rdfs:comment "Kabel die primair zorgt voor het uitwisselen van digitale en analoge stuursignalen."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#Signaalkabel>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "type"@nl;
    rdfs:comment "Geeft aan wat voor stuurkabel gebruikt wordt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#Signaalkabel.Type>;
    shacl:description "Geeft aan wat voor stuurkabel gebruikt wordt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Signaalkabel.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aders specificatie"@nl;
    rdfs:comment "Aantal en sectie van de ader(s) in de signalisatiekabel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#Signaalkabel.AdersSpecificatie>;
    shacl:description "Aantal en sectie van de ader(s) in de signalisatiekabel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aders specificatie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Signaalkabel.aantalAdersEnSectie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type specificatie"@nl;
    rdfs:comment "Een verdere specificatie van het type van de signalisatiekabel volgens een vaste lijst om bv. de brandklasse mee te geven."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#Signaalkabel.TypeSpecificatie>;
    shacl:description "Een verdere specificatie van het type van de signalisatiekabel volgens een vaste lijst om bv. de brandklasse mee te geven."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type specificatie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Signaalkabel.typeSpecificatie>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Signaalkabel> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#SluitAanOpShape> a shacl:NodeShape;
  rdfs:label "Sluit aan op"@nl;
  rdfs:comment "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/kabelsenleidingen/ontwerpdocument/DEV#SluitAanOp>;
