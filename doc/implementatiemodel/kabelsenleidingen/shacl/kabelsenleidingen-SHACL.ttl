    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "afdichting"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kabelleidingdoorvoer.afdichting>
  ], [
