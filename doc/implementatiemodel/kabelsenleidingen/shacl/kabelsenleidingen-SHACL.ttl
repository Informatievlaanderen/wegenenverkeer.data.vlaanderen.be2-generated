    shacl:description "Het verschil tussen de laagste en hoogste frequentie waarop het signaal effectief werkt. Dit bereik wordt uitgedrukt in megahertz (MHz)."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "frequentiebereik"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#StralendeKabel.frequentiebereik>
  ], [
