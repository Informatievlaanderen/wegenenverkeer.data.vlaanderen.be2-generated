    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "bewakingstijd"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Detectielus.bewakingstijd>
  ], [
