    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "oriëntatie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kabelleidingdoorvoer.orientatie>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kabelleidingdoorvoer> .

