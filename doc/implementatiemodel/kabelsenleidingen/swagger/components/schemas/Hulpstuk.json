{
  "title": "Hulpstuk",
  "type": "object",
  "description": "Stukken die zorgen voor verbindingen tussen buizen en/of leidingen om bv. van richting te veranderen,te verlengen,te verlopen van diameter,meerdere buizen op mekaar aan te sluiten,...",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Hulpstuk)",
      "pattern": "^Hulpstuk$"
    },
    "type": {
      "$ref": "#/components/schemas/HulpstukType"
    },
    "inwendigeDiameter": {
      "type": "array",
      "description": "Lijst van KwantitatieveWaardeInMillimeter items.",
      "items": {
        "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
      },
      "minItems": 1
    },
    "materiaal": {
      "$ref": "#/components/schemas/AansluitstukMateriaal"
    },
    "uitwendigeDiameter": {
      "type": "array",
      "description": "Lijst van KwantitatieveWaardeInMillimeter items.",
      "items": {
        "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
      },
      "minItems": 1
    },
    "technischeFiche": {
      "type": "array",
      "description": "Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    }
  },
  "required": [
    "@type",
    "type",
    "inwendigeDiameter",
    "materiaal",
    "uitwendigeDiameter",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "asset-Versie",
    "isActief",
    "aIM-Toestand"
  ]
}