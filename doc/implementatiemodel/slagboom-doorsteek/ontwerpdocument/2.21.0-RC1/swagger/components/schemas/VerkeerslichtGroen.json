{
  "title": "VerkeerslichtGroen",
  "type": "object",
  "description": "Een lichtbron met groene kleur om de weggebruikers aan te geven dat het verkeerslicht mag voorbijgereden worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VerkeerslichtGroen)",
      "pattern": "^VerkeerslichtGroen$"
    },
    "vermogen": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInWatt"
    },
    "masker": {
      "$ref": "#/components/schemas/VerkeerslichtMasker"
    },
    "merk": {
      "$ref": "#/components/schemas/VerkeerslichtMerk"
    },
    "modelnaam": {
      "$ref": "#/components/schemas/VerkeerslichtModelnaam"
    },
    "naam": {
      "$ref": "#/components/schemas/VerkeerslichtGroen.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/VerkeerslichtGroen.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VerkeerslichtGroen.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/VerkeerslichtGroen.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VerkeerslichtGroen.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/VerkeerslichtGroen.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/VerkeerslichtGroen.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "vermogen",
    "masker",
    "merk",
    "modelnaam",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}