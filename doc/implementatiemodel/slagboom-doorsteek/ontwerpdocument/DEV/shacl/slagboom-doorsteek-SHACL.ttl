    rdfs:comment "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#AIMObject.DatumOprichtingObject>;
