    shacl:description "Vermogen (Watt) van het verkeerslicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vermogen"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeerslicht.vermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "masker"@nl;
    rdfs:comment "Type masker dat is aangebracht op het verkeerslicht."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#Verkeerslicht.Masker>;
    shacl:description "Type masker dat is aangebracht op het verkeerslicht."@nl;
    shacl:maxCount 1;
