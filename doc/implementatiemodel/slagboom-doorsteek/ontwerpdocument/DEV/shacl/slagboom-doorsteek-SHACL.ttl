    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "afmetingen b l"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Detectielus.afmetingenBL>
  ];
