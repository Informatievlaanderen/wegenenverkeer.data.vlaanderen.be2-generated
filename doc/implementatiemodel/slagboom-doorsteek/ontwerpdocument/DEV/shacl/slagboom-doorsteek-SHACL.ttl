<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#VerkeerslichtShape> a shacl:NodeShape;
  rdfs:label "Verkeerslicht"@nl;
  rdfs:comment "Abstracte voor verkeerslichten. Dit zijn apparaten, opgesteld naast of boven de weg, om weggebruikers visueel te geleiden over een kruispunt door het gebruik van rode, oranje-gele en groene lichten. De bepalingen van de wegcode zijn van toepassing, meer bepaald titel III, hoofdstuk I, artikelen 61 t.e.m. 64."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#Verkeerslicht>;
  shacl:closed false;
