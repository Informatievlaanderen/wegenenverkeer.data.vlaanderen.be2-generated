<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#DetectielussenShape> a shacl:NodeShape;
  rdfs:label "Detectielussen"@nl;
  rdfs:comment "Abstracte voor een detectielus. Een detectielus is een kabel onder het wegdek die in staat is om voertuigen te detecteren teneinde de verkeersregelaar aan te sturen. Selectieve lussen zijn in staat om gecodeerde informatie door te geven van prioritaire voertuigen, niet-selectieve lussen geven informatie door van alle voertuigen die het detectie gebied passeren."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/slagboom-doorsteek/ontwerpdocument/DEV#Detectielussen>;
  shacl:closed false;
