    },
    "asset-IdBron-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdDoel-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "typeURI": {
      "$ref": "#/components/schemas/HeeftBijlage.typeURI"
    },
    "isActief": {
      "$ref": "#/components/schemas/HeeftBijlage.isActief"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "asset-Id",
    "asset-IdBron-Asset",
    "asset-IdDoel-Asset",
