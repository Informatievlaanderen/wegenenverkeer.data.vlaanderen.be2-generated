{
  "title": "Omhult",
  "type": "object",
  "description": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Omhult)",
      "pattern": "^Omhult$"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdBron-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdDoel-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "typeURI": {
      "$ref": "#/components/schemas/Omhult.typeURI"
    },
    "isActief": {
      "$ref": "#/components/schemas/Omhult.isActief"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "asset-Id",
    "asset-IdBron-Asset",
    "asset-IdDoel-Asset",
    "typeURI",
    "isActief",
    "asset-Versie"
  ]
}