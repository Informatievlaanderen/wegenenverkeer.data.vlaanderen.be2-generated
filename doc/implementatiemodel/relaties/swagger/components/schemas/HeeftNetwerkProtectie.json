      "pattern": "^HeeftNetwerkProtectie$"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdBron-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdDoel-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "asset-Id",
    "asset-IdBron-Asset",
    "asset-IdDoel-Asset",
    "typeURI",
    "isActief",
    "asset-Versie"
