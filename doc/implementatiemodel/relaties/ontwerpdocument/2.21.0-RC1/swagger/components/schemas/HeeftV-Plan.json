{
  "title": "HeeftV-Plan",
  "type": "object",
  "description": "Deze relatie duidt aan welke V plannen gekoppeld zijn aan een verkeersregelinstallatie en/of ITSapp, met aanduiding van de periode waarin deze koppeling geldig is via een indienstdatum en uitdienstdatum.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse HeeftV-Plan)",
      "pattern": "^HeeftV-Plan$"
    },
    "dienstdatum": {
      "type": "array",
      "description": "De datum(s) waarop een V-plan indienst of uitdienst werd genomen. Lijst van DienstdatumV-Plan items.",
      "items": {
        "$ref": "#/components/schemas/DienstdatumV-Plan"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdBron-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "asset-IdDoel-Asset": {
      "$ref": "#/components/schemas/Identificator"
    },
    "typeURI": {
      "$ref": "#/components/schemas/HeeftV-Plan.typeURI"
    },
    "isActief": {
      "$ref": "#/components/schemas/HeeftV-Plan.isActief"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "dienstdatum",
    "asset-Id",
    "asset-IdBron-Asset",
    "asset-IdDoel-Asset",
    "typeURI",
    "isActief",
    "asset-Versie"
  ]
}