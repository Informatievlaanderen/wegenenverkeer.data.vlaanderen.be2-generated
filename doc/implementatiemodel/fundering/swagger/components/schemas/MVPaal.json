{
  "title": "MVPaal",
  "type": "object",
  "description": "Grondverdringende stalen paal met een inwendige en/of uitwendige injectie met grout-specie. Ze wordt vervaardigd door het heien van een stalen profiel/buis in de bodem onder gelijktijdig injecteren van een groutmengsel.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse MVPaal)",
      "pattern": "^MVPaal$"
    },
    "volumeCementgrout": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKubiekeMeterPerUur"
    },
    "technischeFicheMVPaal": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "afkap-OfBovenpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "dwarsafmetingen": {
      "$ref": "#/components/schemas/Dwarsafmetingen"
    },
    "paallengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "hellings-OfSchoorhoek": {
      "$ref": "#/components/schemas/Hellings-OfSchoorhoek"
    },
    "aanzetpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "naam": {
      "$ref": "#/components/schemas/MVPaal.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/MVPaal.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/MVPaal.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/MVPaal.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/MVPaal.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/MVPaal.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/MVPaal.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "drukdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "drukdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "ontwerpnota": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    }
  },
  "required": [
    "@type",
    "volumeCementgrout",
    "technischeFicheMVPaal",
    "afkap-OfBovenpeil",
    "dwarsafmetingen",
    "paallengte",
    "hellings-OfSchoorhoek",
    "aanzetpeil",
    "hoogte",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie",
    "drukdraagvermogenInUitersteGrenstoestand",
    "drukdraagvermogenInGebruiksgrenstoestanden",
    "trekdraagvermogenInUitersteGrenstoestand",
    "trekdraagvermogenInGebruiksgrenstoestanden",
    "ontwerpnota"
  ]
}