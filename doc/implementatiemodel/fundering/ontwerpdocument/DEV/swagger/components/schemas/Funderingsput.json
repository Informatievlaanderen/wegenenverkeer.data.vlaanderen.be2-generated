{
  "title": "Funderingsput",
  "type": "object",
  "description": "Funderingstype dat gebruikt wordt als goede funderingsgrond zich op betrekkelijke diepte bevindt. Gemaakt door putten te graven en deze met wapening en beton te vullen op de juiste diepte.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Funderingsput)",
      "pattern": "^Funderingsput$"
    },
    "typePut": {
      "$ref": "#/components/schemas/TypePut"
    },
    "grondvlakafmeting": {
      "$ref": "#/components/schemas/AfmetingGrondvlak"
    },
    "funderingshoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "betonspecificaties": {
      "$ref": "#/components/schemas/Betonspecificaties"
    },
    "wapeningsplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "uitvoeringsmethode": {
      "$ref": "#/components/schemas/Uitvoeringsmethode"
    },
    "bekistingsplan": {
      "type": "array",
      "description": "Een plan die bekistingsmaten bevat en ook alle maten van alle mogelijke uitsparingen die er kunnen zijn. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "technischeFicheBetonbescherming": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aanzetpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Funderingsput.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Funderingsput.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Funderingsput.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Funderingsput.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Funderingsput.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Funderingsput.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Funderingsput.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    },
    "drukdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "drukdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "ontwerpnota": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    }
  },
  "required": [
    "@type",
    "typePut",
    "grondvlakafmeting",
    "funderingshoogte",
    "betonspecificaties",
    "wapeningsplan",
