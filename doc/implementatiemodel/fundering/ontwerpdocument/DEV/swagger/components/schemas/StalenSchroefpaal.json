{
  "title": "StalenSchroefpaal",
  "type": "object",
  "description": "Stalen paal met een stalen schacht die is voorzien van een spiraalvormige schroefdraad aan het uiteinde. Deze schroefdraad zorgt ervoor dat deze stevig in de grond vast komt te zitten, zonder dat er traditionele graaf- of betonwerkzaamheden nodig zijn.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse StalenSchroefpaal)",
      "pattern": "^StalenSchroefpaal$"
    },
    "hoogteBovenHetMaaiveld": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "staalspecificaties": {
      "$ref": "#/components/schemas/Staalspecificaties"
    },
    "buitendiameter": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "paallengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "technischeFiche": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aanzetpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "naam": {
      "$ref": "#/components/schemas/StalenSchroefpaal.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/StalenSchroefpaal.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/StalenSchroefpaal.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/StalenSchroefpaal.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/StalenSchroefpaal.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/StalenSchroefpaal.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/StalenSchroefpaal.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
