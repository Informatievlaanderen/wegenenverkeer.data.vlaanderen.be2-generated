{
  "title": "Funderingszool",
  "type": "object",
  "description": "Structuur van voldoende stijfheid om de belastingen van de bovenbouw op te nemen en over te dragen naar andere funderingselementen (bv. palen). Als het gaat over een funderingszool die de belastingen naar de grond overdraagt (fundering op staal), dan moet 'Fundering op staal' gebruikt worden.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Funderingszool)",
      "pattern": "^Funderingszool$"
    },
    "volume": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKubiekeMeter"
    },
    "zoolhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "heeftVariabeleDikte": {
      "$ref": "#/components/schemas/Funderingszool.heeftVariabeleDikte"
    },
    "betonspecificaties": {
      "$ref": "#/components/schemas/Betonspecificaties"
    },
    "wapeningsplan": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "uitvoeringsmethode": {
      "$ref": "#/components/schemas/Uitvoeringsmethode"
    },
    "bekistingsplan": {
      "type": "array",
      "description": "Een plan die bekistingsmaten bevat en ook alle maten van alle mogelijke uitsparingen die er kunnen zijn. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "technischeFicheBetonbescherming": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "aanzetpeil": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeterTAW"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "naam": {
      "$ref": "#/components/schemas/Funderingszool.naam"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Funderingszool.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Funderingszool.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Funderingszool.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Funderingszool.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Funderingszool.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Funderingszool.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "volume",
    "zoolhoogte",
    "heeftVariabeleDikte",
    "betonspecificaties",
    "wapeningsplan",
    "uitvoeringsmethode",
    "bekistingsplan",
    "technischeFicheBetonbescherming",
    "aanzetpeil",
    "hoogte",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}