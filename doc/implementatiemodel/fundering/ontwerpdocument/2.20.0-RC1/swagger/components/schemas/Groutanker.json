    },
    "isActiefAnker": {
      "type": "object",
      "description": "Geeft aan of het anker actief (voorgespannen) of passief (niet voorgespannen) is.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "typeGrondanker": {
      "$ref": "#/components/schemas/TypeGrondanker"
    },
    "aanvaardingsdocument": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "drukdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "drukdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInUitersteGrenstoestand": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "trekdraagvermogenInGebruiksgrenstoestanden": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKN"
    },
    "ontwerpnota": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    }
  },
  "required": [
