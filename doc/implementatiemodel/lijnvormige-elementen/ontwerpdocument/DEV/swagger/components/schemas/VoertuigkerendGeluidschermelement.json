{
  "title": "VoertuigkerendGeluidschermelement",
  "type": "object",
  "description": "Dit zijn schermelementen met een voet in de vorm van een T. Op de voet worden deltablocs geplaatst die een stabiliserende en voertuigkerende functie hebben.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VoertuigkerendGeluidschermelement)",
      "pattern": "^VoertuigkerendGeluidschermelement$"
    },
    "werkingsbreedte": {
      "$ref": "#/components/schemas/Werkingsbreedte"
    },
    "videoVoertuigkering": {
      "type": "array",
      "description": "Video-opname van de crashtesten op de voertuigkerende constructie. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "testrapportVoertuigkering": {
      "type": "array",
      "description": "De testresultaten van de crashtesten die op de voertuigkerende constructie uitgevoerd zijn. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "kerendVermogen": {
      "$ref": "#/components/schemas/KerendVermogen"
    },
    "voertuigOverhelling": {
      "$ref": "#/components/schemas/VoertuigOverhelling"
    },
    "schokindex": {
      "$ref": "#/components/schemas/Schokindex"
    },
    "maximaleTotaleDikte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "windbelasting": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKNPerVierkanteMeter"
    },
    "materiaalkarakteristiek": {
      "$ref": "#/components/schemas/MateriaalKarakteristiek"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "hoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van het lijnvormig element. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/VoertuigkerendGeluidschermelement.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "werkingsbreedte",
    "videoVoertuigkering",
    "testrapportVoertuigkering",
    "kerendVermogen",
    "voertuigOverhelling",
    "schokindex",
    "maximaleTotaleDikte",
    "windbelasting",
    "materiaalkarakteristiek",
    "lengte",
    "hoogte",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}