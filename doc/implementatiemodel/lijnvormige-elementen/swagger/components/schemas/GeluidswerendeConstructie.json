{
  "title": "GeluidswerendeConstructie",
  "type": "object",
  "description": "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse GeluidswerendeConstructie)",
      "pattern": "^GeluidswerendeConstructie$"
    },
    "schermtype": {
      "type": "array",
      "description": "Lijst van Schermtype items.",
      "items": {
        "$ref": "#/components/schemas/Schermtype"
      },
      "minItems": 1
    },
    "totaleLengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "schermelement": {
      "type": "array",
      "description": "Lijst van SchermelementType items.",
      "items": {
        "$ref": "#/components/schemas/SchermelementType"
      },
      "minItems": 1
    },
    "windbelasting": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKNPerVierkanteMeter"
    },
    "kleur": {
      "$ref": "#/components/schemas/RAL-Kleur"
    },
    "materiaalKarakteristiek": {
      "type": "array",
      "description": "Lijst van MateriaalKarakteristiek items.",
      "items": {
        "$ref": "#/components/schemas/MateriaalKarakteristiek"
      },
      "minItems": 1
    },
    "statischeBelasting": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKNPerVierkanteMeter"
    },
    "heeftAfdeklatten": {
      "type": "object",
      "description": "Bepaling of er boven- of onderaan latten gebruikt worden om de geluidswerende constructie te laten aansluiten op de tunnel. Klasse uit gebruik sinds versie 2.0.0-RC3",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "individueleLengteSchermelement": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "overzichtSchermhoogte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "detailplan(3D-As-Built)": {
      "$ref": "#/components/schemas/Bestandsbijlage"
    },
    "opstelling": {
      "$ref": "#/components/schemas/Opstelling"
    },
    "totaleOppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "individueleHoogteSchermelement": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "isBeginOfEindconstructie": {
      "type": "object",
      "description": "Bepaling of het gaat om een begin- of eindconstructie. Klasse uit gebruik sinds versie 2.0.0-RC3",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "maximaleDikteSchermelement": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInCentimeter"
    },
    "horizontaalRuimteBeslag": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMeter"
    },
    "videoVoertuigkering": {
      "type": "array",
      "description": "Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "testrapport": {
      "type": "array",
      "description": "Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "technischeFiche": {
      "type": "array",
      "description": "Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "schermtype",
    "totaleLengte",
    "schermelement",
    "windbelasting",
    "kleur",
    "materiaalKarakteristiek",
    "statischeBelasting",
    "heeftAfdeklatten",
    "individueleLengteSchermelement",
    "overzichtSchermhoogte",
    "detailplan(3D-As-Built)",
    "opstelling",
    "totaleOppervlakte",
    "individueleHoogteSchermelement",
    "isBeginOfEindconstructie",
    "maximaleDikteSchermelement",
    "horizontaalRuimteBeslag",
    "videoVoertuigkering",
    "testrapport",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}