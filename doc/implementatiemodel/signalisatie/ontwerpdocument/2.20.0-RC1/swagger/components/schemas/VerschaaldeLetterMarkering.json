{
  "title": "VerschaaldeLetterMarkering",
  "type": "object",
  "description": "Een markering bestaande uit letters die een verschaling ondergaat zoals een vergroting en/of een verkleining.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse VerschaaldeLetterMarkering)",
      "pattern": "^VerschaaldeLetterMarkering$"
    },
    "letter": {
      "$ref": "#/components/schemas/LetterVerschaald"
    },
    "oppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "type": {
      "$ref": "#/components/schemas/TypeVanDeVerschaaldeLetter"
    },
    "vergrotingsfactor": {
      "type": "object",
      "description": "Een decimaal getal dat weergeeft in welke mate de figuratiemarkering vergroot of verkleind wordt.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "basisoppervlakte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInVierkanteMeter"
    },
    "verlengingsfactor": {
      "type": "object",
      "description": "Een decimaal getal dat de verlenging van een figuratiemarkering weergeeft.",
      "properties": {
        "@value": {
          "type": "string",
          "pattern": "(+|-)?([0-9]+(.[0-9]*)?|.[0-9]+)"
        },
        "@type": {
          "type": "string",
          "pattern": "^Decimal$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isGoedgekeurd": {
      "type": "object",
      "description": "Bepaling van de goedkeuring van AOWS.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "versieGoedgekeurd": {
      "type": "object",
      "description": "De versie van het standaardbestek 250 waar de goedkeuring is bepaald.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "markeringsysteemCOPRO": {
      "$ref": "#/components/schemas/Productidentificatiecode"
    },
    "opvatting": {
      "$ref": "#/components/schemas/MarkeringOpvatting"
    },
    "markeringsoort": {
      "$ref": "#/components/schemas/SoortMarkeringsproduct"
    },
    "isTijdelijk": {
      "type": "object",
      "description": "Aanduiding of de wegmarkering al dan niet tot de werfsignalisatie behoort.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "technischeFiche": {
      "type": "array",
      "description": "Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "isHandwerk": {
      "type": "object",
      "description": "Boolean om te bepalen of de markering machinaal of handmatig is aangebracht.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "markeringssysteem": {
      "$ref": "#/components/schemas/Markeringssysteem"
    },
    "kleur": {
      "$ref": "#/components/schemas/KleurMarkering"
    },
    "markeringsproduct": {
      "$ref": "#/components/schemas/Markeringsproduct"
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "type": "object",
      "description": "Extra notitie voor het object.",
      "properties": {
        "@value": {
          "type": "string"
        }
      },
      "required": [
        "@value"
      ]
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "typeURI": {
      "type": "object",
      "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
      "properties": {
        "@id": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "@id"
      ]
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Lijst van String items.",
      "items": {
        "type": "object",
        "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
        "properties": {
          "@value": {
            "type": "string"
          }
        },
        "required": [
          "@value"
        ]
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "type": "object",
      "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
      "properties": {
        "@value": {
          "type": "string",
          "format": "date"
        },
        "@type": {
          "type": "string",
          "pattern": "^Date$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "isActief": {
      "type": "object",
      "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
      "properties": {
        "@value": {
          "type": "boolean"
        },
        "@type": {
          "type": "string",
          "pattern": "^Boolean$"
        }
      },
      "required": [
        "@value",
        "@type"
      ]
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "letter",
    "oppervlakte",
    "type",
    "vergrotingsfactor",
    "basisoppervlakte",
    "verlengingsfactor",
    "isGoedgekeurd",
    "versieGoedgekeurd",
    "markeringsysteemCOPRO",
    "opvatting",
    "markeringsoort",
    "isTijdelijk",
    "technischeFiche",
    "isHandwerk",
    "markeringssysteem",
    "kleur",
    "markeringsproduct",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}