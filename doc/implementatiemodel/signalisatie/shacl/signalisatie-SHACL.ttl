    rdfs:label "hoek"@nl;
    <http://purl.org/vocab/vann/usageNote> "hoek"@nl;
    rdfs:comment "De hoek waarin het fysiek bord gepositioneerd is ten opzichte van een vooropgestelde as."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/signalisatie/ontwerpdocument/DEV#AanzichtVerkeersbordopstelling.Hoek>;
    shacl:class xsd:decimal;
    shacl:description "De hoek waarin het fysiek bord gepositioneerd is ten opzichte van een vooropgestelde as."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hoek"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.hoek>
  ], [
    a shacl:PropertyShape;
    rdfs:label "foto"@nl;
