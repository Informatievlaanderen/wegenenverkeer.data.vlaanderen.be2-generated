{
  "openapi": "3.0.4",
  "info": {
    "title": "Components of OpenAPI",
    "description": "This",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "AIMToestand": {
        "title": "AIMToestand",
        "type": "object",
        "description": "Keuzelijst met fasen uit de levenscyclus van een object om de toestand op een moment mee vast te leggen.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse AIMToestand)",
            "pattern": "^AIMToestand$"
          }
        },
        "required": [
          "@type"
        ]
      },
      "Weguitrusting": {
        "title": "Weguitrusting",
        "type": "object",
        "description": "Generiek type om alles wat bij de weg hoort in onder te brengen.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Weguitrusting)",
            "pattern": "^Weguitrusting$"
          },
          "naampad": {
            "type": "object",
            "description": "Een set van objecten (bv. collecties) die aanduiden waar het object zich bevindt in de objectenboom (EM-Infra). Dient consistent te zijn met de naam.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "naam": {
            "type": "object",
            "description": "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt. Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "asset-Id": {
            "$ref": "#/components/schemas/Identificator"
          },
          "notitie": {
            "type": "object",
            "description": "Extra notitie voor het object.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "standaardbestekpostnummer": {
            "type": "array",
            "description": "Lijst van String items.",
            "items": {
              "type": "object",
              "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G.",
              "properties": {
                "@value": {
                  "type": "string"
                }
              },
              "required": [
                "@value"
              ]
            },
            "minItems": 1
          },
          "typeURI": {
            "type": "object",
            "description": "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI .",
            "properties": {
              "@id": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "@id"
            ]
          },
          "bestekpostnummer": {
            "type": "array",
            "description": "Lijst van String items.",
            "items": {
              "type": "object",
              "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek.",
              "properties": {
                "@value": {
                  "type": "string"
                }
              },
              "required": [
                "@value"
              ]
            },
            "minItems": 1
          },
          "theoretischeLevensduur": {
            "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
          },
          "datumOprichtingObject": {
            "type": "object",
            "description": "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg.",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date"
              },
              "@type": {
                "type": "string",
                "pattern": "^Date$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "isActief": {
            "type": "object",
            "description": "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem.",
            "properties": {
              "@value": {
                "type": "boolean"
              },
              "@type": {
                "type": "string",
                "pattern": "^Boolean$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "aIM-Toestand": {
            "$ref": "#/components/schemas/AIMToestand"
          },
          "asset-Versie": {
            "$ref": "#/components/schemas/AssetVersie"
          }
        },
        "required": [
          "@type",
          "naampad",
          "naam",
          "asset-Id",
          "notitie",
          "standaardbestekpostnummer",
          "typeURI",
          "bestekpostnummer",
          "theoretischeLevensduur",
          "datumOprichtingObject",
          "isActief",
          "aIM-Toestand",
          "asset-Versie"
        ]
      },
      "Identificator": {
        "title": "Identificator",
        "type": "object",
        "description": "Complex datatype voor de identificator van een AIM object volgens de bron van de identificator.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse Identificator)",
            "pattern": "^Identificator$"
          },
          "identificator": {
            "type": "object",
            "description": "Een groep van tekens om een AIM object te identificeren of te benoemen.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          },
          "toegekendDoor": {
            "type": "object",
            "description": "Gegevens van de organisatie die de toekenning deed.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          }
        },
        "required": [
          "@type",
          "identificator",
          "toegekendDoor"
        ]
      },
      "KwantitatieveWaardeInMaand": {
        "title": "KwantitatieveWaardeInMaand",
        "type": "object",
        "description": "Een kwantitatieve waarde die een getal in aantal maanden uitdrukt.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse KwantitatieveWaardeInMaand)",
            "pattern": "^KwantitatieveWaardeInMaand$"
          },
          "waarde": {
            "type": "object",
            "description": "Bevat een getal die bij het datatype hoort.",
            "properties": {
              "@value": {
                "type": "number",
                "format": "int64"
              },
              "@type": {
                "type": "string",
                "pattern": "^NonNegativeInteger$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "standaardEenheid": {
            "type": "object",
            "description": "De standaard eenheid bij dit datatype is uitgedrukt in maand. \"mo\"^^cdt:ucumunit",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          }
        },
        "required": [
          "@type",
          "waarde",
          "standaardEenheid"
        ]
      },
      "AssetVersie": {
        "title": "AssetVersie",
        "type": "object",
        "description": "Complex datatype voor de eigenschappen ten behoeve van de versionering van een asset in de databank.",
        "properties": {
          "@id": {
            "type": "string",
            "format": "uri"
          },
          "@type": {
            "type": "string",
            "description": "Object type (klasse AssetVersie)",
            "pattern": "^AssetVersie$"
          },
          "versienummer": {
            "type": "object",
            "description": "Het versienummer als een oplopende integer.",
            "properties": {
              "@value": {
                "type": "number",
                "format": "int64"
              },
              "@type": {
                "type": "string",
                "pattern": "^NonNegativeInteger$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "timestamp": {
            "type": "object",
            "description": "De timestamp van het moment dat de versienummer werd toegekend.",
            "properties": {
              "@value": {
                "type": "string",
                "format": "date-time"
              },
              "@type": {
                "type": "string",
                "pattern": "^DateTime$"
              }
            },
            "required": [
              "@value",
              "@type"
            ]
          },
          "context": {
            "type": "object",
            "description": "De context van de versie creatie.",
            "properties": {
              "@value": {
                "type": "string"
              }
            },
            "required": [
              "@value"
            ]
          }
        },
        "required": [
          "@type",
          "versienummer",
          "timestamp",
          "context"
        ]
      }
    },
    "links": {
      "Weguitrusting.asset-Id": {
        "operationId": "WeguitrustingGET",
        "parameters": {
          "id": "$response.body#/Weguitrusting.asset-Id/@id"
        },
        "description": "De waarde van het attribuut `@id` kan gebruikt worden om het gerefereerde object van het type `Identificator` op te halen."
      },
      "Weguitrusting.theoretischeLevensduur": {
        "operationId": "WeguitrustingGET",
        "parameters": {
          "id": "$response.body#/Weguitrusting.theoretischeLevensduur/@id"
        },
        "description": "De waarde van het attribuut `@id` kan gebruikt worden om het gerefereerde object van het type `KwantitatieveWaardeInMaand` op te halen."
      },
      "Weguitrusting.aIM-Toestand": {
        "operationId": "WeguitrustingGET",
        "parameters": {
          "id": "$response.body#/Weguitrusting.aIM-Toestand/@id"
        },
        "description": "De waarde van het attribuut `@id` kan gebruikt worden om het gerefereerde object van het type `AIMToestand` op te halen."
      },
      "Weguitrusting.asset-Versie": {
        "operationId": "WeguitrustingGET",
        "parameters": {
          "id": "$response.body#/Weguitrusting.asset-Versie/@id"
        },
        "description": "De waarde van het attribuut `@id` kan gebruikt worden om het gerefereerde object van het type `AssetVersie` op te halen."
      }
    }
  }
}