        "@value": "false"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging"
      }
    ]
  },
