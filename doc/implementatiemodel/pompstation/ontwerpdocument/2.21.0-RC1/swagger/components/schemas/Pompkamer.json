{
  "title": "Pompkamer",
  "type": "object",
  "description": "Elk volume,inclusief de bouwkundige elementen die dit volume bepalen,dat deel uitmaakt van het waterbouwkundig systeem van het pompstation en als zodanig onder water kan staan.",
  "properties": {
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "@type": {
      "type": "string",
      "description": "Object type (klasse Pompkamer)",
      "pattern": "^Pompkamer$"
    },
    "volume": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInKubiekeMeter"
    },
    "diepte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "reinigingsinterval": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "breedte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "isLuchtdichtAfgesloten": {
      "$ref": "#/components/schemas/Pompkamer.isLuchtdichtAfgesloten"
    },
    "isExplosiefVeilig": {
      "$ref": "#/components/schemas/Pompkamer.isExplosiefVeilig"
    },
    "lengte": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMillimeter"
    },
    "functie": {
      "$ref": "#/components/schemas/KamerFunctie"
    },
    "technischeFiche": {
      "type": "array",
      "description": "De technische fiche van de pompkamer. Bestanden van het type xlsx, dwg of pdf. Lijst van Bestandsbijlage items.",
      "items": {
        "$ref": "#/components/schemas/Bestandsbijlage"
      },
      "minItems": 1
    },
    "asset-Id": {
      "$ref": "#/components/schemas/Identificator"
    },
    "notitie": {
      "$ref": "#/components/schemas/Pompkamer.notitie"
    },
    "standaardbestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pompkamer.standaardbestekpostnummer"
      },
      "minItems": 1
    },
    "typeURI": {
      "$ref": "#/components/schemas/Pompkamer.typeURI"
    },
    "bestekpostnummer": {
      "type": "array",
      "description": "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt. Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek. Lijst van String items.",
      "items": {
        "$ref": "#/components/schemas/Pompkamer.bestekpostnummer"
      },
      "minItems": 1
    },
    "theoretischeLevensduur": {
      "$ref": "#/components/schemas/KwantitatieveWaardeInMaand"
    },
    "datumOprichtingObject": {
      "$ref": "#/components/schemas/Pompkamer.datumOprichtingObject"
    },
    "isActief": {
      "$ref": "#/components/schemas/Pompkamer.isActief"
    },
    "aIM-Toestand": {
      "$ref": "#/components/schemas/AIMToestand"
    },
    "asset-Versie": {
      "$ref": "#/components/schemas/AssetVersie"
    }
  },
  "required": [
    "@type",
    "volume",
    "diepte",
    "reinigingsinterval",
    "breedte",
    "isLuchtdichtAfgesloten",
    "isExplosiefVeilig",
    "lengte",
    "functie",
    "technischeFiche",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
    "isActief",
    "aIM-Toestand",
    "asset-Versie"
  ]
}