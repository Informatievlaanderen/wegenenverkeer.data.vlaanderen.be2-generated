    "aantalArmen",
    "armlengte",
    "bevestigingToestellen",
    "dwarsdoorsnede",
    "isDraaibaar",
    "leverancier",
    "masthoogte",
    "masttype",
    "rekennota",
    "elektrischeBeveiliging",
    "naampad",
    "naam",
    "asset-Id",
    "notitie",
    "standaardbestekpostnummer",
    "typeURI",
    "bestekpostnummer",
    "theoretischeLevensduur",
    "datumOprichtingObject",
