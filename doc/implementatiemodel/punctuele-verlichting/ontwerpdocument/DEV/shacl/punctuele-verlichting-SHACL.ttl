    rdfs:label "standaard methode"@nl;
    rdfs:comment "Bepaling van de standaardbevestigingen van verlichtingstoestellen aan lichtmasten."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/punctuele-verlichting/ontwerpdocument/DEV#BevestigingWegverlichtingstoestel.StandaardMethode>;
    shacl:description "Bepaling van de standaardbevestigingen van verlichtingstoestellen aan lichtmasten."@nl;
    shacl:maxCount 1;
    shacl:name "standaard methode"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtuWvLichtmastBevsToestelMethode.standaardMethode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "afwijkende methode"@nl;
    rdfs:comment "Tekstveld waarin de afwijkende methode van bevestiging van verlichtingstoestel aan lichtmast kan beschreven worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/punctuele-verlichting/ontwerpdocument/DEV#BevestigingWegverlichtingstoestel.AfwijkendeMethode>;
    shacl:class xsd:string;
    shacl:description "Tekstveld waarin de afwijkende methode van bevestiging van verlichtingstoestel aan lichtmast kan beschreven worden."@nl;
    shacl:maxCount 1;
    shacl:name "afwijkende methode"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtuWvLichtmastBevsToestelMethode.afwijkendeMethode>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtuWvLichtmastBevsToestelMethode> .

