      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MIVMeetpunt.afmetingen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "afmetingen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "afmetingen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De afmetingen van de lussen als lengte en breedte volgens een lijst van vaste afmetingen"
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De lengte van een lus wordt gemeten parallel aan de rijweg. De breedte dwars op de rijweg. Beide lussen van een MIV meetpunt moeten altijd dezelfde afmetingen hebben."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:022db730682c5f0e0c2c1a49a4a694765f8757ccc886bb3b3ac5b1ecb7a34b33"
