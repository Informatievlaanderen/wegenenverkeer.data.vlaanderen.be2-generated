        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c0909541e37ffb30996bff664249fc8c1a07ddde3e56af6d6a592d8ef2cc1f63",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#GewapendeGrond",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gewapende grond"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GewapendeGrond"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Grondkering waarbij constructieve elementen van staal of geotextiel/geogrid samenwerken met de grond en daaruit stabiliteit ontwikkelen. Gewapende grond is ook wel gekend als 'terre armée'."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        },
        {
          "@id": "urn:oslo-toolchain:98943e68f8bd6bd02157c1cb0a74cc705859db37fc926efa4299d26282ddc1d5"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:713c6e3b00ab075e46a56e7e759e60bb594fa17c79a09fa537491d27800b4f63",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gording",
