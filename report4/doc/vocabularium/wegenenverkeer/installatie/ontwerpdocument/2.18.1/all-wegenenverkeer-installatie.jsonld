    {
      "@id": "urn:oslo-toolchain:a87c3afa7e1dbe5457e1ce06e09be78a204f025ff59a9e99050e29fc02f29928",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Landhoofd",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Landhoofd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Landhoofd"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eindsteunpunt van een brug die de overgang vormt naar het achterliggend grondlichaam én als hoofdfunctie heeft de brug te ondersteunen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f53ff4eeb35af5b6b38ca6e88da9e26a3bcdee7bc8aa9489c78f775944599e1d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Boog",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Boog"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Boog"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gebogen overspanning (boven een opening), tussen twee steunpunten en ter ondersteuning van een brug, waarbij de druk (ook) zijdelings wordt afgevoerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6cd4a246a59d7e4d44b191d567fd62f99989372c7b6612b2c6e4a70c3de154ae",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Trekker",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Trekker"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Trekker"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een lineair mechanisch element, dubbelzijdig scharnierend, dat beoogd is om hoofdzakelijk op trek te belasten. Het verbindt, bijvoorbeeld, enerzijds het (bewegend) brugdeel/ beweegbare waterkerende constructie met anderzijds de lastzijde van de balansarm/bovenrolwagen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        },
        {
          "@id": "urn:oslo-toolchain:10f8946cee7e5e0c6e3ce3d0f80d3294cad8764d9c35f955953cf30ae849282b"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3ceaa0877d766d8ba2fec89785b45336c1e3f53929d338fa786e636b318506e7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Tegengewichtkist",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Tegengewichtskist"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Tegengewichtkist"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De tegengewichtkist is een stevige behuizing die deel uitmaakt van de macht-zijde van balans of een gebalanceerd, beweegbaar brugdeel. Vaak erdoor beschermd tegen nadelige atmosferische invloeden, is er massa (ballast) in ondergebracht om een (regelbaar) tegengewicht te bekomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6ce97ddc8df739e866d656f06eb5c6c2631a1fc652395d386b343b7043f6e514",
