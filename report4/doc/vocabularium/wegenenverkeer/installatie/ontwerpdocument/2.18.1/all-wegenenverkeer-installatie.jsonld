      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Koppelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Koppelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balk die delen van een constructie met elkaar verbindt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
