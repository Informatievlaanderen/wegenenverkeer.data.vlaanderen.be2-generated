    {
      "@id": "urn:oslo-toolchain:104818c2f308760eae5a04af566b02d716fb0a5cfab5e84941760ff4e56d808c",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hameistijl",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hameistijl"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hameistijl"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hameistijl is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. De verticale (kolom)structuur staat op de onderbouw, aan de scharnierzijde. Samen met een tweede hameistijl draagt het de balans die bovenaan scharnierend ermee verbonden is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:76a008db688bc38a3094573d732fe5dab97747ba29e4ee8d988d2b0d899f5d99",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vast tegengewicht materiaal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlVastTegengewichtMateriaal"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De mogelijke materialen van een vast tegengewicht."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlVastTegengewichtMateriaal",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7dfadf864707b658b13881e237f3b2722d260b2c79304b1360136e1297582b79",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balans",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Balans"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Balans"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8b64e356b8d0469c26cb3ca0d76072ac6b7277757e92dce20561f191c532746e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Hameipoort",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hameipoort"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hameipoort"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hameipoort is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Het is een portaalstructuur die staat op de onderbouw, aan de scharnierzijde. Het draagt bovenaan de volledige balans die er scharnierend ermee verbonden is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5db8722654677c924291670299befba8222265fe3eede5a0dabae3d7a3e5ce85",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Balansarm",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Balansarm"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Balansarm"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel van een balans. Er kunnen één of meerdere balansarmen aanwezig zijn. Het is typisch een lange, horizontale arm die aan lastzijde via een trekker verbonden is met het beweegbare brugdeel ('het val' of ook 'de klap') en aan machtzijde het gebruik van tegengewicht mogelijk maakt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:02dcd358e09eac7101fcb17bf12397c41d9b246abb7217832511c6f47c9f806e",
