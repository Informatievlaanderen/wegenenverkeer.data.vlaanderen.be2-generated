    {
      "@id": "urn:oslo-toolchain:0b5ebe7f22c0d344cf3e9182ef618500e42281582b8e7a24f4e32b32c1cde9af",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pijler",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Pijler"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Pijler"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een pijler is een steunpilaar die fungeert als vrijstaande drager en een steunpunt vormt tussen landhoofden voor de liggers of gewelven van een kunstwerk."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:cd861e16c878ec0f1f19e14b4919ef843ac44f5fe1d03119b58737cc806aed20",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VoorzieningNegatieveReactie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voorziening negatieve reactie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VoorzieningNegatieveReactie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voorziening om opwaartse reacties ter hoogte van de steunpunten tegen te gaan, bv. stalen staven. Dit element maakt de verbinding tussen brugdeel en landhoofd/pijler en bevindt zich in de onmiddellijke omgeving van de opleggingen. De oplegging (dit is een andere klasse) kan zowel druk als trek opnemen en kan ook gebruikt worden als een voorziening tegen negatieve reactie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        },
        {
          "@id": "urn:oslo-toolchain:b1fb52f1a9ed5d773beeb16af07f49b4283facda4f89e26ef0aed364f6ec3b9d"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:53cd25ea9ae014893c47012eb092cdea6980569c31666fb4f628b8a95ab59e75",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Brug",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brug"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brug"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een beweegbare, vaste of drijvende verbinding voor het verkeer tussen twee punten, die door water of iets anders gescheiden zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
