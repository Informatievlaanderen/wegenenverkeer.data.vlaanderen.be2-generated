        {
          "@language": "nl",
          "@value": "Gording"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gording"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balk of ligger(s) die is(zijn) aangebracht om de stabiliteit van verticale grondkerende elementen zoals damwanden, palen of berlinerwanden te waarborgen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:215e1279b54864b087fac90ddb1f65eeac044a877b388e38b4091f252cc39690"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8e5ffd6bb8d2a63f0ac022fb20fab976c614566773b1d9ddd5867326ab970027",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Gewichtsmuur",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gewichtsmuur"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gewichtsmuur"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kerende constructie die stabiliteit ontleent aan zijn eigen gewicht. Onder stabiliteit dient verstaan te worden: glijden, omkantelen en verticaal draagvermogen. De muur is (meestal) onderaan breder dan bovenaan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        },
        {
          "@id": "urn:oslo-toolchain:98943e68f8bd6bd02157c1cb0a74cc705859db37fc926efa4299d26282ddc1d5"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:79b7f893eb677e4cb1951f815cde50890938211e1ec6eed47892078aa596bf48",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Lmuur",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "L-muur"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lmuur"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Grond- en/of waterkerend betonnen element bedoeld om een niveauverschil in het maaiveld op te vangen met een teen of voet aan de basis waaraan het zijn stabiliteit ontleent."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
