    {
      "@id": "urn:oslo-toolchain:2290a268694d6b16595258152edf63c8d3b4633bf2fe8d7a236cc24ac5228981",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Berlinerwand",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Berlinerwand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Berlinerwand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een damwandconstructie, opgebouwd uit stalen H-profielen en (stalen)planken. De berlinerwand wordt vooral toegepast als grondkering bij bouwputten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
