        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Wordt gebruikt om bouwkundige constructies, zoals een puntdeur, draaideur of draaibrug, te geleiden. De geleiding omvat voornamelijk rotatie en soms ook translatie. Daarnaast vervult het een dragende functie met betrekking tot de sluisdeur."
        }
      ],
