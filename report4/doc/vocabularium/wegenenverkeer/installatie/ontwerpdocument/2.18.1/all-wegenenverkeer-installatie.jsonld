          "@language": "nl",
          "@value": "Dukdalf"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Dukdalf"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verticaal paal-element in het water of aan de waterkant, bedoeld om schepen op te vangen, af te weren of aan te meren. Dukdalven worden geplaatst om constructies te beschermen tegen schade door aanmerende of passerende schepen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
