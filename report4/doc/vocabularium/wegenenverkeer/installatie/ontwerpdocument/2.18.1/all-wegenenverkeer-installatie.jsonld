          "@id": "urn:oslo-toolchain:98943e68f8bd6bd02157c1cb0a74cc705859db37fc926efa4299d26282ddc1d5"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fc8b62a258e300c244e6f9392eb358a6b9aec22010b11a05c2e57d0452a44939",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenCaisson",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stalen caisson"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenCaisson"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit is een samengesteld element bestaande uit twee of meerdere warmgewalste stalen damplanken met Z- of U-vorm."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
