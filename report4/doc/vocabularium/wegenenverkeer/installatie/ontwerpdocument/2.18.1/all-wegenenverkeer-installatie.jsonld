    {
      "@id": "urn:oslo-toolchain:8b2704ba5d7b34f8d159a8dd8918b7fdb3fd371a144218c7b600a80062c83374",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verdeelbalk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verdeelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verdeelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een constructief element dat de belasting op een grondkerende constructie, zoals een damwand of beschoeiing, verdeelt naar meerdere ankerstaven of andere steunpunten. Het zorgt voor een gelijkmatige(re) spreiding van de belastingen op de constructie en vormt zo mee een essentieel onderdeel van de structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:215e1279b54864b087fac90ddb1f65eeac044a877b388e38b4091f252cc39690"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b48457f6398dbfb39880d77d8fab34a9dd4185d223a29d7d8e703fa955886188",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Dukdalf",
