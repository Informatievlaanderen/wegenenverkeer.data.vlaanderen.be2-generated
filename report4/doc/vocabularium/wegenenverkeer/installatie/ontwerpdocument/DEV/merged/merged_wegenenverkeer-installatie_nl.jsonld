          "@language": "nl",
          "@value": "totale breedte brug"
        }
      ],
      "diagramLabel": [
        {
          "@value": "totaleBreedteBrug"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Totale breedte van de bovenbouw, gemeten loodrecht op de lengteas van de bovenliggende weg, tussen de uiterste grens van de constructie, uitgedrukt in meter. Indien de breedte van de constructie variabel is (bv. trapeziumvormige brug, boog die uitwaaiert), wordt de gemiddelde breedte van de constructie genomen — d.w.z. de gemiddelde breedte van de dwarsprofielen gemeten loodrecht op de bovenliggende weg."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:f1892686a96bbc7e49f44710ebd1a89f47201df24500df9c99082f2eec79d9fd"
