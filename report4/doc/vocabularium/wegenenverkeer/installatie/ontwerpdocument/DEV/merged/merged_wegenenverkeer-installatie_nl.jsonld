      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een kokervormige constructie, die is bedoeld om wateren met elkaar te verbinden. Bij een duiker wordt in principe de bodem van de watergang onderbroken, dit in tegenstelling tot een brug."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
