        {
          "@language": "nl",
          "@value": "Grond- en/of waterkerend betonnen element bedoeld om een niveauverschil in het maaiveld op te vangen met een teen of voet aan de basis waaraan het zijn stabiliteit ontleent."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
