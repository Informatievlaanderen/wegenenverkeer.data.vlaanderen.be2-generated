        }
      ],
      "diagramLabel": [
        {
          "@value": "TijdelijkeBerlinerwandTussenschot"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het tussenschot (plaat of plank tussen profielen) voor een tijdelijke berlinerwand. Om een berlinerwand te definiëren die permanent in de grond blijft, moeten de specifieke (materiaal)onderdelen gebruikt worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
