        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:21c107608c534047f905c23eaa76c43f4994a6640d2ce443f066657c01a3d5f0",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug.totaleBreedteBrug",
