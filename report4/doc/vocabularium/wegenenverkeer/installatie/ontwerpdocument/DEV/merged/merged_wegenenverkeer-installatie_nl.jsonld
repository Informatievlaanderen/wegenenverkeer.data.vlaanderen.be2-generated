        }
      ],
      "diagramLabel": [
        {
          "@value": "Gronddam"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gronddammen zijn trapeziumvormige constructies bestaande uit zand, grond of steenachtige materialen. De onderkant van de gronddam wordt direct op het bestaand maaiveld aangebracht of op een vooraf aangebrachte grondverbetering. Een gronddam kan volgende functies vervullen: geluidswering, geleiding van dieren, veiligheid en lichtwering."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
