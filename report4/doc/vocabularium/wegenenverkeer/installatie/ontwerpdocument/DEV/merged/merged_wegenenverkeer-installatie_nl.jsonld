      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het geheel van twee bi-flashsteunen,seinlantaarns,retroreflecterende verkeersborden en hun aansluiting,beveiligingsapparatuur en sturing op een bepaalde locatie."
        }
      ],
