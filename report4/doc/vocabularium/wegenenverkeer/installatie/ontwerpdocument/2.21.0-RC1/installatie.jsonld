    {
      "@id": "urn:oslo-toolchain:23eaa057cea970cddd19080f0b15cd5581601cf6d186559d088beb854c961c04",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#VoorzieningNegatieveReactie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voorziening negatieve reactie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VoorzieningNegatieveReactie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voorziening om opwaartse reacties ter hoogte van de steunpunten tegen te gaan, bv. stalen staven. Dit element maakt de verbinding tussen brugdeel en landhoofd/pijler en bevindt zich in de onmiddellijke omgeving van de opleggingen. De oplegging (dit is een andere klasse) kan zowel druk als trek opnemen en kan ook gebruikt worden als een voorziening tegen negatieve reactie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
