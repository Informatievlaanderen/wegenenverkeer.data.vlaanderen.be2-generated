    {
      "@id": "urn:oslo-toolchain:ee7883de3840752a56eb87cff9e4561f03a21b3f5b3782368974760e2019ae2b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aanzicht verkeersbordopstelling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AanzichtVerkeersbordopstelling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aanzicht van een verkeersbordopstelling is de verzameling van één of meerdere verkeersborden en hun bijbehorende ondersteunende elementen,zoals palen en eventuele onderborden, zoals deze zichtbaar zijn vanuit een specifieke kijkhoek of positie in de verkeerssituatie. Het aanzicht biedt inzicht in de ruimtelijke indeling, plaatsing en zichtbaarheid van de verkeersborden ten opzichte van de weggebruikers."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Geometrie van AanzichtVerkeersbordopstelling heeft betrekking op de kaart voorstelling in de verkeersbordenapplicatie en heeft niets te maken met de fysieke positie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
