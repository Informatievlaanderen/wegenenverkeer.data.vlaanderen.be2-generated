    {
      "@id": "urn:oslo-toolchain:a1089dc5647d8bbbe07fb8e9645da99e8c8529d0d048c2eba6652a2b15e4c044",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Hameistijl",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hameistijl"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hameistijl"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hameistijl is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. De verticale (kolom)structuur staat op de onderbouw, aan de scharnierzijde. Samen met een tweede hameistijl draagt het de balans die bovenaan scharnierend ermee verbonden is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7f2daff9d8869217dc22c32335050e38460eee4ec106a3c541dc79bd8bf0549e"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a29499c0db5a1e66cd7c712599b68477871fdd649b52b711691a982443814330",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Brugdeel",
