        {
          "@language": "nl",
          "@value": "Grondkeringen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Grondkeringen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een grondkerende constructie is de oplossing om hoogteverschillen in het maaiveld te overbruggen als er geen ruimte is voor een natuurlijk talud."
