      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Lagerblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lagerblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lagerblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een behuizing waarin een lager is bevestigd. Wordt ook wel lagerhuis genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        },
        {
          "@id": "urn:oslo-toolchain:13d0461b3f313989bdaedfd2cc47ab8612f95f753ea117f404b5f39e00fd575f"
        },
        {
