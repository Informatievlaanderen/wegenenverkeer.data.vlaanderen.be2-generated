    {
      "@id": "urn:oslo-toolchain:5ea8e56b724724319b5096c96ea34ab5b05aa22382eef1148e27db0271c33a21",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#PTDemodulatoren",
