    {
      "@id": "urn:oslo-toolchain:1bb6e0158f9783073ff738abaa8fb7595a644a7f64da68e6df958a89f3b23771",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#SelNietSelLus",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sel niet sel lussen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SelNietSelLus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse die de eigenschappen van selectieve en niet-selectieve lussen combineert."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:aa8935a8360283cc393e73ceacc339ccb2e4360376f3e8814819ba02e8e59804",
      "@type": "http://www.w3.org/2002/07/owl#Class"
    },
    {
      "@id": "urn:oslo-toolchain:0cc555a7c032b7cdfe3a8f8d23bf3872fa883b635ebb52e9f604dc5990c23d13",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Detectielus",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Detectielussen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Detectielus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor een detectielus. Een detectielus is een kabel onder het wegdek die in staat is om voertuigen te detecteren teneinde de verkeersregelaar aan te sturen. Selectieve lussen zijn in staat om gecodeerde informatie door te geven van prioritaire voertuigen, niet-selectieve lussen geven informatie door van alle voertuigen die het detectie gebied passeren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:766d913b99c74996ed0561e69bc94d599179cb955916096571959f8696afb998",
      "@type": "http://www.w3.org/2002/07/owl#Class"
    },
    {
      "@id": "urn:oslo-toolchain:5f18b4e97a1fff0edad7219fd52ac6398fbbbcd9bc4a0948785d3b9b29198ec9",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Detectie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Detectie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Detectie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor de overige detecties, zijnde die die niet onder de groepen \"niet weggebonden detecties\", \" weggebonden detecties\" of \"detectielussen\" vallen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6e496b865c0379d7f4151b17604e1a68127326091bd63c450faf6302e1f34798",
      "@type": "http://www.w3.org/2002/07/owl#Class"
    },
    {
      "@id": "urn:oslo-toolchain:87128fd76bdfc684fe05ecaad9263c9fd35eea2a530d5668eec7fa6244135bb1",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#NietWeggebondenDetectie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Niet weggebonden detectie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "NietWeggebondenDetectie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor niet weggebonden detectoren. Deze bevinden zich niet in het wegoppervlak en worden aangewend voor volgende doeleinden: *nabij de stoplijnen van kruispunten als kruispuntdetectoren waardoor de verkeersafhankelijke werking van de verkeersregelaar mogelijk wordt (zogenaamde microregeling); *op willekeurige plaatsen in het verkeersnet, als selectieve detectoren voor het registreren van een aanvraag voor prioritaire doorgang vanwege het openbaar vervoer (bussen of tramrijtuigen) teneinde de afloop van de cyclus op de kruispunten te beïnvloeden"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
