        {
          "@language": "nl",
          "@value": "V plan"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VPlan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijving van de werking en sturing van een verkeersregelinstallatie, waarin de fasering, conflicten, prioriteiten en schakellogica van de verkeerslichten eenduidig worden vastgelegd, zodat de regeling correct kan worden geïmplementeerd, geconfigureerd en beheerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
