          "@language": "nl",
          "@value": "Afwijkende schampkant"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SchampkantAfw"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afwijkende kantopsluiting, die zones van voertuigenverkeer onderling of voertuigenzones van andere verkeerszones scheidt en de overschrijding door voertuigen bemoeilijkt maar geen voertuigkerende functie heeft."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:9593289834613954bf6933674629ef63ecf359e08774e24b6868131466069a5c"
        }
      ],
