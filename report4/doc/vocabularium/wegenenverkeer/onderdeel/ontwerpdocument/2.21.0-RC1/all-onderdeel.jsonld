        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d44da9a44d65d5d5d527b4d439b2d39bebffed6a3fc148bd1711f6f6470baac0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aandrijfas",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aandrijfas"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aandrijfas"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een as die deel uitmaakt van een aandrijflijn en die dus een kracht overbrengt van een aandrijvend element naar een aangedreven element. Een aandrijfas kan aangedreven worden door o.a. een elektromotor, een verbrandingsmotor, een hydromotor, etc. Het aangedreven element kan een schoepenwiel van een pomp, een tandlat/tandrondsel, etc. zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:291e0daf2f590b206d4a0a17dc63e145fd33c27696a236eb6a2e6ce5c34e8920",
