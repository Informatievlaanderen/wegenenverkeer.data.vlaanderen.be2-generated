    {
      "@id": "urn:oslo-toolchain:0d376f6c98dcd259a29aaf97778e1bbf79c749083930ab2de9bb2e2a77e16fb6",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Overdrukventilator",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Overdrukventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Overdrukventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel dat tot doel heeft overdruk te creëren in een gesloten ruimte zodat bij het openen van de ruimte enkel lucht kan ontsnappen naar buiten en geen lucht,rook,partikels,... naar binnen te laten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
