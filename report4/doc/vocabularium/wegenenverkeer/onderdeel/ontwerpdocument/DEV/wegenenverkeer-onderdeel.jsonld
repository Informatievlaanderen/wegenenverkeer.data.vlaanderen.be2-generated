    {
      "@id": "urn:oslo-toolchain:c9b7c13cfc88c9bbef489bef84158c593e7ff263776b9ceee35b86b55b10d2f6",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Oplegging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Oplegging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Oplegging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een oplegging of steunpunt is een element dat is vastgemaakt aan de vaste ondergrond (vb. aan het landhoofd) of aan een ander constructiedeel. Een oplegging beperkt hier de beweging van het bewegend lichaam (vb. van de brugklap). Een oplegging kan ook een dempend effect hebben bij het sluiten van een bewegend lichaam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8edf839674b9e5bd2d5adf74dcce74dd9b1e146d9158edce70d1104bf01e6374",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brugdekvoeg",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brugdekvoeg"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdekvoeg"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
