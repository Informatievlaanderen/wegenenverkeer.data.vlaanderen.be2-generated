      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De selectieve detectielussen moeten bepaalde voertuigen toelaten het kruispunt prioritair te dwarsen. Daarvoor zijn die prioritaire voertuigen uitgerust met een zendtoestel dat gecodeerd informatie doorstuurt naar een datalus in het wegdek. Deze lus is verbonden met een demodulator die de informatie decodeert en doorstuurt naar de verkeersregelaar van het te dwarsen kruispunt"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
