      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "G4d - akkerhoornbloem, gewone veldbies, gewoon biggenkruid, gewoon duizendblad, gewoon struisgras, hazenpootje, klein vogelpootje, kleine klaver, kleine leeuwentand, knolboterbloem, muizenoor, schapenzuring, smalle weegbree, vroege haver, zilverhaver."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
        }
      ],
