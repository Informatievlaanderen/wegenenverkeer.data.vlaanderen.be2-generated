        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor een elektromechanisch (EM) dragend element (bv. paal, kolom, seinbrug, galgpaal, mast) waaraan EM-toestellen bevestigd kunnen worden."
