      ],
      "diagramLabel": [
        {
          "@value": "Verankeringsmassief"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een fundering waarin ankers zijn aangebracht en die zorgen voor bevestiging en stabilisatie van een object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b8928ac800b9c5e14d4bdb1b4f0832e5ec00d10af6552808ca7c10b29a359664"
