    {
      "@id": "urn:oslo-toolchain:633baabba1e2cfd158146fe5bd19ef996bc01a44ba2f69f9805b9356c4e6b93b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Meetmicrofoon",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Meetmicrofoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meetmicrofoon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een microfoon is een elektromechanisch instrument dat geluid omzet in een elektrisch signaal. Een meetmicrofoon registreert de geluidsdruk, is gevoelig voor geluid uit alle richtingen en heeft een vlakke frequentiekarakteristiek. Nauwkeurigheid is hier belangrijker dan geluidskwaliteit. In een tunnel meet de microfoon het geluidsniveau in de tunnel om het volume van een luidspreker aan te kunnen passen om zo verstaanbaar mogelijk te communiceren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:95a98ceddbe45ec07c2c986e4875e7307417679f9709b1ca99dac8cc6ac31809"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
