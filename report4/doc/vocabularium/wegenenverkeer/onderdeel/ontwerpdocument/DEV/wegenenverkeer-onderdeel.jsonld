    },
    {
      "@id": "urn:oslo-toolchain:cd8e52721cba3b9f41741abf7d1cfe43d9f97d862572316333c3d950b5370ad4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingsrooster",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsrooster"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsrooster"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een raster dat wordt gebruikt voor de aarding van elektrische installaties. Het biedt een veilige afvoer van elektrische stroom naar de aarde, waardoor de kans op elektrische schokken en schade aan apparatuur wordt verminderd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
