      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een ondergrondse constructieve laag, geplaatst tussen verharding en groeimedium of ondergrond (bv. doorwortelbare fundering), bedoeld om belastingen te spreiden, bodemverdichting te beperken en opdruk van de verharding door wortelgroei te voorkomen, meestal uitgevoerd met sandwichpanelen of gelijkaardige prefab-units."
        }
      ],
