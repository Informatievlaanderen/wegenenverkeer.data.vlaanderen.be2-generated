    {
      "@id": "urn:oslo-toolchain:cd6ca3b9aac1741a1a5689e0898b33856d2d8032b01614f57b7f0e788922741b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Funderingsmassief",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Funderingsmassief"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Funderingsmassief"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een fundering waarop een klein(er) object geplaatst wordt of er (in principe) onlosmakelijk in vastgezet wordt (vb.: een paal/een steun, een kleine sokkel,...) Als het grotere constructie-elementen betreft (vb.: een pijler, een gebouw,...), moeten andere onderdelen van fundering gebruikt worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5187e4037f3edecb08316e80a4f997a27d39636acdaee6ceee39d9249cd7658d"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c1085dfd114b37e2f86a7b895e99d023c5c9a1bde76d56a3129d4aedecf745d5",
