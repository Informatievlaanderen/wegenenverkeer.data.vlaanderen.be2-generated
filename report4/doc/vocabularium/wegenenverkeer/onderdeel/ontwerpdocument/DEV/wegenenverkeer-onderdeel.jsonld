    {
      "@id": "urn:oslo-toolchain:8d2540a68a3e201ce9cc0dd068dbd2f2cc5d5141d54c53df7fe1b18e22af7368",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Lagerblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lagerblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lagerblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een behuizing waarin een lager is bevestigd. Wordt ook wel lagerhuis genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        },
        {
          "@id": "urn:oslo-toolchain:cdd4fd1005880231d4b105e39846014e34f35f6594f5de353bc6d873d78b6ec4"
        },
        {
          "@id": "urn:oslo-toolchain:bc059cf9f12bc05441b75020f0202d127ea93bfa1f0ae78c1cc64a55bc34101f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:e36ddd52820ca345197c3d812c89ee2f2c63c5a226006c62e609b4894fd11e30",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aandrijfas",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aandrijfas"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aandrijfas"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een as die deel uitmaakt van een aandrijflijn en die dus een kracht overbrengt van een aandrijvend element naar een aangedreven element. Een aandrijfas kan aangedreven worden door o.a. een elektromotor, een verbrandingsmotor, een hydromotor, etc. Het aangedreven element kan een schoepenwiel van een pomp, een tandlat/tandrondsel, etc. zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2c7e97c3738b5a18e052fa6e6d57bcca88295d11c8d677bb68c84378e6881b58",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Riemschijf",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Riemschijf"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Riemschijf"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een riemschijf of poelie wordt op een as bevestigd en brengt het vermogen dat door de as geleverd wordt over op een riem, of omgekeerd. Een riemschijf is samen met een riem en riemspanner onderdeel van een riemoverbrenging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
