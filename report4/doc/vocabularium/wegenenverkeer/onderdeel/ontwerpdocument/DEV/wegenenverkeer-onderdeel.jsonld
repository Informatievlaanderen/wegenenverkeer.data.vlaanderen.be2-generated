        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:787c09a48b8b8a13976536697427a195a5dfea47a96688726e5176b7b233f2d1",
