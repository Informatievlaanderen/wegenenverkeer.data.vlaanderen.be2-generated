      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a8f5dad6de0c573da332b7bf1575c02ff35c713035750177f26995a67f0b6dba",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Cilinderbodem.isOog",
