    {
      "@id": "urn:oslo-toolchain:429dafb5550fe76b818e31ca2566cf267d3ef9480b5ce3b45663e4aeb3e3dcf7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HeeftNetwerktoegang",
