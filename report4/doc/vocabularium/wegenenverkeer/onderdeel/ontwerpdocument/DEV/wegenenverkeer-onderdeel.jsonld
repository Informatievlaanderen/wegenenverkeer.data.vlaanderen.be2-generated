    {
      "@id": "urn:oslo-toolchain:6f1d5a5643c3ffc5cf05ec592ecdd826a5a09600daee8678ed8eba95d3bcb6eb",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerlichtingstoestelLED",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verlichtingstoestel LED"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerlichtingstoestelLED"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het geheel van de LEDlichtmodule en de behuizing die werden samengesteld met als doel: * de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen; * de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt; * het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen De LED driver bevindt zich fysiek in het verlichtingstoestel maar wordt als een apart onderdeel behandeld."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPackage",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1fa378e38a10728ead5067940b1be727c2bad65fd7379d0ea5b67b65e38c7a1e"
