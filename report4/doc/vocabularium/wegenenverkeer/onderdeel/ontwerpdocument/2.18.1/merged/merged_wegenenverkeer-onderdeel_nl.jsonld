    {
      "@id": "urn:oslo-toolchain:52a13eb9feda809679d1d41ad0ad971710dbbe543e15be8f0373bed05d1059bd",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/abstracten#Verlichtingstoestel",
