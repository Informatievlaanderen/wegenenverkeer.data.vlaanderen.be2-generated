        {
          "@language": "nl",
          "@value": "Brugdek"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdek"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dragende structuur die kan bestaan uit platen,balken,... Deze kan uitgevoerd worden in verschillende materialen (beton,staal,kunststof,hout)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
