    {
      "@id": "urn:oslo-toolchain:51215e2ceacce2d8c53af5ba4b1c89784e7da538c777ca2479fca3b2597a80a2",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Hefportiek",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hefportiek"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hefportiek"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hefportiek is een vrijstaand, stijf hoofdconstructieonderdeel. Het bestaat uit minstens twee steunbenen die onderling verbonden zijn en rusten op de onderbouw. Deze steunbenen staan (mede) in voor het verticale steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dit niet rust op zijn vaste steunpunten. Het tilt meestal een brugdeel of beweegbare waterkerende constructie op. Meestal herbergt een hefportiek een mechaniek met ook een tegengewicht en steekt het samen met een tweede, gelijkaardig exemplaar aan de overzijde, hoog boven de rest van het kunstwerk uit."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:704af95e59ef4e82eb630893dbfb71c8c646863190a3a03123284ddf9fc95067",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brugdek",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brugdek"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdek"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dragende structuur die kan bestaan uit platen,balken,... Deze kan uitgevoerd worden in verschillende materialen (beton,staal,kunststof,hout)."
        }
      ],
