        }
      ],
      "diagramLabel": [
        {
          "@value": "overhang"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afstand tot de rand van de rijbaan van de verticale projectie van het verlichtingstoestel op de rijbaan in meter. Als de afstand tot de rijbaan gelijk is aan 0, dan valt de verticale projectie samen met de rand van de rijbaan, bij negatieve waardes ligt de verticale projectie in de berm en bij positieve waardes ligt de verticale projectie op de rijbaan"
        }
      ],
