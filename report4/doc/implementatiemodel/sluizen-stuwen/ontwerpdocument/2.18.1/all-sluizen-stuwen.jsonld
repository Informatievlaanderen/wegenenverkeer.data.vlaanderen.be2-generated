        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Open raamwerk dat aan zeezijde van de afwaartse sluisdeur tegen de sluisdeur geplaatst wordt en vergrendeld door het inschuiven van een spie via verticale cilinder op de deur. Bij voorspelde storm vermijdt dit schade door het voorkomen van klapperen van de afwaartse deuren bij grote stormgolven en wisselende waterdruk."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
