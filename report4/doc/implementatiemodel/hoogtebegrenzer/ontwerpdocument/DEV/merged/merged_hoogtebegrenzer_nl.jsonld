      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Metalen constructie bestaande uit twee of meer verticale steunen met voetplaat en uit een enkele of een dubbel uitgevoerde horizontale dwarsverbinding,allen kokervormig met rechthoekige doorsnede."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Wordt voornamelijk toegepast in het kader van verkeersmanagement."
        }
      ],
