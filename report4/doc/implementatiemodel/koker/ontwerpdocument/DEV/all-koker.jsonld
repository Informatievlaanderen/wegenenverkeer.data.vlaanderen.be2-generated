      "@id": "urn:oslo-toolchain:94d8d23e615dee049b206a61bd7ef472d8d62fb6b323c3a0c5fd5c37fe3b4f69",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "type brandwerende bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlTypeBrandwerendeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verschijningsvorm of applicatiemethode van het materiaal, zoals plaat, paneel, gespoten materiaal of intumescente verf."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlTypeBrandwerendeBekleding",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:cc54fd604857067e5870ba69a7b70a45488be98af2d088c19f950c65f0b5270f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#BrandwerendeBekleding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brandwerende bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BrandwerendeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Bekleding die op de wanden of andere oppervlakken van een constructie wordt aangebracht met als functie de achterliggende constructie gedurende een bepaalde tijd te beschermen tegen de effecten van brand, door warmteoverdracht te beperken en structurele integriteit te behouden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a1762ac5149fd12cd9371d57ca4146fc6f0423ae6643bfab1f121a51bd7a1010"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:41ae7a0c819f9c9e08d52db7fb6df1532f3be1fd3e9e28daf92ea2b9c961f682",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#EsthetischeBekleding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Esthetische bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EsthetischeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Bekleding die op constructieve elementen of oppervlakken van een kunstwerk wordt aangebracht met als hoofddoel het esthetisch afwerken of verfraaien van het zichtbare oppervlak."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a1762ac5149fd12cd9371d57ca4146fc6f0423ae6643bfab1f121a51bd7a1010"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:23e14bc895ac8365adecc817f0ed6668c5aab7c8a7fb94dc16a73547290f954e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verkenmerk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verkenmerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkenmerk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een (roestvast) verkenmerk is geplaatst op een kunstwerk. Het periodiek opmeten maakt mogelijk de vervormingen van het kunstwerk te bepalen en de evolutie ervan na te gaan t.o.v. de begintoestand."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:29444ac2a986da36a98796e77e3d3f7568e704343e88e9dd07013a992505fc0c"
