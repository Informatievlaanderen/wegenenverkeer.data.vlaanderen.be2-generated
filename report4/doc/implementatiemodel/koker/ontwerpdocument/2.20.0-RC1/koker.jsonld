          "@value": "Verkenmerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkenmerk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een (roestvast) verkenmerk is geplaatst op een kunstwerk. Het periodiek opmeten maakt mogelijk de vervormingen van het kunstwerk te bepalen en de evolutie ervan na te gaan t.o.v. de begintoestand."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
