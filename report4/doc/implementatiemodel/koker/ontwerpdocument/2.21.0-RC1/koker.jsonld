    },
    {
      "@id": "urn:oslo-toolchain:fc416e18f5f2dabef06c9b5da713ff8995dcb7ab139200a6d1fe11541ba129d4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Oplegging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Oplegging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Oplegging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een oplegging of steunpunt is een element dat is vastgemaakt aan de vaste ondergrond (vb. aan het landhoofd) of aan een ander constructiedeel. Een oplegging beperkt hier de beweging van het bewegend lichaam (vb. van de brugklap). Een oplegging kan ook een dempend effect hebben bij het sluiten van een bewegend lichaam."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:03bdea5b5a13dc482e081eacdc87d8e14f8b250341a44c40bdc62b5ca8b210dd",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Brugdekvoeg",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brugdekvoeg"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdekvoeg"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
