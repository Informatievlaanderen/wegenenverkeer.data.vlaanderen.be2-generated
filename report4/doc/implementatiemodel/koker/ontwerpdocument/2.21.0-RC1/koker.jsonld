      "@id": "urn:oslo-toolchain:212b9e2ec2954840b9bb1153ce974bbe146f66a461b6b1954e52150da77e2e47",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "type brandwerende bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlTypeBrandwerendeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verschijningsvorm of applicatiemethode van het materiaal, zoals plaat, paneel, gespoten materiaal of intumescente verf."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlTypeBrandwerendeBekleding",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:315fb1719b2aeb0e37ae0ca89d2f47875a737e445b8b429c43880dc005f91ae2",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#BrandwerendeBekleding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brandwerende bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BrandwerendeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Bekleding die op de wanden of andere oppervlakken van een constructie wordt aangebracht met als functie de achterliggende constructie gedurende een bepaalde tijd te beschermen tegen de effecten van brand, door warmteoverdracht te beperken en structurele integriteit te behouden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8af6fc14db7ec9a4cafc096a68662da78de8b39a963decb6cf2b0bf4dbb95072"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:747583fdaf380724917304d14512420188183d2a735aa247ac6627dd52965d60",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#EsthetischeBekleding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Esthetische bekleding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EsthetischeBekleding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Bekleding die op constructieve elementen of oppervlakken van een kunstwerk wordt aangebracht met als hoofddoel het esthetisch afwerken of verfraaien van het zichtbare oppervlak."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8af6fc14db7ec9a4cafc096a68662da78de8b39a963decb6cf2b0bf4dbb95072"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:145479a29cea9d0e8518516ba268ac06a3956ca7ba9f3e72e9655204ca157abb",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Verkenmerk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verkenmerk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkenmerk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een (roestvast) verkenmerk is geplaatst op een kunstwerk. Het periodiek opmeten maakt mogelijk de vervormingen van het kunstwerk te bepalen en de evolutie ervan na te gaan t.o.v. de begintoestand."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:934dd5aa5c00e02e3bee03efeb9fd01173c8aef32c14a6ad66eab422c7ed5640"
