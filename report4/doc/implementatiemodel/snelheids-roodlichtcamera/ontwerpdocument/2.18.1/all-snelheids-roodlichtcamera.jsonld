        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek."
        }
      ],
