        {
          "@language": "nl",
          "@value": "WV lichtmast"
        }
      ],
      "diagramLabel": [
        {
          "@value": "WVLichtmast"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Paal voorzien van armen voor het bevestigen van wegverlichtingstoestellen. Omvat het deurtje, klemmenblok, de bevestigingsmaterialen (bv. voetplaten) en fundering of verankeringsmassief. Gebruik Lichtmast voor de bevestiging van andere toestellen dan wegverlichting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7da8323d43ca5c485183b0e893e7f7356daad76a4160df6e933a4a5dfd724e46"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7da8323d43ca5c485183b0e893e7f7356daad76a4160df6e933a4a5dfd724e46",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lichtmast",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lichtmast"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lichtmast"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Paal waarop een verlichtingstoestel of andere toestellen zoals een camera bevestigd kunnen worden met uitzondering van wegverlichting. Omvat het deurtje, klemmenblok, montagekastje, bevestigingsmaterialen (bv. voetplaten) en fundering (bv. buisfundering) of verankeringsmassief. Indien de paal gebruikt wordt voor wegverlichting moet het objecttype WVLichtmast gebruikt worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
