        {
          "@value": "HoogtebegrenzerInstallatie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanische en/of elektronische opstelling die bij kunstwerken (zoals bruggen of tunnels) de maximale doorrijhoogte van voertuigen detecteert en overtredingen voorkomt om schade te vermijden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
