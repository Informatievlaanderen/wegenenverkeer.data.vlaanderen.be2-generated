    {
      "@id": "urn:oslo-toolchain:cb2079f9027cbe6c62051f2d51b29d801ee7519deeefe6160c3269083904486f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Pijler",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Pijler"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Pijler"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een pijler is een steunpilaar die fungeert als vrijstaande drager en een steunpunt vormt tussen landhoofden voor de liggers of gewelven van een kunstwerk."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
