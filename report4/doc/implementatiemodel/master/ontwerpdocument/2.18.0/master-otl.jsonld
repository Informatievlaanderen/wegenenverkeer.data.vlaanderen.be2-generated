    {
      "@id": "urn:oslo-toolchain:70ceb3cd508b17db15d53f8256a29bf2dca097126bf39dbe0d267ed34ea1e19d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#DominantGraslandfase2",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Dominant grasland - fase2"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DominantGraslandfase2"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "G2 - Meer dan 50% van de oppervlakte ingenomen door één niet sterk glanzende grassoort:gestreepte witbol, grote vossenstaart of glanshaver, + grassen en kruiden uit G0 en G1."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
