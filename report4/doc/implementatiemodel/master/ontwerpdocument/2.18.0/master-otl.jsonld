    {
      "@id": "urn:oslo-toolchain:c084b6c904efa8d81c5e983b23907547f46a0d367b5457c9fc9b9ad568974b58",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Boog",
