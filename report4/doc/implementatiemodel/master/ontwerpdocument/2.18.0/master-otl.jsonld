        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Keuzelijst met de normen of standaarden (bv. NBN EN 13501) volgens dewelke de brandwerende eigenschappen van het materiaal zijn getest en gecertificeerd."
        }
      ],
