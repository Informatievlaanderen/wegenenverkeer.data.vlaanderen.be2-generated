    {
      "@id": "urn:oslo-toolchain:8397884d5db3ebb14a4a11aac2b4e64061a37842deb668261e501905b17d39f0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Grondverbetering",
