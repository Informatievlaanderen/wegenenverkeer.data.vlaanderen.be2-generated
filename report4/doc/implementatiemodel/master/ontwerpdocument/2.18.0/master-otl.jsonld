          "@value": "Wilddetectiezone"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De wilddetectiezone van een wilddetectiesysteem betreft de nabije zone rond de detectiesystemen (zoals een bewegingssensor). Deze zone vereist extra onderhoud, om valse detecties te voorkomen."
        }
      ],
