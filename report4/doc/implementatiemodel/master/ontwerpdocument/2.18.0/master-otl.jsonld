    {
      "@id": "urn:oslo-toolchain:412e956038b01535285dc5ccb51e6e56d19e7b728b4a771d1756cf136bb717f4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Heftoren",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Heftoren"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Heftoren"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:69c89238e885352b4132b83a242f8a78558e46df16691b677417823fe8fd9b93"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
