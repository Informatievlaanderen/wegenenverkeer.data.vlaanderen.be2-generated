      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8b8550b671ae35567819a604f0b1b6de2a352d1d223bc6cb7c75c328a5021738",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#GrasKruidenmixGraslandfase3",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gras kruidenmix grasland - fase3"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GrasKruidenmixGraslandfase3"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "G3 - Fijn mozaïek van grassen en kruiden zoals: beemdlangbloem, gewone berenklauw, gewoon duizendblad, gewoon reukgras, glanshaver, grasmuur, grote vossenstaart, hopklaver, kleine klaver, pastinaak, peen, rietzwenkgras, rode klaver, rood zwenkgras, scherpe boterbloem, sint-Janskruid, smalle weegbree, timotee, veldbeemdgras, veldzuring, gewoon biggenkruid, kamgras, veldgerst, vijfvingerkruid."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
