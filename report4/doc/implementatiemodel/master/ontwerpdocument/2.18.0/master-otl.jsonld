      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#MVPaal",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "MV Paal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "MVPaal"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Grondverdringende stalen paal met een inwendige en/of uitwendige injectie met grout-specie. Ze wordt vervaardigd door het heien van een stalen profiel/buis in de bodem onder gelijktijdig injecteren van een groutmengsel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
