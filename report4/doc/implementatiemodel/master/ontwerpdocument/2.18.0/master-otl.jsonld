        {
          "@language": "nl",
          "@value": "Kesp"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kesp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Algemene benaming voor het aanduiden van een betonnen balk bovenaan grondkerende structuren, een kopbalk als het ware (wordt ook wel kaaimuurkop genoemd). Ankervoorzieningen, ladders, enz. worden in/tegen de kesp bevestigd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cb66f4a3620d3a685634f059b4b770be61cbe6ec70a6db55a350e08cae33a02f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d797e50bd77e4b002ba8d2a18fcce34425e20caf8fd72be4478f6fb0c32c2a2b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Koppelbalk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Koppelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Koppelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balk die delen van een constructie met elkaar verbindt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cb66f4a3620d3a685634f059b4b770be61cbe6ec70a6db55a350e08cae33a02f"
