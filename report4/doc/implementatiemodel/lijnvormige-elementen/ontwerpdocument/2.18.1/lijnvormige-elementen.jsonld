          "@id": "urn:oslo-toolchain:d42096b61839e190b4347e4c7a5ae9eb3586ec2ff84aa93285ffa2da7360146f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
