      "@id": "urn:oslo-toolchain:684b5908a6cf8662c79f3d0f407fb9cd203aec0bff0f84cec06cb2947669d9ce",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SluitAanOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sluit aan op"
