      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afstand, uitgedrukt in meter met maximun 1 cijfer na de komma, tussen de verschillende LED verlichtingstoestellen."
        }
      ],
      "vocUsageNote": [
