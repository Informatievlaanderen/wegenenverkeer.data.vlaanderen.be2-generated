    {
      "@id": "urn:oslo-toolchain:afa8815b0eaaa1ceac04713b2e38a4e09c0ed553fab876c6af8e47ab3a75ee91",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Gronddam",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gronddam"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gronddam"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Gronddammen zijn trapeziumvormige constructies bestaande uit zand, grond of steenachtige materialen. De onderkant van de gronddam wordt direct op het bestaand maaiveld aangebracht of op een vooraf aangebrachte grondverbetering. Een gronddam kan volgende functies vervullen: geluidswering, geleiding van dieren, veiligheid en lichtwering."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f7382d66049641975dcc0f4d9104ef8a8d29d6f413b8a89cac29fb11228a8cfb",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#GeluidwerendeConstructie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Geluidwerende constructie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeluidwerendeConstructie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De geometrie van de z-coördinaat dient overeen te stemmen met de bovenkant van de geluidwerende constructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
