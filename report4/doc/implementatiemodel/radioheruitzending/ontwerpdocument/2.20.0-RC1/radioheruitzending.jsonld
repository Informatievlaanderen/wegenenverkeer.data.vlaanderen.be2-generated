        }
      ],
      "diagramLabel": [
        {
          "@value": "FMRepeaterBox"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een radio-ontvanger en -zender, die het FM-signaal ontvangt en weer doorgeeft om zo grotere afstanden te overbruggen en plaatsen te bereiken, waar de radiosignalen niet geraken, zoals in tunnels. De uitvoering is van het type 'box' waar aparte repeatermodules per frequentie of voor meerdere frequenties kunnen ingestoken worden, zoals in een vaste computer."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
