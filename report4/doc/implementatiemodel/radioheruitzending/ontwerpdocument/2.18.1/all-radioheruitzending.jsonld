    {
      "@id": "urn:oslo-toolchain:89ec685f32650b0caba566fbcd81982545a44be979ee556ac6d0ae5720def282",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Signaalkabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Signaalkabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Signaalkabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kabel die primair zorgt voor het uitwisselen van digitale en analoge stuursignalen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De kabel zorgt primair voor de uitwisseling van digitale en analoge stuursignalen tussen twee onderdelen, bv. tussen een sensor en een verwerkingseenheid. De sturing verloopt in principe via lagere spanning. In voorkomende gevallen kan die ook met gewone netspanning gebeuren om de gekoppelde techniek van stroom te voorzien. De sturing primeert evenwel op het loutere transport van spanning en vermogen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ac012b65a8516c4f4bd95b78f8527f0de93f42d0fb83033af1bb6542d1ff99d2"
        }
      ],
