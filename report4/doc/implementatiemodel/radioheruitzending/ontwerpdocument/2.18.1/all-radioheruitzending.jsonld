          "@id": "urn:oslo-toolchain:9bef8bc6f7eb2895cc74554c194f0ade17fbcfa9969ea9c160f4b0aa09137eeb"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
