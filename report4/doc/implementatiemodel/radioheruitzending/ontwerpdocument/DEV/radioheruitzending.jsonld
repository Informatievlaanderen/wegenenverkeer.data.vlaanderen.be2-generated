    {
      "@id": "urn:oslo-toolchain:0b5e4d1e48b627b17f099b87293b3b141cb1a302c05af56244dc8c854e6f1b8c",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Signaalkabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Signaalkabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Signaalkabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kabel die primair zorgt voor het uitwisselen van digitale en analoge stuursignalen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De kabel zorgt primair voor de uitwisseling van digitale en analoge stuursignalen tussen twee onderdelen, bv. tussen een sensor en een verwerkingseenheid. De sturing verloopt in principe via lagere spanning. In voorkomende gevallen kan die ook met gewone netspanning gebeuren om de gekoppelde techniek van stroom te voorzien. De sturing primeert evenwel op het loutere transport van spanning en vermogen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d999e6091012fdfa169972b7ebcc06cf19231b8cb6b0f1f7b947455479a02ccf"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
