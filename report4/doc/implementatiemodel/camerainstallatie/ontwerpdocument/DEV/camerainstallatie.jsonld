    {
      "@id": "urn:oslo-toolchain:905acdd1aaffc1af6de19f7f2245b5ecd6d36b586323374cf8c00072f88a805b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#AIDModule",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "AID-module"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AIDModule"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Aparte hardware module voor automatische incidentdetectie op camerabeelden. De module kan centraal of lokaal opgesteld staan maar altijd als apart onderdeel, niet als deel van de camera die de beelden doorstuurt. Ze kan gebruikt worden voor modules die analoge beelden analyseren en voor modules die werken op basis van digitale beelden. Het doel is om op een automatische en zo intelligent mogelijk manier gebeurtenissen uit de beelden van een CCTV-camera te halen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
