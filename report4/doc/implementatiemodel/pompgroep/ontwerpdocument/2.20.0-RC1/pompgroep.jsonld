          "@value": "Pompgroep"
        }
      ],
      "diagramLabel": [
        {
          "@value": "PompGroep"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een systeem dat instaat voor het omzetten van elektrische energie in een verplaatsing of drukverhoging van water. In dit geval spreekt men van een pomp. In de omgekeerde situatie spreekt men van een turbine."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Gebruik PompGroep voor een modulair systeem."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
