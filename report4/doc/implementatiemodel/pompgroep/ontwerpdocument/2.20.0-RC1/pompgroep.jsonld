        {
          "@language": "nl",
          "@value": "Naaf"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Naaf"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanisch element dat op een as bevestigd wordt. Het is onderdeel van een as-naaf-verbinding. Het kan gebruikt worden als verbindingsstuk om een verwisselbaar onderdeel op een as te kunnen bevestigen (zo wordt een wiel bijvoorbeeld d.m.v. een naaf op een as bevestigd). Een naaf kan ook een onderdeel van een koppeling tussen twee assen zijn. (as-naaf-naaf-as)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
