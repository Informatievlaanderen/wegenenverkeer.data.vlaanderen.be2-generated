    {
      "@id": "urn:oslo-toolchain:2db9f4b595bb4de4228054c98c57d3073e47ba922fa28861031916b86b740077",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Glijlager",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Glijlager"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Glijlager"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een machineonderdeel met als functie het toelaten van rotatie of translatie van een as. Bij een glijlager glijdt de as in een vast lager,het verlagen van de wrijving tussen as en lager gebeurt door smering of door het materiaal van het lager."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1fd9ee7c18ca4237e417cf4e23293f5d223d87ca60056cb6cae5ce2fb71551ac"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4b2c8f936993db3df6a7991297c88daa69dfa8fa3b68b4e3a13e4072ad753c27",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#ElastischElement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Elastisch element"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ElastischElement"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een elastisch of flexibel element is een onderdeel van een mechanische koppeling en zorgt voor het dempen van trillingen en schokken. Het wordt meestal tussen twee naven geplaatst."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:b55f9ec05b30053b40f8ffc9ba13068ebe07d3b3cc89dc5cf0993400bcbaacf7"
        },
        {
          "@id": "urn:oslo-toolchain:e26684ff38be769a0f7ace1ac4a9325b89786512543475aeb8eac81feb097aed"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bd829d77a23e61b4768c5b6157cb59358ed307adbb84c900124ebb5aeeba250e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Waaier",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Waaier"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Waaier"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanische constructie die bestaat uit een aantal schoepen. Deze schoepen brengen de mechanische energie van de aandrijflijn, in de vorm van een roterende beweging, over naar het te verpompen medium. Men spreekt dan van een pomp. In het omgekeerde regime, waarbij er energie wordt overgedragen van de vloeistof op de aandrijflijn, spreekt men van een turbine. Wordt ook wel impeller genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:45c30737ad706bcc8aa5328ae7e49513d3e35cda687f3c9240b15ca152292b4c"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:cadbfb3a6efdcd1ce0c27697d57d4a5780db89378f71642bfa0a45bd6293fab7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Wormschroef",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Wormschroef"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Wormschroef"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een spiraalvormige schroef die toelaat vloeistoffen, sluries, of poeders te transporteren. De schroef, geplaatst in een gesloten of deels open buis, wordt aangedreven en draait rond zijn eigen as. Deze draaiende beweging leidt tot de verplaatsing van het te verplaatsen medium. Wanneer het medium in opwaartse richting getransporteerd wordt spreekt men van een pomp. Wanneer het medium in afwaartse richting beweegt en al doende de schroef doet draaien, spreekt men van een turbine. Wordt ook wel waterschroef, opvoerschroef, vijzelpomp, of een schroef van Archimedes genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:45c30737ad706bcc8aa5328ae7e49513d3e35cda687f3c9240b15ca152292b4c"
        },
        {
          "@id": "urn:oslo-toolchain:17b22482083118231e0f7b0979818ab1bdb1d1a9b61a41d52fdd185f89e3bfee"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7054c31bcf5ef0d73dbb712a3fe331266098a0d50734b04abd6796bc06ba86e0",
      "@type": "Class",
