          "@id": "urn:oslo-toolchain:e26684ff38be769a0f7ace1ac4a9325b89786512543475aeb8eac81feb097aed"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0607a6ac359804996a18f0a4d470f5f5ab6eecc1aa86cfcfa119321070a07325",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Koppeling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Koppeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Koppeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een koppeling is een machineonderdeel dat wordt gebruikt om vermogen (rotatie en koppel) over te brengen van een aandrijvende as naar een aangedreven as."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
