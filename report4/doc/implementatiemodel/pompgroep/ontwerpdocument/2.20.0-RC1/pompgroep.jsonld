    {
      "@id": "urn:oslo-toolchain:5daca561e8f6c4a1b66065b3a54f64bee4947ef5dace89546a5a9a149e706f36",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Waaier.typeOpstelling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "type opstelling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "typeOpstelling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan van wat voor pomp of turbine de waaierl deel uitmaakt. Bij een axiale pomp, wordt de vloeistof in de richting van de as van de waaier verpompt. Bij een radiale pomp, is er een hoek van 90° tussen de as van de waaierl en de richting waarin het vloeistof wordt verpompt. Bij een gemengde pomp ligt de hoek tussen de as van de waaier en de richting van de stroming van de vloeistof ergens tussen deze twee waarden. Voor turbines geldt een analoge terminologie."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:bd829d77a23e61b4768c5b6157cb59358ed307adbb84c900124ebb5aeeba250e"
      },
      "range": {
        "@id": "urn:oslo-toolchain:a63c456e44b4803eb499a5afe96bfe976e01a3da91cf8e00a1a6965ffd253d9d"
      },
      "minCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
