    {
      "@id": "urn:oslo-toolchain:254a9adb1eff9c8729139832a98e45e7d60850c41d8259cde504a12feaf642f4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Glijlager",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Glijlager"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Glijlager"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een machineonderdeel met als functie het toelaten van rotatie of translatie van een as. Bij een glijlager glijdt de as in een vast lager,het verlagen van de wrijving tussen as en lager gebeurt door smering of door het materiaal van het lager."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6631d9f509fcb54716246e6198d022ed9d341e1555b3f1d8167893fa99859ca8"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a56278dfdeea41bf2ecfb8a771260920eb7424c715f7b1518f14b82d3c65e0c1",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ElastischElement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Elastisch element"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ElastischElement"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een elastisch of flexibel element is een onderdeel van een mechanische koppeling en zorgt voor het dempen van trillingen en schokken. Het wordt meestal tussen twee naven geplaatst."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c425e7bd58f235d034a9d69be04a81b77c6c5e03e24d0ce47ef3803f5c1c43d"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4b7e4d41d512b3872c9c729e7f7c35ee2e228550533ba9749414d6c6928405c9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Waaier",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Waaier"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Waaier"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanische constructie die bestaat uit een aantal schoepen. Deze schoepen brengen de mechanische energie van de aandrijflijn, in de vorm van een roterende beweging, over naar het te verpompen medium. Men spreekt dan van een pomp. In het omgekeerde regime, waarbij er energie wordt overgedragen van de vloeistof op de aandrijflijn, spreekt men van een turbine. Wordt ook wel impeller genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6f71443947b26b7452bbb2823855bd13329b3b94ad36976d919a24275bb60f71"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ef272b2aee060a8627c4e97706a1c58b61b877f4d7f82027ff46f9602e9f2897",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Toestelventlaitor modelnamen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlToestelventilatorModelnaam"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijst met modelnamen van ventilatoren gebruikt voor de koeling van toestellen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer.data.vlaanderen.be/id/conceptscheme/KlToestelventilatorModelnaam",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:611773f15019e7415e7b1f215c2d00c667d77a4a9452e9b59145b832343584f2",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Lagerblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lagerblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lagerblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een behuizing waarin een lager is bevestigd. Wordt ook wel lagerhuis genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
