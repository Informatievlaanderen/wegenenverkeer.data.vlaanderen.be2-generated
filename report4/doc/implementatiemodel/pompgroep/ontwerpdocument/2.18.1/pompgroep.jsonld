          "@id": "urn:oslo-toolchain:616ebe03833104b57a8d52bae1bdd260028850ba624ae9fc8d5b4f95e644d03c"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:25af5f87b448116b44597d8bad8cd6844cdd60c3ce3ac17d08712662926cdb70",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aandrijfas",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aandrijfas"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aandrijfas"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een as die deel uitmaakt van een aandrijflijn en die dus een kracht overbrengt van een aandrijvend element naar een aangedreven element. Een aandrijfas kan aangedreven worden door o.a. een elektromotor, een verbrandingsmotor, een hydromotor, etc. Het aangedreven element kan een schoepenwiel van een pomp, een tandlat/tandrondsel, etc. zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
