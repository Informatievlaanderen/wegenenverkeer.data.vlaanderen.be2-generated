    },
    {
      "@id": "urn:oslo-toolchain:2d7be11a11333d25054cc6602b095560d385a7e7e4d5061d39794cf59dadb5e3",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Voedt",
