        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:aa1f1a707537e119cfc33a26bd95b4bc3859e4f1fee704ce5c4d5db22e910dee",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Koppeling",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Koppeling"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Koppeling"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een koppeling is een machineonderdeel dat wordt gebruikt om vermogen (rotatie en koppel) over te brengen van een aandrijvende as naar een aangedreven as."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
