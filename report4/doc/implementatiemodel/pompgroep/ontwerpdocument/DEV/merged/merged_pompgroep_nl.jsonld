        }
      ],
      "diagramLabel": [
        {
          "@value": "Overbrenging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een overbrenging of transmissie brengt een vermogen (bv. van een motor) over op een bewegingsmechanisme. Daarbij kan de snelheid, de kracht en het koppel aangepast worden aan de noden van het bewegingsmechanisme (bv. door gebruik te maken van een tandwielkast)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
