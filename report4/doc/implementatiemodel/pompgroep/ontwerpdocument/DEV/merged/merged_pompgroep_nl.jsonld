    {
      "@id": "urn:oslo-toolchain:593d04c3abcce6b0d5020fb47047d5e5dfe856183707bc907d6cac547ff5cf93",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Glijlager",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Glijlager"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Glijlager"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een machineonderdeel met als functie het toelaten van rotatie of translatie van een as. Bij een glijlager glijdt de as in een vast lager,het verlagen van de wrijving tussen as en lager gebeurt door smering of door het materiaal van het lager."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cb8ffff6356694a4bdec1cd5d269d621a237be0f6aeaaa8051bbf5b5f6caf766"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:db28186f65f83168d7536a96184f6cacfdd9339152107fe1e5d264d2f00bd874",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#ElastischElement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Elastisch element"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ElastischElement"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een elastisch of flexibel element is een onderdeel van een mechanische koppeling en zorgt voor het dempen van trillingen en schokken. Het wordt meestal tussen twee naven geplaatst."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:75cde0b2181286eb2d684104ac286bcf860ab4a6ec1964554ff859ec83783759"
        },
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a9e02b84ba17303fc076ca30c17dab05d9038b6691c0687d398eeb29351e5baa",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Waaier",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Waaier"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Waaier"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanische constructie die bestaat uit een aantal schoepen. Deze schoepen brengen de mechanische energie van de aandrijflijn, in de vorm van een roterende beweging, over naar het te verpompen medium. Men spreekt dan van een pomp. In het omgekeerde regime, waarbij er energie wordt overgedragen van de vloeistof op de aandrijflijn, spreekt men van een turbine. Wordt ook wel impeller genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a74fe5ef7a44c01679e87d8374dc663cda662f4f98b34d88ec9a11cdec638344"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f3fa8353499ce313d25704690ab3546f1d2c87aac712e1bc7ee3953dfe19dd31",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Wormschroef",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Wormschroef"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Wormschroef"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een spiraalvormige schroef die toelaat vloeistoffen, sluries, of poeders te transporteren. De schroef, geplaatst in een gesloten of deels open buis, wordt aangedreven en draait rond zijn eigen as. Deze draaiende beweging leidt tot de verplaatsing van het te verplaatsen medium. Wanneer het medium in opwaartse richting getransporteerd wordt spreekt men van een pomp. Wanneer het medium in afwaartse richting beweegt en al doende de schroef doet draaien, spreekt men van een turbine. Wordt ook wel waterschroef, opvoerschroef, vijzelpomp, of een schroef van Archimedes genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a74fe5ef7a44c01679e87d8374dc663cda662f4f98b34d88ec9a11cdec638344"
        },
        {
          "@id": "urn:oslo-toolchain:95a98ceddbe45ec07c2c986e4875e7307417679f9709b1ca99dac8cc6ac31809"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8b7a70520563877705f0b39e1f2b761b8f809b86b38d94bf8fc09bedbdc87487",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
