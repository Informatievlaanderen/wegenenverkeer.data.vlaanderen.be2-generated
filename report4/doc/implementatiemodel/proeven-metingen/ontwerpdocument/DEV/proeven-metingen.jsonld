    {
      "@id": "urn:oslo-toolchain:9223420c593dd702db9998b3a8607918a2b63ab3ae0b705fa33f76649c3e51c5",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#GeluidwerendeConstructie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Geluidwerende constructie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "GeluidwerendeConstructie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geluidswerende wandvormige constructie bestaande uit een desgevallend geluidsisolerend materiaal en/of geluidsabsorberend materiaal en voorzien van de nodige structuren om de bouwkundige stabiliteit te verzekeren."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De geometrie van de z-coördinaat dient overeen te stemmen met de bovenkant van de geluidwerende constructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d12d1952a2a6f4ca9c6cc51f0de45b0ecf14922805600bf8f5108b3cfd852553",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gewaarborgde wrijvingshoek"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlGewaarborgdeWrijvingshoek"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De hoek van inwendige wrijving geeft een aanwijzing omtrent de afschuifkarakteristieken en wordt dan ook gebruikt bij berekening van afschuiving, gronddruk en draagvermogen van paalfunderingen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlGewaarborgdeWrijvingshoek",
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:87aa7de08a8dc44828627183b6ae6ffa0ec7fccf26564f5a83933ad9f334d210",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IsInspectieVan",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Is inspectie van"
        }
      ],
      "diagramLabel": [
        {
          "@value": "IsInspectieVan"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie geeft aan dat er een inspectie, proef of meting gedaan kan worden op een onderdeel of installatie. De bron van de relatie is de inspectie, het doel het onderdeel of de installatie waarbij de inspectie hoort."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:009b169aa35f59ec65b8d16bffc53902aca7b4fb8a7f46960617b7db89fe9991",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:022034a7a8929a0a08652c4ff7939e3388390a4896a3571f9e0513b802efeea0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7454728651be8766d368e1287ee51fc928ee184a2e8b9be992914f235e71082d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SluitAanOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sluit aan op"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SluitAanOp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a14cd2b3ab1d06f95959b6b955ba435acf2265ccab0979859060de759476c6d4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:90f78f71dca6fac3331cd7c521d99de2271dc9c29abd0cee9cb044accdf2bc57",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#LigtOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ligt op"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LigtOp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
