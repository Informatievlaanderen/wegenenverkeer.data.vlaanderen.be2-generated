        {
          "@value": "KlAlgGemeente"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijst van gemeentes in Vlaanderen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
