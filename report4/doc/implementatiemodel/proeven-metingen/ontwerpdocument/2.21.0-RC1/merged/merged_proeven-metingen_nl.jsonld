        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit een overzichtsfoto van de hele constructie. Op basis van deze afbeelding kan je snel bekijken hoe de kleur of hoogte varieert over het verloop van de geluidswerende constructie."
        }
      ],
