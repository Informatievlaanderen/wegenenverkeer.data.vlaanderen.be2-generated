        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit is een document waarin allerlei berekeningen bijgehouden worden omtrent de stabiliteit en sterkte van de geluidswerende constructie (oa de variatie in statische belasting en windbelasting over het verloop van geluidswerende constructie)."
        }
      ],
      "domain": {
