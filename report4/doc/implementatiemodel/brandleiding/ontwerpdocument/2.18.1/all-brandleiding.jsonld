    {
      "@id": "urn:oslo-toolchain:828ed68d3ab3b6fbf1da0c385b006c233669c9bd81ede469aa24a857d1cffb75",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Sturing",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sturing"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sturing"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ed683849367dcb78939a30ba21508d2b5cac2d3a07293cbedc32dbc9b3591084"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:407901cddc339cd8fca02ac7d27a54f9d96c7a03f9252197c46b46f06dca625e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voedt",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voedt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voedt"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:504be097ad6fa652dba6787ee9e2cd5ebc62e074e6730e3d2a239f8161ca1d0a",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ed683849367dcb78939a30ba21508d2b5cac2d3a07293cbedc32dbc9b3591084"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:684b5908a6cf8662c79f3d0f407fb9cd203aec0bff0f84cec06cb2947669d9ce",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#SluitAanOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sluit aan op"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SluitAanOp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f665512fdec2a8b2c8b55087624bf351671e97f7b79e06a0cba2c7afa06039dd",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
