      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van meerdere verkeerslichten die boven elkaar worden opgesteld en worden bevestigd op een steun, teneinde de beweging van voetgangers te verhinderen of toe te laten."
        }
      ],
