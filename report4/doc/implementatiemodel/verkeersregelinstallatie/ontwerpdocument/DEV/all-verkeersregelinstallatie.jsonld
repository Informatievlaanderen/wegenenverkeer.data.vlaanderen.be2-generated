    },
    {
      "@id": "urn:oslo-toolchain:3aaaae4e314927bd38ba48e42ca1513e5461134f55831d7994ce91283534d53b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VRIVirtueleDetectiezone",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Virtuele detectiezone"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VRIVirtueleDetectiezone"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een virtuele detectiezone is een draadloos alternatief voor een traditionele lus. Op basis van GPS gegevens wordt een zone of traject vastgelegd waarbinnen er (al dan niet selectieve) input dient geleverd te worden aan de verkeersregelaar. De virtuele detectiezone kan ook gebruikt worden om de detectiezones van detectiecamera's en radars te inventariseren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
