    {
      "@id": "urn:oslo-toolchain:117d098e34c5255fc22b6eae831ab7fccfcbc9d2f5229662e3f2eb07221a9e0a",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#WeggebondenDetector",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Weggebonden detector"
        }
      ],
      "diagramLabel": [
        {
          "@value": "WeggebondenDetector"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Weggebonden detectoren zijn draadloze in het wegdek geïntegreerde radars of magnetische inductiesensoren. Ze zitten ingebed in een cilinder, die geplaatst wordt in het wegdek en die draadloos communiceert met een access point die met de verkeersregelaar verbonden is"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
