      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van één of meerdere verkeerslichten die boven of naast elkaar worden opgesteld en worden bevestigd op een steun, teneinde de beweging van een weggebruiker die een bepaald traject volgt, te verhinderen of toe te laten door het gebruik van aangepaste lenzen"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:701df461a9cc33c73cbe2902e3027ed88b024167fe11bf2421faa8ab9e5f3d6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ff41a9871dbf5988fa1d0d19f065ccddade89349313b97517fad4f050e5807f6",
      "@type": "Class",
