    {
      "@id": "urn:oslo-toolchain:00a401b246c464018717a14ae8a0f41998bc8a20d0fd1996e6f385978c834136",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#NietWeggebondenDetectie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Niet weggebonden detectie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "NietWeggebondenDetectie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor niet weggebonden detectoren. Deze bevinden zich niet in het wegoppervlak en worden aangewend voor volgende doeleinden: *nabij de stoplijnen van kruispunten als kruispuntdetectoren waardoor de verkeersafhankelijke werking van de verkeersregelaar mogelijk wordt (zogenaamde microregeling); *op willekeurige plaatsen in het verkeersnet, als selectieve detectoren voor het registreren van een aanvraag voor prioritaire doorgang vanwege het openbaar vervoer (bussen of tramrijtuigen) teneinde de afloop van de cyclus op de kruispunten te beïnvloeden"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
