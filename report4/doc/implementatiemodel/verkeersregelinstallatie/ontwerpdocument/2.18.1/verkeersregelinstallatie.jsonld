    },
    {
      "@id": "urn:oslo-toolchain:315f31d578792b48984fc0eb42590cf5d3c6c9b4c23ef0354a58560faf91aec5",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#OpenbaarVervoerslantaarn",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Openbaar vervoerslantaarn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "OpenbaarVervoerslantaarn"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van meerdere verkeerslichten die boven elkaar worden opgesteld en worden bevestigd op een steun, teneinde de beweging van het openbaar vervoer te verhinderen of toe te laten. Deze lantaarns worden enkel gebruikt op de plaatsen waar het openbaar vervoer in een eigen bedding of bijzondere overrijdbare bedding rijdt. Het openbaar vervoer en het toegelaten verkeer op de bijzondere overrijdbare bedding moeten deze verkeerslichten volgen"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:61e7a71e258b9ff38f27737043940289e3e9b72afc356063882b9746a0a9751f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3eed4855d260d59a2ee82282d2f91165c60594906b76b7efddfda033f145a96d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Knipperlantaarn",
