        {
          "@language": "nl",
          "@value": "Voertuiglantaarn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voertuiglantaarn"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geheel van meerdere verkeerslichten die boven elkaar worden opgesteld en worden bevestigd op een steun, teneinde de beweging van voertuigen te verhinderen of toe te laten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:61e7a71e258b9ff38f27737043940289e3e9b72afc356063882b9746a0a9751f"
        }
