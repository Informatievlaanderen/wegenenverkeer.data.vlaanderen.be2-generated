          "@language": "nl",
          "@value": "Knipperlantaarn"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Knipperlantaarn"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een lantaarn bestaande uit één of meerdere knipperende oranje-geel verkeerslichten bevestigd op een steun,teneinde de weggebruiker te waarschuwen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
