          "@value": "ExterneDetectie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Inputsignalen bv. van een brug of een overweg, die door een externe partij doorgegeven worden teneinde de verkeersregelaar aan te sturen. Dit object wordt niet gebruikt voor eigen lussen van een ander kruispunt."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De asset hoeft geometrisch niet gelokaliseerd te worden."
        }
