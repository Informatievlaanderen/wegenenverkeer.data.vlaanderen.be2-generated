          "@id": "urn:oslo-toolchain:d532b40f330e1108a40d6fcd8afb1daff40eddb7537f42ad8b57adb1009ef774"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
