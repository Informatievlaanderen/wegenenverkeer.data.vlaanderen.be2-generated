    {
      "@id": "urn:oslo-toolchain:fb66def7cad127dd80d1b0c5e967fa239839e7ef62a4e16904dfe5cd8e92f5a4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Radar",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Radar"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Radar"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een detector die werkt volgens het Doppler-effect. De detectie gebeurt met behulp van een microgolfbundel die in de richting van het wegdek wordt uitgezonden. Gebruikt voor het detecteren van voertuigen,voetgangers en fietsers."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1bfb12a9ada389de7d7a3d49f364956384f1e792e3c4a4d8ab65c52a3a014ecb"
        },
        {
          "@id": "urn:oslo-toolchain:dbccc1379177159d86af78c1e6bd55578e047c292cf7f7b0c19d005c4d9adfa7"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:29bf1ea34849e3b1f78e5370e4f77f2dbde9eff95048817f91cfff4776f57fa6",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#WeggebondenDetector",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Weggebonden detector"
        }
      ],
      "diagramLabel": [
        {
          "@value": "WeggebondenDetector"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Weggebonden detectoren zijn draadloze in het wegdek geïntegreerde radars of magnetische inductiesensoren. Ze zitten ingebed in een cilinder, die geplaatst wordt in het wegdek en die draadloos communiceert met een access point die met de verkeersregelaar verbonden is"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
