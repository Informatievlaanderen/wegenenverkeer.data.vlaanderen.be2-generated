        {
          "@value": "StroomMeetmodule"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Differentieel dat de spanning op de leidingen detecteert en fouten doorgeeft naar de PLC."
        }
      ],
