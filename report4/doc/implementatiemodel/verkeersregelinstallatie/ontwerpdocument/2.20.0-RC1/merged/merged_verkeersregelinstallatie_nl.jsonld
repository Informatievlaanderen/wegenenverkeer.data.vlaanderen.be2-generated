    {
      "@id": "urn:oslo-toolchain:14113c075b36bf7ced25699bf7d5d211ee6b498b08629bdb91ce27ed4d8ff5b2",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Drukknop",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Drukknop"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Drukknop"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Drukknoppen zijn de toestellen die opgesteld zijn op kruispunten om de aanwezigheid te melden van voetgangers of fietsers die de rijweg wensen over te steken of voor het aanmelden van openbaar vervoer. De toestellen sturen een geheugenelement (module voor de sturing en visualisatie) in de verkeersregelaar aan, zodanig dat een kortstondig indrukken van de drukknop of kortstondig aanraken van de sensor volstaat opdat de aanvraag tot doorgang blijft gelden tot de doorgang verleend wordt"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:227377fc68ed9c053c3e02f86398ff966bfcbe23047ff6e2d7dc60b8a1bef97f"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
