      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Niet-selectieve detectielus"
        }
      ],
      "diagramLabel": [
        {
          "@value": "NietSelectieveDetectielus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een niet-selectieve detectielus werkt onder invloed van een wijziging in de zelfinductie van een lus in het wegdek wanneer het metaal van een voertuig binnen het gevoeligheidsgebied van de lus komt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:2cca2617328cedbedb832826a3784ca98436f2885f93a68d768153459ae14da5"
        },
