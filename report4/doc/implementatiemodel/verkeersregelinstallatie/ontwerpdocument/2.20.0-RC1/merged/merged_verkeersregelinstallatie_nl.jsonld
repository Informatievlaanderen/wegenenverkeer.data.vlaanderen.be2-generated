    },
    {
      "@id": "urn:oslo-toolchain:24ee0cd793b09a9eca56153f4ef8f9e7dcf402bc8784da3d9a85470f7b101c16",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#WeggebondenDetector",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Weggebonden detector"
        }
      ],
      "diagramLabel": [
        {
          "@value": "WeggebondenDetector"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Weggebonden detectoren zijn draadloze in het wegdek geïntegreerde radars of magnetische inductiesensoren. Ze zitten ingebed in een cilinder, die geplaatst wordt in het wegdek en die draadloos communiceert met een access point die met de verkeersregelaar verbonden is"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:2cc55fa6630a9baca96389cd55c21edea5a5a500c3e9653865a93d3eb9fad158"
