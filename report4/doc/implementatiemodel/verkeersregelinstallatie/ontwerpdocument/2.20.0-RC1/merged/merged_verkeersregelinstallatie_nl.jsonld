      "@id": "urn:oslo-toolchain:c830a61716d8d506daaef7a615fe7253407236fc9b73ad5f9cb51e80675c9bba",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#StroomMeetmodule",
