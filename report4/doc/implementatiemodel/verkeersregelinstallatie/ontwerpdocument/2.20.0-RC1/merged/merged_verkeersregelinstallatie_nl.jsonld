    {
      "@id": "urn:oslo-toolchain:8852f5e6f9571df43313b941b15fbeba7c91df69d71f15a4ca00da247fd31057",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Verkeerslicht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verkeerslicht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verkeerslicht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte voor verkeerslichten. Dit zijn apparaten, opgesteld naast of boven de weg, om weggebruikers visueel te geleiden over een kruispunt door het gebruik van rode, oranje-gele en groene lichten. De bepalingen van de wegcode zijn van toepassing, meer bepaald titel III, hoofdstuk I, artikelen 61 t.e.m. 64."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
