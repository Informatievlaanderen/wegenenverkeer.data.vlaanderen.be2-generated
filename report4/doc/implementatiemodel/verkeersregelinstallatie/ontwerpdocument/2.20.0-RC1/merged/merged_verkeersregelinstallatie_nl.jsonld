    },
    {
      "@id": "urn:oslo-toolchain:f0c527cafcd7d944b48b960c50ef4217aa45eae01f12eb404f5fa26c498929e7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VRIVirtueleDetectiezone",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Virtuele detectiezone"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VRIVirtueleDetectiezone"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een virtuele detectiezone is een draadloos alternatief voor een traditionele lus. Op basis van GPS gegevens wordt een zone of traject vastgelegd waarbinnen er (al dan niet selectieve) input dient geleverd te worden aan de verkeersregelaar. De virtuele detectiezone kan ook gebruikt worden om de detectiezones van detectiecamera's en radars te inventariseren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:550bdef33a32d0c467ace541f01b849f6bc5de0ca38be08852c52838c8caedb1"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
