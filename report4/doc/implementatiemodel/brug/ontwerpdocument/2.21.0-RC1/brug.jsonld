          "@value": "Pyloon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Pyloon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een pyloon is een taps toelopende hoge constructie, als drager van kabels e.d. (bv. een hoogspanningmast of een mast van een brug)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
