      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Landhoofd uitgerust met kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen (bv. beweging tegengewicht). Deze kan ook afgesloten zijn (niet toegankelijk) en holle ruimtes bevatten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
