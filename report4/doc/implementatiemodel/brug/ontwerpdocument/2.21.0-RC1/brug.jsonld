    {
      "@id": "urn:oslo-toolchain:5be294cc29180c1ec7f72fd4214125177e23c5eabef855482ed2bac5bc9b23c0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#RegelbaarTegengewicht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Regelbaar tegengewicht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RegelbaarTegengewicht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het regelbaar tegengewicht betreft de hoeveelheid massa die relatief eenvoudig kan worden aangepast om een beweegbaar constructieonderdeel vrij nauwkeurig te balanceren; vaak bevindt dit zich in één of meerdere tegengewichtkisten. De hoeveelheid te plaatsen massa wordt bepaald door de vooropgestelde mate van onevenwicht. De massa kan bestaan uit blokken/staven/platen/puin van beton, steen, staal, gietijzer of lood."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b455879b943497f52bc94513da418a139074598b2000e62652b5eeb2e753c9a7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VastTegengewicht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vast tegengewicht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VastTegengewicht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het vast tegengewicht betreft de hoeveelheid massa die onlosmakelijk met de machtarm is verbonden om (mee) het bewegende brugdeel te balanceren. De hoeveelheid massa benadert de vooropgestelde mate van onevenwicht. De massa kan bestaan uit beton, steen, staal, gietijzer of lood dat permanent ingewerkt is in de constructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
