      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen."
        }
