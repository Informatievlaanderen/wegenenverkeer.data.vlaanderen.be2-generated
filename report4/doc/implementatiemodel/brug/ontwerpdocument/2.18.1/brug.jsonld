          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3ceaa0877d766d8ba2fec89785b45336c1e3f53929d338fa786e636b318506e7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Tegengewichtkist",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Tegengewichtskist"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Tegengewichtkist"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De tegengewichtkist is een stevige behuizing die deel uitmaakt van de macht-zijde van balans of een gebalanceerd, beweegbaar brugdeel. Vaak erdoor beschermd tegen nadelige atmosferische invloeden, is er massa (ballast) in ondergebracht om een (regelbaar) tegengewicht te bekomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
