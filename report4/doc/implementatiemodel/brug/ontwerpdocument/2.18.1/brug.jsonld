        }
      ],
      "diagramLabel": [
        {
          "@value": "Landhoofd"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Eindsteunpunt van een brug die de overgang vormt naar het achterliggend grondlichaam én als hoofdfunctie heeft de brug te ondersteunen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
