        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdeel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het deel dat je kan wegnemen van een brug in zijn geheel. Dit kan ook meerdere overspanningen hebben. In het geval van beweegbare bruggen worden de onderdelen die de beweging mogelijk maken zoals balansarmen, tegengewicht, hameipoort,..etc ook gevat in het object brugdeel."
        }
