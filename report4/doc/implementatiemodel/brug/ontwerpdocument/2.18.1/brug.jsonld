    },
    {
      "@id": "urn:oslo-toolchain:f53ff4eeb35af5b6b38ca6e88da9e26a3bcdee7bc8aa9489c78f775944599e1d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Boog",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Boog"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Boog"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een gebogen overspanning (boven een opening), tussen twee steunpunten en ter ondersteuning van een brug, waarbij de druk (ook) zijdelings wordt afgevoerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
        }
      ],
