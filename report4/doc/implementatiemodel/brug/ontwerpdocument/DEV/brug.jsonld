    },
    {
      "@id": "urn:oslo-toolchain:221653ccc57bbe5ecd50b5b6aa9d7f7473fb472feec894018fb1702fd141191f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Tegengewichtkist",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Tegengewichtskist"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Tegengewichtkist"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De tegengewichtkist is een stevige behuizing die deel uitmaakt van de macht-zijde van balans of een gebalanceerd, beweegbaar brugdeel. Vaak erdoor beschermd tegen nadelige atmosferische invloeden, is er massa (ballast) in ondergebracht om een (regelbaar) tegengewicht te bekomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0615148b89ad10831fa02758c0bd420bf7d85bd630cce8df07cd97b871fed1b6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
