      "diagramLabel": [
        {
          "@value": "Brug"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een beweegbare,vaste of drijvende verbinding voor het verkeer tussen twee punten,die door water of iets anders gescheiden zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
