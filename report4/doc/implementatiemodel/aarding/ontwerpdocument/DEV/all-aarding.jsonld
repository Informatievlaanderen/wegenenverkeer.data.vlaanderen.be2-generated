    {
      "@id": "urn:oslo-toolchain:41cd30e3d370ef7895edffe9f27a1c31f84a22ea5bb13a1533088c37822024da",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HoortBij",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hoort bij"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HoortBij"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie geeft aan dat een onderdeel of collectie behoort bij, deel van of lid van een (andere) groep of collectie is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:76029c32ef3d7f2b165d514b61e022083fbfc1eb56fe330edb82c31c3f8c4fae",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HeeftAanvullendeGeometrie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Heeft aanvullende geometrie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HeeftAanvullendeGeometrie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie legt een link tussen een object/onderdeel/installatie en een (bestands)bijlage waar een geometrie aan toegekend is. De richting loopt vanuit het fysiek object naar de bijlage met geometrie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:009b169aa35f59ec65b8d16bffc53902aca7b4fb8a7f46960617b7db89fe9991",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:022034a7a8929a0a08652c4ff7939e3388390a4896a3571f9e0513b802efeea0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a14cd2b3ab1d06f95959b6b955ba435acf2265ccab0979859060de759476c6d4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c1e2fc7646da9559f2ff979440b18b271598fbb765b3a38831886922ef30d563",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingskabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingskabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingskabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aardingskabel is een geleidende verbinding,typisch uit koper,die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5e2e794244bda48ac89d58929b3fe26d3f87e90b9b8a883aaa46a7203535fe20"
        },
        {
          "@id": "urn:oslo-toolchain:f86100d0d124704e890b28639faf990b01b0c3575ae501a3bc5d9611b420805f"
        },
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f1637e64a366ee3478b3948f468532929375074fa2d7f619da8c192a888c9b21",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#EquipotentiaalVerbinding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Equipotentiaal verbinding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EquipotentiaalVerbinding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een equipotentiaal verbinding, ook wel equipotentiaalgeleider genoemd, voorziet de galvanische verbinding van een metalen object, dat in normale toestand niet stroomvoerend is, met het aardingsstelsel. Deze verbinding mag als aardingsgeleider derhalve nooit verbroken worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:371862ed2bb2f62847aeee11e567ec12ef36b1669e3d052a92a30dc7bbcadff2",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingspen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingspen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingspen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1dde0a2ac8c642bb4e6b2df7f09515a2b0bad3350d4934b8740c0f241d31cc68",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingsonderbreker",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsonderbreker"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsonderbreker"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verbindingsklem waarop de aardgeleider(s), de hoofdbeschermingsgeleider(s), en de hoofdequipotentiaalgeleider(s) toekomen. Het gaat om een T-vormige klem, waarbij de functie van meetklem en hoofdaardingsklem wordt gecombineerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b360f75aca612931e52d6733798dfcfd79ad63f97cacd82c657ce631d2210ca1",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingslus",
