    },
    {
      "@id": "urn:oslo-toolchain:f144285ec75da24d8839f63ebff03f80f9004dc83c9120f00d5ba80bb823bfbb",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#HoortBij",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hoort bij"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HoortBij"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie geeft aan dat een onderdeel of collectie behoort bij, deel van of lid van een (andere) groep of collectie is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:97a6855c4fc35c83ab82824ada443a8e33e5204a6aca1567a28d38e4ead0a191"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f4f39c6d51fc072a7719f108389a65c5d5e6d46b74710d068b218e925c930785",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#HeeftAanvullendeGeometrie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Heeft aanvullende geometrie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HeeftAanvullendeGeometrie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie legt een link tussen een object/onderdeel/installatie en een (bestands)bijlage waar een geometrie aan toegekend is. De richting loopt vanuit het fysiek object naar de bijlage met geometrie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:97a6855c4fc35c83ab82824ada443a8e33e5204a6aca1567a28d38e4ead0a191"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:4ec8b35b3609356ffed7f94f41481f234f0e103df5964da2c5f072172b67cdc7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5788184b8ef5ab3da274551fcff51fd50a84d2a53a40e60aa946ecbc822e37ee"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1ca52c1e139000f988d664144d2cae3eb698c7661673945539f3c79c7e1b212c",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:97a6855c4fc35c83ab82824ada443a8e33e5204a6aca1567a28d38e4ead0a191"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9c778e437967feb980288ee7cbdd4ead7bfb5379016f880a08a8ed7a92fafc76",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingskabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingskabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingskabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aardingskabel is een geleidende verbinding,typisch uit koper,die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fd938d24f1fe066b830a7e156994cd113725f35a93815ceb10a20737e62efcf0"
        },
        {
          "@id": "urn:oslo-toolchain:8bd977e464ec89860e4126e84f11db5b19247db92c993c27b44ecf8b05208e60"
        },
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1cb4d8006a6a0d2f3ede97b47af7f8fd64a9965c534da591b0d19d700cb4793e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#EquipotentiaalVerbinding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Equipotentiaal verbinding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EquipotentiaalVerbinding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een equipotentiaal verbinding, ook wel equipotentiaalgeleider genoemd, voorziet de galvanische verbinding van een metalen object, dat in normale toestand niet stroomvoerend is, met het aardingsstelsel. Deze verbinding mag als aardingsgeleider derhalve nooit verbroken worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f944dc36a63d820100f1714529971cc0804194376d0a166f6d686a2bbb62696f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingspen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingspen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingspen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:aca520965d0761a9ce2a18be419ee3b53ecf9b86065df5986026b27c22ec591f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingsonderbreker",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsonderbreker"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsonderbreker"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verbindingsklem waarop de aardgeleider(s), de hoofdbeschermingsgeleider(s), en de hoofdequipotentiaalgeleider(s) toekomen. Het gaat om een T-vormige klem, waarbij de functie van meetklem en hoofdaardingsklem wordt gecombineerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9ffdf74404327b99a4b9574521645a682b822762c17f8123792dfbdbd6147a3b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingslus",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingslus"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingslus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een koperen geleider die onder de fundering van een gebouw de contouren van het te aarden gebouw volgt. De lus vertrekt en komt aan op de aardingsonderbreker."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:fd938d24f1fe066b830a7e156994cd113725f35a93815ceb10a20737e62efcf0"
        },
        {
          "@id": "urn:oslo-toolchain:8bd977e464ec89860e4126e84f11db5b19247db92c993c27b44ecf8b05208e60"
        },
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:77148b9a13f3c6f5694e84dc198593777e06bc59808cd4199c88ce1d07b34026",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingsplaat",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsplaat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geleidende metalen plaat die in de grond wordt begraven en verbonden is met een elektrisch systeem om een veilige weg te bieden voor foutstromen en deze af te voeren naar de aarde."
