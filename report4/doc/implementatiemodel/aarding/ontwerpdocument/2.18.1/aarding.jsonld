      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een galvanische verbinding van een elektrische installatie met de aarde. De elektrische installatie die op deze wijze met de aarde wordt verbonden krijgt een spanning van nul volt."
        }
