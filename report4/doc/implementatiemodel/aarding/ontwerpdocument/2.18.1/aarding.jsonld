    },
    {
      "@id": "urn:oslo-toolchain:517735f419dbf628b1c95ec5b6273e582cd6c104225383dc5cca725bfeb1997f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HoortBij",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hoort bij"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HoortBij"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De relatie geeft aan dat een onderdeel of collectie behoort bij, deel van of lid van een (andere) groep of collectie is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2d26412b3349658d9a7b69559db351b3f9a2be5a90da05a632de15ab17aeea61",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#HeeftAanvullendeGeometrie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Heeft aanvullende geometrie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HeeftAanvullendeGeometrie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie legt een link tussen een object/onderdeel/installatie en een (bestands)bijlage waar een geometrie aan toegekend is. De richting loopt vanuit het fysiek object naar de bijlage met geometrie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:504be097ad6fa652dba6787ee9e2cd5ebc62e074e6730e3d2a239f8161ca1d0a",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ed683849367dcb78939a30ba21508d2b5cac2d3a07293cbedc32dbc9b3591084"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:f665512fdec2a8b2c8b55087624bf351671e97f7b79e06a0cba2c7afa06039dd",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:46edf83d3ac3c3a9a050008c1b7a6eb8c2afc5195496b4fc3b36cc27e3168f9e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a1e87a8333fcedae575ac84277a686db64c2621d764984b2227341c8b178ccbb",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingskabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingskabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingskabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aardingskabel is een geleidende verbinding,typisch uit koper,die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6a70fc9bb8bd2382b6d1faa8aa5375a5350d2aff14a44f2bea2d1e1a95027387"
        },
        {
          "@id": "urn:oslo-toolchain:657ec6a6df2524cc3cf15835254b42a212c449b33f3c3597ae3d0d395f3af789"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:27624ac83f65bba2c381adc3ac65fd9d130919cfed860de3bfd38364a6b668da",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#EquipotentiaalVerbinding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Equipotentiaal verbinding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EquipotentiaalVerbinding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een equipotentiaal verbinding, ook wel equipotentiaalgeleider genoemd, voorziet de galvanische verbinding van een metalen object, dat in normale toestand niet stroomvoerend is, met het aardingsstelsel. Deze verbinding mag als aardingsgeleider derhalve nooit verbroken worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d9a545fe1798121dab886e22e8b62837bf5a7d7d4a5ce48e82db8dea368265bc",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingspen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingspen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingspen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c9cac8498e80306f2737c61e2455401b09c56e4daa8ab7f923fc0ebff31068a6",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingsonderbreker",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsonderbreker"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsonderbreker"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verbindingsklem waarop de aardgeleider(s), de hoofdbeschermingsgeleider(s), en de hoofdequipotentiaalgeleider(s) toekomen. Het gaat om een T-vormige klem, waarbij de functie van meetklem en hoofdaardingsklem wordt gecombineerd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0715425c86e3d2f618726ea63bf89ebba3b63b1eb6658bbcc63ae7fa3ff10dcd",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingslus",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingslus"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingslus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een koperen geleider die onder de fundering van een gebouw de contouren van het te aarden gebouw volgt. De lus vertrekt en komt aan op de aardingsonderbreker."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:6a70fc9bb8bd2382b6d1faa8aa5375a5350d2aff14a44f2bea2d1e1a95027387"
        },
        {
          "@id": "urn:oslo-toolchain:657ec6a6df2524cc3cf15835254b42a212c449b33f3c3597ae3d0d395f3af789"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:821e0594e8610fa5620beeaa71c98198cd477416bb6b387d246ef6b20ab31389",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingsplaat",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsplaat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geleidende metalen plaat die in de grond wordt begraven en verbonden is met een elektrisch systeem om een veilige weg te bieden voor foutstromen en deze af te voeren naar de aarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:61bcbf2fe371da6762b0d328277225a4f1b9faa7f1b8391e2576aab5216af966",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Aardingsrooster",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsrooster"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsrooster"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een raster dat wordt gebruikt voor de aarding van elektrische installaties. Het biedt een veilige afvoer van elektrische stroom naar de aarde, waardoor de kans op elektrische schokken en schade aan apparatuur wordt verminderd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
