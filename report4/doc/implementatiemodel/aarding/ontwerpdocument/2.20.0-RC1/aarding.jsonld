          "@value": "Ingress Protection Codering"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlAlgIngressProtectionCode"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De IP-codering als een aanduiding voor de mate van beveiliging van de constructie van elektrische of elektronische apparatuur tegen eigen schade door gebruik in 'vijandige omgevingen' en tegen eventueel gevaar voor de gebruiker volgens IEC 60529."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
