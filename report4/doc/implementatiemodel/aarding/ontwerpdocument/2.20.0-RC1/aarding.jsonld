      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Aardingsrooster",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingsrooster"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingsrooster"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een raster dat wordt gebruikt voor de aarding van elektrische installaties. Het biedt een veilige afvoer van elektrische stroom naar de aarde, waardoor de kans op elektrische schokken en schade aan apparatuur wordt verminderd."
        }
