    {
      "@id": "urn:oslo-toolchain:a04a58433054bcf067e065de81f99223f0bc48492109d3350a7d368401785b88",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Halsbeugelmechanisme",
