    {
      "@id": "urn:oslo-toolchain:a70fbfd8814cae97a83c7181d7a0e7a8779a3ff7fa955bfaf883712e3a584738",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Drukvat.maximaleDruk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "maximale druk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "maximaleDruk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De hoogste druk die het drukvat kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van het drukvat. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij het drukvat geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat het drukvat faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:33f1a5c8e281ff5981ef4ceed50222f98b2a20762209eeb249ea6f22d23831f6"
