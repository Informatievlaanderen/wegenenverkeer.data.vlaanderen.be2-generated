      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stootblok is een element dat specifiek is voorzien om enige mechanische impact van een bewegend (brug)deel op te vangen en zo schade aan de overige delen te voorkomen."
        }
      ],
