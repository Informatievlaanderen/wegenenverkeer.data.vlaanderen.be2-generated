    },
    {
      "@id": "urn:oslo-toolchain:67e22ea732b10fb9478ac336dc8d08436da3f205cc17c5b8b2ef8d7bff75dfd5",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#HoortBij",
