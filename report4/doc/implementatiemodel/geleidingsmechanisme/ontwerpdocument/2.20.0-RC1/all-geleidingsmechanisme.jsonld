        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Mechanisch element dat een bewegingsmechanisme of geleidingsmechanisme verbindt met de bouwkundige constructie. Het is meestal d.m.v. ankers bevestigd in een (betonnen) vloer of wand."
        }
