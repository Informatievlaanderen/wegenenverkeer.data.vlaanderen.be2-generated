          "@language": "nl",
          "@value": "Halsbeugelmechanisme"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Halsbeugelmechanisme"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dient om de beweging van de waterkerende constructie, meer bepaald puntdeur of draaideur, te geleiden. De geleiding bestaat hoofdzakelijk uit een rotatie om een verticale as en soms mogelijk ook een translatie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:200346dd26067d58c01ee0666f4100dc5c7d9f1f278e0fcbb86a82c00532afce"
