      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanisme dat de beweging van een beweegbare constructie blokkeert. Het bestaat uit een grendel die in een vaste of beweegbare constructie schuift of draait om beweging te verhinderen."
        }
      ],
