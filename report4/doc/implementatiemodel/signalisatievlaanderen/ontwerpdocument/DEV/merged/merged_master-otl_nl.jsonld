      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Pijler",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Pijler"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Pijler"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een pijler is een steunpilaar die fungeert als vrijstaande drager en een steunpunt vormt tussen landhoofden voor de liggers of gewelven van een kunstwerk."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        }
      ],
