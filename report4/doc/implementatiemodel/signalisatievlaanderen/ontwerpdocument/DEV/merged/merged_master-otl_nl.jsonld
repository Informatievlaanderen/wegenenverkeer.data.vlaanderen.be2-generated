    {
      "@id": "urn:oslo-toolchain:c160b334a479a73a88b23e024ae8ddf0016c62dbd5cfe773d3fde4b6ca047224",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerlichtingstoestelTL",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verlichtingstoestel TL"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerlichtingstoestelTL"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het geheel van de TL-lamp en de behuizing die werden samengesteld met als doel:* de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen;* de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt;* het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:664740d796595b38a2ed71be85d35da1d4f766d943897b24241cdfbe862f56f9"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
