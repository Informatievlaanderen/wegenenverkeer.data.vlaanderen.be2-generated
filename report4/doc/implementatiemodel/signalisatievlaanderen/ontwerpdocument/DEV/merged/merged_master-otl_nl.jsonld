    {
      "@id": "urn:oslo-toolchain:d115facff448e54edf9914fc72668976456f85023c194e0f7dca92c92a840c8b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Glijlager",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Glijlager"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Glijlager"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een machineonderdeel met als functie het toelaten van rotatie of translatie van een as. Bij een glijlager glijdt de as in een vast lager,het verlagen van de wrijving tussen as en lager gebeurt door smering of door het materiaal van het lager."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:40b8f68faaf2d2e24df2f46ce878bc492f5120e0a623be2f0fd634ec7ab4c99f"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d59b1b22fc94bb056df2320e7272021a6e133aa9d333ce54571ee7b502e3558c",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#ElastischElement",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Elastisch element"
        }
      ],
      "diagramLabel": [
        {
          "@value": "ElastischElement"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een elastisch of flexibel element is een onderdeel van een mechanische koppeling en zorgt voor het dempen van trillingen en schokken. Het wordt meestal tussen twee naven geplaatst."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        },
        {
          "@id": "urn:oslo-toolchain:c255b95929686dd111e211fb32a07d9d5a78513a5e47bf9d8f94d19fe5de6cdf"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5cb571181f8d8efdc7f8bf3429da024cc396b0860a80523efb32cd40dfa611b9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Waaier",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Waaier"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Waaier"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanische constructie die bestaat uit een aantal schoepen. Deze schoepen brengen de mechanische energie van de aandrijflijn, in de vorm van een roterende beweging, over naar het te verpompen medium. Men spreekt dan van een pomp. In het omgekeerde regime, waarbij er energie wordt overgedragen van de vloeistof op de aandrijflijn, spreekt men van een turbine. Wordt ook wel impeller genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8977f46181df02fcd9662a87739db2e5bc9579e5081fd4da1f29796a0428abd9"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:47e38be730688ca18fef3f87eb0f2ead257874bdd193f6d8ce514ed09ede3b5c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Toestelventlaitor modelnamen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlToestelventilatorModelnaam"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lijst met modelnamen van ventilatoren gebruikt voor de koeling van toestellen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlToestelventilatorModelnaam",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5e6939d3ba4fee42ed3dc5197d508da2c8f467f4081aed6e17d3168bcee43612",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Lagerblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lagerblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lagerblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een behuizing waarin een lager is bevestigd. Wordt ook wel lagerhuis genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        },
        {
          "@id": "urn:oslo-toolchain:23f003cf68ffa298d0a859d0d84df0540e7a31ca132425a34b4c641019a6a71e"
        },
        {
          "@id": "urn:oslo-toolchain:47c14777cdfff9d9e003eeefaa2ab952641f2e51f5c763c00cb24fa8bf1da500"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ab34dedf24ae39df4e967f4e8c4ef03b99fb51139ccd306fd73c0165567d0e15",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aandrijfas",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aandrijfas"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aandrijfas"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een as die deel uitmaakt van een aandrijflijn en die dus een kracht overbrengt van een aandrijvend element naar een aangedreven element. Een aandrijfas kan aangedreven worden door o.a. een elektromotor, een verbrandingsmotor, een hydromotor, etc. Het aangedreven element kan een schoepenwiel van een pomp, een tandlat/tandrondsel, etc. zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:c2aa744b3e931b3e086bf440590f1a114e01dd82ef82fbfea3a4b611f39c56a5",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Riemschijf",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Riemschijf"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Riemschijf"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een riemschijf of poelie wordt op een as bevestigd en brengt het vermogen dat door de as geleverd wordt over op een riem, of omgekeerd. Een riemschijf is samen met een riem en riemspanner onderdeel van een riemoverbrenging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
