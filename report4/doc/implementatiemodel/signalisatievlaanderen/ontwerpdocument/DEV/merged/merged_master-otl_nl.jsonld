          "@id": "urn:oslo-toolchain:ecb6a787704e8835402e0a69f76cfa8cdaeab467e4b28c094670425688004f49"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
