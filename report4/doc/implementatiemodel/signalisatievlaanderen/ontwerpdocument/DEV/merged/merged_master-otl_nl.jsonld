    {
      "@id": "urn:oslo-toolchain:d562bea9238aba16cbcc5a767f1bf6ea1078c1164317ce0c03649dab5e6248d0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Binnenverlichtingstoestel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Binnenverlichtingstoestel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Binnenverlichtingstoestel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verlichtingstoestel dat binnen in een gebouw geplaatst wordt. Een verlichtingstoestel is de combinatie van de lamp en de armatuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ecb6a787704e8835402e0a69f76cfa8cdaeab467e4b28c094670425688004f49"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:dee8a9eb2ed0a28655df2094a65513fbfc81fbeac0c72053d6087615036dd3d3",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingskabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingskabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingskabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aardingskabel is een geleidende verbinding,typisch uit koper,die ervoor zorgt dat een ongewenste elektrische stroom (foutstroom) op een installatie naar de aarde kan afgeleid worden."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Dit type verwijst naar een kabel die enkel de aarding als functie heeft en niet de geel-groene draad in een voedingskabel. Die laatste maakt impliciet deel uit van de voedingskabel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        },
        {
          "@id": "urn:oslo-toolchain:d6deec48d3a49c34f38788783cefd5b413ff609220ce7e894f84e774c923ce66"
        },
        {
          "@id": "urn:oslo-toolchain:428f949f8900f1d4cda6014585e412fb285f5f05c884b20de8ccb8c8f7e44a3d"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:1d6980aedf9c4c10999fd7207755b1ce814f7540e78b27ae4da8c40cca6cbbed",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#EquipotentiaalVerbinding",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Equipotentiaal verbinding"
        }
      ],
      "diagramLabel": [
        {
          "@value": "EquipotentiaalVerbinding"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een equipotentiaal verbinding, ook wel equipotentiaalgeleider genoemd, voorziet de galvanische verbinding van een metalen object, dat in normale toestand niet stroomvoerend is, met het aardingsstelsel. Deze verbinding mag als aardingsgeleider derhalve nooit verbroken worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:bf13305e9733eb27c2018d80fe2c89674fbd1a593e278e430d8ecc0b134a6048",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Aardingspen",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aardingspen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Aardingspen"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De aardingspen is het deel van de aardingsinstallatie dat in direct contact staat met de grond / de aarde."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5291364550bf507780493b8454271ee6a14b590a45f5b56b1fc322e9f8feb8f6"
