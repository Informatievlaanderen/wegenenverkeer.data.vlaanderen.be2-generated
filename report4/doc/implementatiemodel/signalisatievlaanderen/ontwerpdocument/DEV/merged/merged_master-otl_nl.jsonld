    {
      "@id": "urn:oslo-toolchain:8be13aa0c2f88f080170cb95324be226137c67f0c1f6847d67d8c23bbab40118",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerlichtingstoestelHgLP",
