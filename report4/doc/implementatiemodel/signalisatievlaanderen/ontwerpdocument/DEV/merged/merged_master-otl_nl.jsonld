    {
      "@id": "urn:oslo-toolchain:5a77400e68f4a47ed1411a058eeddcf61206db4a60a4a179dba40f3ff9417e7b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Heftoren",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Heftoren"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Heftoren"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een heftoren is een vrijstaand hoofdconstructieonderdeel dat als singulier steunpunt (mee) instaat voor het verticaal steunen en begeleiden van een beweegbaar constructieonderdeel wanneer dat niet rust op zijn vaste steunpunten (meestal een brugdeel of beweegbare waterkerende constructie). Meestal herbergt een heftoren een mechaniek met ook een tegengewicht en steekt het, samen de overige, gelijkaardige heftorens, hoog boven de rest van het kunstwerk uit."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17372beb0b6ece25f2cfe29aa208a4e65e49834a0f18c17ae8f1f681b195d3ba"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
