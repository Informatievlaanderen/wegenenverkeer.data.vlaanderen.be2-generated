      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een haalkom is een voorziening in een sluis- of kademuur waaraan men een schip kan vastmaken."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
