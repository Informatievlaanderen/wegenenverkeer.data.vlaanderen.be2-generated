    {
      "@id": "urn:oslo-toolchain:9c95bfd0fec581d81ba0c3e9ab67400de93f342445a9455d96b56174daa90735",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SelectieveDetectielus",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Selectieve detectielus"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SelectieveDetectielus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De selectieve detectielussen moeten bepaalde voertuigen toelaten het kruispunt prioritair te dwarsen. Daarvoor zijn die prioritaire voertuigen uitgerust met een zendtoestel dat gecodeerd informatie doorstuurt naar een datalus in het wegdek. Deze lus is verbonden met een demodulator die de informatie decodeert en doorstuurt naar de verkeersregelaar van het te dwarsen kruispunt"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:77b27bd3b17a8cca0b2ef8d84a5fd0f846f62f595c315086a82ab876412f916a"
