    {
      "@id": "urn:oslo-toolchain:1bb6a216579211f2fdda8af703e9f1f96b99726cd31b512375dae15b5a124c4e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Hameistijl",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hameistijl"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hameistijl"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hameistijl is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. De verticale (kolom)structuur staat op de onderbouw, aan de scharnierzijde. Samen met een tweede hameistijl draagt het de balans die bovenaan scharnierend ermee verbonden is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17372beb0b6ece25f2cfe29aa208a4e65e49834a0f18c17ae8f1f681b195d3ba"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:eed2d8970d67341fb731c2defa0b37a6c72a04923a6332e39074a621bb15fe06",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vast tegengewicht materiaal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "KlVastTegengewichtMateriaal"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De mogelijke materialen van een vast tegengewicht."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlVastTegengewichtMateriaal",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:6ef4a5a08f631c715c8ecaff24b59305a6f26cae6d6a819ac9357ebc939646b7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balans",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Balans"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Balans"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balans is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Klassiek bestaat het uit: twee balansarmen en hun onderlinge verbinding(en) met aan één zijde twee trekkers en aan de andere zijde een tegengewicht(kist). Een balans wordt scharnierend verankerd aan de bovenzijde van een hameipoort of aan die van (twee) hameistijlen. Dankzij dit onderdeel kan het met de trekkers verbonden val (ook 'klap') met het tegengewicht zodanig gebalanceerd worden, dat er weinig arbeid moet geleverd worden om dit brugdeel eenzijdig te kunnen lichten van zijn oplegging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17372beb0b6ece25f2cfe29aa208a4e65e49834a0f18c17ae8f1f681b195d3ba"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8f64762843342c072dc00b299d341cca704e6e4de277af68c546bd30064ff4f9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Hameipoort",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hameipoort"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Hameipoort"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een hameipoort is een hoofdconstructieonderdeel van een beweegbare brug, type ophaalbrug. Het is een portaalstructuur die staat op de onderbouw, aan de scharnierzijde. Het draagt bovenaan de volledige balans die er scharnierend ermee verbonden is."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17372beb0b6ece25f2cfe29aa208a4e65e49834a0f18c17ae8f1f681b195d3ba"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:be80a9b1c6a3a1153fc7e88b922f1d20bd3b6aefc309dfedcbe62cde29c77ae0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Balansarm",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Balansarm"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Balansarm"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel van een balans. Er kunnen één of meerdere balansarmen aanwezig zijn. Het is typisch een lange, horizontale arm die aan lastzijde via een trekker verbonden is met het beweegbare brugdeel ('het val' of ook 'de klap') en aan machtzijde het gebruik van tegengewicht mogelijk maakt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:17372beb0b6ece25f2cfe29aa208a4e65e49834a0f18c17ae8f1f681b195d3ba"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
