    {
      "@id": "urn:oslo-toolchain:c6a052225ff74f307cf59b2e6b5a739f7ed64c76ada35d01cdf7b5c23d9622ec",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedingskabel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voedingskabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voedingskabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Zorgt voor het overbrengen van een elektrisch vermogen van de ene locatie naar de andere binnen een privaat netwerk. Onder dit type vallen ook installatiedraden die beschouwd worden als kabels met slechts één ader."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het gaat om voedingskabels die niet behoren het het openbaar nutsvoorzieningennet. Binnen het eigen netwerk kan een entiteit de voedingskabels ter beschikking stellen en beheren voor anderen binnen dezelfde (overkoepelende) entiteit. Ook in dat geval is er nog steeds sprake van voedingskabels."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cf5c4f028b796cf61158264aa20657e0d978f95134465ca8764ff6cbde155d44"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
