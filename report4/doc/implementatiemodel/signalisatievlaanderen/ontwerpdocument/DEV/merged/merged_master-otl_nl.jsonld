        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7d1014edf529a206dbd8acaab1fdf5060ee33c85cf1800bf45bb4a882a618b97",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Brug",
