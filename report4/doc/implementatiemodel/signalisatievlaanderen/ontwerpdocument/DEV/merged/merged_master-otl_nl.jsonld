    {
      "@id": "urn:oslo-toolchain:78255ff8f3d2fe5d50a2d7877daea7fcdd72bb2c4a414bd9b34e6c4faa3dfb63",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kabelgoot",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kabelgoot"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kabelgoot"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een inrichting die ervoor zorgt dat een kabel beschermd is tegen beschadiging en/of op een gecontroleerde plaats blijft hangen of liggen. Een kabelgoot is doorgaans een halfopen constructie. Er bestaan ook kabelgoten die door een deksel gesloten kunnen worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:885e41e1751ad1c02ff2fef14646e286394849c282ba508952e20f3fe2795d66"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
