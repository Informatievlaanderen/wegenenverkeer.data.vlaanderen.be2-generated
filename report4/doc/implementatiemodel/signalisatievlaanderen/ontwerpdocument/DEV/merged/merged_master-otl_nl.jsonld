    {
      "@id": "urn:oslo-toolchain:31c8a78149b4860668857cec8ce6cbf64c79403db7a1d959e43d3871a7ba954b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brugdekvoeg",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Brugdekvoeg"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Brugdekvoeg"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Voegconstructie die dient om een opening te overbruggen. Voldoende vervormbaar om zich te kunnen aanpassen aan de bewegingen van de boorden en weerstandbiedend om belastingen te kunnen opvangen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
