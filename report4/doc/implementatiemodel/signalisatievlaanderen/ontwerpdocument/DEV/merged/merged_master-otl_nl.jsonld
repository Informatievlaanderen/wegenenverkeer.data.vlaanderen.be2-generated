    },
    {
      "@id": "urn:oslo-toolchain:b0adb17e7e9ee68be098ecfbc9e8e5aceb9e985e21e26261467936aba84d7662",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#WeggebondenDetector",
