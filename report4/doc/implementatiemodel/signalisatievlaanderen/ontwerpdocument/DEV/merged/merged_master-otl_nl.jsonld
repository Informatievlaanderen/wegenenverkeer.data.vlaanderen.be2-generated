    {
      "@id": "urn:oslo-toolchain:2a7dc7f953d4ea5a78ce6cc6b42125b8a072a31651c046d422b6535b55e9a0d0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Kelderlandhoofd",
