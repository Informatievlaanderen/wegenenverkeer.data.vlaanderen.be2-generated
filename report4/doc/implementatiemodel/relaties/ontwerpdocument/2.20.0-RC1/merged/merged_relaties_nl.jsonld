          "@value": "Heeft toegangsprocedure"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HeeftToegangsprocedure"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie wordt gelegd tussen een klasse en de klasse Toegangsprocedure. De relatie vertrekt vanuit de klasse Toegangsprocedure en geeft aan dat er een toegangsprocedure van toepassing is voor een object."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
