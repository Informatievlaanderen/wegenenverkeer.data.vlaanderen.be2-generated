    },
    {
      "@id": "urn:oslo-toolchain:27d4093a0f803d95b434b08a9a93ead2cd1973647ebfdaf03a5afd04b1728e1c",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#IsInspectieVan",
