    {
      "@id": "urn:oslo-toolchain:f31cd12f84cd695c9046277f834cba5b799c90bd2a7d39c12e57fd7c6bfac618",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HydrostatischeNiveaumeting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Hydrostatische niveaumeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HydrostatischeNiveaumeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een inrichting voor het bepalen van het peil van een vloeistof (bv. het waterniveau in een vloeistoftank of lekwaterput van een kelder). De sensor meet de hydrostatische druk (gewicht) van een vloeistof en bepaalt met deze gegevens het niveau van de vloeistof. Het resultaat wordt omgezet in een uitleesbaar signaal."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:36e6e68929e40593e75240fb7bba0b31fc5e1c137812479715636c690c3ccda6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:39946a60348ef72169d065f663894ed719d4c14c92f80ed5de0b7cf3c5c3d625",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#CapacitieveNiveaumeting",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Capacitieve niveaumeting"
        }
      ],
      "diagramLabel": [
        {
          "@value": "CapacitieveNiveaumeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een inrichting voor het bepalen van het peil van een vloeistof (bv. het waterniveau in een vloeistoftank of lekwaterput van een kelder). Een capacitieve sensor meet de aan- of afwezigheid van een materiaal of vloeistof. Het meest gebruikte type is de driepunts elektrode, hierbij krijgt elke elektrode een eigen grenswaarde, uit de combinatie van de gegeven die de verschillende elektroden oplevert kan het niveau bepaald worden. Het resultaat wordt omgezet in een uitleesbaar signaal."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:36e6e68929e40593e75240fb7bba0b31fc5e1c137812479715636c690c3ccda6"
        },
        {
          "@id": "urn:oslo-toolchain:95a98ceddbe45ec07c2c986e4875e7307417679f9709b1ca99dac8cc6ac31809"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
