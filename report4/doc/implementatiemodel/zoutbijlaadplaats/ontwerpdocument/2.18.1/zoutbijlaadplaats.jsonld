        {
          "@value": "TrekdraadEncoderNiveaumeting"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een inrichting voor het bepalen van het peil van een vloeistof (bv het peil van een waterloop, uitgedrukt in meter TAW). Deze inrichting maakt gebruik van een combinatie van vlotter-kabel-encoder. Het resultaat wordt omgezet in een uitleesbaar signaal."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het betreft de hele inrichting, dus zowel de trekdraad encoder als de vlotter."
        }
      ],
