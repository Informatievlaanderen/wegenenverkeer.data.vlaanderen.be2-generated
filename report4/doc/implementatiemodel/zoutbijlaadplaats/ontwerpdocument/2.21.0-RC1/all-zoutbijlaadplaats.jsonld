    {
      "@id": "urn:oslo-toolchain:76658856507a65452d8201a8f5fa21e130ccd59c80f023cb92aeb73be352fb54",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.opstelhoogte",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "opstelhoogte"
        }
      ],
      "diagramLabel": [
        {
          "@value": "opstelhoogte"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De hoogte waarop de camera bevestigd is, gemeten ten opzichte van het maaiveld waarin de draagconstructie voor de camera verankerd is."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De plaats waar de draagconstructie in de grond bevestigd is, bepaalt van waar gemeten wordt voor het bepalen van de opstelhoogte. Wanneer een camera die een brugdek overziet, bevestigd is aan een paal die naast de brug staat, wordt de hoogte gemeten vanaf de basis van de paal en niet vanaf het brugdek."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:8601e5bac1df9e44678f4f43ef290fce094da9f0686ed9dec87d3827517fa95b"
      },
