    {
      "@id": "urn:oslo-toolchain:189f6185df92c0638134226051cb78c6888720f25af43162782559e077bbc85c",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
        {
          "@language": "nl",
