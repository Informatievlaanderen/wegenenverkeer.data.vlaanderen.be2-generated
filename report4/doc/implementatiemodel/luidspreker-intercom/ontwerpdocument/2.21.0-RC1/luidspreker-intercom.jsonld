    {
      "@id": "urn:oslo-toolchain:012d90c74664eaaf3f1e1512f336db1b2cc7e9aeb4aa7c193f01070db1a589b0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Meetmicrofoon",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Meetmicrofoon"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Meetmicrofoon"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een microfoon is een elektromechanisch instrument dat geluid omzet in een elektrisch signaal. Een meetmicrofoon registreert de geluidsdruk, is gevoelig voor geluid uit alle richtingen en heeft een vlakke frequentiekarakteristiek. Nauwkeurigheid is hier belangrijker dan geluidskwaliteit. In een tunnel meet de microfoon het geluidsniveau in de tunnel om het volume van een luidspreker aan te kunnen passen om zo verstaanbaar mogelijk te communiceren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d355c25b7a720fb3b04b68afa442d799f60a1a05c89c786017ed237fe0b8c503"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
