    {
      "@id": "urn:oslo-toolchain:0599c23495b529e01153a7b3d0f39c83d8eebb5f15504af4ba8bbcfef2e71ea0",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Kopmuur",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kopmuur"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kopmuur"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een kopmuur is een inrichtingselement van de wegbaan, dat gebruikt wordt voor de geleiding van verkeer bij grachten. Een kopmuur is een keermuur die een functie vervult van afwateringssysteem en is in de regel haaks op de hartlijn van de wegcorridor georiënteerd. Afgeschuinde varianten worden als meer vergevingsgezind gezien bij een aanrijding."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5535d0613f21375573e4f083e95e1e2e4c8470467560120b8d15a941b708cc82"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
