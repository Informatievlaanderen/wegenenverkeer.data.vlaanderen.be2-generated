          "@language": "nl",
          "@value": "heeft betrokkene"
        }
      ],
      "diagramLabel": [
        {
          "@value": "HeeftBetrokkene"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Koppelt een natuurlijk persoon,rechtspersoon of een hoedanigheid (een functie eerder dan de persoon die de functie uitoefent) aan een object in een bepaalde rol."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
