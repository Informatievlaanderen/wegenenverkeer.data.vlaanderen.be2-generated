    },
    {
      "@id": "urn:oslo-toolchain:dd9f571e6906fcc29516a46e4069e792a61dee7c0f7eefa45ff737b731a38578",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#HeeftToegangsprocedure",
