    {
      "@id": "urn:oslo-toolchain:9983a882b0651503c58328ffeb4329202639cc414162d5283df37a562ff6efd5",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#ElektrischeKeuring",
