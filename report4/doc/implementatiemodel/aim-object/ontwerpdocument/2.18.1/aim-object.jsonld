    {
      "@id": "urn:oslo-toolchain:bc2aa728051c2a9ee89878a99ea5b72a1556cc47200f68e6480aafb093def8ff",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#AanvullendeGeometrie",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Aanvullende geometrie"
        }
      ],
      "diagramLabel": [
        {
          "@value": "AanvullendeGeometrie"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Beschrijft een geometrie die aanvullend is bij de de werking van een asset maar beschrijft niet de asset zelf, bv. een detailplan of een werkingsgebied met een specifieke locatie, enz...De aanvullende geometrie kan al dan niet een bijlage bevatten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a587e4924c1b6520056dba3fbcc8aadbc1bcf22120251ab323d597feb703e2f0"
        }
      ],
