    {
      "@id": "urn:oslo-toolchain:28ae8dad5bb1fc6bafcd780564e2fb345aa30b96f4a226dd4f8d52089fd217aa",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#ElektrischeKeuring",
