        {
          "@language": "nl",
          "@value": "Bijlage"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bijlage"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een bestand (document,afbeelding,...) dat behoort tot 1 of meerdere assets."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Voor bijlagen die meerdere assettypes behandelen of aanvullende informatie bieden. Voor specifieke informatie van de asset, en waarvoor een eigenschap gedefinieerd is bv. technische fiche, detailplan, moet deze opgenomen worden via deze eigenschap."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:a587e4924c1b6520056dba3fbcc8aadbc1bcf22120251ab323d597feb703e2f0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:828ed68d3ab3b6fbf1da0c385b006c233669c9bd81ede469aa24a857d1cffb75",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Sturing",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sturing"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sturing"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ed683849367dcb78939a30ba21508d2b5cac2d3a07293cbedc32dbc9b3591084"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:407901cddc339cd8fca02ac7d27a54f9d96c7a03f9252197c46b46f06dca625e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Voedt",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Voedt"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Voedt"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
