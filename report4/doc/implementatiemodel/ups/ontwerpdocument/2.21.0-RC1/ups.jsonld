      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een aparte permanente lader die een batterij oplaadt. Deze wordt ook wel een druppelaar of druppellader genoemd. Doorgaans wordt de batterij opgeladen door gebruik te maken van de netvoeding."
        }
      ],
