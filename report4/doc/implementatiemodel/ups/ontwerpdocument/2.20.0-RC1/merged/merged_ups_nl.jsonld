          "@value": "Bypass schakelaar"
        }
      ],
      "diagramLabel": [
        {
          "@value": "BypassSchakelaar"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een schakelaar die toelaat om de stroomtoevoer naar afnemende technieken via het geschakeld toestel zoals een UPS, te omzeilen en te isoleren om veilig te kunnen werken aan dat toestel terwijl de stroomtoevoer voor afnemende technieken verzekerd blijft."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
