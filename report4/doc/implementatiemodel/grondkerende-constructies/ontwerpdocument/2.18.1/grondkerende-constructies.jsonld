      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Soilmixwand",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Soilmixwand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Soilmixwand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een cutter soilmixwand (CSM-wand) is een aansluitende kerende wand bestaande uit elkaar overlappende moten in de grond gevormd. Deze heeft een grond- en waterkerende functie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:98943e68f8bd6bd02157c1cb0a74cc705859db37fc926efa4299d26282ddc1d5"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fc8b62a258e300c244e6f9392eb358a6b9aec22010b11a05c2e57d0452a44939",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#StalenCaisson",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stalen caisson"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenCaisson"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit is een samengesteld element bestaande uit twee of meerdere warmgewalste stalen damplanken met Z- of U-vorm."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
