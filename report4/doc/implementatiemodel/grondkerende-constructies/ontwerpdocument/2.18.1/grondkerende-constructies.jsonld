        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:86884f87e0265ae4996a6c3b9999119de1925dddbff73e17f79a61732a98ca18",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#SecansTangenspalenwand",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Secans- of tangenspalenwand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SecansTangenspalenwand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een secans- of tangenspalenwand bestaat uit betonnen boorpalen. Bij de secanspalenwand zijn dit primaire en secundaire, in elkaar oversneden palen. Bij de tangenspalenwand snijden de boorpalen niet in elkaar in (geen overlap). De wand heeft tot doel een bouwputbeschoeiing te realiseren. De stabiliteit van de grondkering wordt verzekerd door verankeringen en/of schoringen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:98943e68f8bd6bd02157c1cb0a74cc705859db37fc926efa4299d26282ddc1d5"
        },
        {
          "@id": "urn:oslo-toolchain:9f24e8bc7dbb36332491b85cb47fe20506247bc158113de74f8806124fecfe8e"
        },
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:96a61ef79276849f10cdf5fc93f2d7f9dc75a123d9b80c9e1ce2b664cec61467",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kesp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kesp"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kesp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Algemene benaming voor het aanduiden van een betonnen balk bovenaan grondkerende structuren, een kopbalk als het ware (wordt ook wel kaaimuurkop genoemd). Ankervoorzieningen, ladders, enz. worden in/tegen de kesp bevestigd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:215e1279b54864b087fac90ddb1f65eeac044a877b388e38b4091f252cc39690"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
