      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:eac67c00e63971e313af408e07bcd6e411ad6face9f5d110b76bd0572836194a",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#VernageldeWand",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vernagelde wand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VernageldeWand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Versteviging van de grond door een rooster van ankers (nagels), waarbij de oppervlakte tussen de ankers gestabiliseerd wordt door middel van gewapend spuitbeton."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
