      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Koppelbalk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Koppelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Koppelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balk die delen van een constructie met elkaar verbindt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:215e1279b54864b087fac90ddb1f65eeac044a877b388e38b4091f252cc39690"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fd87953caae323589f1f1a81f8f102e464514f833c248463ac200463a77c2ba1",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#TijdelijkeBerlinerwandTussenschot",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Tijdelijke berlinerwandtussenschot"
        }
      ],
      "diagramLabel": [
        {
          "@value": "TijdelijkeBerlinerwandTussenschot"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het tussenschot (plaat of plank tussen profielen) voor een tijdelijke berlinerwand. Om een berlinerwand te definiëren die permanent in de grond blijft, moeten de specifieke (materiaal)onderdelen gebruikt worden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:10120588cdcc653cd048c25be7f1411cde190c11dab57cb6660b846aa37c10fc"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:8b2704ba5d7b34f8d159a8dd8918b7fdb3fd371a144218c7b600a80062c83374",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Verdeelbalk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verdeelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verdeelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een constructief element dat de belasting op een grondkerende constructie, zoals een damwand of beschoeiing, verdeelt naar meerdere ankerstaven of andere steunpunten. Het zorgt voor een gelijkmatige(re) spreiding van de belastingen op de constructie en vormt zo mee een essentieel onderdeel van de structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:215e1279b54864b087fac90ddb1f65eeac044a877b388e38b4091f252cc39690"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:b48457f6398dbfb39880d77d8fab34a9dd4185d223a29d7d8e703fa955886188",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Dukdalf",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Dukdalf"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Dukdalf"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verticaal paal-element in het water of aan de waterkant, bedoeld om schepen op te vangen, af te weren of aan te meren. Dukdalven worden geplaatst om constructies te beschermen tegen schade door aanmerende of passerende schepen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
