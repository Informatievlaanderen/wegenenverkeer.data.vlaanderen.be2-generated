          "@language": "nl",
          "@value": "Berlinerwand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Berlinerwand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een damwandconstructie, opgebouwd uit stalen H-profielen en (stalen)planken. De berlinerwand wordt vooral toegepast als grondkering bij bouwputten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:1bf91d7c44596475e61a33fdd9240c8510621224df65dff7383568014e245cba"
