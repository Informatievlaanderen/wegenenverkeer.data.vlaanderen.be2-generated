          "@value": "Gording"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gording"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een balk of ligger(s) die is(zijn) aangebracht om de stabiliteit van verticale grondkerende elementen zoals damwanden, palen of berlinerwanden te waarborgen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
