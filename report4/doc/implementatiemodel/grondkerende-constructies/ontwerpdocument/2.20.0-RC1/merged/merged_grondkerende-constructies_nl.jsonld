        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ab08f94ae5c93fe3930d3039ff64d768bc0342da9878e568cbf7b6e357f7c846",
      "@type": "Class",
