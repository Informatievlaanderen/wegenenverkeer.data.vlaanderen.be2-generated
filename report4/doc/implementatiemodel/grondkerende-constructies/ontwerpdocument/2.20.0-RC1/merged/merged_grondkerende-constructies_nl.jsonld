        {
          "@language": "nl",
          "@value": "Verdeelbalk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Verdeelbalk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een constructief element dat de belasting op een grondkerende constructie, zoals een damwand of beschoeiing, verdeelt naar meerdere ankerstaven of andere steunpunten. Het zorgt voor een gelijkmatige(re) spreiding van de belastingen op de constructie en vormt zo mee een essentieel onderdeel van de structuur."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0352a3cff125facc90088014488533de54eeea63c652bc9ed25bc4f25817d293"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
