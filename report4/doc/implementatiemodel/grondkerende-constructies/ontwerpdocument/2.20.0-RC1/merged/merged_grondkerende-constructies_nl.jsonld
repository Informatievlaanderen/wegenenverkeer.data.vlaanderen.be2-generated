    },
    {
      "@id": "urn:oslo-toolchain:07aa474b3882d16ad671228b1c0b2303d833f2251c5a3a0a4b4e134e3a01a264",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#StalenCaisson",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stalen caisson"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenCaisson"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit is een samengesteld element bestaande uit twee of meerdere warmgewalste stalen damplanken met Z- of U-vorm."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
