        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:67e44e83e20de5af626ec2552e96feb72609b2e6c1038b6e6e26070a3a42b90f",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Gewichtsmuur",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Gewichtsmuur"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Gewichtsmuur"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Kerende constructie die stabiliteit ontleent aan zijn eigen gewicht. Onder stabiliteit dient verstaan te worden: glijden, omkantelen en verticaal draagvermogen. De muur is (meestal) onderaan breder dan bovenaan."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0d7639b8dae114fa56b8c4bd1f7019815287e10fe868e523425d21093c44ee83"
