      "@id": "urn:oslo-toolchain:c4953b25d5ae0be40128138e559d74c0cc09703ddc632e54712cfc7bf01b38d2",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#StalenConstructieObject",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stalen constructie-object"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenConstructieObject"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Op maat gemaakt generiek stalen object dat dient ter constructie. Dit kan gemaakt zijn uit verschillende stalen delen aan elkaar gelast/gebout/... die één geheel vormen. Dit gaat niet over een standaard profiel of plaat, maar over een specifiek gevormd stalen object, zoals bijvoorbeeld: een stalen verbindingsknoop,..."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
