        {
          "@language": "nl",
          "@value": "Vernagelde wand"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VernageldeWand"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Versteviging van de grond door een rooster van ankers (nagels), waarbij de oppervlakte tussen de ankers gestabiliseerd wordt door middel van gewapend spuitbeton."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
