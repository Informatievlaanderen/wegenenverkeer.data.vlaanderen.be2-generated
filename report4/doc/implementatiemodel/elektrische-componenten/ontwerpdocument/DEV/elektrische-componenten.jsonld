      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Sturing",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sturing"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sturing"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:022034a7a8929a0a08652c4ff7939e3388390a4896a3571f9e0513b802efeea0"
