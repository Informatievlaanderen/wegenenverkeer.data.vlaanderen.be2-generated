    {
      "@id": "urn:oslo-toolchain:52dafa575a8b5a82fa13840cf9cf3f5187dbfbb1a8beaa954fb93a4c8904f3c1",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Sturing",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sturing"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Sturing"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5788184b8ef5ab3da274551fcff51fd50a84d2a53a40e60aa946ecbc822e37ee"
