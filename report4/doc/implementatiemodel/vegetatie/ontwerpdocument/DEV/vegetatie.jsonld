      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Duingrasland",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Duingrasland"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Duingrasland"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "G5a - Zanddoddengras, Kleverige reigersbek, Ruw vergeet-mij-nietje, Kruipend stalkruid, Zandhoornbloem, Duinfakkelgras, Liggende asperge, Duindravik, Duinviooltje, Kegelsilene, Ruwe klaver, Duin- en gewimperd langbaardgras, Lathyruswikke, Geel walstro, Grote tijm, Geel zonneroosje, Liggend bergvlas, Nachtsilene, Walstrobremraap, Kalkbedstro, Zachte haver, Voorjaarsganzerik, Duindravik, Gestreepte klaver, Wondklaver."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
