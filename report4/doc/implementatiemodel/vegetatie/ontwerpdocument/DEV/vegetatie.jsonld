    {
      "@id": "urn:oslo-toolchain:48658a4a02a3986394ad4ceca6b5b375f5055619287eb2765cefea6ab98e3af9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#NatteRuigte",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Natte ruigte"
        }
      ],
      "diagramLabel": [
        {
          "@value": "NatteRuigte"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een natte ruigte is een vegetatie op natte standplaatsen die ontstaat na het wegvallen van beheer (maaien of begrazen) en dat gepaard gaat met de vestiging en/of uitbreiding van forse plantensoorten (zogenaamde ruigtekruiden). Deze ruigtekruiden zijn gekenmerkt door hun overblijvende natuur, hun snelle groei en de productie van aanzienlijke hoeveelheden strooisel, waardoor ze andere, vooral kleinere soorten, verdringen en de vestiging van andere soorten verhinderen."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:c2a60aee7c7f4cc145164e1b6e7be8661037c8d163f69386b177961aaa6aab7c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:d556759dd5b058690c95b630885049f2668e4fbb748eabbe4633e84d3e8ab3bc",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SolitaireHeester",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Solitaire heester"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SolitaireHeester"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Afzonderlijk te onderscheiden heester. Heesters zijn houtachtige planten die in of dicht bij de grond vertakken. Anders dan een boom vormen ze in het algemeen geen duidelijke stam, maar komen de meeste soorten met een aantal takken uit de grond, die dan ook grondtakken genoemd worden. Voorwaarde is wel dat de plant in zijn eventuele stam en takken houtweefsel vormt, hoewel dat niet tot in het hart hoeft te zijn."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8952e2f4028b132ffa8e270f1874e97ba4e42c081bcda48a59fd0eb31d188fe6"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
