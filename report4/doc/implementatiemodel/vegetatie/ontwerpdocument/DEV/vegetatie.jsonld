        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Exoten, in deze context, zijn planten die zich hebben gevestigd in België terwijl ze oorspronkelijk niet in België voorkwamen. Ze verdringen bovendien inheemse soorten uit hun normale groeiplaats."
        }
      ],
      "vocUsageNote": [
