    {
      "@id": "urn:oslo-toolchain:afa1aff5932499efefb65165f08a4f50580f29fc3e7ec4744f1b4b84f80d8692",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Beschermbuis.indicatieveDiepte",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "indicatieve diepte"
        }
      ],
      "diagramLabel": [
        {
          "@value": "indicatieveDiepte"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De opgemeten diepte als een (positief) getal in meter tussen het hoogste punt van de buis en het maaiveld zoals dit gekend was op het moment van aanleg van de buis."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Meet de kleinste afstand tussen de buis en het maaiveld bij aanleg aangezien bij graafwerken dit de eerste diepte zal zijn waarop een buis kan aangetroffen worden. De diepte moet opgemeten worden, niet ingeschat: \"indicatief\" wijst op de tijdelijkheid van de waarde, niet op een waarde die bij benadering gegeven wordt. Bij een discrepantie tussen de waarde van dit attribuut en de waarde in TAW uit de geometrie van het object, geldt altijd de waarde in TAW."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:386f7a65a141f93b2ef56955f16be9fc65d967f07717c5b9a11750c441ab10e8"
      },
