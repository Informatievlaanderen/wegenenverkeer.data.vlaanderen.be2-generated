          "@value": "HeeftNetwerktoegang"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Koppelt de toegang zoals gekend in Kabelnet aan het fysiek object dat daarbij hoort."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
