          "@value": "Stralende kabel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StralendeKabel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stralende kabel zendt radiogolven uit waardoor het radiosignaal kan worden opgepikt en draadloze communicatie mogelijk blijft. Het radiosignaal wordt opgepikt uit de lucht en in de afgesloten ruimte terug uitgezonden."
        }
      ],
