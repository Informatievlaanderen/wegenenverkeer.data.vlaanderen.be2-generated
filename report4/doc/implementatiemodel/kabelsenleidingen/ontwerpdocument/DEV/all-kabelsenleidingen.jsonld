    {
      "@id": "urn:oslo-toolchain:76029c32ef3d7f2b165d514b61e022083fbfc1eb56fe330edb82c31c3f8c4fae",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HeeftAanvullendeGeometrie",
