    {
      "@id": "urn:oslo-toolchain:47e7db54795957ba69025dca31742f6ace6959c8eb7be48fa58281fbc941ed64",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#Kabelkoker",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kabelkoker"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kabelkoker"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een ruimte die een of meerdere kabels of leidingen beschermt tegen beschadiging en/of de kabels of leidingen op een gecontroleerde plaats laat hangen of liggen. De constructieve elementen die de ruimte creëeren vormen een aaneen- en afgesloten geheel dat niet meer uit elkaar kan gehaald worden. De kabels en leidingen zijn enkel nog toegankelijk door in de koker zelf rond te lopen (of te kruipen). De koker is op die toegankelijkheid voorzien."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d6107f36f8a927e889df92bce3c0c7f9973b359337894f1eeaa04dc3fc490c6f"
