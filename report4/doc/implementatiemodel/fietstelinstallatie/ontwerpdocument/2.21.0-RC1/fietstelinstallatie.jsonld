      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sel niet sel lussen"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SelNietSelLus"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Abstracte klasse die de eigenschappen van selectieve en niet-selectieve lussen combineert."
        }
      ],
