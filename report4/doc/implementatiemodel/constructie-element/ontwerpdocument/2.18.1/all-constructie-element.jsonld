        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenPlaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stalen enkelvoudig constructie-element dat zowel horizontaal geplaatst kan worden, in het geval van een plaat, alsook verticaal in het geval van een wand."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
