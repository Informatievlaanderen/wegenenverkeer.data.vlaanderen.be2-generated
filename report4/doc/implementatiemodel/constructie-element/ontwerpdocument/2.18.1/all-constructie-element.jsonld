      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Golfplaat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Golfplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Dit is een gegolfd constructie-element van metaal of kunststof,gebruikt in bouw- en infrastructuurprojecten zoals tunnels en duikers. Het biedt verhoogde stijfheid en sterkte en verdeelt belastingen en spanningen efficiënt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
