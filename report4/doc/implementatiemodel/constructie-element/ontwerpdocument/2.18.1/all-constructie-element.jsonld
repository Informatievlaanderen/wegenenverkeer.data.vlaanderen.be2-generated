          "@language": "nl",
          "@value": "Standaard stalen profiel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "StandaardStalenProfiel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stalen constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. Standaard stalen profiel omvat de meest genormeerde soorten profielen, zoals H-, I- en U-profielen met voorgedefinieerde profielhoogtematen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:4bcec61e674cecc92ab6ea224f79cdabd1c8236935f3ab0859c4303fc5643e95"
        }
      ],
