      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Installatie voor het meten van verschillende aspecten van de luchtkwaliteit in tunnels tussen twee punten op basis van de onderbrekingen in een signaal dat tussen die twee punten reist."
        }
      ],
