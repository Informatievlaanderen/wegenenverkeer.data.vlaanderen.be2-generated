        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een technische installatie die bestaat uit zonnepanelen, elektrische bekabeling, omvormers en ondersteunende infrastructuur, en die tot doel heeft om door middel van fotovoltaïsche omzetting gelijkstroom te produceren en deze, via energieomzetting en beveiligingscomponenten, bruikbaar te maken voor lokaal verbruik of injectie op het elektriciteitsnet."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Technische fiches, legplan,  berekeningsnota's, ballast- of funderingsberekening, etc... aanleveren via Bijlage."
        }
      ],
