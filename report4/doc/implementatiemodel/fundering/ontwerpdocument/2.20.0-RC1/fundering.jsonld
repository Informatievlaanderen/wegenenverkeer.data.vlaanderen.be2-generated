    {
      "@id": "urn:oslo-toolchain:f8bf03854d8e9f10627d3e2da1303bb2fbcc1d42defd2f183e5fa01a9ac772aa",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Paalmatras",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Paalmatras"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Paalmatras"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een funderingsconstructie die wordt gebruikt op slappe bodems, voornamelijk bij de aanleg van wegen en andere infrastructuur. Het combineert (funderings)palen met een dragende matras van gewapend geokunststof en grofkorrelig materiaal, om belastingen efficiënt naar de dieper gelegen stabiele grondlagen over te brengen. De palen dragen de matras, die op zijn beurt de belasting verdeelt en overdraagt aan de palen. Deze aanpak minimaliseert zettingen en verbetert de stabiliteit van de constructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:e26684ff38be769a0f7ace1ac4a9325b89786512543475aeb8eac81feb097aed"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
