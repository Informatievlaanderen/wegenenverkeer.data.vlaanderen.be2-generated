        }
      ],
      "diagramLabel": [
        {
          "@value": "StalenFunderingsprofiel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Stalen profiel, bijvoorbeeld een H-profiel, dat wordt gebruikt als fundering of wapening van een fundering. Dit is geen profiel voor een damwand: hiervoor moet 'Stalen damplank' worden gebruikt."
        }
      ],
