        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Diepfundering waarbij d.m.v. palen de belasting wordt afgedragen naar de diepe ondergrond. Enkel te gebruiken wanneer het type paal niet gekend is."
        }
      ],
