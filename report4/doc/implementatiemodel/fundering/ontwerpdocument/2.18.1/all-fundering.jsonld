      "vocLabel": [
        {
          "@language": "nl",
          "@value": "MV Paal"
        }
      ],
      "diagramLabel": [
        {
          "@value": "MVPaal"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Grondverdringende stalen paal met een inwendige en/of uitwendige injectie met grout-specie. Ze wordt vervaardigd door het heien van een stalen profiel/buis in de bodem onder gelijktijdig injecteren van een groutmengsel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:ebce24478f2d9f180f4e95a95a03edf7d0204258a1d8dab57d9dc8ad2a5e1fbd"
