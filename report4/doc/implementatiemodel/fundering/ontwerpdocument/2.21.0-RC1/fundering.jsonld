    {
      "@id": "urn:oslo-toolchain:a24d7c145e72ecaede213f8787ca90298a71f29536940db5a9b093898d21e831",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Grondverbetering",
