        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Funderingsconstructie voor gelijkmatige spreiding van belasting over een grote oppervlakte, waarvan de oppervlakte minstens het volledige grondvlak van het gefundeerd object omvat."
        }
      ],
