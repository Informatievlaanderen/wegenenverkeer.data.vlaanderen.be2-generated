        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stalen constructie-element waarvan de lengte vele malen groter is dan de breedte en de hoogte in doorsnede. Niet-standaard stalen profiel omvat alle speciale,op maat gemaakte en/of niet vaak voorkomende profielen."
        }
      ],
