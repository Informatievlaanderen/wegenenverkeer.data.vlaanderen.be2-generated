        }
      ],
      "diagramLabel": [
        {
          "@value": "Lichtzuil"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Inwendig verlichte, geel gekleurde conische steun, inclusief het voetstuk waarop het bevestigd is, die gebruikt wordt om obstakels op de weg te signaleren voor het aankomend verkeer."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Het type vat de lichtzuil als geheel inclusief conische steun, voetstuk en de verzonken elektrische uitrusting."
        }
      ],
