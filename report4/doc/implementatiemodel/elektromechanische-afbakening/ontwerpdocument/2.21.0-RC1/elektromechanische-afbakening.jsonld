    {
      "@id": "urn:oslo-toolchain:5217f2ace2fa7c6098632f9306bc5fb67f53383d54a76f4f6cbb26d567de2dca",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Lichtnagel",
