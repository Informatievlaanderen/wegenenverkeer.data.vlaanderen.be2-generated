    {
      "@id": "urn:oslo-toolchain:4058d5ab9276157c658e1c6acf7b87496b1c5b1a4743f58ee9f2b7681c21a8a7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Lichtnagel",
