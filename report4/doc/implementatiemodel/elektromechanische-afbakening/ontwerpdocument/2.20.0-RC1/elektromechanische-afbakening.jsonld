    },
    {
      "@id": "urn:oslo-toolchain:52b75a0d0d7830c4f18bb920ec10e0c3337dcba600b62ed773a858358a4eff72",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#LEDWegdekreflectorBebakening",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "LED wegdekreflector bebakening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LEDWegdekreflectorBebakening"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verzameling van op de rijbaan verankerde actieve lichtmodules. De modules hebben als doel de randen van de rijbaan of de grenzen tussen rijstroken te markeren of gevaarlijke plaatsen te signaleren. De verzameling bundelt de actieve reflectoren die hetzelfde obstakel of risico aanduiden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:8861b96fde6763ebb7a455ff806904a300f804177fa2edaa6e0b75579892a635"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
