      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDRotondeafbakening",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "LED rotondeafbakening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LEDRotondeafbakening"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verzameling van actieve lichtgevende modules ter hoogte van één toerit die ingeslepen worden in, of geplaatst worden op, de boordsteen van een rotonde en als doel hebben om de rand van de rotonde duidelijk zichtbaar te maken."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d08285e3def6c5a1a78619ced95c8af69fd35917cfe5c72e7c09b80fdb37f14e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9be5d868d61e88a71dfd962329a55bf8145608a9dbf2408d5c533ceadb0dc770",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/installatie#LEDWegdekreflectorBebakening",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "LED wegdekreflector bebakening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LEDWegdekreflectorBebakening"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verzameling van op de rijbaan verankerde actieve lichtmodules. De modules hebben als doel de randen van de rijbaan of de grenzen tussen rijstroken te markeren of gevaarlijke plaatsen te signaleren. De verzameling bundelt de actieve reflectoren die hetzelfde obstakel of risico aanduiden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:d08285e3def6c5a1a78619ced95c8af69fd35917cfe5c72e7c09b80fdb37f14e"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/ErkendeStandaard"
    },
