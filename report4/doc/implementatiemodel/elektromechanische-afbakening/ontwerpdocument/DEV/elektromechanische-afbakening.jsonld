          "@value": "Lichtnagel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Lichtnagel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een lage, gele, plastic koepel die geplaatst wordt op een ondergronds geïnstalleerde, lichtgevende module waardoor de weggebruiker de indruk heeft dat de koepel zelf verlicht is. De koepel kan ook geïntegreerde LEDjes bevatten om op te lichten in plaats van boven een lichtgevende module gezet te worden. Deze voorwerpen hebben als doel de weggebruiker attent te maken van een gewijzigde wegprofiel (bv. betonnen middeneiland op de weg,...)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bddf845bcc8a4b4ab4f26a57e47d9f23777a58b5bac58f88c8a3d049ccb6c3d6"
        }
      ],
