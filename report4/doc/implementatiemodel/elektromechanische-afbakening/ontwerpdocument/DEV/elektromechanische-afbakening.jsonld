    },
    {
      "@id": "urn:oslo-toolchain:e8e105f83f7615c23eda47a0f8bed0525e6ee588834f83232051c9b05e655d3e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#LEDWegdekreflectorBebakening",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "LED wegdekreflector bebakening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LEDWegdekreflectorBebakening"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verzameling van op de rijbaan verankerde actieve lichtmodules. De modules hebben als doel de randen van de rijbaan of de grenzen tussen rijstroken te markeren of gevaarlijke plaatsen te signaleren. De verzameling bundelt de actieve reflectoren die hetzelfde obstakel of risico aanduiden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bddf845bcc8a4b4ab4f26a57e47d9f23777a58b5bac58f88c8a3d049ccb6c3d6"
        }
