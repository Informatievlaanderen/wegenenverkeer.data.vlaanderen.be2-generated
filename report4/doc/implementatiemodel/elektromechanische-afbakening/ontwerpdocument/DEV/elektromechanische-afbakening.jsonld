      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#LEDRotondeafbakening",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "LED rotondeafbakening"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LEDRotondeafbakening"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De verzameling van actieve lichtgevende modules ter hoogte van één toerit die ingeslepen worden in, of geplaatst worden op, de boordsteen van een rotonde en als doel hebben om de rand van de rotonde duidelijk zichtbaar te maken."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:bddf845bcc8a4b4ab4f26a57e47d9f23777a58b5bac58f88c8a3d049ccb6c3d6"
        }
      ],
