    {
      "@id": "urn:oslo-toolchain:2174df4cf3c9c63dff0bd6465ee82bac045add20e249b1456da18d58581b528e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Ventilator",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Ventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel voor het creëren van luchtcirculatie binnen een open of gesloten ruimte met het oog op het vervangen van vervuilde door zuivere lucht. Voor een gesloten ruimte kan de luchtcirculatie ook zorgen voor afkoeling."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De ruimtes in kwestie zijn groot tot middelgroot zoals bv. kasten,cabines,lokalen en groter. Een ventilator in de behuizing van een toestel die dient om het toestel te koelen,wordt als Toestelventilator toegevoegd aan de OTL."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
