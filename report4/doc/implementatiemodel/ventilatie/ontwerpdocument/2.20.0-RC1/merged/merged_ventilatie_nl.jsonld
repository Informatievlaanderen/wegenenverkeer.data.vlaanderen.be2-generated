        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een systeem van ventilatoren die samenwerken om de luchtstroom en luchtkwaliteit in een deel van de koker of een specifieke ruimte te reguleren en te verbeteren."
        }
      ],
