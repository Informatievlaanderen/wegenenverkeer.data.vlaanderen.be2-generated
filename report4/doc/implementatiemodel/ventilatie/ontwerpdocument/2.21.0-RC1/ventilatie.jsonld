          "@value": "Rookkoepel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een veiligheidssysteem dat bij brand automatisch opent om rook en warmte af te voeren, zodat het kokerdeel stroomopwaarts van de brand rookvrij blijft en de vluchtroutes toegankelijk blijven."
        }
      ],
