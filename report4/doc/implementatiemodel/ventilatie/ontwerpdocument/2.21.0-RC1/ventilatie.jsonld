        }
      ],
      "diagramLabel": [
        {
          "@value": "Ventilatierooster"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Stuurt de luchtstromen van of naar een ventilator in de gewenste richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
