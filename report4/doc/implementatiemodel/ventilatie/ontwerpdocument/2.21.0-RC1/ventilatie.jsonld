    {
      "@id": "urn:oslo-toolchain:02948971131ce696c6547166e0cd88e93032556f11cbcdd3d7ad4bbb5771f5e7",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overdrukventilator",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Overdrukventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Overdrukventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel dat tot doel heeft overdruk te creëren in een gesloten ruimte zodat bij het openen van de ruimte enkel lucht kan ontsnappen naar buiten en geen lucht,rook,partikels,... naar binnen te laten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:98ab6d1637c6d4685b3f15c8eabcbca336bad7d5b7cf51f07ed6ff337923aa87"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:2ae4b92d084fd9d75966de5f9abe7bbe0d76a909293314b4a50a84c73d11a813",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Ventilatierooster",
