        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Keuzelijst die aangeeft of de luchtstroom in één richting of beide richtingen kan plaatsvinden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
