    },
    {
      "@id": "urn:oslo-toolchain:03b11648fdd7f62fbabcb029292b92d1de281454a897a878cdc5f448e30abf25",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Ventilator",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Ventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel voor het creëren van luchtcirculatie binnen een open of gesloten ruimte met het oog op het vervangen van vervuilde door zuivere lucht. Voor een gesloten ruimte kan de luchtcirculatie ook zorgen voor afkoeling."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De ruimtes in kwestie zijn groot tot middelgroot zoals bv. kasten,cabines,lokalen en groter. Een ventilator in de behuizing van een toestel die dient om het toestel te koelen,wordt als Toestelventilator toegevoegd aan de OTL."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:98ab6d1637c6d4685b3f15c8eabcbca336bad7d5b7cf51f07ed6ff337923aa87"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
