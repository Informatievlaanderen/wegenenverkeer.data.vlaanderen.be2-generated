    {
      "@id": "urn:oslo-toolchain:857ecd8df26e442c4b1f9122eb08f2cb4a902aadaf7de886bfe62605c5b55ec9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Ventilator",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Ventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel voor het creëren van luchtcirculatie binnen een open of gesloten ruimte met het oog op het vervangen van vervuilde door zuivere lucht. Voor een gesloten ruimte kan de luchtcirculatie ook zorgen voor afkoeling."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "De ruimtes in kwestie zijn groot tot middelgroot zoals bv. kasten,cabines,lokalen en groter. Een ventilator in de behuizing van een toestel die dient om het toestel te koelen,wordt als Toestelventilator toegevoegd aan de OTL."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:0952ace3edac397b81accb171d1dda20c9cf1ac1b5265947b3ecce18f80c66ff"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
