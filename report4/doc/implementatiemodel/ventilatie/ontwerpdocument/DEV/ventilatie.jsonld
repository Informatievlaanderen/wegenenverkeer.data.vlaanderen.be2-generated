        {
          "@language": "nl",
          "@value": "Overdrukventilator"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Overdrukventilator"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Onderdeel dat tot doel heeft overdruk te creëren in een gesloten ruimte zodat bij het openen van de ruimte enkel lucht kan ontsnappen naar buiten en geen lucht,rook,partikels,... naar binnen te laten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
