    {
      "@id": "urn:oslo-toolchain:009b169aa35f59ec65b8d16bffc53902aca7b4fb8a7f46960617b7db89fe9991",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Bevestiging"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Bevestiging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat twee onderdelen direct fysiek op elkaar bevestigd zijn. Dit kan zowel aan de buitenkant als aan de binnenkant zijn zoals bv. een camera aan een paal of een laagspanningsbord in een kast. Daarnaast omvat deze relatie ook situaties waarin onderdelen niet direct, maar wel structureel of functioneel met elkaar verbonden zijn op een manier die bevestiging impliceert, bv. een trap die eindigt net onder een voetgangersbrug zonder fysieke bevestiging. Deze relatie heeft geen richting."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:022034a7a8929a0a08652c4ff7939e3388390a4896a3571f9e0513b802efeea0"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:7454728651be8766d368e1287ee51fc928ee184a2e8b9be992914f235e71082d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SluitAanOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Sluit aan op"
        }
      ],
      "diagramLabel": [
        {
          "@value": "SluitAanOp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:a14cd2b3ab1d06f95959b6b955ba435acf2265ccab0979859060de759476c6d4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Omhult",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Omhult"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Omhult"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat het ene onderdeel het andere omhult. Dit vereist geen gesloten omhulling: de omhulling kan een open zijde hebben of bestaan uit open ruimtes. Deze relatie heeft een richting en gaat van het omhullende onderdeel naar het onderdeel dat omhuld wordt."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:90f78f71dca6fac3331cd7c521d99de2271dc9c29abd0cee9cb044accdf2bc57",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#LigtOp",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Ligt op"
        }
      ],
      "diagramLabel": [
        {
          "@value": "LigtOp"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Deze relatie geeft aan dat 2 onderdelen direct fysiek op elkaar liggen. Deze relatie heeft een richting en gaat van het bovenste naar het onderste onderdeel."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdc80ee6c494bc15b065b9f0769a4a45b6cbbe62c1d3d96b63c3d384a41da7f4"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
