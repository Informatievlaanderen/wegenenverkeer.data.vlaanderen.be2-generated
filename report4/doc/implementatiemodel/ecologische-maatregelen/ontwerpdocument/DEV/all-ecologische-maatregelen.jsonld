          "@value": "Stobbenwal"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Wortelkluiten of ander houtmateriaal (zoals stamhout) om beschutting en geleiding van kleinere diersoorten zoals muizen, egels."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
