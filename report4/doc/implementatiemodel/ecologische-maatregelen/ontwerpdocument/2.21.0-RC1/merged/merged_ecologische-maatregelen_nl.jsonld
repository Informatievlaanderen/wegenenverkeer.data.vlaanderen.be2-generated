        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een geleiding om dieren te leiden naar een plaats (ecoduct, ecotunnel, ...) waar ze veilig een drukke weg kunnen oversteken."
        }
      ],
