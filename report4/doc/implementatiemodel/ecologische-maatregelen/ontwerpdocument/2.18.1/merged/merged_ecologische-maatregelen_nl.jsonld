      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Buis- of tunnelvormige doorgang voor water onder een weg, die is voorzien van een oeverstrook of van looprichels zodat kleinere diersoorten beschermd voor het verkeer kunnen doorsteken."
        }
      ],
