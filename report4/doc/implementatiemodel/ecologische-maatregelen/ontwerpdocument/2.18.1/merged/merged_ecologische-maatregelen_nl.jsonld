        }
      ],
      "diagramLabel": [
        {
          "@value": "Ecotunnel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een (grote) ecotunnel is een tunnel onder een grote weg, waarlangs dieren veilig de overkant kunnen bereiken."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
