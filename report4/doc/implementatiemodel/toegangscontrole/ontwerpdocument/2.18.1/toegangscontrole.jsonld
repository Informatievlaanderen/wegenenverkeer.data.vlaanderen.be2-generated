    {
      "@id": "urn:oslo-toolchain:9f1678893e04c763ea1f75a09691b225a8c7c8033da71275ba5bb5ab67eba345",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#UPS",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "UPS"
        }
      ],
      "diagramLabel": [
        {
          "@value": "UPS"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel (Uninterruptible Power Supply = niet onderbreekbare voeding) voor het leveren van elektrische energie van een vastgelegde kwaliteit, onafhankelijk van de beschikbaarheid van een betrouwbare netspanning. Indien het openbare net niet langer bruikbaar is om als energiebron te fungeren, wordt de energievoorziening overgenomen door de accubatterij. Deze zal gedurende een bepaalde tijd, afhankelijk van de capaciteit, de stroomvoorziening verzorgen. De UPS dient om de (minimale) voeding ononderbroken te verzekeren"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:82d136cfccf588383782b2ae61115f248fd6feb78a99a3e03cfe70ac21dd30b3"
        },
        {
          "@id": "urn:oslo-toolchain:c0c4997cda3d5f8609daf238c4ba3f1ec60738b044ca7971a4fad73abd94f97a"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0ab96e9131271fb22851c24d59fe63b9c317e15eeb6d9a1a78b6bda7b467135b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Spanningsomvormer",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Spanningsomvormer"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Spanningsomvormer"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een apparaat dat de invoerspanning kan omvormen om een andere uitvoerspanning te bekomen. Typisch is dit type apparaat ook in staat om de frequentie van de elektriciteit te veranderen. Het kan dus gelijkspanning omvormen naar wisselspanning (alternator of wisselrichter), wisselspanning naar wisselspanning van een andere frequentie, of wisselspanning naar gelijkspanning (gelijkrichter)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5e65841689bf1d620f8cc3a06dbfaa3ea0b70300b22a89e4895033ab1e777426"
