        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Element bestaande uit meerdere elektrochemische cellen voor het leveren van elektriciteit,die ontstaat door de omzetting van opgeslagen chemische energie in elektrische energie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/inPublicationNamespace",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c425e7bd58f235d034a9d69be04a81b77c6c5e03e24d0ce47ef3803f5c1c43d"
        },
        {
          "@id": "urn:oslo-toolchain:82d136cfccf588383782b2ae61115f248fd6feb78a99a3e03cfe70ac21dd30b3"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/ErkendeStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:5816fc65e5f2b203c237c0ff4efbc9e092a3f0ba7144967e7a7774da96cc1b22",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
      "vocLabel": [
