        {
          "@language": "nl",
          "@value": "Ankerplaat"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Ankerplaat"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een plaat die in de grond is geplaatst of ingebetonneerd en dient om een mechanisch element, zoals een draagstoel, te positioneren en zijn krachten over te dragen aan de omliggende beton- of grondconstructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdd4fd1005880231d4b105e39846014e34f35f6594f5de353bc6d873d78b6ec4"
        },
