        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:3741e2bbba49bcd0a34425205c1d0154e5dcfc348a6247d5e6f09fa372da0b7f",
      "@type": "Class",
