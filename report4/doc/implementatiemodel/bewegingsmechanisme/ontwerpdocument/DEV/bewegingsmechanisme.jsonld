    },
    {
      "@id": "urn:oslo-toolchain:6a580498dc88f6b0aa65d7628fefa77853cb4852181074286b8e6d84f8c53217",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#RegelbaarTegengewicht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Regelbaar tegengewicht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "RegelbaarTegengewicht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het regelbaar tegengewicht betreft de hoeveelheid massa die relatief eenvoudig kan worden aangepast om een beweegbaar constructieonderdeel vrij nauwkeurig te balanceren; vaak bevindt dit zich in één of meerdere tegengewichtkisten. De hoeveelheid te plaatsen massa wordt bepaald door de vooropgestelde mate van onevenwicht. De massa kan bestaan uit blokken/staven/platen/puin van beton, steen, staal, gietijzer of lood."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:fae59bfc0451eae79b381b4eecc889f86ba0f2791d6c8e8246c87424174734ab",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VastTegengewicht",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Vast tegengewicht"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VastTegengewicht"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het vast tegengewicht betreft de hoeveelheid massa die onlosmakelijk met de machtarm is verbonden om (mee) het bewegende brugdeel te balanceren. De hoeveelheid massa benadert de vooropgestelde mate van onevenwicht. De massa kan bestaan uit beton, steen, staal, gietijzer of lood dat permanent ingewerkt is in de constructie."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:61b6ac90348a6d9c40bb7ea2c08a581f5c604d680d52651b047ecadc9d83ff52",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Ankerplaat",
