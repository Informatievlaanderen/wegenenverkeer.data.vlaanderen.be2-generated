    {
      "@id": "urn:oslo-toolchain:edf0b36aba22ac7a5955f9cd107bbe11aaadf635340460952b944d6494b78ed9",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stootblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stootblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Stootblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stootblok is een element dat specifiek is voorzien om enige mechanische impact van een bewegend (brug)deel op te vangen en zo schade aan de overige delen te voorkomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:cdd4fd1005880231d4b105e39846014e34f35f6594f5de353bc6d873d78b6ec4"
        },
        {
          "@id": "urn:oslo-toolchain:5c8448bca2b9e92ff721229abb2199d4a4da052b44717bc949a00000104ef03c"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:dae293846ec7387a72b3607568449696bf4c1a5f7d24bbfb4dccaea9dabc3ee4",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
