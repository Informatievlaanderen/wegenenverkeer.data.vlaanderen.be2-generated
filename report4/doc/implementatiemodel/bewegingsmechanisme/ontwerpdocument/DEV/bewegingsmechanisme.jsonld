    {
      "@id": "urn:oslo-toolchain:c8617fa0316d36dae17e5bd979187e5f43ff97460049f2f831bf293871fbede4",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Kelderlandhoofd",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Kelderlandhoofd"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Kelderlandhoofd"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Landhoofd uitgerust met kelder voor het herbergen van bewegende delen of onderhoudsvoorzieningen (bv. beweging tegengewicht). Deze kan ook afgesloten zijn (niet toegankelijk) en holle ruimtes bevatten."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
