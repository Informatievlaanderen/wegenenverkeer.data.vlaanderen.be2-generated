          "@value": "AsMechanisch"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een cilindrisch onderdeel dat dient om rotatie te ondersteunen,krachten over te dragen en bewegingen nauwkeurig te geleiden binnen het mechanisme."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
