    },
    {
      "@id": "urn:oslo-toolchain:816f07a70da92de23c6bc1e8299d9e39bc251e7d7c6e4e3607d3f43062939eea",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Stootblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stootblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Stootblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stootblok is een element dat specifiek is voorzien om enige mechanische impact van een bewegend (brug)deel op te vangen en zo schade aan de overige delen te voorkomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:5945ddb39087f98f24c6adcdc4bb5a0071cae412e30d62c6afd5e98c5c226114"
        },
        {
          "@id": "urn:oslo-toolchain:e26684ff38be769a0f7ace1ac4a9325b89786512543475aeb8eac81feb097aed"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:0b893f5bac6c4e5e85f30a168fe744d17c67ab27b8819ff492905379377666b7",
      "@type": "Class",
