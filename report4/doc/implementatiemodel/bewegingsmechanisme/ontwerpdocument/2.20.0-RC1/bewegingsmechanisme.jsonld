        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Keuzelijst voor de soorten bekleding voor een stang van een hydraulishe cilinder."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
