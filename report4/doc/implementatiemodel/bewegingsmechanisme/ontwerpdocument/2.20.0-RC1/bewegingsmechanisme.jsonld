    {
      "@id": "urn:oslo-toolchain:43f77d17102dfb3cd2f776d99b2dd061888cd20b8db475797d5ad2c80f5f1ddc",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kelderlandhoofd",
