      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:ffd548244a0c8da1b2307cc9f985abd380b0dbaec2205e62be34fba20a3d7fbf",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Drukvat",
