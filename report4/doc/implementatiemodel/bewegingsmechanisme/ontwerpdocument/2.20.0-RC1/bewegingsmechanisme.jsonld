          "@value": "KlOverigeFunctiesOplegging"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De overige functies van de oplegging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
