    {
      "@id": "urn:oslo-toolchain:cfbb647989a0f8195638175e6a576c37f9744a2eb091fd3ac119e8f1f570183e",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Balg.maximaleDruk",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "maximale druk"
        }
      ],
      "diagramLabel": [
        {
          "@value": "maximaleDruk"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "De hoogste druk die de balg kan weerstaan zonder te falen of beschadigd te raken. Dit wordt bepaald door het materiaal, de constructie en de toepassing van de balg. Het wordt vaak vastgesteld door middel van testen onder gecontroleerde omstandigheden, waarbij de balg geleidelijk aan toenemende druk wordt blootgesteld totdat deze faalt. De druk net voordat de balg faalt, wordt beschouwd als de maximale druk. In de praktijk wordt vaak een veiligheidsmarge toegepast"
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:d9f7240b88f71abd5ec48a74be3dc73f143ba74833fd7b003e795f60a9ddf386"
      },
