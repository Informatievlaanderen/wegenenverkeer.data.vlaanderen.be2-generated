    },
    {
      "@id": "urn:oslo-toolchain:d9f3bce5875831d88d7f7f0e920934be83fe578572813bb1ddbb799452aab67b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Stootblok",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Stootblok"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Stootblok"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een stootblok is een element dat specifiek is voorzien om enige mechanische impact van een bewegend (brug)deel op te vangen en zo schade aan de overige delen te voorkomen."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:13d0461b3f313989bdaedfd2cc47ab8612f95f753ea117f404b5f39e00fd575f"
        },
        {
          "@id": "urn:oslo-toolchain:754b04f1415ad5f2c9aea92116865b19905fb91c2e614675806b1b519cf86990"
        }
      ],
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:9f87969acfde9d6ee8e9daaa4ab274c5c3565a73c58ef0fa7b6a4f5d3db68c85",
      "@type": "Class",
      "assignedURI": "http://www.w3.org/2004/02/skos/core#Concept",
