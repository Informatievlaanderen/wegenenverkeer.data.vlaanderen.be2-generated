      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het mechanisch onderdeel (oog of vork) dat op het uiteinde van de cilinderstang wordt gemonteerd en de verbinding van de stang met de bewegende constructie realiseert."
        }
      ],
