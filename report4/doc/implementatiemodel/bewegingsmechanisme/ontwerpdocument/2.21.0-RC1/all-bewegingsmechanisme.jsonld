    {
      "@id": "urn:oslo-toolchain:470dfb141e4dc936a6998d265febc8750e02aaba6dda389509588a5fc1109199",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Drukvat",
