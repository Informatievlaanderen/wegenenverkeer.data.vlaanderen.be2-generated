    {
      "@id": "urn:oslo-toolchain:533edbb84b0c19ee2589e47fb25120871c75a153a01ade08e218fc6144e4c962",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Kelderlandhoofd",
