          "@value": "Geleidingssteun"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een mechanisch onderdeel dat dient om kettingen en kabels te ondersteunen en in de juiste richting te geleiden."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
