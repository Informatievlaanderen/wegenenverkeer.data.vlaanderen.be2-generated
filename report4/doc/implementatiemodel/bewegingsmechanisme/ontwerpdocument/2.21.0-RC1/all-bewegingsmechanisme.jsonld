          "@language": "nl",
          "@value": "De bewegingsvrijheid in het vlak bij een oplegging."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "codelist": "https://wegenenverkeer-test.data.vlaanderen.be/id/conceptscheme/KlBewegingsvrijheidInVlakBijOplegging",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
