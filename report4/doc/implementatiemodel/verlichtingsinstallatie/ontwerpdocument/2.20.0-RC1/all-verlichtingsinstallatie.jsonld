    {
      "@id": "urn:oslo-toolchain:66763c0fb08916d0c2d49e775c51ebebe2e0d43463d79a15813d8cb8e25d4709",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/abstracten#Verlichtingstoestel",
