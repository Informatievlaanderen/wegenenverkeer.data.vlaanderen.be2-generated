    {
      "@id": "urn:oslo-toolchain:6c3b80418501e355fc38c72b95709d3a9fc6756df4d4551e3361b36e85c898fd",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Lichtmast",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Lichtmast"
        },
        {
          "@language": "nl",
