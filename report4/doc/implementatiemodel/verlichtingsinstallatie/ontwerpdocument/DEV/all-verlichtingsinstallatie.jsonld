    {
      "@id": "urn:oslo-toolchain:e8fc71f2da1675419b279bbb9a25ee555a018933fefee3350c7226d0a7921b6e",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VerlichtingstoestelMHHP",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Verlichtingstoestel MH HP"
        }
      ],
      "diagramLabel": [
        {
          "@value": "VerlichtingstoestelMHHP"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het geheel van de metaalhalogenide lamp (MHHP), voorschakelapparatuur en de behuizing die werden samengesteld met als doel: * de lichtstroom van de lichtbronnen hoofdzakelijk op het te verlichten oppervlak (doorlopende wegsectie, conflictgebied,...) te richten, teneinde de zichtbaarheid te verhogen; * de lichtstroom te beheersen zodat de weggebruikers niet verblind worden en de lichthinder beperkt wordt; * het optisch systeem, de lichtbronnen en de hulpapparatuur tegen uitwendige invloeden te beschermen"
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
      "parent": [
