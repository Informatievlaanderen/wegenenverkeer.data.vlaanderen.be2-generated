        }
      ],
      "diagramLabel": [
        {
          "@value": "IpPowerSwitch"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een IP powerswitch levert netspanning (230V) aan achterliggende apparaten. Door in te loggen op de powerswitch kunt u de poort en dus de netspanning naar het aangesloten apparaat vanop afstand uit en aan zetten."
        }
