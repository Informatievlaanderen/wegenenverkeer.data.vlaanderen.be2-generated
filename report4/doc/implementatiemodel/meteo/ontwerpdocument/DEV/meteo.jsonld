          "@id": "urn:oslo-toolchain:95a98ceddbe45ec07c2c986e4875e7307417679f9709b1ca99dac8cc6ac31809"
        }
      ],
      "status": "https://data.vlaanderen.be/id/concept/StandaardStatus/OntwerpStandaard"
    },
