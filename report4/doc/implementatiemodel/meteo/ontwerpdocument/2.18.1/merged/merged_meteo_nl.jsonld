    {
      "@id": "urn:oslo-toolchain:0ab96e9131271fb22851c24d59fe63b9c317e15eeb6d9a1a78b6bda7b467135b",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.vlaanderen.be/ns/onderdeel#Spanningsomvormer",
      "vocLabel": [
