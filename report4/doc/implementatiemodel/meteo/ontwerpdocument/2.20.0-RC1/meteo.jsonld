        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een verwerkingseenheid die volgens een vaste cyclus op basis van informatie van zijn ingangen, zijn uitgangen aanstuurt op basis van zijn programma. Omwille van zijn vormfactor kan de eenheid gebruikt worden in een vijandige omgeving."
        }
      ],
