    {
      "@id": "urn:oslo-toolchain:25c4d7f144acabe678814081d89b19a7daa5226005e03bee020a8cb93a344dff",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Spanningsomvormer",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Spanningsomvormer"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Spanningsomvormer"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Een apparaat dat de invoerspanning kan omvormen om een andere uitvoerspanning te bekomen. Typisch is dit type apparaat ook in staat om de frequentie van de elektriciteit te veranderen. Het kan dus gelijkspanning omvormen naar wisselspanning (alternator of wisselrichter), wisselspanning naar wisselspanning van een andere frequentie, of wisselspanning naar gelijkspanning (gelijkrichter)."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
        {
          "@id": "urn:oslo-toolchain:7d05d4d36ffb89135d02e390036889afcac54c2de93df86e116324d63f576730"
        },
