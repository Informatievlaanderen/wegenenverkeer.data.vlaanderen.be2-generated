    {
      "@id": "urn:oslo-toolchain:79805f107f43c1338d805415f1187c79c23a016c4fa64acaeb7fb5a1d1914d41",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Zonnepaneel",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Zonnepaneel"
        }
      ],
      "diagramLabel": [
        {
          "@value": "Zonnepaneel"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel om elektrische energie op te wekken uit zonlicht met als doel het voeden van een installatie. Ook wel fotovoltaïsche cellen of zonnecellen genoemd."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
