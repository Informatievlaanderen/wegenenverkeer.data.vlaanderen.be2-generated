        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Toestel om elektrische energie op te wekken uit zonlicht met als doel het voeden van een installatie. Ook wel fotovoltaïsche cellen of zonnecellen genoemd."
        }
