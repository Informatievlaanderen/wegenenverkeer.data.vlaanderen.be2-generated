      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Geeft aan of de kamer een ingebouwde olieafscheidende voorziening heeft voor het afscheiden en tijdelijk vasthouden van lichte vloeistoffen van minerale oorsprong (zoals oliën en brandstoffen)."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Gebruik dit attribuut enkel wanneer de afscheidende functie integraal deel uitmaakt van de bouwkundige uitvoering van de kamer. Is er een afzonderlijk geplaatst, vervangbaar toestel aanwezig, gebruik dan de klasse KWSAfscheider."
        }
      ],
