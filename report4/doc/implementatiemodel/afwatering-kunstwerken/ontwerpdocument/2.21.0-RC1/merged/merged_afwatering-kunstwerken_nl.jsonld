    {
      "@id": "urn:oslo-toolchain:08201cc261ac696770d61b15eeba1badc9aebcf468127c9410ec40a9b67bd26b",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Brug.totaleLengteBrug",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "totale lengte brug"
        }
      ],
      "diagramLabel": [
        {
          "@value": "totaleLengteBrug"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Horizontaal geprojecteerde oppervlakte van de bovenbouw. Bij constante breedte berekend als de totale lengte van de brug (gemeten volgens de bovenliggende weg) vermenigvuldigd met de totale breedte, uitgedrukt in vierkante meter. Indien de lengte of breedte variabel is, of bij niet-rechthoekige vormen, wordt de oppervlakte van de ingetekende omschreven polygoon van de constructie gebruikt. Bij beschikbaarheid van een polygoon heeft deze methode de voorkeur."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:b0b97f7168954a8c7d537a095bf9d80507a1149785e957bb9969e04d228f4197"
      },
      "range": {
        "@id": "urn:oslo-toolchain:4c7e175b23aa68722ad85f953b61a254f24120cd8d5dca24b0b1f8d6ecc23cf6"
      },
      "minCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "maxCount": {
        "@value": "1",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "status": "https://data.vlaanderen.be/doc/concept/StandaardStatus/KandidaatStandaard"
    },
    {
      "@id": "urn:oslo-toolchain:764b84a5902e62ec22c94d71d1195938c34b01267f88b9bd171d255536db1127",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#Brug.totaleBreedteBrug",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "totale breedte brug"
        }
      ],
      "diagramLabel": [
        {
          "@value": "totaleBreedteBrug"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Totale breedte van de bovenbouw, gemeten loodrecht op de lengteas van de bovenliggende weg, tussen de uiterste grens van de constructie, uitgedrukt in meter. Indien de breedte van de constructie variabel is (bv. trapeziumvormige brug, boog die uitwaaiert), wordt de gemiddelde breedte van de constructie genomen — d.w.z. de gemiddelde breedte van de dwarsprofielen gemeten loodrecht op de bovenliggende weg."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:b0b97f7168954a8c7d537a095bf9d80507a1149785e957bb9969e04d228f4197"
      },
      "range": {
