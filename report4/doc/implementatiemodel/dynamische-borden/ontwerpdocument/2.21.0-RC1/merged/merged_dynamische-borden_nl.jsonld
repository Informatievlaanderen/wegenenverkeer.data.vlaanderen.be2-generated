      "@id": "urn:oslo-toolchain:7082fa54057eaff9919d1f7d5a6f086a1b5887061e9de4f88ae4dc29e496cc3d",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#DynBordExternePU",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Processing unit voor dynamisch borden"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DynBordExternePU"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lokale stuureenheid van een dynamisch bord of bi-flash, die ook de functie van netwerkmodem vervult. Het betreft dus geen stuureenheid in een serverroom."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/External",
      "parent": [
