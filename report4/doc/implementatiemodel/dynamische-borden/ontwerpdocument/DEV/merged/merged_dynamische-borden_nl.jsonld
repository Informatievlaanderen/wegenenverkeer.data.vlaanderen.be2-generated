    {
      "@id": "urn:oslo-toolchain:2267237f64e1c5aa72c1b6e9eda8f622a47a28977511c8c64d245dd529d11287",
      "@type": "Class",
      "assignedURI": "https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DynBordExternePU",
      "vocLabel": [
        {
          "@language": "nl",
          "@value": "Processing unit voor dynamisch borden"
        }
      ],
      "diagramLabel": [
        {
          "@value": "DynBordExternePU"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Lokale stuureenheid van een dynamisch bord of bi-flash, die ook de functie van netwerkmodem vervult. Het betreft dus geen stuureenheid in een serverroom."
        }
      ],
      "scope": "https://data.vlaanderen.be/id/concept/scope/InPublicationEnvironment",
