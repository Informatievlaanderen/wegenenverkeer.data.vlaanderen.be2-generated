      "vocLabel": [
        {
          "@language": "nl",
          "@value": "aantal te verlichten rijstroken"
        }
      ],
      "diagramLabel": [
        {
          "@value": "aantalTeVerlichtenRijstroken"
        }
      ],
      "vocDefinition": [
        {
          "@language": "nl",
          "@value": "Het aantal rijstroken dat verlicht wordt door het LED verlichtingstoestel."
        }
      ],
      "vocUsageNote": [
        {
          "@language": "nl",
          "@value": "Bij een kruispunt zijn dit het aantal effectieve rijstroken. Bij een ontdubbeling van de verlichting, de helft ook al is het fotometrisch mogelijk anders. Bij ontdubbelde rijbanen wordt het aantal rijstroken genomen waarvoor de verlichting is bedoeld."
        }
      ],
      "domain": {
        "@id": "urn:oslo-toolchain:ab2a154f7ef6e1b87bb1c09e357d83c7f02ac293846a6207d6a2aa95e0bfd4fc"
