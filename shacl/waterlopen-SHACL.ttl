<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMNaamObjectShape> a shacl:NodeShape;
  rdfs:label "AIM naam object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor elk OTL object dat benoemd wordt met een mensleesbare identificator."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMNaamObject>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is."@nl;
    rdfs:comment "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMNaamObject.Naam>;
    shacl:class xsd:string;
    shacl:description "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject.naam>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Leuning>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#WaterloopRelatie>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Waterweg>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Waterloop>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Gracht>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#Rioleringsstelsel>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#WaterdoorvoerendeDuiker>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpenInfiltratievoorziening>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Spaarbekken>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stuwconstructie>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Golfplaat> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMObject>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMObject.Asset-Id>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#AIMObject.Notitie>;
    shacl:class xsd:string;
    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.notitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardbestekpostnummer"@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
