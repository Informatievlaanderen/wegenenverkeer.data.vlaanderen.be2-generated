<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#StuwconstructieShape> a shacl:NodeShape;
  rdfs:label "Stuwconstructie"@nl;
  rdfs:comment "Een debietbegrenzende constructie waarbij de afvoer van water gebeurt al dan niet via een knijpopening of een andere hydraulische beperking. Bij hevige regenval, wanneer de watertoevoer niet meer kan worden verwerkt, wordt buffering opgebouwd tot aan de overstort."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Stuwconstructie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "overstortpeil"@nl;
    rdfs:comment "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Stuwconstructie.Overstortpeil>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW>;
    shacl:description "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "overstortpeil"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stuwconstructie.overstortpeil>
  ], [
    a shacl:PropertyShape;
    rdfs:label "diameter knijpopening"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien er geen knijpopening aanwezig is, is deze waarde 0."@nl;
    rdfs:comment "De diameter van de opening onderaan de cascade die zorgt voor een vertraagde waterafvoer bij hevige regenval of overvloedige toevoer van water in millimeter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Stuwconstructie.DiameterKnijpopening>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter>;
    shacl:description "De diameter van de opening onderaan de cascade die zorgt voor een vertraagde waterafvoer bij hevige regenval of overvloedige toevoer van water in millimeter."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "diameter knijpopening"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stuwconstructie.diameterKnijpopening>
  ], [
    a shacl:PropertyShape;
    rdfs:label "breedte uitsparing"@nl;
    <http://purl.org/vocab/vann/usageNote> "Indien er geen uitsparing aanwezig is, is deze waarde 0."@nl;
    rdfs:comment "De breedte van het uitgesneden deel dat de functie heeft van overstort in millimeter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Stuwconstructie.BreedteUitsparing>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter>;
    shacl:description "De breedte van het uitgesneden deel dat de functie heeft van overstort in millimeter."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "breedte uitsparing"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stuwconstructie.breedteUitsparing>
  ];
