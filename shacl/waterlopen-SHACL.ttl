<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#KopmuurShape> a shacl:NodeShape;
  rdfs:label "Kopmuur"@nl;
  rdfs:comment "Een kopmuur is een inrichtingselement van de wegbaan, dat gebruikt wordt voor de geleiding van verkeer bij grachten. Een kopmuur is een keermuur die een functie vervult van afwateringssysteem en is in de regel haaks op de hartlijn van de wegcorridor georiënteerd. Afgeschuinde varianten worden als meer vergevingsgezind gezien bij een aanrijding."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Kopmuur>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "materiaal"@nl;
    rdfs:comment "Bepaalt het materiaal van de kopmuur."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Kopmuur.Materiaal>;
    shacl:description "Bepaalt het materiaal van de kopmuur."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "materiaal"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kopmuur.materiaal>
  ], [
    a shacl:PropertyShape;
    rdfs:label "hellingshoek"@nl;
    rdfs:comment "De hoek tussen de as van de gracht en het vlak van de kopmuur in graden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/waterlopen/ontwerpdocument/DEV#Kopmuur.Hellingshoek>;
    shacl:description "De hoek tussen de as van de gracht en het vlak van de kopmuur in graden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hellingshoek"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kopmuur.hellingshoek>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Kopmuur> .

