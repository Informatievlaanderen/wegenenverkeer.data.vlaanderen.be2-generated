    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject.theoretischeLevensduur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "datum oprichting object"@nl;
    rdfs:comment "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#AIMObject.DatumOprichtingObject>;
