<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#OverstortShape> a shacl:NodeShape;
  rdfs:label "Overstort"@nl;
  rdfs:comment "Een overstort is een constructief element dat toelaat om water vanaf een bepaald peil van het ene hydraulische compartiment naar het andere te laten stromen; bv. een drempel of muur tussen twee kamers, een open bufferbekken en een rioleringsstelsel, etc..."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#Overstort>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "breedte"@nl;
    rdfs:comment "Drempellengte of breedte van de overstort. Deze wordt gemeten aan de kortste zijde van de drempel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#Overstort.Breedte>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMillimeter>;
    shacl:description "Drempellengte of breedte van de overstort. Deze wordt gemeten aan de kortste zijde van de drempel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "breedte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.drempellengte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "peil"@nl;
    rdfs:comment "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#Overstort.Peil>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeterTAW>;
    shacl:description "Drempelpeil van de overstort. Uitgedrukt in meter-TAW gemeten in het midden van de drempel."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "peil"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.peil>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vrije hoogte"@nl;
    rdfs:comment "De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#Overstort.VrijeHoogte>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "De vrije hoogte tussen de overstortdrempel en het plafond van de constructie ter hoogte van de drempel. Voor drempels in leidingen worden de vrije hoogte voor de databank genomen tussen de drempel en de binnenbovenkant buis. Indien er geen sprake is van een vrije hoogte (vb drempels in grachten) wordt dit niet ingevuld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vrije hoogte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.vrijeHoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "materiaal drempel"@nl;
    rdfs:comment "Het gebruikte materiaal voor het vervaardigen van de overstort (drempel)."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/riolering/ontwerpdocument/2.21.0-RC1#Overstort.MateriaalDrempel>;
    shacl:description "Het gebruikte materiaal voor het vervaardigen van de overstort (drempel)."@nl;
