    shacl:minCount 1;
    shacl:name "materiaal drempel"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Overstort.materiaalDrempel>
