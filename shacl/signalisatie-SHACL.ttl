    shacl:description "Een foto van de opstelling zoals die te zien is op het openbaar domein."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "foto"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling.foto>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#AanzichtVerkeersbordopstelling> .

