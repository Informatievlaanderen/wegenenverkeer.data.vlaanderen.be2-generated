<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMDatabankStatus>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMDatabankStatus.IsActief>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "is actief"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMDBStatus.isActief>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IOKaart>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestigingsbeugel>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Buis>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Persleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#LinkendElement>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Brandvoorziening>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Hydrant>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#StuurklepBrandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OntluchterBrandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brandhaspel>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Drukverhogingsgroep>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VulpuntBrandweer>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verwarmingslint>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stroomkring>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verwarmingselement>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMDBStatus> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMNaamObjectShape> a shacl:NodeShape;
  rdfs:label "AIM naam object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor elk OTL object dat benoemd wordt met een mensleesbare identificator."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMNaamObject>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "naam"@nl;
    <http://purl.org/vocab/vann/usageNote> "Dient leeg of consistent te zijn met het naampad indien het naampad attribuut aanwezig en gekend is."@nl;
    rdfs:comment "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMNaamObject.Naam>;
    shacl:class xsd:string;
    shacl:description "De mensleesbare naam van een asset zoals dit bv. ook terug te vinden is op een etiket op het object zelf. De assetbeheerder kent deze naam toe of geeft de opdracht om deze toe te kennen. Indien een object een algemeen gangbare naam heeft zoals bv. bij een waterloop dan wordt deze gebruikt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "naam"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject.naam>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#IOKaart>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestigingsbeugel>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Persleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMNaamObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Brandvoorziening>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Hydrant>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#StuurklepBrandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OntluchterBrandleiding>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Brandhaspel>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Drukverhogingsgroep>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VulpuntBrandweer>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NaampadObject>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Verwarmingslint>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Stroomkring> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.Asset-Id>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.Notitie>;
    shacl:class xsd:string;
    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.notitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardbestekpostnummer"@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.Standaardbestekpostnummer>;
    shacl:class xsd:string;
    shacl:description "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    shacl:minCount 1;
    shacl:name "standaardbestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.standaardBestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "type URI"@nl;
    rdfs:comment "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.TypeURI>;
    shacl:class xsd:anyURI;
    shacl:description "De URI van het object volgens https://www.w3.org/2001/XMLSchema#anyURI ."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type URI"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.typeURI>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bestekpostnummer"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bevat de specifieke identificatie binnen een bestek van een post in de meetstaat. De notatie kan eender welke codering aannemen, bv. in de vorm van een nummer, id of tekst naargelang de notatie in het specifieke bestek."@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.Bestekpostnummer>;
    shacl:class xsd:string;
    shacl:description "Een verwijzing naar een postnummer uit het specifieke bestek waar het object mee verband houdt."@nl;
    shacl:minCount 1;
    shacl:name "bestekpostnummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.bestekPostNummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "theoretische levensduur"@nl;
    rdfs:comment "De levensduur in aantal maanden die theoretisch mag verwacht worden voor een object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/brandleiding/ontwerpdocument/DEV#AIMObject.TheoretischeLevensduur>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMaand>;
    shacl:description "De levensduur in aantal maanden die theoretisch mag verwacht worden voor een object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "theoretische levensduur"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#AIMObject.theoretischeLevensduur>
  ], [
    a shacl:PropertyShape;
    rdfs:label "datum oprichting object"@nl;
    rdfs:comment "De datum waarop het object op het terrein is beginnen bestaan, bv. de datum van aanleg."@nl;
