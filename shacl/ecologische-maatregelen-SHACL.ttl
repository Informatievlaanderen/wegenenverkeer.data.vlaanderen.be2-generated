    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "boomverankeringszone"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Boom.boomverankeringszone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanleg"@nl;
    rdfs:comment "De manier van aanplanten van individuele bomen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#Boom.Aanleg>;
