<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#AanlegBoomvormShape> a shacl:NodeShape;
  rdfs:label "aanleg boomvorm"@nl;
  rdfs:comment "Complex datatype om alle eigenschappen van de aanleg van een opgaande boom onder 1 noemer te houden."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#AanlegBoomvorm>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft boomplaat"@nl;
    rdfs:comment "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#AanlegBoomvorm.HeeftBoomplaat>;
    shacl:class xsd:boolean;
    shacl:description "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft boomplaat"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftBoomplaat>
  ], [
    a shacl:PropertyShape;
    rdfs:label "wortel aanplant"@nl;
    rdfs:comment "De manier van levering en aanplanting van het wortelgestel van de boom of plant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#AanlegBoomvorm.WortelAanplant>;
