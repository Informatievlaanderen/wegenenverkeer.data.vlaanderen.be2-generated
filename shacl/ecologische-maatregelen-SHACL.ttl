    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "totale boombeschermingszone"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Boom.totaleBoombeschermingszone>
  ], [
