    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpgaandeBoom.boomverankeringszone>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aanleg"@nl;
    <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.0.0-RC3"@nl;
    rdfs:comment "De manier van aanplanten van individuele bomen."@nl;
