    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "eindbeeld"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpgaandeBoom.eindbeeld>
  ], [
