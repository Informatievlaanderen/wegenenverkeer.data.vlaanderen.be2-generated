    rdfs:comment "Diameter van de kroonprojectie in meter."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#OpgaandeBoom.KroonDiameter>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInMeter>;
    shacl:description "Diameter van de kroonprojectie in meter."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "kroon diameter"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#OpgaandeBoom.kroonDiameter>
  ], [
