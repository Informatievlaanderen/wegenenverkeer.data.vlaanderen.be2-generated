    shacl:minCount 1;
    shacl:name "aanleg"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Boom.aanleg>
  ], [
    a shacl:PropertyShape;
    rdfs:label "takvrije hoogte"@nl;
    rdfs:comment "Tot aan de hoogte van de gewenste takvrije stamlengte wordt de boom zodanig gesnoeid dat er één doorgaande stam is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#Boom.TakvrijeHoogte>;
    shacl:description "Tot aan de hoogte van de gewenste takvrije stamlengte wordt de boom zodanig gesnoeid dat er één doorgaande stam is."@nl;
