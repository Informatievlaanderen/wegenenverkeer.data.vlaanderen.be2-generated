  ], [
    a shacl:PropertyShape;
    rdfs:label "totale boombeschermingszone"@nl;
    rdfs:comment "De straal van de cirkelvormige ruimte rond de boom waar maatregelen genomen worden om de boom te beschermen tijdens projecten of manifestaties uitgedrukt in centimeters."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/ecologische-maatregelen/ontwerpdocument/DEV#Boom.TotaleBoombeschermingszone>;
