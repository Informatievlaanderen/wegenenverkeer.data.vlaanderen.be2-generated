<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/complexe-datatypes/ontwerpdocument/2.20.0-RC1#AanlegBoomvormShape> a shacl:NodeShape;
  rdfs:label "aanleg boomvorm"@nl;
  rdfs:comment "Complex datatype om alle eigenschappen van de aanleg van een opgaande boom onder 1 noemer te houden."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "heeft boomplaat"@nl;
    rdfs:comment "Boomplaten worden aangebracht rond de stam van bomen, bosgoed en heesters en eventueel vastgezet met piketten. Ze hebben een centrale opening en een rechte snede, zodat ze op eenvoudige wijze rond de planten kunnen aangebracht worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/complexe-datatypes/ontwerpdocument/2.20.0-RC1#AanlegBoomvorm.HeeftBoomplaat>;
