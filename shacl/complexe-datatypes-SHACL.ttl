    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft boomplaat"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftBoomplaat>
  ], [
