<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/complexe-datatypes/ontwerpdocument/DEV#AanlegBoomvormShape> a shacl:NodeShape;
  rdfs:label "aanleg boomvorm"@nl;
