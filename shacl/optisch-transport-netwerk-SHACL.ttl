    shacl:description "Unieke identificatiecode van het toestel, toegekend door de fabrikant."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "serienummer"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS.serienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "maximaal continu vermogen"@nl;
    rdfs:comment "Maximale continu vermogen van de UPS."@nl;
