    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "Modelnaam van de UPS volgens de fabrikant."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/optisch-transport-netwerk/ontwerpdocument/2.20.0-RC1#UPS.Modelnaam>;
    shacl:class skos:Concept;
    shacl:description "Modelnaam van de UPS volgens de fabrikant."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#UPS.modelnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "serienummer"@nl;
