<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/optisch-transport-netwerk/ontwerpdocument/2.20.0-RC1#AIMObjectShape> a shacl:NodeShape;
  rdfs:label "AIM object"@nl;
  rdfs:comment "Abstracte als de basisklasse voor alle uniek geïdentificeerde OTL objecten met de basiseigenschappen die elk OTL object minstens heeft."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-id"@nl;
    rdfs:comment "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/optisch-transport-netwerk/ontwerpdocument/2.20.0-RC1#AIMObject.Asset-Id>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcIdentificator>;
    shacl:description "Unieke identificatie van de asset zoals toegekend door de assetbeheerder of n.a.v. eerste aanlevering door de leverancier."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "asset-id"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject.assetId>
  ], [
    a shacl:PropertyShape;
    rdfs:label "notitie"@nl;
    rdfs:comment "Extra notitie voor het object."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/optisch-transport-netwerk/ontwerpdocument/2.20.0-RC1#AIMObject.Notitie>;
    shacl:class xsd:string;
    shacl:description "Extra notitie voor het object."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "notitie"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#AIMObject.notitie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standaardbestekpostnummer"@nl;
    rdfs:comment "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/optisch-transport-netwerk/ontwerpdocument/2.20.0-RC1#AIMObject.Standaardbestekpostnummer>;
    shacl:class xsd:string;
    shacl:description "Een verwijzing naar een postnummer uit het standaardbestek waar het object mee verband houdt. De notatie van het postnummer moet overeenkomen met de notatie die gebruikt is in de catalogi van standaardbestekken, bijvoorbeeld postnummer 0701.20404G."@nl;
