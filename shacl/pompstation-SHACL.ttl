    shacl:description "De diameter van het deel van de leiding dat verticaal is opgesteld."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "diameter verticaal"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Voetbocht.diameterVerticaal>
