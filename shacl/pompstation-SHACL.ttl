    shacl:description "De modelnaam van de vlotterschakeling."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Vlotterschakelaar.modelnaam>
