    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "totale lengte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/installatie#GeluidwerendeConstructie.totaleLengte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "overzichtsafbeelding"@nl;
    rdfs:comment "Dit een overzichtsfoto van de hele constructie. Op basis van deze afbeelding kan je snel bekijken hoe de kleur of hoogte varieert over het verloop van de geluidswerende constructie."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/2.20.0-RC1#GeluidwerendeConstructie.Overzichtsafbeelding>;
