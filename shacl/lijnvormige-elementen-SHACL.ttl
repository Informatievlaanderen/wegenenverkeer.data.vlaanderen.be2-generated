    shacl:minCount 1;
    shacl:name "rekennota"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#GeluidwerendeConstructie.rekennota>
  ], [
    a shacl:PropertyShape;
    rdfs:label "horizontaal ruimtebeslag"@nl;
    rdfs:comment "Document waarin de variatie in horizontaal ruimtebeslag over het verloop van de geluidswerende constructie is weergegeven. Het horizontaal ruimtebeslag is de breedte die de gehele constructie inneemt op het maaiveld, loodrecht op de richting waarin de schermelementen op elkaar aangesloten zijn. Er moet een nieuwe waarde ingegeven worden elke keer als de hoogte van de constructie wijzigt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/DEV#GeluidwerendeConstructie.HorizontaalRuimtebeslag>;
