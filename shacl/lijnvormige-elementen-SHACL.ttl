    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "schermelementtype"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VlakGeluidsschermelement.schermelementtype>
  ], [
    a shacl:PropertyShape;
