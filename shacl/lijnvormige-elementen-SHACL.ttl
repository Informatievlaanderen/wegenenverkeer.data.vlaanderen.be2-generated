<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/DEV#VlakGeluidschermelementShape> a shacl:NodeShape;
  rdfs:label "Vlak geluidschermelement"@nl;
  <http://purl.org/vocab/vann/usageNote> "De technische fiche van \"Geluidsschermelementen\" bevat extra informatie over: kleurvariatie/kleurverloop, mate van profilering van de absorberende laag, statische belasting, gedetailleerde materiaalspecificaties, of er gebruik wordt gemaakt van een draadpaneel om beplanting op te laten groeien, de eventuele kromming van de schermelementen en ook in welke mate het scherm naar voor of naar achter helt."@nl;
  rdfs:comment "Een vlak scherm zijn alle schermtypes die getest kunnen worden volgens de normen NBN EN 1793-1 NBN EN 1793-2."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/DEV#VlakGeluidschermelement>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "opstelling"@nl;
    rdfs:comment "Dit attribuut beschrijft de oriëntatie van het geplaatste schermelement t.o.v. de weg. De oriëntatie van vlakke schermen kan naast loodrecht op het maaiveld ook schuin naar achter hellend of schuin naar voor hellend zijn."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/DEV#VlakGeluidschermelement.Opstelling>;
    shacl:description "Dit attribuut beschrijft de oriëntatie van het geplaatste schermelement t.o.v. de weg. De oriëntatie van vlakke schermen kan naast loodrecht op het maaiveld ook schuin naar achter hellend of schuin naar voor hellend zijn."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "opstelling"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VlakGeluidsschermelement.opstelling>
  ], [
    a shacl:PropertyShape;
    rdfs:label "vorm"@nl;
    rdfs:comment "Dit attribuut geeft aan of het schermelement recht of gebogen is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/DEV#VlakGeluidschermelement.Vorm>;
    shacl:description "Dit attribuut geeft aan of het schermelement recht of gebogen is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vorm"@nl;
