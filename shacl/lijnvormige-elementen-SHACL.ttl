    rdfs:label "rekennota"@nl;
    rdfs:comment "Dit is een document waarin allerlei berekeningen bijgehouden worden omtrent de stabiliteit en sterkte van de geluidswerende constructie (oa de variatie in statische belasting en windbelasting over het verloop van geluidswerende constructie)."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/lijnvormige-elementen/ontwerpdocument/2.20.0-RC1#GeluidwerendeConstructie.Rekennota>;
