    shacl:minCount 1;
    shacl:name "horizontaal ruimtebeslag"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/installatie#GeluidwerendeConstructie.horizontaalRuimtebeslag>
