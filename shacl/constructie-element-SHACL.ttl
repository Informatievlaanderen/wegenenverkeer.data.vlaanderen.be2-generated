<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/constructie-element/ontwerpdocument/2.20.0-RC1#AssetVersieShape> a shacl:NodeShape;
  rdfs:label "Asset versie"@nl;
  rdfs:comment "Complex datatype voor de eigenschappen ten behoeve van de versionering van een asset in de databank."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versienummer"@nl;
    rdfs:comment "Het versienummer als een oplopende integer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/constructie-element/ontwerpdocument/2.20.0-RC1#AssetVersie.Versienummer>;
    shacl:class xsd:nonNegativeInteger;
    shacl:description "Het versienummer als een oplopende integer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "versienummer"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcAssetVersie.versienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "timestamp"@nl;
    rdfs:comment "De timestamp van het moment dat de versienummer werd toegekend."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/constructie-element/ontwerpdocument/2.20.0-RC1#AssetVersie.Timestamp>;
    shacl:class xsd:dateTime;
    shacl:description "De timestamp van het moment dat de versienummer werd toegekend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "timestamp"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcAssetVersie.timestamp>
  ], [
    a shacl:PropertyShape;
