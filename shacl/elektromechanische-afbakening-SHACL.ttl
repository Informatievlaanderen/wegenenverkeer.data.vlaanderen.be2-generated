<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektromechanische-afbakening/ontwerpdocument/2.20.0-RC1#AIMDatabankStatusShape> a shacl:NodeShape;
  rdfs:label "AIM databank status"@nl;
  rdfs:comment "Voegt een attribuut toe aan de subklasse dat aangeeft of de asset zichtbaar is in de databank of (zacht) verwijderd is."@nl;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "is actief"@nl;
    rdfs:comment "Geeft aan of het object actief kan gebruikt worden of (zacht) verwijderd is uit het asset beheer systeem."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/elektromechanische-afbakening/ontwerpdocument/2.20.0-RC1#AIMDatabankStatus.IsActief>;
