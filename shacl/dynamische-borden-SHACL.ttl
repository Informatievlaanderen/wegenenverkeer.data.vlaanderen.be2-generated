    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/dynamische-borden/ontwerpdocument/DEV#Omvormer.Type>;
    shacl:description "De soort omvorming die gebeurt er in de omvormer."@nl;
