<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aim-object/ontwerpdocument/DEV#AIMVersieShape> a shacl:NodeShape;
  rdfs:label "AIM versie"@nl;
  rdfs:comment "Abstracte klasse met de eigenschappen om de versionering van een asset te beheren."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aim-object/ontwerpdocument/DEV#AIMVersie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "asset-versie"@nl;
    rdfs:comment "De versie van de asset in de database."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aim-object/ontwerpdocument/DEV#AIMVersie.Asset-Versie>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAssetVersie>;
    shacl:description "De versie van de asset in de database."@nl;
    shacl:maxCount 1;
