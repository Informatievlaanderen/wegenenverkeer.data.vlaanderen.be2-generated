<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/aim-object/ontwerpdocument/DEV#ToegangsprocedureShape> a shacl:NodeShape;
  rdfs:label "Toegangsprocedure"@nl;
