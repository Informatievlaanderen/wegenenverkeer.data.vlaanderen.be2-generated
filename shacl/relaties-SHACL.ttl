<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#AdresShape> a shacl:NodeShape;
  rdfs:label "Adres"@nl;
  rdfs:comment "Complex datatype voor de aanduiding van een bepaalde locatie, doorgaans van een huis, woning, gebouw of faciliteit, op de aarde."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "straatnaam"@nl;
    rdfs:comment "De naam van de straat."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Straatnaam>;
    shacl:class xsd:string;
    shacl:description "De naam van de straat."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "straatnaam"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.straatnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "huisnummer"@nl;
    rdfs:comment "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Huisnummer>;
    shacl:class xsd:string;
    shacl:description "Een nummer dat door de gemeente aan bv. een huis wordt toegekend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "huisnummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.huisnummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "bus"@nl;
    rdfs:comment "Een nummer dat de postbus aanduidt."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Bus>;
    shacl:class xsd:string;
    shacl:description "Een nummer dat de postbus aanduidt."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "bus"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.bus>
  ], [
    a shacl:PropertyShape;
    rdfs:label "postcode"@nl;
    rdfs:comment "Een korte reeks tekens die in het postadres wordt opgenomen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Postcode>;
    shacl:class xsd:string;
    shacl:description "Een korte reeks tekens die in het postadres wordt opgenomen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "postcode"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.postcode>
  ], [
    a shacl:PropertyShape;
    rdfs:label "provincie"@nl;
    rdfs:comment "Het deelgebied waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Provincie>;
    shacl:description "Het deelgebied waarin het adres gelegen is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "provincie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.provincie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "gemeente"@nl;
    rdfs:comment "De bestuurlijke eenheid waarin het adres gelegen is."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Adres.Gemeente>;
    shacl:description "De bestuurlijke eenheid waarin het adres gelegen is."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "gemeente"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres.gemeente>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAdres> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#AssetVersieShape> a shacl:NodeShape;
  rdfs:label "Asset versie"@nl;
  rdfs:comment "Complex datatype voor de eigenschappen ten behoeve van de versionering van een asset in de databank."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#AssetVersie>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "versienummer"@nl;
    rdfs:comment "Het versienummer als een oplopende integer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#AssetVersie.Versienummer>;
    shacl:class xsd:nonNegativeInteger;
    shacl:description "Het versienummer als een oplopende integer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "versienummer"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAssetVersie.versienummer>
  ], [
    a shacl:PropertyShape;
    rdfs:label "timestamp"@nl;
    rdfs:comment "De timestamp van het moment dat de versienummer werd toegekend."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#AssetVersie.Timestamp>;
    shacl:class xsd:dateTime;
    shacl:description "De timestamp van het moment dat de versienummer werd toegekend."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "timestamp"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#DtcAssetVersie.timestamp>
  ], [
    a shacl:PropertyShape;
    rdfs:label "context"@nl;
    rdfs:comment "De context van de versie creatie."@nl;
