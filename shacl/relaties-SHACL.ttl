    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#HeeftVPlan>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#NietDirectioneleRelatie>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Sturing>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Bevestiging> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#SluitAanOpShape> a shacl:NodeShape;
  rdfs:label "Sluit aan op"@nl;
  rdfs:comment "Deze relatie geeft aan hoe 2 onderdelen in horizontale zin elkaar opvolgen. Dit wordt gebruikt om een topologisch netwerk op te bouwen. Enkel in gebruik bij afschermende constructies en riolering/waterlopen. Deze relatie heeft steeds een richting van het opwaartse naar het afwaartse onderdeel."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#SluitAanOp>;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#SluitAanOp> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#StringShape> a shacl:NodeShape;
  rdfs:label "String"@nl;
  <http://purl.org/vocab/vann/usageNote> "https://www.w3.org/TR/xmlschema-2/#string"@nl;
  rdfs:comment "Beschrijft een tekstregel volgens http://www.w3.org/2001/XMLSchema#string."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#String>;
  shacl:closed false;
  shacl:targetClass xsd:string .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#SturingShape> a shacl:NodeShape;
  rdfs:label "Sturing"@nl;
  rdfs:comment "Deze relatie geeft aan of er een of andere vorm van dataverkeer is tussen 2 onderdelen. Een wegverlichtingstoestel dat aan staat wordt ook als sturing beschouwd, in dit geval is het een lang ononderbroken elektrisch aan-signaal. Deze relatie heeft geen richting."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Sturing>;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Sturing> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#TijdShape> a shacl:NodeShape;
  rdfs:label "Tijd"@nl;
  <http://purl.org/vocab/vann/usageNote> "https://www.w3.org/TR/xmlschema-2/#time"@nl;
  rdfs:comment "Beschrijft een tijd volgens http://www.w3.org/2001/XMLSchema#time."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Tijd>;
  shacl:closed false;
  shacl:targetClass xsd:time .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#URIShape> a shacl:NodeShape;
  rdfs:label "URI"@nl;
  <http://purl.org/vocab/vann/usageNote> "https://www.w3.org/TR/xmlschema-2/#anyURI"@nl;
  rdfs:comment "Een tekstwaarde die een verwijzing naar meer informatie van het element bevat volgens http://www.w3.org/2001/XMLSchema#anyURI ."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#URI>;
  shacl:closed false;
  shacl:targetClass xsd:anyURI .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#VoedtAangestuurdShape> a shacl:NodeShape;
  rdfs:label "Voedt aangestuurd"@nl;
  rdfs:comment "Deze relatie wordt enkel gelegd naar objecttypes die typisch een groot vermogen vereisen en onder spanning komen nadat het voedend element aangestuurd is om die spanning door te sturen."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#VoedtAangestuurd>;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VoedtAangestuurd> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#VoedtShape> a shacl:NodeShape;
  rdfs:label "Voedt"@nl;
  rdfs:comment "Deze relatie wordt enkel gelegd naar onderdelen die permanent onder spanning staan in normaal bedrijf. Aan deze relatie wordt steeds een richting toegekend van de voedinggever naar de ontvanger."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Voedt>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "aansluitspanning"@nl;
    rdfs:comment "Spanning van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Voedt.Aansluitspanning>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInVolt>;
    shacl:description "Spanning van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aansluitspanning"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt.aansluitspanning>
  ], [
    a shacl:PropertyShape;
    rdfs:label "aansluitvermogen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.1.0-RC2"@nl;
    rdfs:comment "Vermogen van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#Voedt.Aansluitvermogen>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInVolt>;
    shacl:description "Vermogen van de aansluiting, dit wordt enkel ingevuld op voedingsrelaties voorbij de hoofdschakelaar."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "aansluitvermogen"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt.aansluitvermogen>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Voedt> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/relaties/ontwerpdocument/DEV#WeekdagenShape> a shacl:NodeShape;
