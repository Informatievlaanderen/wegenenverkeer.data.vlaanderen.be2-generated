    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "tussenafstand LED"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#VerlichtingstoestelLED.tussenafstandLED>
  ], [
    a shacl:PropertyShape;
    rdfs:label "tussen afstand"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.4.0-RC1"@nl;
    rdfs:comment "Afstand tussen de verschillende LED verlichtingstoestellen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/koker/ontwerpdocument/2.20.0-RC1#VerlichtingstoestelLED.TussenAfstand>;
