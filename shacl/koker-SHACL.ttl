  ], [
    a shacl:PropertyShape;
    rdfs:label "bewegingsvrijheid in het vlak"@nl;
    rdfs:comment "De bewegingsvrijheid in het vlak. Er kunnen meerdere mogelijkheden zijn."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/koker/ontwerpdocument/2.20.0-RC1#Oplegging.BewegingsvrijheidInHetVlak>;
