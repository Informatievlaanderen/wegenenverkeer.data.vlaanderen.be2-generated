    shacl:description "Vermogen (Watt) van het verkeerslicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "vermogen"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeerslicht.vermogen>
  ], [
    a shacl:PropertyShape;
    rdfs:label "masker"@nl;
    rdfs:comment "Type masker dat is aangebracht op het verkeerslicht."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#Verkeerslicht.Masker>;
    shacl:description "Type masker dat is aangebracht op het verkeerslicht."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "masker"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Verkeerslicht.masker>
  ], [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van het verkeerslicht."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#Verkeerslicht.Merk>;
