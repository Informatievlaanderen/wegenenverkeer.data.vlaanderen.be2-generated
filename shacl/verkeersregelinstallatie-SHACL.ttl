    a shacl:PropertyShape;
    rdfs:label "type geheugen"@nl;
    <http://purl.org/vocab/vann/usageNote> "Klasse uit gebruik sinds versie 2.12.0-RC2"@nl;
    rdfs:comment "Type opslaggeheugen op de aanwezige SD-kaart."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#VR-Communicatiekaart.TypeGeheugen>;
    shacl:description "Type opslaggeheugen op de aanwezige SD-kaart."@nl;
