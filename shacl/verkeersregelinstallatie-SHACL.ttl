    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "tabel uitwendige invloeden"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#Behuizing.tabelUitwendigeInvloeden>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Wegkantkast>,
