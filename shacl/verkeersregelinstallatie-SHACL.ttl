    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/implementatieelement#KwantWrdInVolt>;
    shacl:description "Spanning waarmee de detectoren gevoed worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "voedingsspanning"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#NietWeggebondenDetectie.voedingsspanning>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#NietWeggebondenDetectie>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Drukknop>,
