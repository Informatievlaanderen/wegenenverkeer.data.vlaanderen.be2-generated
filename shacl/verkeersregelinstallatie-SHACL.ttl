<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#VirtueleDetectiezoneShape> a shacl:NodeShape;
  rdfs:label "Virtuele detectiezone"@nl;
  rdfs:comment "Een virtuele detectiezone is een draadloos alternatief voor een traditionele lus. Op basis van GPS gegevens wordt een zone of traject vastgelegd waarbinnen er (al dan niet selectieve) input dient geleverd te worden aan de verkeersregelaar. De virtuele detectiezone kan ook gebruikt worden om de detectiezones van detectiecamera's en radars te inventariseren."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#VirtueleDetectiezone>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "functie"@nl;
    rdfs:comment "Functie van de VRI detectiezone."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/verkeersregelinstallatie/ontwerpdocument/DEV#VirtueleDetectiezone.Functie>;
    shacl:description "Functie van de VRI detectiezone."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "functie"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#VRIVirtueleDetectiezone.functie>
  ], [
    a shacl:PropertyShape;
    rdfs:label "is richtingsgevoelig"@nl;
