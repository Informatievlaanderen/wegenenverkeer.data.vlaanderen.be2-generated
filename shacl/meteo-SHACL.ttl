    shacl:minCount 1;
    shacl:name "ip adres"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.ipAdres>
  ], [
    a shacl:PropertyShape;
    rdfs:label "rijrichting"@nl;
    rdfs:comment "De effectieve rijrichting van de voertuigen aan de hand van de km-punten die door de camera geregistreerd worden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/meteo/ontwerpdocument/2.20.0-RC1#Camera.Rijrichting>;
    shacl:class skos:Concept;
    shacl:description "De effectieve rijrichting van de voertuigen aan de hand van de km-punten die door de camera geregistreerd worden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "rijrichting"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.rijrichting>
  ], [
    a shacl:PropertyShape;
    rdfs:label "technische fiche"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bestanden van het type pdf."@nl;
    rdfs:comment "Technische fiche van dit element met opsplitsing tussen CCTV, AID en PTZ-camera's."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/meteo/ontwerpdocument/2.20.0-RC1#Camera.TechnischeFiche>;
    shacl:class <https://wegenenverkeer-test.data.vlaanderen.be/ns/implementatieelement#DtcDocument>;
    shacl:description "Technische fiche van dit element met opsplitsing tussen CCTV, AID en PTZ-camera's."@nl;
    shacl:minCount 1;
    shacl:name "technische fiche"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.technischeFiche>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "De modelnaam van de camera."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/meteo/ontwerpdocument/2.20.0-RC1#Camera.Modelnaam>;
    shacl:class skos:Concept;
    shacl:description "De modelnaam van de camera."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "modelnaam"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.modelnaam>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft spitsstrook"@nl;
    <http://purl.org/vocab/vann/usageNote> "Attribuut uit gebruik sinds versie 2.3.0-RC1"@nl;
    rdfs:comment "Locatie-eigenschap van een camera. Dit attribuut geeft aan of de camera ingezet wordt om een spitsstrook te schouwen."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/meteo/ontwerpdocument/2.20.0-RC1#Camera.HeeftSpitsstrook>;
    shacl:class xsd:boolean;
    shacl:description "Locatie-eigenschap van een camera. Dit attribuut geeft aan of de camera ingezet wordt om een spitsstrook te schouwen."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft spitsstrook"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.heeftSpitsstrook>
  ], [
    a shacl:PropertyShape;
    rdfs:label "heeft flits"@nl;
    rdfs:comment "Geeft aan of de camera een externe infrarood flits heeft."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/meteo/ontwerpdocument/2.20.0-RC1#Camera.HeeftFlits>;
    shacl:class xsd:boolean;
    shacl:description "Geeft aan of de camera een externe infrarood flits heeft."@nl;
