  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hellingshoek"@nl;
    rdfs:comment "Hoek die het object maakt ten opzichte van de verticale, uitgedrukt in decimale graden."@nl;
