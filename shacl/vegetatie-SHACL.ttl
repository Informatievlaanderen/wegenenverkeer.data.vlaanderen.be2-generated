    shacl:minCount 1;
    shacl:name "natuurstreefbeeld"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Grasland.natuurstreefbeeld>
