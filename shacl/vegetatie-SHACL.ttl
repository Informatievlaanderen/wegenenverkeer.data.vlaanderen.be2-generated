    a shacl:PropertyShape;
    rdfs:label "huidig natuurbeeld"@nl;
    rdfs:comment "Bepaling van het vegetatietype op basis van terreininventarisatie."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#GrasKruidenmixGrasland-Fase3.HuidigNatuurbeeld>;
    shacl:description "Bepaling van het vegetatietype op basis van terreininventarisatie."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "huidig natuurbeeld"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#GrasKruidenmixGraslandfase3.huidigNatuurbeeld>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#GrasKruidenmixGraslandfase3> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#GraslandShape> a shacl:NodeShape;
  rdfs:label "Grasland"@nl;
  rdfs:comment "Grazige vegetatie met daarin kruidachtigen die jaarlijks één of meerdere malen per jaar gemaaid of begraasd wordt."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#Grasland>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "natuurstreefbeeld"@nl;
    rdfs:comment "Een natuurstreefbeeld is een nagestreefd biotoop, mozaïek van biotopen of een leefgebied van een soort dat je wil behouden of verkrijgen via een goed natuurbeheer. In het definitief plan van type twee, drie of vier wordt het ecologisch einddoel vastgesteld aan de hand van natuurstreefbeelden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#Grasland.Natuurstreefbeeld>;
    shacl:description "Een natuurstreefbeeld is een nagestreefd biotoop, mozaïek van biotopen of een leefgebied van een soort dat je wil behouden of verkrijgen via een goed natuurbeheer. In het definitief plan van type twee, drie of vier wordt het ecologisch einddoel vastgesteld aan de hand van natuurstreefbeelden."@nl;
