<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#UitheemsLoofhoutShape> a shacl:NodeShape;
  rdfs:label "Uitheems loofhout"@nl;
  <http://purl.org/vocab/vann/usageNote> "Deze klasse wordt vooral gebruikt ikv. een natuurbeheerplan waarbij een bepaald terrein via een inventarisatie van de bestaande toestand, verder wordt opgevolgd dmv. beheermaatregelingen om bepaalde beheerdoelstellingen/natuurstreefbeelden te realiseren."@nl;
  rdfs:comment "H4 - Jonge aanplant met dominantie van allerlei loofhout op niet-bosbodems, incl. exoten (Robinia, populier, vederesdoorn, Amerikaanse eik, Amerikaanse vogelkers) eventueel met bijmenging van struweelsoorten (S3 tot S5)."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#UitheemsLoofhout>;
  shacl:closed false;
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#UitheemsLoofhout> .

<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElementShape> a shacl:NodeShape;
  rdfs:label "Vegetatie element"@nl;
  rdfs:comment "Abstracte om alle gemeenschappelijke eigenschappen en relaties van de solitaire plant in de ruimte onder 1 noemer te plaatsen."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElement>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "hoogteklasse"@nl;
    rdfs:comment "De hoogteklasse van het vegetatie-element."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElement.Hoogteklasse>;
    shacl:description "De hoogteklasse van het vegetatie-element."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "hoogteklasse"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#VegetatieElement.hoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "standplaats"@nl;
    rdfs:comment "De plek of locatie waar het vegetatieelement groeit."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElement.Standplaats>;
    shacl:description "De plek of locatie waar het vegetatieelement groeit."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "standplaats"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#VegetatieElement.standplaats>
  ], [
    a shacl:PropertyShape;
    rdfs:label "niveau"@nl;
    rdfs:comment "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten. Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElement.Niveau>;
    shacl:class xsd:decimal;
    shacl:description "Het niveau waarop het object zich bevindt, relatief ten opzichte van andere objecten. Negatieve waarden worden geassocieerd met ondergronds en positieve waarden met bovengronds. Nul wordt beschouwd als een absolute waarde om het maaiveld aan te duiden."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "niveau"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#VegetatieElement.niveau>
  ], [
    a shacl:PropertyShape;
    rdfs:label "soortnaam"@nl;
    rdfs:comment "Met deze eigenschap worden de Nederlandse soortnaam, wetenschappelijke soortnaam en de soortcode van de plantensoort weergegeven."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#VegetatieElement.Soortnaam>;
    shacl:class <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcVegetatieSoortnaam>;
    shacl:description "Met deze eigenschap worden de Nederlandse soortnaam, wetenschappelijke soortnaam en de soortcode van de plantensoort weergegeven."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "soortnaam"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#VegetatieElement.soortnaam>
  ];
  shacl:targetClass <https://wegenenverkeer.data.dev-vlaanderen.be/ns/abstracten#VegetatieElement>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Klimvorm>,
    <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#Muurvegetatie>,
