    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "heeft wortelgeleiding wortelwering"@nl;
    shacl:path <https://wegenenverkeer.data.dev-vlaanderen.be/ns/onderdeel#DtcAanlegBoomvorm.heeftWortelgeleidingwortelwering>
  ], [
    a shacl:PropertyShape;
    rdfs:label "plantmaat hoogte"@nl;
    rdfs:comment "De hoogte in meter gemeten van de stamvoet tot de top met een minimum en maximum waarde."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/vegetatie/ontwerpdocument/DEV#AanlegBoomvorm.PlantmaatHoogte>;
    shacl:description "De hoogte in meter gemeten van de stamvoet tot de top met een minimum en maximum waarde."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "plantmaat hoogte"@nl;
