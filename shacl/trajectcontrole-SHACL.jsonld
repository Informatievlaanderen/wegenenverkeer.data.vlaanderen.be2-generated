      {
        "@id": "https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/trajectcontrole/ontwerpdocument/2.20.0-RC1#Camera.IsPTZ"
      }
    ],
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "nl",
        "@value": "Een PTZ-camera is een CCTV-camera met bijhorend de mogelijkheid om te pannen, tilten en zoomen. Dit vanop afstand met behulp van een verstelbare lens en een motor die in twee assen draaibeweging toelaat."
