    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "opstelhoogte"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Camera.opstelhoogte>
  ], [
    a shacl:PropertyShape;
    rdfs:label "service prioriteit"@nl;
