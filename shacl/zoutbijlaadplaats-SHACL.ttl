    shacl:description "Technische fiche van de omvormer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "technische fiche"@nl;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omvormer.technischeFiche>
  ], [
