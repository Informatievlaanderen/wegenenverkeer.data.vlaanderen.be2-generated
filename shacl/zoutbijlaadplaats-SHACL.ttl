    rdfs:label "type"@nl;
    rdfs:comment "De soort omvorming die gebeurt er in de omvormer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#Omvormer.Type>;
    shacl:description "De soort omvorming die gebeurt er in de omvormer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "type"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omvormer.type>
  ], [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van de omvormer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#Omvormer.Merk>;
    shacl:description "Het merk van de omvormer."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#Omvormer.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "technische fiche"@nl;
    <http://purl.org/vocab/vann/usageNote> "Bestanden van het type pdf."@nl;
    rdfs:comment "Technische fiche van de omvormer."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#Omvormer.TechnischeFiche>;
