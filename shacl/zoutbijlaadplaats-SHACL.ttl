    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#CapacitieveNiveaumeting.modelnaam>
  ];
  shacl:targetClass <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#CapacitieveNiveaumeting> .

