<https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#CapacitieveNiveaumetingShape> a shacl:NodeShape;
  rdfs:label "Capacitieve niveaumeting"@nl;
  rdfs:comment "Een inrichting voor het bepalen van het peil van een vloeistof (bv. het waterniveau in een vloeistoftank of lekwaterput van een kelder). Een capacitieve sensor meet de aan- of afwezigheid van een materiaal of vloeistof. Het meest gebruikte type is de driepunts elektrode, hierbij krijgt elke elektrode een eigen grenswaarde, uit de combinatie van de gegeven die de verschillende elektroden oplevert kan het niveau bepaald worden. Het resultaat wordt omgezet in een uitleesbaar signaal."@nl;
  rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#CapacitieveNiveaumeting>;
  shacl:closed false;
  shacl:property [
    a shacl:PropertyShape;
    rdfs:label "merk"@nl;
    rdfs:comment "Het merk van de capacitieve niveaumeting."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#CapacitieveNiveaumeting.Merk>;
    shacl:description "Het merk van de capacitieve niveaumeting."@nl;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "merk"@nl;
    shacl:nodeKind shacl:BlankNodeOrIRI;
    shacl:path <https://wegenenverkeer-test.data.vlaanderen.be/ns/onderdeel#CapacitieveNiveaumeting.merk>
  ], [
    a shacl:PropertyShape;
    rdfs:label "modelnaam"@nl;
    rdfs:comment "De modelnaam van de capacitieve niveaumeting."@nl;
    rdfs:seeAlso <https://wegenenverkeer.data.dev-vlaanderen.be/doc/implementatiemodel/zoutbijlaadplaats/ontwerpdocument/2.21.0-RC1#CapacitieveNiveaumeting.Modelnaam>;
